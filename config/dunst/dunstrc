[global]
    font = DejaVu Sans Mono 12
    markup = yes
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    geometry = "400x5-20+40"
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    history_length = 20
    show_indicators = no
    line_height = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 16
    separator_color = frame
    startup_notification = false
    corner_radius = 8

    frame_color = "#c44d7a"
    background = "#1a0a12"
    foreground = "#ffe3ee"

[urgency_low]
    background = "#2a1520"
    foreground = "#9d5c75"
    timeout = 4

[urgency_normal]
    background = "#1a0a12"
    foreground = "#ffe3ee"
    timeout = 6

[urgency_critical]
    background = "#2a1520"
    foreground = "#ff2d55"
    frame_color = "#ff2d55"
    timeout = 0
