# i3 config — the house desktop.
#
# Provenance matters here. This file was once slimmed from the 2026-09-23
# backup (~/.config/i3/config.bak-2026-09-23-165842, 9315 bytes) down to 89
# lines, and the slimmer file DROPPED `tiling_drag modifier`, `floating_modifier`
# and `for_window [class=".*"] floating enable`. Those three lines are the whole
# reason Super+drag works. Losing them made it look like "i3 ignores my drag",
# and a long detour followed into the `drag` *command*, which is a different
# feature and is separately broken on this machine (measured: press arrives,
# command runs, 0px of movement).
#
# Measured on this box, 2026-09-27:
#   floating_modifier + drag on a FLOATING window  -> WORKS  (window moves)
#   drag move / drag resize (the command)          -> 0px, does nothing
#   tiling_drag on a tiled window                  -> does not reorder
# Therefore windows open FLOATING, exactly as the Sep 23 config had them.
# Do not "tidy" the for_window rule away; it is load-bearing for the mouse.
#
# What is deliberately different from Sep 23, and why:
#   - no i3bar. Its status_command needed a resident process, and a dying
#     status_command printed errors across the screen. fae-cycle owns the cues
#     now (kitty set-tab-color flash + toast + an audit log).
#   - house pink palette and DejaVu Sans Mono 12 (all-mono type, house rule).
#   - Alt+Tab is fae-cycle (global MRU), not `rofi -show window`.
#   - every kitty gets listen_on=unix:@faeos-kitty so the cue can reach it.

set $mod Mod4

# ── look ───────────────────────────────────────────────────────────────────
# i3 requires `font` even with no bar (it styles window title placeholders).
font pango:DejaVu Sans Mono 12

gaps inner 8
gaps outer 4
default_border pixel 3
hide_edge_borders both
client.focused          #ff2d55 #2a1520 #ffe3ee
client.focused_inactive #e879a0 #1a0a12 #ffebf2
client.unfocused        #9d5c75 #1a0a12 #b0b0b8
client.urgent           #ff2d55 #2a1520 #ffe3ee
client.placeholder      #9d5c75 #1a0a12 #b0b0b8
client.background       #1a0a12

# ── Super + drag ───────────────────────────────────────────────────────────
# Load-bearing, see the header. `tiling_drag` is a setting, not a binding, and
# an explicit `bindsym $mod+button1 … drag move` SHADOWS it — that shadowing is
# what made the breakage so hard to see. There is deliberately no button1 or
# button3 drag binding here.
tiling_drag modifier
floating_modifier $mod
# Super + middle click: float/unfloat under the cursor.
bindsym $mod+button2 floating toggle

# Windows open floating, so Super+drag has something to grab. Sep 23 behaviour.
for_window [class=".*"] floating enable

# Pointer must not warp into a window mid-drag.
mouse_warping none
focus_follows_mouse no

# ── terminals ─────────────────────────────────────────────────────────────
# Every kitty gets the house socket (@faeos-kitty-<pid>) so fae-cycle can toast
# and tint the window you land in.
set $kitty kitty -o allow_remote_control=yes -o listen_on="unix:@faeos-kitty"

bindsym $mod+Return         exec --no-startup-id $kitty
bindsym $mod+Shift+Return   exec --no-startup-id $kitty -o initial_window_width=120c -o initial_window_height=36c
bindsym Ctrl+Shift+Return   exec --no-startup-id $kitty -o initial_window_width=120c
bindsym $mod+Shift+q        exec --no-startup-id $kitty

exec --no-startup-id $kitty
exec --no-startup-id $kitty

# ── launchers ──────────────────────────────────────────────────────────────
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+z exec --no-startup-id rofi -show run

# ── window cycling: global MRU, with a visible cue ─────────────────────────
# fae-cycle moves focus, toasts the window, flashes its tab bar pink, and logs
# to $XDG_RUNTIME_DIR/fae-cycle.log. Note i3 runs `exec` with stderr inherited
# from i3, whose fd 2 is /dev/tty1 — so its stderr is invisible; the log and
# the kitty cue are the only things you can actually see.
bindsym Mod1+Tab       exec --no-startup-id ~/bin/fae-cycle next
bindsym Mod1+Shift+Tab exec --no-startup-id ~/bin/fae-cycle prev
bindsym Mod1+c         exec --no-startup-id ~/bin/fae-cycle next
bindsym Mod1+Shift+c   exec --no-startup-id ~/bin/fae-cycle prev
bindsym $mod+Tab       workspace next

# ── focus ──────────────────────────────────────────────────────────────────
bindsym $mod+j         focus left
bindsym $mod+k         focus down
bindsym $mod+l         focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left      focus left
bindsym $mod+Down      focus down
bindsym $mod+Up        focus up
bindsym $mod+Right     focus right
bindsym $mod+a         focus parent
bindsym $mod+space     focus mode_toggle

# ── move the focused window through the layout ─────────────────────────────
bindsym $mod+Shift+j         move left
bindsym $mod+Shift+k         move down
bindsym $mod+Shift+l         move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left      move left
bindsym $mod+Shift+Down      move down
bindsym $mod+Shift+Up        move up
bindsym $mod+Shift+Right     move right

# ── split / layout ─────────────────────────────────────────────────────────
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle

# ── windows-key snapping ───────────────────────────────────────────────────
bindsym $mod+Ctrl+Left  resize set 952 px 1072 px;  move position 4 px 4 px
bindsym $mod+Ctrl+Right resize set 952 px 1072 px;  move position 964 px 4 px
bindsym $mod+Ctrl+Up    resize set 1912 px 1072 px; move position 4 px 4 px
bindsym $mod+Ctrl+Down  resize set 1200 px 700 px;  move position 360 px 190 px

# ── workspaces ─────────────────────────────────────────────────────────────
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ── resize mode ────────────────────────────────────────────────────────────
bindsym $mod+r mode "resize"
mode "resize" {
        bindsym j        resize shrink width  10 px or 10 ppt
        bindsym k        resize grow   height 10 px or 10 ppt
        bindsym l        resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow  width  10 px or 10 ppt
        bindsym Left     resize shrink width  10 px or 10 ppt
        bindsym Right    resize grow   width  10 px or 10 ppt
        bindsym Up       resize shrink height 10 px or 10 ppt
        bindsym Down     resize grow   height 10 px or 10 ppt
        bindsym Return   mode "default"
        bindsym Escape   mode "default"
        bindsym $mod+r   mode "default"
}

# ── seal: the house lock ───────────────────────────────────────────────────
bindsym $mod+Control+l       exec seal
bindsym $mod+Control+Shift+l exec seal --suspend

# ── siren transport (output-aware: local mpv or HEOS speaker) ──────────────
bindsym XF86AudioPlay  exec --no-startup-id siren pause
bindsym XF86AudioStop  exec --no-startup-id siren stop
bindsym XF86AudioNext  exec --no-startup-id siren next
bindsym XF86AudioPrev  exec --no-startup-id siren prev

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# ── i3 housekeeping ────────────────────────────────────────────────────────
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# ── desktop layer ──────────────────────────────────────────────────────────
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id feh --bg-fill $HOME/Pictures/wall.png
