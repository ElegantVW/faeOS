# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# i3 requires `font` even with no bar (it styles window title placeholders).
font pango:DejaVu Sans Mono 12

# window styling: popOS-style gaps, thin pink borders
gaps inner 8
gaps outer 4
default_border pixel 3
hide_edge_borders both
client.focused          #ff2d55 #2a1520 #ffe3ee
client.focused_inactive #e879a0 #1a0a12 #ffebf2
client.unfocused        #9d5c75 #1a0a12 #b0b0b8
client.urgent           #ff2d55 #2a1520 #ffe3ee
client.placeholder      #9d5c75 #1a0a12 #b0b0b8
client.background       #1a0a12

# windows-key snapping (Windows-style): snap to half / full / restore
bindsym $mod+Ctrl+Left  resize set 952 px 1072 px; move position 4 px 4 px
bindsym $mod+Ctrl+Right resize set 952 px 1072 px; move position 964 px 4 px
bindsym $mod+Ctrl+Up    resize set 1912 px 1072 px; move position 4 px 4 px
bindsym $mod+Ctrl+Down  resize set 1200 px 700 px; move position 360 px 190 px

# rofi launchers: $mod+d = app menu, $mod+z = run dialog (the Win+R)
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+z exec --no-startup-id rofi -show run

# classic alt+tab: global MRU window cycling
# window cycling: fae-cycle wraps any X client (kitty tabs, panels, games)
bindsym Mod1+Tab exec --no-startup-id ~/bin/fae-cycle next
bindsym Mod1+Shift+Tab exec --no-startup-id ~/bin/fae-cycle prev
bindsym Mod1+c exec --no-startup-id ~/bin/fae-cycle next
bindsym Mod1+Shift+c exec --no-startup-id ~/bin/fae-cycle prev
bindsym $mod+Tab workspace next

# Font for window titles (there is no bar; the title bar uses this).
bindsym $mod+r mode "resize"

# No i3bar on purpose: its status script needed a resident process, and a dying
# status_command printed errors on screen. fae-cycle paints its cues inside the
# windows instead (toast when a kitty socket exists).

# kitty with remote control on, so fae-cycle can toast the window you land in.
exec --no-startup-id kitty -o allow_remote_control=yes -o listen_on="unix:@faeos-kitty"
exec --no-startup-id kitty -o allow_remote_control=yes -o listen_on="unix:@faeos-kitty"

# desktop layer: compositor + wallpaper
# Cycle cue. fae-cycle flashes the focused border (Lilac) while you move and
# leaves it Rose when you land, so Alt+Tab is visible without a status bar.
# Declared in the config so the color always returns home on reload.
# ── mouse that behaves ────────────────────────────────────────────────────
# Pointer warps into a dragged window otherwise, so kill it.
mouse_warping output
focus_follows_mouse no

# Super + drag = move the window under the cursor (tiled windows float
# first, so the pointer actually leads). Super+Mod1+drag stays tiled.
bindsym $mod+button1 noprint, floating enable, drag move
bindsym $mod+button3 noprint, floating enable, drag resize
bindsym Mod1+$mod+button1 move container
bindsym Mod1+$mod+button3 resize set 320 px 240 px, resize set 640 px 360 px, resize set 952 px 1072 px

# Super + middle click: close the window under the cursor. It is a normal
# click binding, so a drag still moves/resizes instead of closing anything.
bindsym $mod+button2 kill

exec_always --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id feh --bg-fill $HOME/Pictures/wall.png
