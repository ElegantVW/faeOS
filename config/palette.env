# Shared pink palette — source from shell:  source ~/.config/palette.env
# Roles: pink family for UI; danger/warn/ok only when user must notice.

export PALETTE_PINK="#e879a0"
export PALETTE_DARK_PINK="#c44d7a"
export PALETTE_PINK_DIM="#9d5c75"
export PALETTE_BLUSH="#f0b4c8"
export PALETTE_SILVER="#c0c0c8"
export PALETTE_SILVER_DIM="#8a8a96"
export PALETTE_DANGER="#ff2d55"
export PALETTE_WARN="#ffb020"
export PALETTE_OK="#3dd68c"
export PALETTE_BG="#1a0a12"
export PALETTE_FG="#ffebf2"
