# secrets & machine state — never commit
*.pem
*.key
.env
accounts.conf
**/credentials*
**/*password*

# caches / runtime
.cache/
*.pyc
__pycache__/
*.pid
*.log
*.egg-info/
.venv/

# huge model weights
*.gguf
*.bin
models/

# local lib copies of llama-server (optional vendor)
vendor/lib-pixie/*.so*
vendor/lib-pixie/llama-server

# OS junk
.DS_Store
*~

# local wifi / machine secrets
**/netherweave.env
**/*netherweave*
auth.json
**/accounts.conf

# rust build artifacts (in-tree crates + any leftover vendor paths)
seal/target/
hearth/target/
rift/target/
bulwark/target/
fairy-lantern/target/
fairy-lantern/roms/

# never commit prebuilt engines or carts
*.gba
*.sav
# local installed engines live under ~/.local/lib/faeos/ (not in repo)

# do not re-add machine-local ELF probes
bin/pixie-lock
