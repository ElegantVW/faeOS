#!/usr/bin/env bash
# One-shot CPU busy % for starship (from /proc/stat)
# shellcheck disable=SC2034
read -r _ u1 n1 s1 i1 rest </proc/stat
sleep 0.12
read -r _ u2 n2 s2 i2 rest </proc/stat
idle1=$i1
idle2=$i2
# approx total from first 4 fields
t1=$((u1 + n1 + s1 + i1))
t2=$((u2 + n2 + s2 + i2))
di=$((idle2 - idle1))
dt=$((t2 - t1))
if (( dt <= 0 )); then
  echo "CPU ?%"
  exit 0
fi
busy=$(( (100 * (dt - di)) / dt ))
if (( busy < 0 )); then busy=0; fi
if (( busy > 100 )); then busy=100; fi
# tiny load bars (glyph) — fill by bucket
bars=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)
idx=$(( busy * 7 / 100 ))
(( idx > 7 )) && idx=7
(( idx < 0 )) && idx=0
echo "CPU ${bars[idx]} ${busy}%"
