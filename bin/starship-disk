#!/usr/bin/env bash
# Root (or home) disk use % for starship — portable
set -euo pipefail
bars=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)

# Prefer / ; on some systems home is more relevant
pct=""
if df -P / >/dev/null 2>&1; then
  pct=$(df -P / 2>/dev/null | awk 'NR==2 {gsub(/%/,"",$5); print $5}')
fi
if [[ -z "${pct:-}" ]]; then
  pct=$(df -P "$HOME" 2>/dev/null | awk 'NR==2 {gsub(/%/,"",$5); print $5}')
fi
# macOS df sometimes lacks -P but works without
if [[ -z "${pct:-}" ]]; then
  pct=$(df / 2>/dev/null | awk 'NR==2 {for(i=1;i<=NF;i++) if($i ~ /%$/) {gsub(/%/,"",$i); print $i}}')
fi

if [[ -z "${pct:-}" || ! "$pct" =~ ^[0-9]+$ ]]; then
  echo "HDD ?"
  exit 0
fi
idx=$(( pct * 7 / 100 ))
(( idx > 7 )) && idx=7
(( idx < 0 )) && idx=0
echo "HDD ${bars[idx]} ${pct}%"
