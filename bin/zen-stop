#!/usr/bin/env bash
# zen — fullscreen Zen Browser on its own VT; your TTY keeps working
#
#   zen                 start browser on vt7, return to shell on vt1
#   zen https://…       open URL
#   zen --private
#   zen stop | zen-stop kill browser + X
#   zen status
#   zen focus           jump to browser VT (Ctrl+Alt+F7)
#
# Browser runs in the background. Shell is NOT blocked.
#   Ctrl+Alt+F7  →  browser
#   Ctrl+Alt+F1  →  your kmscon shell (still usable)
#
set -euo pipefail

ZEN_BIN="${ZEN_BIN:-/usr/bin/zen-browser}"
[[ -x $ZEN_BIN ]] || ZEN_BIN="$(command -v zen-browser 2>/dev/null || true)"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/pixie"
STATE="$STATE_DIR/zen.session"
vt="${ZEN_VT:-7}"
xlog="${XDG_DATA_HOME:-$HOME/.local/share}/xorg"
mkdir -p "$STATE_DIR" "$xlog"

die() { echo "zen: $*" >&2; exit 1; }

cmd_status() {
  if [[ -f $STATE ]]; then
    # shellcheck disable=SC1090
    source "$STATE"
    echo "zen: running"
    echo "  display:  ${DISPLAY_NUM:-?}"
    echo "  vt:       ${VT:-$vt}  (Ctrl+Alt+F${VT:-$vt})"
    echo "  X pid:    ${XPID:-?}"
    echo "  browser:  ${BPID:-?}"
    echo "  stop:     zen stop"
  else
    echo "zen: not running"
  fi
}

cmd_stop() {
  if [[ ! -f $STATE ]]; then
    echo "zen: not running" >&2
    return 0
  fi
  # shellcheck disable=SC1090
  source "$STATE"
  [[ -n ${BPID:-} ]] && kill "$BPID" 2>/dev/null || true
  [[ -n ${XPID:-} ]] && sudo -n kill "$XPID" 2>/dev/null || true
  sleep 0.3
  [[ -n ${BPID:-} ]] && kill -9 "$BPID" 2>/dev/null || true
  [[ -n ${XPID:-} ]] && sudo -n kill -9 "$XPID" 2>/dev/null || true
  [[ -n ${DISPLAY_NUM:-} ]] && sudo -n rm -f "/tmp/.X${DISPLAY_NUM}-lock" 2>/dev/null || true
  [[ -n ${AUTH:-} ]] && rm -f "$AUTH" 2>/dev/null || true
  rm -f "$STATE"
  [[ -x $HOME/bin/pixie-screen ]] && "$HOME/bin/pixie-screen" release zen 2>/dev/null || true
  sudo -n chvt 1 2>/dev/null || true
  echo "zen: stopped"
}

cmd_focus() {
  if [[ -f $STATE ]]; then
    # shellcheck disable=SC1090
    source "$STATE"
    sudo -n chvt "${VT:-$vt}" 2>/dev/null || chvt "${VT:-$vt}" 2>/dev/null || true
    echo "zen: switched to vt${VT:-$vt} (Ctrl+Alt+F${VT:-$vt})"
  else
    die "not running — start with: zen"
  fi
}

# --- subcommands (also: symlink zen-stop → zen) ---
if [[ ${0##*/} == zen-stop ]]; then
  cmd_stop
  exit 0
fi
case "${1:-}" in
  -h|--help|help)
    sed -n '2,16p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
  stop|kill|quit|exit) cmd_stop; exit 0 ;;
  status|st) cmd_status; exit 0 ;;
  focus|fg|show) cmd_focus; exit 0 ;;
esac

[[ -n ${ZEN_BIN:-} && -x $ZEN_BIN ]] || die "zen-browser not found"

PRIVATE=0
URLS=()
for a in "$@"; do
  case "$a" in
    --private|-p) PRIVATE=1 ;;
    -*) die "unknown option: $a" ;;
    *) URLS+=("$a") ;;
  esac
done

zen_args=(--kiosk)
(( PRIVATE )) && zen_args=(--kiosk --private-window)
((${#URLS[@]})) && zen_args+=("${URLS[@]}")

# Already graphical: just run in foreground
if [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} ]]; then
  exec "$ZEN_BIN" "${zen_args[@]}"
fi

# Already have a session → focus it
if [[ -f $STATE ]]; then
  # shellcheck disable=SC1090
  source "$STATE"
  if [[ -n ${XPID:-} ]] && kill -0 "$XPID" 2>/dev/null; then
    echo "zen: already running on vt${VT:-$vt} — focusing (shell stays here)"
    cmd_focus
    exit 0
  fi
  rm -f "$STATE"
fi

sudo -n true 2>/dev/null || die "passwordless sudo required to start X from kmscon"
[[ -x /usr/lib/Xorg ]] || die "/usr/lib/Xorg missing"
command -v xauth >/dev/null && command -v mcookie >/dev/null || die "need xauth + mcookie"

disp=0
while [[ -e /tmp/.X${disp}-lock || -S /tmp/.X11-unix/X${disp} ]]; do
  ((disp++)) || true
  (( disp > 20 )) && die "no free X display"
done

auth="$STATE_DIR/zen-xauth"
rm -f "$auth"
touch "$auth"
chmod 600 "$auth"
cookie=$(mcookie)
xauth -f "$auth" add ":${disp}" . "$cookie"
xauth -f "$auth" add "localhost/unix:${disp}" . "$cookie" 2>/dev/null || true
hn=$(hostname 2>/dev/null || echo localhost)
xauth -f "$auth" add "${hn}/unix:${disp}" . "$cookie" 2>/dev/null || true

[[ -x $HOME/bin/pixie-screen ]] && "$HOME/bin/pixie-screen" hold zen 2>/dev/null || true

# Background supervisor: X + browser; cleans up when browser exits
(
  set +e
  xerr="$xlog/zen-xorg.err"
  sudo -n /usr/lib/Xorg ":${disp}" "vt${vt}" \
    -auth "$auth" \
    -nolisten tcp \
    -noreset \
    -logfile "$xlog/Xorg.zen.log" \
    >"$xerr" 2>&1 &
  xpid=$!

  ok=0
  for _ in $(seq 1 80); do
    [[ -S /tmp/.X11-unix/X${disp} ]] && { ok=1; break; }
    kill -0 "$xpid" 2>/dev/null || break
    sleep 0.1
  done
  if (( ! ok )); then
    echo "zen: X failed to start — see $xerr" >&2
    sudo -n kill "$xpid" 2>/dev/null
    rm -f "$STATE" "$auth"
    exit 1
  fi

  export DISPLAY=":${disp}"
  export XAUTHORITY="$auth"
  export MOZ_ENABLE_WAYLAND=0
  export GDK_BACKEND=x11

  "$ZEN_BIN" "${zen_args[@]}" &
  bpid=$!

  cat >"$STATE" <<EOF
XPID=$xpid
BPID=$bpid
DISPLAY_NUM=$disp
VT=$vt
AUTH=$auth
EOF

  # Wait for browser; then tear down X
  wait "$bpid" 2>/dev/null
  sudo -n kill "$xpid" 2>/dev/null
  sleep 0.2
  sudo -n kill -9 "$xpid" 2>/dev/null
  sudo -n rm -f "/tmp/.X${disp}-lock" 2>/dev/null
  rm -f "$auth" "$STATE"
  [[ -x $HOME/bin/pixie-screen ]] && "$HOME/bin/pixie-screen" release zen 2>/dev/null
) >/dev/null 2>&1 &
disown

# Wait until session file exists (browser up) or timeout
for _ in $(seq 1 100); do
  [[ -f $STATE ]] && break
  sleep 0.1
done

if [[ ! -f $STATE ]]; then
  die "failed to start (check $xlog/zen-xorg.err and $xlog/Xorg.zen.log)"
fi

# Stay on the terminal VT — do NOT leave the user stuck on the browser VT
sudo -n chvt 1 2>/dev/null || true

cat <<EOF
zen: browser on vt${vt}  (switch:  Ctrl+Alt+F${vt}   or   zen focus)
     terminal stays here (Ctrl+Alt+F1)
     stop:  zen stop
EOF
