#!/usr/bin/env python3
"""scroll — themed command directory.

  scroll             arrow picker → prints insert text (for zsh print -z)
  scroll list       static boxed board once
  scroll menu       raw tab-separated lines
  scroll board      old modal board (view only)

UI paints on /dev/tty; selection goes to stdout so the shell can capture it.
"""
from __future__ import annotations

import atexit
import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

# shared art / TTY helpers
sys.path.insert(0, str(Path.home() / "bin"))
import fae_termart as art  # noqa: E402

# Force Unicode box drawing for smooth round corners
os.environ["PIXIE_UNICODE"] = "1"

P = art.P
PIXIE_SCREEN = Path.home() / "bin" / "pixie-screen"

NAME = "scroll"

SECTIONS: list[tuple[str, list[tuple[str, str]]]] = [
