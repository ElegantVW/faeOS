#!/usr/bin/env python3
"""Cute pink-framed status box + single-line cursor.

Modes (argv[1]):
  --status   box only (printed by zsh precmd / tick — NOT part of PS1)
  --cursor   single-line summon + >  (starship PS1 only — no multi-line)
  --full     legacy: box + cursor in one stream (avoid; causes kmscon ghosting)

Putting the multi-line box in PS1 makes zsh mis-track the cursor on kmscon
(ghost/duplicate characters while typing). Status is printed outside PS1.
"""
from __future__ import annotations

import os
import random
import re
import shutil
import subprocess
import sys
import time
import unicodedata
from pathlib import Path
import os

HOME = Path.home()
BIN = HOME / "bin"
CACHE = HOME / ".cache" / "pixie"
SUMMON_FILE = CACHE / "summon.msg"

# Force Unicode box drawing for smooth round corners
os.environ["PIXIE_UNICODE"] = "1"

# Palette (256 + truecolor where music already uses it)
PINK = "\033[38;5;175m"
DARK_PINK = "\033[38;5;168m"
PINK_DIM = "\033[38;5;132m"
BLUSH = "\033[38;5;218m"
SILVER = "\033[38;5;252m"
SILVER_DIM = "\033[38;5;245m"
BOLD = "\033[1m"
RESET = "\033[0m"

ANSI_RE = re.compile(r"\033\[[0-9;]*m")

# Imperative, magical summons — same line as > (ASCII; no trailing dots)
SUMMONS = (
    "Casting cursor",
    "Calling cursor from the ether",
    "Summoning the prompt",
    "Weaving a command line",
    "Invoking the shell spirits",
    "Drawing runes on the void",
    "Opening a rift for your next spell",
    "Conjuring an input charm",
    "Beckoning the cursor forth",
    "Kindling the prompt flame",
    "Unsealing the command circle",
    "Whispering to the key spirits",
    "Binding a fresh line of magic",
    "Stirring the cauldron of stdin",
    "Pulling a thread from the fey net",
    "Charging the sigil of Enter",
    "Awakening the sleeping glyphs",
    "Requesting an audience with the shell",
    "Spinning moonlight into a prompt",
    "Hexing the blank line into life",
    "Channeling keystrokes from beyond",
    "Raising the cursor from slumber",
    "Enchanting the next command",
    "Scrying for your intention",
    "Parting the veil of the terminal",
    "Aligning the stars for a command",
    "Pouring sparkles into the buffer",
    "Hailing the machine spirits",
    "Unlocking the gate of input",
    "Manifesting a place to type",
)


def strip_ansi(s: str) -> str:
    return ANSI_RE.sub("", s)


def _char_width(ch: str) -> int:
    """Column width for monospace terminals (kmscon-safe):

    Box-drawing and dingbats (✦ ♪) are width 1 here — treating them as 2
    misaligns right borders on most European fonts.
    """
    if not ch:
        return 0
    o = ord(ch)
    if o < 32 or 0x7F <= o < 0xA0:
        return 0
    if unicodedata.combining(ch):
        return 0
    eaw = unicodedata.east_asian_width(ch)
    if eaw in ("F", "W"):
        return 2
    # Emoji & symbols that are double-width on most terminals
    if 0x1F300 <= o <= 0x1FAFF:
        return 2
    return 1


def vis_len(s: str) -> int:
    return sum(_char_width(c) for c in strip_ansi(s))


def run_bin(name: str, timeout: float = 1.2) -> str:
    path = BIN / name
    if not path.is_file():
        return ""
    try:
        out = subprocess.check_output(
            [str(path)],
            text=True,
            timeout=timeout,
            env={**os.environ, "PATH": f"{BIN}:{os.environ.get('PATH', '')}"},
            stderr=subprocess.DEVNULL,
        )
        return out.rstrip("\n")
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError):
        return ""


def git_snippet() -> str:
    try:
        top = subprocess.check_output(
            ["git", "rev-parse", "--is-inside-work-tree"],
            text=True,
            timeout=0.4,
            stderr=subprocess.DEVNULL,
        ).strip()
        if top != "true":
            return ""
        branch = subprocess.check_output(
            ["git", "branch", "--show-current"],
            text=True,
            timeout=0.4,
            stderr=subprocess.DEVNULL,
        ).strip()
        if not branch:
            return ""
        return f"{PINK}on {branch}{RESET}"
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError):
        return ""


def username() -> str:
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or "you"
    if os.geteuid() == 0:
        return f"{BOLD}\033[38;5;197m{user}{RESET}"
    return f"{BOLD}{DARK_PINK}{user}{RESET}"


def clock() -> str:
    return f"{BOLD}{SILVER_DIM}{time.strftime('%H:%M')}{RESET}"


def ram() -> str:
    """RAM percent from /proc/meminfo."""
    try:
        info = {}
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if ":" not in line:
                continue
            k, v = line.split(":", 1)
            parts = v.split()
            if parts:
                info[k] = int(parts[0])
        total = info.get("MemTotal") or 0
        avail = info.get("MemAvailable") or info.get("MemFree") or 0
        if total <= 0:
            return f"{BOLD}{BLUSH}RAM ?{RESET}"
        used_pct = max(0, min(100, int(round(100 * (1 - avail / total)))))
        return f"{BOLD}{BLUSH}RAM {used_pct}%{RESET}"
    except OSError:
        return f"{BOLD}{BLUSH}RAM ?{RESET}"


def pad_line(inner: str, width: int) -> str:
    """Pad visible width with spaces so the right border aligns."""
    n = vis_len(inner)
    if n < width:
        return inner + (" " * (width - n))
    if n > width:
        # truncate carefully by visible chars
        plain = strip_ansi(inner)
        cut = plain[: max(0, width - 1)] + "…"
        return f"{PINK}{cut}{RESET}" + (" " * max(0, width - vis_len(cut)))
    return inner


def pick_summon(*, reuse: bool = False) -> str:
    """Imperative summon line. reuse=True reads cache only (stable PS1 length)."""
    prev = ""
    try:
        prev = SUMMON_FILE.read_text(encoding="utf-8").rstrip("\n")
    except OSError:
        pass
    if reuse and prev:
        return prev
    msg = prev
    for _ in range(10):
        cand = random.choice(SUMMONS)
        if cand != prev:
            msg = cand
            break
        msg = cand
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        SUMMON_FILE.write_text(msg + "\n", encoding="utf-8")
    except OSError:
        pass
    return msg


def kur_busy() -> bool:
    d = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    try:
        for p in d.glob("kur-busy.*"):
            if not p.is_file():
                continue
            try:
                pid = int(p.name.rsplit(".", 1)[-1])
            except ValueError:
                try:
                    p.unlink()
                except OSError:
                    pass
                continue
            try:
                os.kill(pid, 0)
                return True
            except OSError:
                try:
                    p.unlink()
                except OSError:
                    pass
    except OSError:
        pass
    return False


def cpu_temp() -> str:
    try:
        temps = []
        for p in Path("/sys/class/thermal").glob("thermal_zone*/temp"):
            try:
                val = int(p.read_text(encoding="utf-8").strip())
                c = val / 1000.0
                if 10 < c < 110:
                    temps.append(c)
            except Exception:
                continue
        if temps:
            avg = int(round(sum(temps) / len(temps)))
            return f"{BOLD}{PINK_DIM}{avg}°C{RESET}"
    except Exception:
        pass
    return ""


def box_lines(rows: list[str]) -> list[str]:
    """Plain artistic frame with username title in top border."""
    term = shutil.get_terminal_size((80, 24)).columns
    max_inner = max(40, min(term - 4, 76))
    content_w = max((vis_len(r) for r in rows), default=20)
    inner = min(max_inner, max(content_w, 36))
    span = inner + 2

    user_name = os.environ.get("USER") or "evenweaker"
    title_segment = f" ✦ {user_name} ✦ "
    dash_len = max(0, span - len(title_segment) - 1)
    top = f"{PINK_DIM}╭─{DARK_PINK}{title_segment}{PINK_DIM}{'─' * dash_len}╮{RESET}"

    mid = []
    for r in rows:
        body = pad_line(r, inner)
        mid.append(f"{PINK_DIM}│{RESET} {body} {PINK_DIM}│{RESET}")
    bot = f"{PINK_DIM}╰{'─' * span}╯{RESET}"
    return [top, *mid, bot]


def build_rows() -> list[str]:
    if kur_busy():
        idle = f"{BOLD}{DARK_PINK}The Dragon thinks…{RESET}"
    else:
        idle = run_bin("starship-pixie-idle") or f"{BOLD}{PINK}Pixie is waiting…{RESET}"

    music = run_bin("starship-music") or f"{SILVER_DIM}Not playing{RESET}"
    goblin = run_bin("starship-goblin") or ""
    cpu = run_bin("starship-cpu") or "CPU ?"
    disk = run_bin("starship-disk") or "HDD ?"
    temp = cpu_temp()

    if "\033" not in cpu:
        cpu = f"{BOLD}{PINK}{cpu}{RESET}"
    if "\033" not in disk:
        disk = f"{BOLD}{DARK_PINK}{disk}{RESET}"

    git = git_snippet()
    sep = f" {PINK_DIM}·{RESET} "
    
    row1_parts = [idle]
    if git:
        row1_parts.append(git)
    row1 = sep.join(row1_parts)
    row2 = sep.join([x for x in (music, goblin) if x])
    
    stats = [clock(), ram(), cpu, disk]
    if temp:
        stats.append(temp)
    row3 = sep.join(stats)
    return [row1, row2, row3]


def cursor_line(*, reuse: bool = True) -> str:
    # ASCII ">" only — fancy glyphs break width math on some fonts
    # Pad summon to fixed width so PS1 column count never changes mid-session
    summon = pick_summon(reuse=reuse).rstrip(".…? ")
    if len(summon) > 34:
        summon = summon[:33] + "…"
    summon = f"{summon:<34}"
    return f"{PINK_DIM}{summon}{RESET} {BOLD}{PINK}>{RESET} "


def main(argv: list[str] | None = None) -> None:
    args = list(sys.argv[1:] if argv is None else argv)
    mode = "cursor"
    if args:
        a = args[0]
        if a in ("--status", "--cursor", "--full", "status", "cursor", "full"):
            mode = a.lstrip("-")
        elif a in ("-h", "--help"):
            print("usage: starship-box [--status|--cursor|--full]", file=sys.stderr)
            sys.exit(0)

    if mode == "cursor":
        # Never re-roll here — length must stay stable for ZLE
        print(cursor_line(reuse=True), end="")
        return

    framed = box_lines(build_rows())
    if mode == "status":
        # Print box without summon line below
        print("\n".join(framed), end="\n\n")
        return

    # legacy full stream (multi-line PS1 — ghosting risk on kmscon)
    pick_summon(reuse=False)
    print("\n".join(framed) + "\n\n" + cursor_line(reuse=True), end="")


if __name__ == "__main__":
    main()
