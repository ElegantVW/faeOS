#!/usr/bin/env python3
"""siren - the Aether's music vessel (faeOS media player).

Offline-first music + free-archive (Internet Archive) player over mpv IPC.

    siren                          interactive TUI (browser · queue · EQ)
    siren play [query]             play ~/Music recursively or match a query
    siren play <playlist>           play a saved playlist by name
    siren random                    shuffle the whole library
    siren now                       print the now-playing track
    siren status                    one-shot status report
    siren pause | toggle | stop | next | prev
    siren queue add|list|clear|play|next|remove|move
    siren playlist save|load|list|remove <name>
    siren config get|set <key> [value]
    siren trove ...                free & legal media (Internet Archive)
    siren about | -h | --help

TUI keys:
  browser:  up/down/j/k move · o/enter/p/space open·play · backspace up
            a add to queue · / filter
  queue:    up/down/j/k move · enter/space play from · d remove · c clear
  EQ:       p/space play·pause · n/b next/prev · s shuffle · r repeat
            w show/hide EQ · W bands 16/32 · +/-
  global:   Tab focuses browser → queue → EQ · S save · L load&play
            R rm playlist · g go-to-path · q/esc quit · ctrl-u clear input
            f open a file (spellbook picker) · F open a directory (play it)
  mouse:    click row select · double-click open/play · wheel scroll ·
            click panel title to focus (config mouse=true)

config: ~/.config/siren/config.json (default_volume · library_roots ·
fuzzy_search · waves · gapless · normalize · cache_meta · wave_bands · mouse)
mpv IPC socket: /tmp/siren-mpv.sock (shared with prompt tick + faectl).
"""
from __future__ import annotations

import atexit
import fcntl
import json
import math
import os
import random
import re
import select
import socket
import struct
import subprocess
import sys
import tempfile
import termios
import time
from dataclasses import dataclass, field
from pathlib import Path

sys.path.insert(0, str(Path.home() / "bin"))
os.environ["PIXIE_UNICODE"] = "1"

import fae_termart as art
from fae_termart import Palette as P

NAME = "Siren"
SOCK = os.environ.get("SIREN_SOCK", "/tmp/siren-mpv.sock")
CONFIG_DIR = Path(os.environ.get("SIREN_CONFIG_DIR", str(Path.home() / ".config" / "siren")))
PLAYLIST_DIR = CONFIG_DIR / "playlists"
CACHE_DIR = Path(os.environ.get("SIREN_CACHE_DIR", str(Path.home() / ".cache" / "siren")))

AUDIO_EXT = (".mp3", ".flac", ".ogg", ".m4a", ".wav", ".opus", ".mp4", ".mkv", ".mka", ".aac")


def fmt_clock(secs: float) -> str:
    m = int(secs // 60)
    s = int(secs % 60)
    return f"{m}:{s:02d}"


def fit_width(lines: list[str], default: int = 42) -> int:
    m = max((art.vis_len(line) for line in lines), default=20)
    return max(default, min(m + 6, art.term_width()))


def basename(path: str) -> str:
    return os.path.basename(path)


# =====================================================================
# CONFIG
# =====================================================================

@dataclass
class SirenConfig:
    default_volume: int = 75
    library_roots: list = field(default_factory=lambda: ["~/Music"])
    fuzzy_search: bool = True
    waves: bool = True
    gapless: bool = True
    normalize: bool = False
    cache_meta: bool = True
    wave_bands: int = 16
    mouse: bool = True

    def as_dict(self) -> dict:
        return {
            "default_volume": self.default_volume,
            "library_roots": self.library_roots,
            "fuzzy_search": self.fuzzy_search,
            "waves": self.waves,
            "gapless": self.gapless,
            "normalize": self.normalize,
            "cache_meta": self.cache_meta,
            "wave_bands": self.wave_bands,
            "mouse": self.mouse,
        }

    @classmethod
    def load(cls) -> "SirenConfig":
        cfg = cls()
        try:
            raw = json.loads((CONFIG_DIR / "config.json").read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return cfg
        for k, v in raw.items():
            if hasattr(cfg, k):
                setattr(cfg, k, v)
        if not isinstance(cfg.default_volume, int) or not 0 <= cfg.default_volume <= 150:
            cfg.default_volume = 75
        if cfg.wave_bands not in (8, 16, 32):
            cfg.wave_bands = 16
        if not isinstance(cfg.library_roots, list) or not cfg.library_roots:
            cfg.library_roots = ["~/Music"]
        if not isinstance(cfg.mouse, bool):
            cfg.mouse = bool(cfg.mouse)
        return cfg

    def save(self) -> None:
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            tmp = CONFIG_DIR / "config.json.tmp"
            tmp.write_text(json.dumps(self.as_dict(), indent=2, ensure_ascii=False), encoding="utf-8")
            tmp.replace(CONFIG_DIR / "config.json")
        except OSError:
            pass


CFG = SirenConfig.load()

_BOOL_WORDS = {"1", "yes", "true", "on"}


def cli_set_config(key: str, val: str) -> tuple[bool, str]:
    k = key.lower()
    if k == "default_volume":
        try:
            n = int(val)
        except ValueError:
            return False, "expects an integer (0-150)"
        if not 0 <= n <= 150:
            return False, "expects 0-150"
        CFG.default_volume = n
        return True, str(n)
    if k == "library_roots":
        parts = [p.strip() for p in val.split(",") if p.strip()]
        if not parts:
            return False, "expects comma-separated paths"
        CFG.library_roots = parts
        return True, ", ".join(parts)
    if k in ("fuzzy_search", "waves", "gapless", "normalize", "cache_meta", "mouse"):
        b = val.strip().lower() in _BOOL_WORDS
        setattr(CFG, k, b)
        return True, "on" if b else "off"
    if k == "wave_bands":
        if val.strip() in ("8", "16", "32"):
            CFG.wave_bands = int(val)
            return True, val
        return False, "expects 8, 16 or 32"
    return False, f"unknown key: {key}"


def cmd_config(args: list[str]) -> int:
    if not args:
        lines = [f"{k}: {v}" for k, v in CFG.as_dict().items()]
        print()
        print(art.box(lines, title=NAME, width=fit_width(lines)))
        print()
        return 0
    sub = args[0].lower()
    if sub == "get":
        if len(args) < 2:
            return cmd_config([])
        d = CFG.as_dict()
        if args[1] not in d:
            print(f"unknown key: {args[1]}")
            return 1
        print(f"{args[1]}: {d[args[1]]}")
        return 0
    if sub == "set":
        if len(args) < 3:
            print("usage: siren config set <key> <value>")
            return 1
        ok, msg = cli_set_config(args[1], " ".join(args[2:]))
        if not ok:
            print(f"cannot set {args[1]}: {msg}")
            return 1
        CFG.save()
        apply_runtime_prefs()
        print(f"{args[1]}: {msg}")
        return 0
    print("config subcommands: get <key> | set <key> <value>")
    return 1


# =====================================================================
# FUZZY MATCH
# =====================================================================

def _tokens(text: str) -> list[str]:
    return re.findall(r"[a-z0-9]+", text.lower())


def fuzzy_score(query: str, text: str) -> tuple[int, int]:
    """Rank a candidate. Returns (tier, bonus); (0, 0) = no match.

    tier: 10 exact · 9 prefix · 8 substring · 7 all tokens present ·
          6 ordered token subsequence. bonus = matched chars (tie-break).
    """
    q = query.strip().lower()
    t = text.lower()
    if not q:
        return 0, 0
    if q == t:
        return 10, len(q)
    if t.startswith(q):
        return 9, len(q)
    if q in t:
        return 8, len(q)
    qt = _tokens(q)
    tt = _tokens(t)
    if not qt:
        return 0, 0
    missing = 0
    for tok in qt:
        if tok not in tt:
            missing += 1
    if missing == 0:
        return 7, sum(len(x) for x in qt)
    joined = "".join(tt)
    pos = 0
    matched = 0
    for tok in qt:
        idx = joined.find(tok, pos)
        if idx < 0:
            break
        pos = idx + len(tok)
        matched += len(tok)
    if matched > 0:
        return 6, matched
    return 0, 0


# =====================================================================
# METADATA
# =====================================================================

try:
    from mutagen import File as _MutagenFile
    _HAS_MUTAGEN = True
except Exception:
    _MutagenFile = None
    _HAS_MUTAGEN = False

_META: dict[str, dict] = {}
_META_MAX = 8000
_META_DIRTY = False


def meta_cache_load() -> None:
    global _META
    if not CFG.cache_meta:
        return
    try:
        raw = json.loads((CACHE_DIR / "meta.json").read_text(encoding="utf-8"))
        if isinstance(raw, dict):
            _META = raw
    except (OSError, json.JSONDecodeError):
        _META = {}


def meta_cache_save() -> None:
    global _META_DIRTY
    if not CFG.cache_meta or not _META_DIRTY:
        return
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        tmp = CACHE_DIR / "meta.json.tmp"
        tmp.write_text(json.dumps(_META), encoding="utf-8")
        tmp.replace(CACHE_DIR / "meta.json")
        _META_DIRTY = False
    except OSError:
        pass


def _clean_tag(audio, keys) -> str | None:
    for key in keys:
        val = audio.get(key)
        if not val:
            continue
        if isinstance(val, (list, tuple)) and val:
            s = str(val[0]).strip()
        else:
            s = str(val).strip()
        if s and s.lower() != "none":
            return s
    return None


def _filename_display(path: str) -> str:
    name = os.path.splitext(os.path.basename(path))[0]
    return name.replace("_", " ").replace("-", " - ")


def meta_display(path: str) -> str:
    """Artist - Title (or filename fallback), cached by (path, mtime)."""
    if not path:
        return "Unknown Track"
    if path.startswith("file://"):
        path = path[7:]
    if not os.path.isfile(path):
        return _filename_display(path)
    try:
        mtime = os.stat(path).st_mtime_ns
    except OSError:
        mtime = -1
    if CFG.cache_meta:
        hit = _META.get(path)
        if hit is not None and hit.get("m") == mtime:
            return hit["d"]
    display = None
    if _HAS_MUTAGEN:
        try:
            audio = _MutagenFile(path)
            if audio is not None:
                title = _clean_tag(audio, ["title", "TIT2"])
                artist = _clean_tag(audio, ["artist", "TPE1"])
                if title and artist:
                    display = f"{artist} - {title}"
                elif title:
                    display = title
        except Exception:
            display = None
    if not display:
        display = _filename_display(path)
    if CFG.cache_meta:
        if len(_META) >= _META_MAX:
            _META.clear()
        _META[path] = {"m": mtime, "d": display}
        global _META_DIRTY
        _META_DIRTY = True
        if len(_META) % 200 == 0:
            meta_cache_save()
    return display


def _tags_for(path: str) -> tuple[str, str]:
    """(title, artist) for queue records; mutagen is optional."""
    title, artist = "", ""
    if not _HAS_MUTAGEN or not os.path.isfile(path):
        return title, artist
    try:
        audio = _MutagenFile(path)
        if audio is not None:
            title = _clean_tag(audio, ["title", "TIT2"]) or ""
            artist = _clean_tag(audio, ["artist", "TPE1"]) or ""
    except Exception:
        pass
    return title, artist


meta_cache_load()
atexit.register(meta_cache_save)


# =====================================================================
# LIBRARY SCAN
# =====================================================================

def library_roots() -> list[Path]:
    roots = [Path(os.path.expanduser(r)) for r in CFG.library_roots]
    roots = [r for r in roots if r.is_dir()]
    if not roots:
        roots = [Path.home() / "Music"]
    return roots


def scan_library() -> list[Path]:
    files: list[Path] = []
    seen: set[str] = set()
    for root in library_roots():
        for dirpath, _dirnames, filenames in os.walk(root):
            for fname in filenames:
                if fname.lower().endswith(AUDIO_EXT):
                    p = Path(dirpath) / fname
                    key = str(p)
                    if key not in seen:
                        seen.add(key)
                        files.append(p)
    return sorted(files, key=lambda p: str(p).lower())


def resolve_library(query: str) -> list[Path]:
    """Fuzzy-ranked library paths for a query; empty when nothing matches."""
    lib = scan_library()
    if not query:
        return lib
    scored: list[tuple[int, int, Path]] = []
    for p in lib:
        best = (0, 0)
        for t in (p.as_posix(), meta_display(str(p))):
            tier, bonus = fuzzy_score(query, t)
            if tier > best[0] or (tier == best[0] and bonus > best[1]):
                best = (tier, bonus)
        if best[0] > 0:
            scored.append((best[0], best[1], p))
    scored.sort(key=lambda r: (-r[0], -r[1], r[2].as_posix().lower()))
    return [s[2] for s in scored]


def resolve_play_args(targets: list[str]) -> list[Path]:
    if not targets:
        return scan_library()
    if len(targets) == 1:
        p = Path(os.path.expanduser(targets[0]))
        if p.is_file() and p.suffix.lower() in AUDIO_EXT:
            return [p]
    return resolve_library(" ".join(targets))


# =====================================================================
# MPV CLIENT
# =====================================================================

class Player:
    """JSON IPC client for an idle mpv instance on our unix socket."""

    def __init__(self, sock: str = SOCK) -> None:
        self.sock = sock
        self._spawn_attempted = False

    def alive(self) -> bool:
        return os.path.exists(self.sock)

    def spawn(self) -> bool:
        """Start idle mpv with our IPC socket (once per run)."""
        if self.alive():
            return True
        if self._spawn_attempted:
            return False
        self._spawn_attempted = True
        try:
            subprocess.Popen(
                ["mpv", "--idle=yes", "--no-video", "--audio-display=no",
                 "--gapless-audio=yes", "--volume-max=150",
                 f"--input-ipc-server={self.sock}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except Exception:
            return False
        for _ in range(20):
            if self.alive():
                break
            time.sleep(0.05)
        if not self.alive():
            return False
        time.sleep(0.15)
        apply_runtime_prefs(self)
        return True

    def send(self, argv: list) -> bool:
        """Send one mpv command. Returns True on any reply."""
        if not self.spawn():
            return False
        c = None
        try:
            c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            c.connect(self.sock)
            payload = json.dumps({"command": argv}) + "\n"
            c.sendall(payload.encode("utf-8"))
            c.recv(1024)
            return True
        except (OSError, ValueError):
            return False
        finally:
            if c is not None:
                try:
                    c.close()
                except OSError:
                    pass

    def get(self, prop: str, default=None):
        """Read one property via a short-lived socket (never spawns mpv)."""
        if not self.alive():
            return default
        c = None
        try:
            c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            c.settimeout(0.5)
            c.connect(self.sock)
            c.sendall((json.dumps({"command": ["get_property", prop]}) + "\n").encode("utf-8"))
            data = b""
            while b"\n" not in data:
                chunk = c.recv(4096)
                if not chunk:
                    break
                data += chunk
            for line in data.decode("utf-8", errors="replace").splitlines():
                try:
                    res = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if res.get("error") == "success" and "data" in res:
                    return res["data"]
        except (OSError, ValueError, socket.timeout):
            pass
        finally:
            if c is not None:
                try:
                    c.close()
                except OSError:
                    pass
        return default


def apply_runtime_prefs(player=None) -> None:
    pv = player if player is not None else _PV
    pv.send(["set_property", "gapless-audio", "yes" if CFG.gapless else "no"])
    pv.send(["set_property", "replaygain-mode", "track" if CFG.normalize else "off"])
    if pv.alive():
        pv.send(["set_property", "volume", int(CFG.default_volume)])


_PV = Player()


def mpv_send(argv: list) -> bool:
    return _PV.send(argv)


def mpv_get(prop: str, default=None):
    return _PV.get(prop, default)


def mpv_alive() -> bool:
    return _PV.alive()


def now_path() -> str:
    p = mpv_get("path", "")
    if p and isinstance(p, str) and p.startswith("file://"):
        p = p[7:]
    return p or ""


def now_label() -> str:
    p = now_path()
    if p:
        return meta_display(p)
    return _last_label


def time_pair() -> tuple[float, float]:
    pos = mpv_get("time-pos") or 0.0
    dur = mpv_get("duration") or 0.0
    try:
        return float(pos), float(dur)
    except (TypeError, ValueError):
        return 0.0, 0.0


def is_paused() -> bool:
    return bool(mpv_get("pause", False))


def get_repeat() -> str:
    loop_pl = mpv_get("loop-playlist")
    loop_file = mpv_get("loop-file")
    if loop_pl in ("inf", "yes", "always", True):
        return "all"
    if loop_file in ("inf", "yes", "always", True):
        return "track"
    return "off"


def cycle_repeat() -> str:
    nxt = {"off": "all", "all": "track", "track": "off"}[get_repeat()]
    mpv_send(["set_property", "loop-playlist", "inf" if nxt == "all" else "no"])
    mpv_send(["set_property", "loop-file", "inf" if nxt == "track" else "no"])
    return nxt


# =====================================================================
# QUEUE + PLAYLISTS
# =====================================================================

@dataclass
class QueueItem:
    path: str
    display: str = ""
    title: str = ""
    artist: str = ""
    duration: float = 0.0


class Queue:
    """Session queue; track metadata is snapshotted at add-time so it
    survives file moves. Missing files are dropped by validate()."""

    def __init__(self) -> None:
        self.items: list[QueueItem] = []

    def add(self, path: str, prepend: bool = False) -> int:
        path = os.path.expanduser(path)
        item = QueueItem(
            path=path,
            display=meta_display(path),
            title="",
            artist="",
        )
        title, artist = _tags_for(path)
        item.title = title
        item.artist = artist
        if prepend:
            self.items.insert(0, item)
        else:
            self.items.append(item)
        return len(self.items)

    def add_many(self, paths: list[str], prepend: bool = False) -> int:
        for p in paths:
            self.add(p, prepend)
        return len(self.items)

    def remove(self, index: int) -> QueueItem | None:
        if 0 <= index < len(self.items):
            return self.items.pop(index)
        return None

    def move(self, from_idx: int, to_idx: int) -> bool:
        if 0 <= from_idx < len(self.items) and 0 <= to_idx < len(self.items):
            item = self.items.pop(from_idx)
            self.items.insert(to_idx, item)
            return True
        return False

    def clear(self) -> None:
        self.items.clear()

    def validate(self) -> list[tuple[QueueItem, str]]:
        removed: list[tuple[QueueItem, str]] = []
        kept: list[QueueItem] = []
        for item in self.items:
            if os.path.exists(item.path):
                kept.append(item)
            else:
                removed.append((item, "File not found"))
        self.items = kept
        return removed

    def __len__(self) -> int:
        return len(self.items)


QUEUE = Queue()
_queue_driven = False
_last_label = ""


def playlist_file(name: str) -> Path:
    return PLAYLIST_DIR / f"{name}.json"


def playlist_save(name: str, items: list[QueueItem] | None = None) -> bool:
    tracks = items if items is not None else QUEUE.items
    data = {
        "name": name,
        "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "modified": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "tracks": [
            {"path": t.path, "display": t.display, "title": t.title,
             "artist": t.artist, "duration": t.duration}
            for t in tracks
        ],
    }
    try:
        PLAYLIST_DIR.mkdir(parents=True, exist_ok=True)
        playlist_file(name).write_text(
            json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
        return True
    except OSError:
        return False


def playlist_load(name: str) -> list[QueueItem]:
    p = playlist_file(name)
    if not p.exists():
        return []
    try:
        raw = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    items: list[QueueItem] = []
    for t in raw.get("tracks", []):
        if not isinstance(t, dict):
            continue
        path = t.get("path", "")
        if not path or not os.path.exists(path):
            continue
        try:
            duration = float(t.get("duration", 0.0) or 0.0)
        except (TypeError, ValueError):
            duration = 0.0
        items.append(QueueItem(
            path=path,
            display=t.get("display", "") or "",
            title=t.get("title", "") or "",
            artist=t.get("artist", "") or "",
            duration=duration,
        ))
    return items


def playlist_names() -> list[str]:
    if not PLAYLIST_DIR.exists():
        return []
    return sorted(f.stem for f in PLAYLIST_DIR.glob("*.json"))


def playlist_delete(name: str) -> bool:
    deleted = False
    for ext in (".json", ".m3u"):
        p = PLAYLIST_DIR / f"{name}{ext}"
        if p.exists():
            try:
                p.unlink()
                deleted = True
            except OSError:
                pass
    return deleted


def playlist_find(name: str) -> str | None:
    names = playlist_names()
    low = name.lower()
    exact = next((n for n in names if n.lower() == low), None)
    if exact:
        return exact
    matches = [n for n in names if n.lower().startswith(low)]
    return matches[0] if len(matches) == 1 else None


# =====================================================================
# PLAYBACK ORCHESTRATION
# =====================================================================

def start_playlist(files: list[str], shuffle: bool = True) -> int:
    global _queue_driven, _last_label
    if not files:
        print("No tracks found to play.")
        return 1
    ordered = list(files)
    if shuffle:
        random.shuffle(ordered)
    _PV.spawn()
    mpv_send(["playlist-clear"])
    mpv_send(["loadfile", ordered[0], "replace"])
    mpv_send(["set_property", "pause", False])
    mpv_send(["set_property", "video", "no"])
    for f in ordered[1:]:
        mpv_send(["loadfile", f, "append"])
    _queue_driven = False
    _last_label = meta_display(ordered[0])
    print(f"Playing {len(ordered)} track(s)")
    return 0


def sync_mpv_playlist(paths: list[str]) -> bool:
    if not paths:
        mpv_send(["stop"])
        return True
    if not mpv_send(["playlist-clear"]):
        return False
    mpv_send(["loadfile", paths[0], "replace"])
    for p in paths[1:]:
        mpv_send(["loadfile", p, "append"])
    mpv_send(["set_property", "pause", False])
    mpv_send(["set_property", "video", "no"])
    return True


def play_queue_from(index: int = 0, wrap: bool = False) -> bool:
    """Play the queue from an index, mirroring it into mpv's playlist.
    With wrap=True the queue loops for explicit next/prev."""
    global _queue_driven, _last_label
    items = QUEUE.items
    if not items or not (0 <= index < len(items)):
        return False
    ordered = (items[index:] + items[:index]) if wrap else items[index:]
    paths = [it.path for it in ordered]
    if not sync_mpv_playlist(paths):
        return False
    _queue_driven = True
    if ordered:
        _last_label = ordered[0].display or ""
    return True


def queue_add_and_play(path: str, prepend: bool = False) -> bool:
    path = os.path.expanduser(path)
    idx = next((i for i, it in enumerate(QUEUE.items) if it.path == path), -1)
    if idx < 0:
        QUEUE.add(path, prepend)
        idx = next((i for i, it in enumerate(QUEUE.items) if it.path == path), 0)
    return play_queue_from(idx, wrap=False)


def maybe_resync_queue() -> None:
    """Rebuild mpv's playlist from the queue when queue-driven, keeping the
    currently playing position when the current track is still queued."""
    global _queue_driven
    if not _queue_driven:
        return
    if not QUEUE.items:
        _queue_driven = False
        mpv_send(["playlist-clear"])
        mpv_send(["stop"])
        return
    cur = now_path()
    idx = 0
    for i, it in enumerate(QUEUE.items):
        if it.path == cur:
            idx = i
            break
    sync_mpv_playlist([it.path for it in QUEUE.items])
    if idx > 0:
        mpv_send(["set_property", "playlist-pos", idx])


def play_playlist(name: str) -> bool:
    tracks = playlist_load(name)
    if not tracks:
        return False
    QUEUE.items = tracks
    return play_queue_from(0, wrap=False)


def queue_add(path: str, prepend: bool = False) -> int:
    n = QUEUE.add(path, prepend)
    if prepend:
        maybe_resync_queue()
    elif _queue_driven:
        mpv_send(["loadfile", os.path.expanduser(path), "append"])
    return n


def queue_add_many(paths: list[str], prepend: bool = False) -> int:
    n = QUEUE.add_many(paths, prepend)
    if prepend:
        maybe_resync_queue()
    elif _queue_driven:
        for p in paths:
            mpv_send(["loadfile", os.path.expanduser(p), "append"])
    return n


def queue_remove(index: int) -> QueueItem | None:
    item = QUEUE.remove(index)
    if item is not None:
        maybe_resync_queue()
    return item


def queue_move(from_idx: int, to_idx: int) -> bool:
    moved = QUEUE.move(from_idx, to_idx)
    if moved:
        maybe_resync_queue()
    return moved


def queue_clear() -> None:
    QUEUE.clear()
    maybe_resync_queue()


def queue_validate() -> list[tuple[QueueItem, str]]:
    removed = QUEUE.validate()
    if removed:
        maybe_resync_queue()
    return removed


def cmd_next() -> int:
    cur = now_path()
    items = QUEUE.items
    if items and cur:
        for i, item in enumerate(items):
            if item.path == cur:
                play_queue_from((i + 1) % len(items), wrap=True)
                return 0
    mpv_send(["playlist-next"])
    return 0


def cmd_prev() -> int:
    cur = now_path()
    items = QUEUE.items
    if items and cur:
        for i, item in enumerate(items):
            if item.path == cur:
                play_queue_from((i - 1) % len(items), wrap=True)
                return 0
    mpv_send(["playlist-prev"])
    return 0


def cmd_stop() -> int:
    global _queue_driven, _last_label
    _queue_driven = False
    _last_label = ""
    mpv_send(["stop"])
    return 0


def cmd_pause() -> int:
    mpv_send(["cycle", "pause"])
    return 0


def cmd_now() -> int:
    label = now_label()
    if label:
        print(label)
    else:
        print("Not playing")
    return 0


def cmd_status() -> int:
    lines: list[str] = []
    if not mpv_alive():
        lines.append("status: idle (no mpv)")
    else:
        status = "paused" if is_paused() else "playing"
        lines.append(f"status: {status}")
        label = now_label() or "— silence —"
        lines.append(f"track:  {label}")
        pos, dur = time_pair()
        if dur > 0:
            lines.append(f"time:   {fmt_clock(pos)} / {fmt_clock(dur)}")
        vol = mpv_get("volume", CFG.default_volume) or CFG.default_volume
        lines.append(f"vol:    {int(vol)}%")
        lines.append(f"mode:   shuffle {'on' if mpv_get('shuffle') else 'off'} · repeat {get_repeat()}")
    lines.append(f"queue:  {len(QUEUE.items)} track(s)")
    lines.append(f"socket: {SOCK}")
    print()
    print(art.box(lines, title=NAME, width=fit_width(lines)))
    print()
    return 0


# =====================================================================
# WAVES (ASCII spectrum EQ)
# =====================================================================

_SR = 11025
_N = 512
_SAMPLE_SECS = _N / _SR

_levels: list[float] = []
_last_sample_t = 0.0
_last_path = ""
_last_pos = -1.0
_source = "idle"

ROSE = "\033[38;5;175m"
ROSE_DIM = "\033[38;5;132m"
BLUE = "\033[38;5;117m"


def _fft_mags(real: list[float]) -> list[float]:
    """Radix-2 Cooley-Tukey FFT magnitude spectrum (real input)."""
    n = len(real)
    if n == 0 or n & (n - 1):
        p = 1
        while p < max(1, n):
            p <<= 1
        real = (real + [0.0] * p)[:p]
        n = p
    j = 0
    re = list(real)
    im = [0.0] * n
    for i in range(1, n):
        bit = n >> 1
        while j & bit:
            j ^= bit
            bit >>= 1
        j ^= bit
        if i < j:
            re[i], re[j] = re[j], re[i]
            im[i], im[j] = im[j], im[i]
    length = 2
    while length <= n:
        ang = -2.0 * math.pi / length
        wlen_r = math.cos(ang)
        wlen_i = math.sin(ang)
        for i0 in range(0, n, length):
            wr, wi = 1.0, 0.0
            half = length // 2
            for k in range(half):
                u_r = re[i0 + k]
                u_i = im[i0 + k]
                v_r = re[i0 + k + half] * wr - im[i0 + k + half] * wi
                v_i = re[i0 + k + half] * wi + im[i0 + k + half] * wr
                re[i0 + k] = u_r + v_r
                im[i0 + k] = u_i + v_i
                re[i0 + k + half] = u_r - v_r
                im[i0 + k + half] = u_i - v_i
                nwr = wr * wlen_r - wi * wlen_i
                wi = wr * wlen_i + wi * wlen_r
                wr = nwr
        length <<= 1
    half = n // 2
    out = [0.0] * half
    scale = 1.0 / n
    for i in range(half):
        out[i] = math.hypot(re[i], im[i]) * scale
    return out


def _band_energies(mags: list[float], bands: int, sr: int = _SR) -> list[float]:
    """Log-ish frequency grouping from FFT bins -> band energies 0..1."""
    n = len(mags)
    if n < 2 or bands < 1:
        return [0.0] * max(1, bands)
    lo_hz, hi_hz = 40.0, min(sr / 2.0 * 0.95, 5000.0)
    edges = [lo_hz * ((hi_hz / lo_hz) ** (i / bands)) for i in range(bands + 1)]
    out = [0.0] * bands
    for b in range(bands):
        i0 = max(1, int(edges[b] / sr * (n * 2)))
        i1 = max(i0 + 1, int(edges[b + 1] / sr * (n * 2)))
        i1 = min(n, i1)
        chunk = mags[i0:i1] or mags[min(i0, n - 1): min(i0, n - 1) + 1]
        e = math.sqrt(sum(x * x for x in chunk) / max(1, len(chunk)))
        out[b] = math.log1p(e * 80.0) / math.log1p(80.0)
    peak = max(out) if out else 0.0
    if peak > 1e-6:
        out = [min(1.0, v / peak) for v in out]
    return out


def _ffmpeg_slice(path: str, t: float) -> list[float] | None:
    if not path or not Path(path).is_file():
        return None
    ss = max(0.0, float(t) - _SAMPLE_SECS * 0.5)
    cmd = [
        "ffmpeg", "-v", "error", "-ss", f"{ss:.3f}",
        "-t", f"{_SAMPLE_SECS * 1.5:.3f}", "-i", path,
        "-ac", "1", "-ar", str(_SR), "-f", "f32le", "-n", "pipe:1",
    ]
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=0.22, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    raw = p.stdout or b""
    n_samp = len(raw) // 4
    if n_samp < 32:
        return None
    try:
        samples = list(struct.unpack(f"<{n_samp}f", raw[: n_samp * 4]))
    except struct.error:
        return None
    if len(samples) > _N:
        samples = samples[-_N:]
    elif len(samples) < _N:
        samples = samples + [0.0] * (_N - len(samples))
    out = []
    for i, x in enumerate(samples):
        w = 0.5 - 0.5 * math.cos(2.0 * math.pi * i / max(1, _N - 1))
        out.append(x * w)
    return out


def _fallback_bands(bands: int, t: float, *, active: bool, vol: float) -> list[float]:
    """Reactive fake spectrum when we cannot sample audio (tide echo)."""
    if not active:
        return [0.04 + 0.03 * math.sin(t * 0.7 + i * 0.4) ** 2 for i in range(bands)]
    out = []
    for i in range(bands):
        bass_w = 1.0 - (i / max(1, bands - 1)) * 0.55
        v = 0.0
        v += 0.55 * abs(math.sin(t * (1.3 + i * 0.11) + i))
        v += 0.30 * abs(math.sin(t * (2.7 + i * 0.07) + i * 1.7))
        v += 0.20 * abs(math.sin(t * (5.1 + i * 0.19)))
        kick = max(0.0, math.sin(t * 2.0)) ** 8
        if i < bands // 4:
            v += 0.45 * kick
        v *= bass_w * (0.45 + 0.55 * vol)
        out.append(max(0.0, min(1.0, v)))
    return out


def _smooth(prev: list[float], target: list[float], attack: float, release: float) -> list[float]:
    if not prev or len(prev) != len(target):
        return list(target)
    out = []
    for a, b in zip(prev, target):
        k = attack if b > a else release
        out.append(a + (b - a) * k)
    return out


def update_levels(*, bands: int = 16, path: str = "", pos: float = 0.0,
                  playing: bool = False, paused: bool = False, volume: float = 0.7) -> list[float]:
    """Refresh smoothed band levels. Call once per UI frame."""
    global _levels, _last_sample_t, _last_path, _last_pos, _source
    bands = max(8, min(32, int(bands)))
    now = time.monotonic()
    active = bool(playing and not paused)
    try:
        hz = float(os.environ.get("SIREN_WAVES_HZ", "18"))
    except ValueError:
        hz = 18.0
    sample_period = 1.0 / max(4.0, min(40.0, hz))
    due = (now - _last_sample_t) >= sample_period
    moved = abs(pos - _last_pos) > 0.02 or path != _last_path
    target: list[float] | None = None
    if active and path and due and (moved or path == _last_path):
        samples = _ffmpeg_slice(path, pos)
        _last_sample_t = now
        _last_path = path
        _last_pos = pos
        if samples:
            mags = _fft_mags(samples)
            target = _band_energies(mags, bands)
            _source = "live"
    if target is None:
        target = _fallback_bands(bands, now, active=active, vol=volume)
        if active and _source != "live":
            _source = "fall"
        elif not active:
            _source = "idle"
    if len(_levels) != bands:
        _levels = list(target)
    else:
        atk = 0.55 if _source == "live" else 0.35
        rel = 0.18 if _source == "live" else 0.22
        if not active:
            atk, rel = 0.2, 0.12
        _levels = _smooth(_levels, target, atk, rel)
    return list(_levels)


def source_label() -> str:
    return {"live": "live sample", "fall": "tide echo", "idle": "still water"}.get(_source, _source)


def render_eq_rows(levels, *, height: int = 8, col_w: int = 2, gap: int = 0,
                   body_w: int | None = None) -> list[str]:
    """Vertical ASCII bars as equal-width plain lines (no ANSI)."""
    if not levels:
        levels = [0.0]
    height = max(4, min(16, height))
    n = len(levels)
    if body_w is not None and body_w > 0 and n > 0:
        gap = 0
        base = max(1, body_w // n)
        widths = [base] * n
        while sum(widths) > body_w and any(w > 1 for w in widths):
            for i in range(n - 1, -1, -1):
                if sum(widths) <= body_w:
                    break
                if widths[i] > 1:
                    widths[i] -= 1
        rem = body_w - sum(widths)
        i = 0
        while rem > 0 and n:
            widths[i % n] += 1
            rem -= 1
            i += 1
    else:
        col_w = max(1, min(4, col_w))
        gap = max(0, min(1, gap))
        widths = [col_w] * n
    hs = [int(round(max(0.0, min(1.0, v)) * height)) for v in levels]
    rows: list[str] = []
    for y in range(height, 0, -1):
        parts = []
        for i, h in enumerate(hs):
            w = widths[i]
            cell = ("#" * w) if h >= y else (" " * w)
            parts.append(cell)
            if gap and i < n - 1:
                parts.append(" " * gap)
        line = "".join(parts)
        if body_w is not None:
            if len(line) < body_w:
                line = line + (" " * (body_w - len(line)))
            else:
                line = line[:body_w]
        rows.append(line)
    base_parts = []
    for i in range(n):
        base_parts.append("-" * widths[i])
        if gap and i < n - 1:
            base_parts.append("-" * gap)
    base = "".join(base_parts)
    if body_w is not None:
        base = (base + " " * body_w)[:body_w]
    rows.append(base)
    return rows


def colorize_eq_rows(rows: list[str], levels) -> list[str]:
    """Tint '#' cells: lower third rose, mid silver, upper baby-blue."""
    if not art.color_ok() or not rows:
        return rows
    height = max(1, len(rows) - 1)
    out = []
    for yi, row in enumerate(rows):
        if yi == len(rows) - 1:
            out.append(art.paint(row, ROSE_DIM))
            continue
        from_bottom = height - yi
        frac = from_bottom / height
        if frac > 0.66:
            code = BLUE
        elif frac > 0.33:
            code = ROSE
        else:
            code = ROSE_DIM
        buf = []
        for ch in row:
            if ch == "#":
                buf.append(art.paint("#", code))
            else:
                buf.append(ch)
        out.append("".join(buf))
    return out


def legend_line(bands: int, body_w: int) -> str:
    left, right = "bass", "treble"
    mid = f"{bands} band"
    room = max(8, body_w)
    if len(left) + len(mid) + len(right) + 4 > room:
        return (left + " -> " + right)[:room].ljust(room)
    pad = room - len(left) - len(mid) - len(right)
    left_pad = pad // 2
    right_pad = pad - left_pad
    return left + (" " * left_pad) + mid + (" " * right_pad) + right


def build_waves_body(*, bands: int = 16, height: int = 8, body_w: int = 60,
                     path: str = "", pos: float = 0.0, playing: bool = False,
                     paused: bool = False, volume: float = 0.7) -> list[str]:
    """Full waves panel body: bars + baseline + legend + meta."""
    levels = update_levels(bands=bands, path=path, pos=pos, playing=playing,
                           paused=paused, volume=volume)
    rows = render_eq_rows(levels, height=height, body_w=body_w)
    rows = colorize_eq_rows(rows, levels)
    meta = f"src {source_label()}  |  w close  |  W toggle 16/32"
    if len(meta) > body_w:
        meta = meta[:body_w]
    leg = legend_line(len(levels), body_w)
    return rows + ["", leg, meta]


def waves_panel_lines(path: str, pos: float, playing: bool, paused: bool,
                      volume: float, width: int, height: int,
                      bands: int = 16) -> list[str]:
    body_w = max(20, width - 4)
    panel_h = max(4, height - 2)
    body = build_waves_body(bands=bands, height=panel_h, body_w=body_w,
                            path=path, pos=pos, playing=playing,
                            paused=paused, volume=volume)
    if len(body) > height:
        body = body[:height]
    return body


# =====================================================================
# TUI BUILDERS
# =====================================================================

def build_header(track: str, status: str, pos: float, dur: float, vol: int,
                 shuffle: bool, repeat: str, width: int) -> str:
    # full-bleed crystal header (exact terminal width)
    outer = max(24, width)
    inner = outer - 4  # borders + padding
    if dur > 0:
        pct = pos / dur
        bar_w = max(8, min(inner - 28, 40))
        filled = int(bar_w * pct)
        bar = "█" * filled + "░" * (bar_w - filled)
        prog = f"{bar}  {fmt_clock(pos)}/{fmt_clock(dur)}"
    else:
        prog = ""
    status_icon = "▶" if status == "playing" else "⏸" if status == "paused" else "■"
    shuffle_icon = "[RND]" if shuffle else "[SEQ]"
    rep_icon = {"all": "[REP:ALL]", "track": "[REP:ONE]", "off": "[REP:OFF]"}.get(repeat, "[REP:OFF]")
    line1 = art.truncate_vis(f"{status_icon}  {track}", max(8, inner))
    line2 = art.truncate_vis(f"vol: {vol}%  {shuffle_icon} {rep_icon}  {prog}", max(8, inner))
    return art.box([line1, line2], title=NAME, width=outer, body_style=(P.SILVER,),
                   cap=None, floor=1)


def rune_row(*pairs: tuple[str, str]) -> str:
    return " · ".join(f"{keys} {label}" for keys, label in pairs)


def build_footer(width: int, focus_mode: int = 0) -> str:
    if focus_mode == 0:
        rows = [
            rune_row(("↑↓/jk", "browse"), ("o/enter/p/space", "open·play"), ("backspace", "up")),
            rune_row(("a", "add"), ("/", "filter"), ("f/F", "spellbook file·dir"), ("S", "save"), ("L", "load&play"), ("R", "rm playlist")),
            rune_row(("g", "go to path"), ("Tab", "→ queue"), ("q", "quit")),
        ]
    elif focus_mode == 1:
        rows = [
            rune_row(("↑↓/jk", "move"), ("enter/space", "play from here")),
            rune_row(("a", "add 10"), ("d", "remove"), ("c", "clear"), ("S", "save"), ("R", "rm playlist")),
            rune_row(("g", "go to path"), ("Tab", "→ EQ"), ("q", "quit")),
        ]
    else:
        rows = [
            rune_row(("p/space", "play·pause"), ("n/b", "next/prev"), ("s", "shuffle"), ("r", "repeat")),
            rune_row(("+/-", "vol"), ("w", "EQ"), ("W", "16/32"), ("S", "save"), ("R", "rm playlist")),
            rune_row(("g", "go to path"), ("Tab", "→ browser"), ("q", "quit")),
        ]
    return art.box(rows, title="runes", width=max(24, width), body_style=(P.MUTED,),
                   cap=None, floor=1)


def missing_notification(removed: list[tuple[QueueItem, str]], playlist_name: str) -> str:
    if not removed:
        return ""
    lines: list[str] = []
    for item, reason in removed:
        fname = basename(item.path)
        lines.append(f"File {fname} was removed from {playlist_name}")
        lines.append(f"Reason was {reason}")
    return art.box(lines, title=NAME, width=60, body_style=(P.WARN,))


def _panel_body_capacity(outer_h: int) -> int:
    """Body rows inside a panel of outer height (top + bottom borders)."""
    return max(1, outer_h - 2)


def build_queue_panel(queue_items: list[QueueItem], playing_index: int,
                      width: int, height: int, focus: bool,
                      *, hitmap: art.HitMap | None = None,
                      x0: int = 1, y0: int = 1,
                      cursor_index: int | None = None) -> str:
    """Crystal queue panel (exact outer width × height). Returns framed string."""
    body_cap = _panel_body_capacity(height)
    body_w = max(4, width - 4)  # inner text width
    sel = playing_index if cursor_index is None else cursor_index
    body: list[str] = []
    row_meta: list[int] = []  # entry index per body line that is a list row

    if not queue_items:
        body.append(art.paint(art.truncate_vis("(empty — 'a' to add)", body_w), P.DIM))
    else:
        # chrome: optional more-above / more-below eat body rows
        max_rows = body_cap
        start = max(0, sel - max(0, max_rows // 2))
        end = min(len(queue_items), start + max_rows)
        if end - start < max_rows:
            start = max(0, end - max_rows)
        # reserve lines for overflow hints
        more_above = start > 0
        more_below = end < len(queue_items)
        slots = max_rows - (1 if more_above else 0) - (1 if more_below else 0)
        slots = max(1, slots)
        end = min(len(queue_items), start + slots)
        if more_above:
            body.append(art.paint(art.truncate_vis(f"… {start} above", body_w), P.MUTED))
            row_meta.append(-1)
        for i in range(start, end):
            item = queue_items[i]
            display = item.display or "Unknown"
            idx_str = f"{i + 1}."
            room = max(4, body_w - len(idx_str) - 1 - 2)
            display = art.truncate_vis(display, room)
            mark = art.focus_mark(i == sel, focused_panel=focus)
            if i == playing_index:
                name = art.paint(display, P.BOLD, P.SILVER)
                play = art.paint("♪", P.PINK)
            else:
                name = art.paint(display, P.SILVER)
                play = " "
            line = mark + art.paint(idx_str, P.PINK_DIM) + play + name
            body.append(line)
            row_meta.append(i)
        if more_below:
            body.append(art.paint(
                art.truncate_vis(f"… {len(queue_items) - end} more", body_w), P.MUTED))
            row_meta.append(-1)

    framed = art.panel(body, title="queue", width=width, height=height,
                       focus=focus, body_style=(P.SILVER,))
    if hitmap is not None:
        hitmap.add(art.Region(
            id="queue:panel", x0=x0, y0=y0,
            x1=x0 + max(0, width - 1), y1=y0 + max(0, height - 1),
            z=1, role="panel", data=1,
        ))
        # body rows start at y0+1 (after top border)
        for bi, idx in enumerate(row_meta):
            if idx < 0:
                continue
            ry = y0 + 1 + bi
            hitmap.add(art.Region(
                id=f"queue:{idx}", x0=x0, y0=ry, x1=x0 + max(0, width - 1),
                y1=ry, z=2, role="list-row", data=idx,
            ))
    return framed


def build_browser_panel(browser, width: int, height: int, focus: bool,
                        *, hitmap: art.HitMap | None = None,
                        x0: int = 1, y0: int = 1) -> str:
    """Crystal browser panel (exact outer width × height). Returns framed string."""
    body_cap = _panel_body_capacity(height)
    body_w = max(4, width - 4)
    path_display = browser.get_display_path()
    if browser.filter:
        path_display += f" [{browser.filter}]"
    path_display = art.truncate_vis(path_display, max(6, body_w))
    body: list[str] = [art.paint(path_display, P.MUTED)]
    row_meta: list[int] = [-1]  # path line not clickable as entry

    if not browser.entries:
        body.append(art.paint(art.truncate_vis("(empty directory)", body_w), P.DIM))
    else:
        max_rows = max(1, body_cap - 1)  # path takes one
        more_budget = max_rows
        start = max(0, browser.selected_idx - more_budget // 2)
        end = min(len(browser.entries), start + more_budget)
        if end - start < more_budget:
            start = max(0, end - more_budget)
        more_above = start > 0
        more_below = end < len(browser.entries)
        slots = more_budget - (1 if more_above else 0) - (1 if more_below else 0)
        slots = max(1, slots)
        end = min(len(browser.entries), start + slots)
        if more_above:
            body.append(art.paint(art.truncate_vis(f"… {start} above", body_w), P.MUTED))
            row_meta.append(-1)
        for i in range(start, end):
            entry = browser.entries[i]
            display = entry["display"]
            room = max(4, body_w - 2)
            display = art.truncate_vis(display, room)
            mark = art.focus_mark(i == browser.selected_idx, focused_panel=focus)
            if i == browser.selected_idx:
                name = art.paint(display, P.BOLD, P.SILVER)
            elif entry["is_dir"]:
                name = art.paint(display, P.SILVER)
            else:
                name = art.paint(display, P.MUTED)
            body.append(mark + name)
            row_meta.append(i)
        if more_below:
            body.append(art.paint(
                art.truncate_vis(f"… {len(browser.entries) - end} more", body_w), P.MUTED))
            row_meta.append(-1)

    title = "browser"
    framed = art.panel(body, title=title, width=width, height=height,
                       focus=focus, body_style=(P.SILVER,))
    if hitmap is not None:
        hitmap.add(art.Region(
            id="browser:panel", x0=x0, y0=y0,
            x1=x0 + max(0, width - 1), y1=y0 + max(0, height - 1),
            z=1, role="panel", data=0,
        ))
        for bi, idx in enumerate(row_meta):
            if idx < 0:
                continue
            ry = y0 + 1 + bi
            hitmap.add(art.Region(
                id=f"browser:{idx}", x0=x0, y0=ry, x1=x0 + max(0, width - 1),
                y1=ry, z=2, role="list-row", data=idx,
            ))
    return framed


def build_waves_panel(path: str, pos: float, playing: bool, paused: bool,
                      volume: float, width: int, height: int,
                      bands: int = 16,
                      *, hitmap: art.HitMap | None = None,
                      y0: int = 1) -> str:
    body_h = _panel_body_capacity(height)
    body = waves_panel_lines(path, pos, playing, paused, volume, width, body_h, bands=bands)
    # strip any outer width assumptions — body lines plain
    framed = art.panel(body, title="waves", width=width, height=height,
                       focus=False, body_style=(P.SILVER,))
    if hitmap is not None:
        hitmap.add(art.Region(
            id="eq:panel", x0=1, y0=y0,
            x1=max(1, width), y1=y0 + max(0, height - 1),
            z=1, role="panel", data=2,
        ))
    return framed


class FileBrowser:
    """File/directory browser for the music library."""

    def __init__(self, root: str | None = None) -> None:
        self.root = Path(os.path.expanduser(root or "~/Music")).resolve()
        self.current_dir = self.root
        self.selected_idx = 0
        self.filter = ""
        self.entries: list[dict] = []
        self._refresh()

    def _refresh(self) -> None:
        all_entries: list[dict] = []
        try:
            if self.current_dir != self.root:
                all_entries.append({
                    "name": "..",
                    "path": self.current_dir.parent,
                    "is_dir": True,
                    "display": "▸  ..",
                })
            for entry in sorted(self.current_dir.iterdir(),
                                key=lambda e: (not e.is_dir(), e.name.lower())):
                if entry.is_dir():
                    all_entries.append({
                        "name": entry.name, "path": entry,
                        "is_dir": True, "display": f"▸  {entry.name}",
                    })
                elif entry.suffix.lower() in AUDIO_EXT:
                    all_entries.append({
                        "name": entry.name, "path": entry,
                        "is_dir": False, "display": f"·  {meta_display(str(entry))}",
                    })
        except PermissionError:
            pass
        if self.filter:
            f = self.filter.strip()
            if CFG.fuzzy_search:
                def _score(e: dict) -> int:
                    a = fuzzy_score(f, e["name"])
                    b = fuzzy_score(f, e["display"])
                    return max(a[0], b[0])
                all_entries = [e for e in all_entries if _score(e) > 0]
                all_entries.sort(key=lambda e: (-_score(e), e["name"].lower()))
            else:
                fl = f.lower()
                all_entries = [
                    e for e in all_entries
                    if fl in e["name"].lower() or fl in e["display"].lower()
                ]
        self.entries = all_entries
        if self.entries:
            self.selected_idx = max(0, min(self.selected_idx, len(self.entries) - 1))
        else:
            self.selected_idx = 0

    def set_filter(self, text: str) -> None:
        if text == self.filter:
            return
        self.filter = text
        self.selected_idx = 0
        self._refresh()

    def navigate_up(self) -> None:
        if self.selected_idx > 0:
            self.selected_idx -= 1

    def navigate_down(self) -> None:
        if self.entries and self.selected_idx < len(self.entries) - 1:
            self.selected_idx += 1

    def enter(self) -> str | None:
        """'dir' when a directory was entered, else the file path."""
        if not self.entries:
            return None
        entry = self.entries[self.selected_idx]
        if entry["is_dir"]:
            self.current_dir = entry["path"].resolve()
            self.selected_idx = 0
            self._refresh()
            return "dir"
        return str(entry["path"])

    def go_up(self) -> bool:
        if self.current_dir != self.root:
            self.current_dir = self.current_dir.parent
            self.selected_idx = 0
            self._refresh()
            return True
        return False

    def get_selected(self) -> dict | None:
        if self.entries and 0 <= self.selected_idx < len(self.entries):
            return self.entries[self.selected_idx]
        return None

    def set_dir(self, path: str) -> None:
        p = Path(os.path.expanduser(path)).resolve()
        if p.exists() and p.is_dir():
            self.current_dir = p
            self.selected_idx = 0
            self._refresh()

    def get_display_path(self) -> str:
        try:
            rel = self.current_dir.relative_to(self.root)
            if str(rel) == ".":
                return "~/Music"
            return f"~/Music/{rel}"
        except ValueError:
            return str(self.current_dir)


# =====================================================================
# TUI
# =====================================================================

def pick_path_via_spellbook(fd: int, start_dir: str | None = None) -> str | None:
    """Spawn spellbook --pick on a PTY and return the chosen path (file or
    directory). The parent fd stays in cbreak so keystrokes pass through raw;
    the child runs in its own sized PTY, exactly like tome's bridge."""
    try:
        with tempfile.NamedTemporaryFile(mode="w+", delete=False) as tf:
            out_path = tf.name
        try:
            cmd = ["spellbook", "--pick", "--output", out_path]
            if start_dir:
                cmd.append(start_dir)
            pid, child_fd = os.forkpty()
            if pid == 0:
                os.execvp(cmd[0], cmd)
            else:
                import tty as _tty
                try:
                    w, h = art.term_width(), art.term_height()
                    fcntl.ioctl(child_fd, termios.TIOCSWINSZ,
                                struct.pack("HHHH", h, w, 0, 0))
                except OSError:
                    pass
                try:
                    _tty.setcbreak(child_fd)
                except Exception:
                    pass
                try:
                    while True:
                        r, _, _ = select.select([fd, child_fd], [], [], 0.1)
                        if fd in r:
                            try:
                                data = os.read(fd, 1024)
                            except OSError:
                                break
                            if data:
                                try:
                                    os.write(child_fd, data)
                                except OSError:
                                    break
                        if child_fd in r:
                            try:
                                data = os.read(child_fd, 1024)
                            except OSError:
                                break
                            if data:
                                try:
                                    os.write(fd, data)
                                except OSError:
                                    break
                        pid_done, _status = os.waitpid(pid, os.WNOHANG)
                        if pid_done:
                            break
                finally:
                    try:
                        os.close(child_fd)
                    except OSError:
                        pass
                if os.path.exists(out_path):
                    with open(out_path, "r") as f:
                        path = f.read().strip()
                    if path:
                        return path
        finally:
            try:
                os.unlink(out_path)
            except OSError:
                pass
    except Exception as e:
        art.tty_write(fd, art.paint(f"siren: spellbook picker failed: {e}", P.ERR))
    return None


def run_tui() -> int:
    fd = art.tui_open_tty()
    if fd is None:
        print(art.paint("siren needs a real TTY (not a pipe).", P.ERR), file=sys.stderr)
        return 2
    art.tui_begin(fd, "siren", mouse=bool(CFG.mouse))

    focus_mode = 0  # 0=browser, 1=queue, 2=EQ
    notification = ""
    notification_time = 0.0
    browser = FileBrowser()
    input_active = False
    input_action = ""
    input_prompt = ""
    input_buf = ""
    eq_visible = CFG.waves
    band_count = CFG.wave_bands
    validate_counter = 0
    queue_sel = 0
    hitmap = art.HitMap()
    dbl = art.DoubleClickTracker(ms=350)

    def _browser_activate() -> None:
        res = browser.enter()
        if res and res != "dir":
            queue_add_and_play(res)

    def _handle_mouse(ev: art.MouseEvent) -> None:
        nonlocal focus_mode, queue_sel, eq_visible, notification, notification_time
        if input_active:
            return
        delta = art.wheel_delta(ev)
        if delta:
            region = hitmap.hit(ev.x, ev.y)
            if region is not None and region.id.startswith("browser"):
                focus_mode = 0
                if delta > 0:
                    browser.navigate_up()
                else:
                    browser.navigate_down()
            elif region is not None and region.id.startswith("queue"):
                focus_mode = 1
                n = len(QUEUE.items)
                if n:
                    queue_sel = max(0, min(n - 1, queue_sel - delta))
            elif focus_mode == 0:
                if delta > 0:
                    browser.navigate_up()
                else:
                    browser.navigate_down()
            elif focus_mode == 1:
                n = len(QUEUE.items)
                if n:
                    queue_sel = max(0, min(n - 1, queue_sel - delta))
            return
        if ev.action != "press" or ev.button != 0:
            return
        region = hitmap.hit(ev.x, ev.y)
        if region is None:
            return
        rid = region.id
        if rid == "browser:panel":
            focus_mode = 0
            return
        if rid == "queue:panel":
            focus_mode = 1
            return
        if rid == "eq:panel":
            focus_mode = 2
            return
        if rid.startswith("browser:"):
            focus_mode = 0
            try:
                idx = int(rid.split(":", 1)[1])
            except ValueError:
                return
            if 0 <= idx < len(browser.entries):
                browser.selected_idx = idx
                if dbl.is_double(rid):
                    _browser_activate()
            return
        if rid.startswith("queue:"):
            focus_mode = 1
            try:
                idx = int(rid.split(":", 1)[1])
            except ValueError:
                return
            if 0 <= idx < len(QUEUE.items):
                queue_sel = idx
                if dbl.is_double(rid):
                    play_queue_from(idx)
            return

    try:
        while True:
            alive = mpv_alive()
            paused = is_paused() if alive else False
            status = "paused" if paused else ("playing" if alive else "idle")
            track = now_label() or "— silence —"
            pos = 0.0
            dur = 0.0
            path = ""
            if alive:
                pos, dur = time_pair()
                path = now_path()

            vol = int(mpv_get("volume", CFG.default_volume) or CFG.default_volume)
            shuffle = bool(mpv_get("shuffle", False))
            repeat = get_repeat()
            width = art.term_width()
            height = art.term_height()

            queue_items = QUEUE.items
            playing_idx = -1
            if alive and queue_items:
                for i, item in enumerate(queue_items):
                    if item.path == path:
                        playing_idx = i
                        break
            if queue_items:
                if playing_idx >= 0 and not (0 <= queue_sel < len(queue_items)):
                    queue_sel = playing_idx
                queue_sel = max(0, min(len(queue_items) - 1, queue_sel))
            else:
                queue_sel = 0

            header = build_header(track, status, pos, dur, vol, shuffle, repeat, width)
            footer = build_footer(width, focus_mode)
            header_h = header.count("\n") + 1
            footer_h = footer.count("\n") + 1
            show_note = bool(notification and (time.time() - notification_time) < 4)
            note_h = (notification.count("\n") + 1) if show_note else 0
            # blanks: after header, after note (or after header), after waves, after mid
            blanks = 3 + (1 if show_note else 0)
            area = max(6, height - header_h - footer_h - blanks - (1 if input_active else 0))
            if eq_visible:
                eq_h = max(4, min(10, int(area * 0.32)))
                bottom_h = area - eq_h
                if bottom_h < 6:
                    eq_h = max(3, area - 6)
                    bottom_h = area - eq_h
            else:
                eq_h = 0
                bottom_h = area
            if bottom_h < 6:
                bottom_h = 6

            validate_counter += 1
            if validate_counter >= 100:
                validate_counter = 0
                removed = queue_validate()
                if removed:
                    notification = missing_notification(removed, "queue")
                    notification_time = time.time()

            gap = 1
            browser_w, queue_w = art.split_widths(width, gap=gap, left_ratio=0.58)

            # 1-based cell rows matching paint_frame home origin
            hitmap.clear()
            y = 1
            y += header_h
            y += 1  # blank after header
            if show_note:
                y += note_h
                y += 1
            waves_block = ""
            if eq_visible and eq_h > 0:
                waves_block = build_waves_panel(
                    path, pos, alive, paused, vol / 100.0,
                    width, eq_h, bands=band_count,
                    hitmap=hitmap, y0=y,
                )
                y += eq_h
                y += 1  # blank after waves
            bottom_y0 = y
            browser_block = build_browser_panel(
                browser, browser_w, bottom_h, focus_mode == 0,
                hitmap=hitmap, x0=1, y0=bottom_y0,
            )
            queue_block = build_queue_panel(
                queue_items, playing_idx, queue_w, bottom_h, focus_mode == 1,
                hitmap=hitmap, x0=browser_w + gap + 1, y0=bottom_y0,
                cursor_index=queue_sel,
            )
            mid = art.split_row(
                browser_block, queue_block,
                gap=gap, left_width=browser_w, right_width=queue_w,
            )

            frame_parts: list[str] = [header, ""]
            if show_note:
                frame_parts.append(notification)
                frame_parts.append("")
            elif notification and (time.time() - notification_time) >= 4:
                notification = ""
            if waves_block:
                frame_parts.append(waves_block)
                frame_parts.append("")
            frame_parts.append(mid)
            frame_parts.append("")
            frame_parts.append(footer)
            if input_active:
                shown = "  " + input_prompt + input_buf + "▌"
                if art.vis_len(shown) > width:
                    shown = art.truncate_vis(art.strip_ansi(shown), width)
                frame_parts.append(art.paint(shown, P.BOLD, P.PINK))
            frame = "\n".join(frame_parts)

            try:
                art.paint_frame(fd, frame)
            except OSError:
                art.tty_write(fd, art.clear_screen() + frame + "\n")

            ev = art.tui_read_event(fd, timeout=0.05)
            if isinstance(ev, art.MouseEvent):
                _handle_mouse(ev)
                continue
            key = ev

            if input_active:
                if key == "esc":
                    if input_action == "filter":
                        browser.set_filter("")
                    input_active = False
                    input_action = ""
                    input_prompt = ""
                    input_buf = ""
                elif key == "backspace":
                    input_buf = input_buf[:-1]
                elif key == "space":
                    input_buf += " "
                elif key == "ctrl-u":
                    input_buf = ""
                elif key == "enter":
                    action = input_action
                    buf = input_buf.strip()
                    input_active = False
                    input_action = ""
                    input_prompt = ""
                    input_buf = ""
                    if action == "save":
                        name = buf or "playlist"
                        count = len(QUEUE.items)
                        if playlist_save(name, QUEUE.items):
                            notification = art.box([f"Saved playlist: {name} ({count} tracks)"],
                                                   title=NAME, width=50, body_style=(P.OK,))
                        else:
                            notification = art.box([f"Failed to save: {name}"],
                                                   title=NAME, width=50, body_style=(P.WARN,))
                        notification_time = time.time()
                    elif action == "load":
                        name = buf
                        if play_playlist(name):
                            notification = art.box([f"Playing playlist: {name}"],
                                                   title=NAME, width=50, body_style=(P.OK,))
                        elif name and name in playlist_names():
                            notification = art.box([f"Playlist '{name}' has no playable tracks"],
                                                   title=NAME, width=50, body_style=(P.WARN,))
                        else:
                            notification = art.box([f"No playlist: {name}"],
                                                   title=NAME, width=50, body_style=(P.WARN,))
                        notification_time = time.time()
                    elif action == "open":
                        dir_input = buf or str(Path.home() / "Music")
                        target = Path(dir_input).expanduser().resolve()
                        if target.is_dir():
                            browser.set_dir(str(target))
                            focus_mode = 0
                            notification = art.box([f"Open: {browser.get_display_path()}"],
                                                   title=NAME, width=50, body_style=(P.OK,))
                        else:
                            notification = art.box([f"Not a directory: {dir_input}"],
                                                   title=NAME, width=50, body_style=(P.WARN,))
                        notification_time = time.time()
                    elif action == "rmplaylist":
                        name = buf
                        if playlist_delete(name):
                            notification = art.box([f"Removed playlist: {name}"],
                                                   title=NAME, width=50, body_style=(P.OK,))
                        else:
                            notification = art.box([f"No playlist: {name}"],
                                                   title=NAME, width=50, body_style=(P.WARN,))
                        notification_time = time.time()
                elif key == "ctrl-c":
                    return 0
                elif len(key) == 1:
                    input_buf += key
                if input_active and input_action == "filter":
                    browser.set_filter(input_buf.strip())
                continue

            if key in ("q", "esc", "ctrl-c", "Q"):
                return 0

            if key == "o":
                focus_mode = 0
                res = browser.enter()
                if res and res != "dir":
                    queue_add_and_play(res)
                continue
            elif key == "S":
                input_active = True
                input_action = "save"
                input_prompt = "save queue as:"
                input_buf = ""
                continue
            elif key == "L":
                names = playlist_names()
                hint = ", ".join(names) if names else "(none)"
                input_active = True
                input_action = "load"
                input_prompt = f"load & play ({hint}):"
                input_buf = ""
                continue
            elif key == "R":
                names = playlist_names()
                hint = ", ".join(names) if names else "(none)"
                input_active = True
                input_action = "rmplaylist"
                input_prompt = f"remove playlist ({hint}):"
                input_buf = ""
                continue
            elif key == "g":
                input_active = True
                input_action = "open"
                input_prompt = "go to directory:"
                input_buf = ""
                continue
            elif key in ("f", "F"):
                want_dir = key == "F"
                picked = pick_path_via_spellbook(fd, str(browser.current_dir))
                if picked:
                    focus_mode = 0
                    p = Path(picked)
                    if p.is_dir():
                        files = [str(f) for f in sorted(p.rglob("*"))
                                 if f.is_file() and f.suffix.lower() in AUDIO_EXT]
                        if files:
                            start_playlist(files, shuffle=False)
                            notification = art.box([f"Playing {len(files)} track(s): {p.name}"],
                                                   title=NAME, width=50, body_style=(P.OK,))
                        else:
                            notification = art.box([f"No audio in: {p.name}"],
                                                   title=NAME, width=50, body_style=(P.WARN,))
                    elif want_dir:
                        notification = art.box([f"{p.name} is a file — pick a directory (p) to play a folder"],
                                               title=NAME, width=50, body_style=(P.WARN,))
                    else:
                        queue_add_and_play(str(p))
                        notification = art.box([f"Playing: {meta_display(str(p))}"],
                                               title=NAME, width=50, body_style=(P.OK,))
                    notification_time = time.time()
                continue
            elif key == "/":
                focus_mode = 0
                input_active = True
                input_action = "filter"
                input_prompt = "filter:"
                input_buf = browser.filter
                continue

            if key == "tab":
                focus_mode = (focus_mode + 1) % 3
                continue

            if focus_mode == 0:
                if key in ("up", "k"):
                    browser.navigate_up()
                elif key in ("down", "j"):
                    browser.navigate_down()
                elif key in ("enter", "p", " "):
                    res = browser.enter()
                    if res and res != "dir":
                        queue_add_and_play(res)
                elif key == "backspace":
                    browser.go_up()
                elif key == "a":
                    entry = browser.get_selected()
                    if entry:
                        count = 0
                        if entry["is_dir"]:
                            try:
                                for f in sorted(entry["path"].iterdir()):
                                    if f.is_file() and f.suffix.lower() in AUDIO_EXT:
                                        queue_add(str(f))
                                        count += 1
                            except PermissionError:
                                pass
                        else:
                            queue_add(str(entry["path"]))
                            count = 1
                        if count:
                            notification = art.box([f"Added {count} track(s) to queue"],
                                                   title=NAME, width=50, body_style=(P.OK,))
                            notification_time = time.time()
            elif focus_mode == 1:
                if key in ("up", "k"):
                    if queue_items:
                        queue_sel = max(0, queue_sel - 1)
                elif key in ("down", "j"):
                    if queue_items:
                        queue_sel = min(len(queue_items) - 1, queue_sel + 1)
                elif key in ("enter", " "):
                    if queue_items and 0 <= queue_sel < len(queue_items):
                        play_queue_from(queue_sel)
                elif key == "a":
                    lib = scan_library()
                    if lib:
                        files = [str(p) for p in lib]
                        random.shuffle(files)
                        for f in files[:10]:
                            queue_add(f)
                elif key == "d":
                    if queue_items and 0 <= queue_sel < len(queue_items):
                        removed = queue_remove(queue_sel)
                        if removed:
                            if queue_sel >= len(QUEUE.items) and QUEUE.items:
                                queue_sel = len(QUEUE.items) - 1
                            notification = art.box([f"Removed: {removed.display or 'track'}"],
                                                   title=NAME, width=50, body_style=(P.OK,))
                            notification_time = time.time()
                elif key == "c":
                    queue_clear()
                    queue_sel = 0
                    notification = art.box(["Queue cleared"], title=NAME, width=30, body_style=(P.OK,))
                    notification_time = time.time()
            else:
                if key in ("p", "enter", " "):
                    if alive:
                        cmd_pause()
                    else:
                        lib = scan_library()
                        if lib:
                            files = [str(p) for p in lib]
                            random.shuffle(files)
                            start_playlist(files, shuffle=False)
                elif key == "n":
                    if alive:
                        cmd_next()
                elif key == "b":
                    if alive:
                        cmd_prev()
                elif key in ("+", "="):
                    if alive:
                        mpv_send(["set_property", "volume", min(150, vol + 5)])
                elif key == "-":
                    if alive:
                        mpv_send(["set_property", "volume", max(0, vol - 5)])
                elif key in ("s",):
                    if alive:
                        mpv_send(["cycle", "shuffle"])
                elif key == "r":
                    if alive:
                        cycle_repeat()
                elif key == "w":
                    eq_visible = not eq_visible
                elif key == "W":
                    band_count = 32 if band_count == 16 else 16
                elif key == "a":
                    lib = scan_library()
                    if lib:
                        files = [str(p) for p in lib]
                        random.shuffle(files)
                        for f in files[:10]:
                            queue_add(f)
                        notification = art.box([f"Added {min(10, len(files))} tracks to queue"],
                                               title=NAME, width=50, body_style=(P.OK,))
                        notification_time = time.time()
    finally:
        art.tui_cleanup()
    return 0


# =====================================================================
# CLI
# =====================================================================

def cmd_about() -> int:
    lines = [
        "Siren — the Aether's music vessel.",
        "Commands: play, pause, stop, next, prev, random, now, status, cove",
        "Queue:    siren queue add|list|clear|play|next|remove|move",
        "Playlist: siren playlist save|load|list|remove · siren play <album>",
        "Free media:  siren trove  (the Archive keep)",
        "Config:   siren config get|set",
        "TUI: / filter · o open · a add · S/L/R playlists · g go-to · Tab focus · q quit",
    ]
    print()
    print(art.box(lines, title=NAME, width=fit_width(lines)))
    print()
    return 0


def cmd_queue_add(query: str, prepend: bool) -> int:
    files = resolve_play_args(query.split())
    if not files:
        print("No tracks found matching query.")
        return 1
    for f in files:
        queue_add(str(f), prepend)
    action = "Prepended" if prepend else "Added"
    print(f"{action} {len(files)} track(s) to queue.")
    return 0


def cmd_queue_list() -> int:
    items = QUEUE.items
    if not items:
        print("(queue empty)")
        return 0
    for i, item in enumerate(items):
        mark = "▶" if i == 0 else " "
        print(f"  {mark} {i+1:3d}. {item.display or 'Unknown'}")
    return 0


def cmd_queue_play() -> int:
    if not QUEUE.items:
        print("Queue empty.")
        return 1
    removed = queue_validate()
    if removed:
        for item, _reason in removed:
            print(f"Removed missing: {basename(item.path)}")
    if not QUEUE.items:
        print("Queue empty after validation.")
        return 1
    return 0 if play_queue_from(0) else 1


def cmd_queue_next() -> int:
    if not QUEUE.items:
        print("Queue empty.")
        return 1
    cur = now_path()
    idx = next((i for i, it in enumerate(QUEUE.items) if it.path == cur), -1)
    if idx < 0:
        return 0 if play_queue_from(0) else 1
    return 0 if play_queue_from((idx + 1) % len(QUEUE.items), wrap=True) else 1


def main_queue(rest: list[str]) -> int:
    sub = rest[0].lower() if rest else ""
    if sub in ("add", "a"):
        query = " ".join(rest[1:]) if len(rest) > 1 else ""
        prepend = "--next" in rest or "-n" in rest
        return cmd_queue_add(query, prepend)
    if sub in ("list", "l", "ls"):
        return cmd_queue_list()
    if sub in ("clear", "c"):
        queue_clear()
        print("Queue cleared.")
        return 0
    if sub in ("play", "p"):
        return cmd_queue_play()
    if sub in ("next", "n"):
        return cmd_queue_next()
    if sub in ("remove", "rm", "del", "d"):
        if len(rest) > 1 and rest[1].isdigit():
            idx = int(rest[1]) - 1
            removed = queue_remove(idx)
            if removed:
                print(f"Removed: {removed.display or 'track'}")
            else:
                print("Invalid index.")
            return 0
        print("Usage: siren queue remove <index>")
        return 1
    if sub in ("move", "mv"):
        if len(rest) >= 3 and rest[1].isdigit() and rest[2].isdigit():
            if queue_move(int(rest[1]) - 1, int(rest[2]) - 1):
                print("Moved.")
            else:
                print("Invalid indices.")
            return 0
        print("Usage: siren queue move <from> <to>")
        return 1
    print("Queue commands: add, list, clear, play, next, remove, move")
    return 1


def cmd_playlist_save(name: str) -> int:
    if playlist_save(name):
        print(f"Saved playlist: {name}")
        return 0
    print("Failed to save playlist.")
    return 1


def cmd_playlist_load(name: str) -> int:
    if play_playlist(name):
        print(f"Playing playlist: {name}")
        return 0
    print(f"Playlist not found: {name}")
    return 1


def cmd_playlist_list() -> int:
    names = playlist_names()
    if not names:
        print("(no saved playlists)")
        return 0
    for n in names:
        print(f"  {n}")
    return 0


def cmd_playlist_remove(name: str) -> int:
    if playlist_delete(name):
        print(f"Deleted playlist: {name}")
        return 0
    print(f"Playlist not found: {name}")
    return 1


def main_playlist(rest: list[str]) -> int:
    sub = rest[0].lower() if rest else ""
    if sub in ("save", "s"):
        name = rest[1] if len(rest) > 1 else "playlist"
        return cmd_playlist_save(name)
    if sub in ("load", "l"):
        name = rest[1] if len(rest) > 1 else ""
        if not name:
            print("Usage: siren playlist load <name>")
            return 1
        return cmd_playlist_load(name)
    if sub in ("list", "ls"):
        return cmd_playlist_list()
    if sub in ("remove", "rm", "delete", "del"):
        name = rest[1] if len(rest) > 1 else ""
        if not name:
            print("Usage: siren playlist remove <name>")
            return 1
        return cmd_playlist_remove(name)
    print("Playlist commands: save, load, list, remove")
    return 1


def _trove_help() -> int:
    print()
    print(art.box([
        "siren trove — free & legal media (Internet Archive)",
        "",
        "  siren trove 10 music lofi      search + pick",
        "  siren trove podcast history     kind + terms",
        "  siren trove get <identifier>    download one item",
        "  siren trove about",
        "",
        "downloads land in ~/Music/trove and ~/Videos/trove",
    ], title=NAME, width=fit_width([])))
    print()
    return 0


def main(argv: list[str]) -> int:
    if not argv:
        return run_tui()

    cmd = argv[0].lower()
    rest = argv[1:]

    if cmd in ("-h", "--help", "help"):
        return cmd_about()

    if cmd == "trove":
        import ia
        sub = rest[0].lower() if rest else ""
        if sub in ("get", "g"):
            return ia.run_get(" ".join(rest[1:]))
        if sub in ("about", "help", "-h", "--help"):
            return _trove_help()
        n = 10
        words = list(rest)
        if words and words[0].isdigit():
            n = int(words.pop(0))
        return ia.run_trove(n=n, terms=words, kind=None)

    if cmd in ("play", "play-music"):
        if not rest and mpv_alive() and (mpv_get("playlist-count", 0) or 0) > 0:
            mpv_send(["set_property", "pause", False])
            if not now_label():
                mpv_send(["playlist-play-index", 0])
            time.sleep(0.15)
            msg = f"Playing: {now_label()}" if now_label() else "Playback resumed"
            print()
            print(art.box([msg], title=NAME, width=fit_width([msg])))
            print()
            return 0
        if len(rest) == 1:
            hit = playlist_find(rest[0])
            if hit:
                return cmd_playlist_load(hit)
        files = resolve_play_args(rest)
        if not files:
            msg = f"No tracks match: {' '.join(rest)}"
            print()
            print(art.box([msg], title=NAME, width=fit_width([msg])))
            print()
            return 1
        return start_playlist([str(p) for p in files], shuffle=False)

    if cmd in ("pause", "toggle"):
        cmd_pause()
        print()
        print(art.box(["Playback paused / resumed"], title=NAME, width=fit_width(["Playback paused / resumed"])))
        print()
        return 0
    if cmd == "stop":
        cmd_stop()
        print()
        print(art.box(["Playback stopped"], title=NAME, width=fit_width(["Playback stopped"])))
        print()
        return 0
    if cmd in ("next", "nex"):
        cmd_next()
        time.sleep(0.15)
        msg = f"Next: {now_label()}"
        print()
        print(art.box([msg], title=NAME, width=fit_width([msg])))
        print()
        return 0
    if cmd == "prev":
        cmd_prev()
        time.sleep(0.15)
        msg = f"Previous: {now_label()}"
        print()
        print(art.box([msg], title=NAME, width=fit_width([msg])))
        print()
        return 0
    if cmd == "now":
        return cmd_now()
    if cmd == "status":
        return cmd_status()
    if cmd == "cove":
        msg = "Siren Cove Directory:\nMusic"
        print()
        print(art.box([msg], title="Siren Cove", width=fit_width([msg])))
        print()
        return 0
    if cmd == "random":
        lib = scan_library()
        if not lib:
            print("No tracks found in library.")
            return 1
        return start_playlist([str(p) for p in lib], shuffle=True)
    if cmd == "config":
        return cmd_config(rest)
    if cmd == "queue":
        return main_queue(rest)
    if cmd == "playlist":
        return main_playlist(rest)
    if cmd in ("about", "-v", "--version"):
        return cmd_about()

    files = resolve_play_args([cmd] + rest)
    if not files:
        msg = f"No tracks match: {cmd}"
        print()
        print(art.box([msg], title=NAME, width=fit_width([msg])))
        print()
        return 1
    return start_playlist([str(p) for p in files], shuffle=False)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        art.tui_cleanup()
        print()
        sys.exit(130)
