#!/usr/bin/env bash
# pixie-art — show pixie/wizard corner mascots via chafa (TTY-friendly symbols)
set -euo pipefail
ART="${XDG_DATA_HOME:-$HOME/.local/share}/pixie/art"
who="${1:-both}"
sz="${2:-28x14}"

render() {
  local name="$1" size="${2:-28x14}"
  local src="$ART/src/${name}.jpg"
  if command -v chafa >/dev/null 2>&1 && [[ -f $src ]]; then
    chafa -f symbols -s "$size" --colors 256 --dither none "$src"
  elif [[ -f $ART/${name}.txt ]]; then
    cat "$ART/${name}.txt"
  else
    echo "(missing art for $name)" >&2
    return 1
  fi
}

case "$who" in
  pixie|wizard) render "$who" "$sz" ;;
  both)
    printf '%s\n' "── pixie ──"
    render pixie "$sz"
    printf '\n%s\n' "── wizard ──"
    render wizard "$sz"
    ;;
  -h|--help|help)
    echo "Usage: pixie-art [pixie|wizard|both] [WxH]"
    echo "  needs: chafa + jpgs in $ART/src/"
    ;;
  *) echo "Usage: pixie-art [pixie|wizard|both] [WxH]" >&2; exit 1 ;;
esac
