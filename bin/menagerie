#!/usr/bin/env bash
# menagerie — fully offline llama.cpp server(s) for Pixie + friends
#
# Profiles (models under ~/.local/share/pixie/models/):
#   qwen     Qwen2.5 (Base or Coder) port 8080  (default Pixie)
#   kur      SmolLM2-360M-Instruct  port 8081  (haiku dragon — tiny/fast)
#   imp      Qwen2.5 Coder          port 8082  (terminal art generator)
#   default  qwen (base), else qwen coder
#
# Usage:
#   menagerie start [qwen|kur|imp|default]
#   menagerie stop  [qwen|kur|all]
#   menagerie status [profile|all]
#   menagerie restart [profile]
#   menagerie chat [profile] "hello"
#   menagerie path|logs [profile]
#
set -euo pipefail

CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pixie"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/pixie/llm"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pixie"
MODEL_DIR="${PIXIE_LLM_MODEL_DIR:-$DATA_DIR/models}"

HOST="${PIXIE_LLM_HOST:-127.0.0.1}"
_NPROC="$(nproc 2>/dev/null || echo 4)"
THREADS_DEFAULT="${PIXIE_LLM_THREADS:-$(( _NPROC > 1 ? _NPROC - 1 : 1 ))}"
NGL="${PIXIE_LLM_NGL:-0}"
# unload the model from RAM after this many idle seconds (0 = keep resident);
# the server stays up and reloads it on the next request
SLEEP_IDLE="${PIXIE_LLM_SLEEP_IDLE:-300}"
if [[ "$SLEEP_IDLE" -le 0 ]]; then SLEEP_IDLE=-1; fi

mkdir -p "$CFG_DIR" "$CACHE_DIR" "$MODEL_DIR"

# profile → model file, port, ctx, alias, threads
resolve_profile() {
  local p="${1:-default}"
  case "$p" in
    default|pixie|"")
      if [[ -f "$MODEL_DIR/qwen3-4b-instruct-q4_k_m.gguf" ]] || \
         [[ -f "$MODEL_DIR/qwen2.5-3b-instruct-q4_k_m.gguf" ]] || \
         compgen -G "$MODEL_DIR/qwen*coder*.gguf" > /dev/null; then
        p=qwen
      else
        echo "menagerie: no model found under $MODEL_DIR" >&2
        echo "  download the coder: hf download Qwen/Qwen2.5-Coder-3B-Instruct-GGUF \\" >&2
        echo "    qwen2.5-coder-3b-instruct-q4_k_m.gguf --local-dir \"$MODEL_DIR\"" >&2
        return 1
      fi
      ;;
  esac
  PROFILE="$p"
  case "$PROFILE" in
    qwen)
      MODEL="${PIXIE_LLM_MODEL:-$MODEL_DIR/qwen3-4b-instruct-q4_k_m.gguf}"
      if [[ ! -f "$MODEL" ]]; then
        MODEL="$MODEL_DIR/qwen2.5-3b-instruct-q4_k_m.gguf"
      fi
      if [[ ! -f "$MODEL" ]]; then
        MODEL="$(compgen -G "$MODEL_DIR/qwen*coder*.gguf" | head -1)"
      fi
      PORT="${PIXIE_LLM_PORT:-8080}"
      CTX="${PIXIE_LLM_CTX:-4096}"
      ALIAS="${PIXIE_LLM_ALIAS:-qwen}"
      THREADS="${PIXIE_LLM_THREADS:-$THREADS_DEFAULT}"
      ;;
    kur)
      MODEL="${KUR_LLM_MODEL:-$MODEL_DIR/smollm2-360m-instruct-q4_k_m.gguf}"
      PORT="${KUR_LLM_PORT:-8081}"
      CTX="${KUR_LLM_CTX:-1024}"
      ALIAS="${KUR_LLM_ALIAS:-kur}"
      # tiny model: all cores OK for snappy haiku
      THREADS="${KUR_LLM_THREADS:-$_NPROC}"
      ;;
    imp)
      # Imp's art generator — a Qwen2.5 Coder on its own port so it never
      # fights Pixie (8080) or the comment dragon (8081). Default to any
      # coder GGUF already present, else the conventional coder filename.
      MODEL=""
      if [[ -n "${IMP_LLM_MODEL:-}" ]]; then
        MODEL="$IMP_LLM_MODEL"
      else
        for f in "$MODEL_DIR"/qwen*coder*.gguf "$MODEL_DIR"/*coder*.gguf; do
          if [[ -f "$f" ]]; then MODEL="$f"; break; fi
        done
      fi
      if [[ -z "$MODEL" ]]; then
        MODEL="$MODEL_DIR/qwen2.5-coder-3b-instruct-q4_k_m.gguf"
      fi
      PORT="${IMP_LLM_PORT:-8082}"
      CTX="${IMP_LLM_CTX:-4096}"
      ALIAS="${IMP_LLM_ALIAS:-imp}"
      THREADS="${IMP_LLM_THREADS:-$THREADS_DEFAULT}"
      ;;
    *)
      echo "unknown profile: $p  (qwen|kur|imp|default)" >&2
      return 1
      ;;
  esac
  PID_FILE="$CACHE_DIR/llama-server.${PROFILE}.pid"
  LOG_FILE="$CACHE_DIR/llama-server.${PROFILE}.log"
  URL="http://${HOST}:${PORT}"
}

find_server() {
  if [[ -n "${PIXIE_LLAMA_SERVER:-}" && -x "${PIXIE_LLAMA_SERVER}" ]]; then
    echo "$PIXIE_LLAMA_SERVER"
    return
  fi
  if [[ -x "$HOME/bin/llama-server" ]]; then
    echo "$HOME/bin/llama-server"
    return
  fi
  if command -v llama-server >/dev/null 2>&1; then
    command -v llama-server
    return
  fi
  for p in \
    "$HOME/.local/lib/pixie/llama-server" \
    /usr/bin/llama-server \
    /usr/local/bin/llama-server
  do
    if [[ -x "$p" ]]; then
      echo "$p"
      return
    fi
  done
  return 1
}

is_running() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  fi
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | grep -qE ":${PORT}\\b" && return 0
  fi
  return 1
}

health() {
  curl -fsS --max-time 2 "${URL}/health" >/dev/null 2>&1 \
    || curl -fsS --max-time 2 "${URL}/v1/models" >/dev/null 2>&1
}

is_asleep() {
  # llama-server returns 503 on /health while the model is unloaded (sleeping)
  local code
  code=$(curl -sS --max-time 2 -o /dev/null -w '%{http_code}' "${URL}/health" 2>/dev/null || true)
  [[ "$code" == "503" ]]
}

cmd_status() {
  local srv
  srv=$(find_server 2>/dev/null || echo "(llama-server not found)")
  echo "profile:  $PROFILE"
  echo "backend:  llama.cpp (offline)"
  echo "server:   $srv"
  echo "model:    $MODEL"
  echo "listen:   ${HOST}:${PORT}  (localhost only)"
  echo "url:      $URL"
  echo "ctx/thr:  $CTX / $THREADS"
  echo "sleep:    ${SLEEP_IDLE}s idle → unloads model from RAM (-1 = keep loaded)"
  if is_running && health; then
    echo "status:   running"
    [[ -f "$PID_FILE" ]] && echo "pid:      $(cat "$PID_FILE")"
    return 0
  elif is_running && is_asleep; then
    echo "status:   running but asleep (model unloaded, RAM freed)"
    echo "          next request reloads it (~20s) — server never needs a manual start"
    [[ -f "$PID_FILE" ]] && echo "pid:      $(cat "$PID_FILE")"
    return 0
  elif is_running; then
    echo "status:   process up, API not ready yet (loading model?)"
    return 1
  else
    echo "status:   stopped"
    return 1
  fi
}

cmd_status_all() {
  local p rc=0
  for p in qwen kur imp; do
    echo "── $p ──"
    resolve_profile "$p"
    cmd_status || true
    echo
  done
}

cmd_start() {
  if is_running && health; then
    echo "menagerie [$PROFILE] already running at $URL"
    return 0
  fi
  # if something else holds the port, stop our profile's pid first
  if is_running; then
    cmd_stop >/dev/null || true
  fi
  local srv
  if ! srv=$(find_server); then
    echo "error: llama-server not found." >&2
    return 1
  fi
  if [[ ! -e "$MODEL" ]]; then
    echo "error: model not found: $MODEL" >&2
    echo "  expected under $MODEL_DIR" >&2
    ls -lh "$MODEL_DIR" 2>/dev/null || true
    return 1
  fi

  local model_path
  model_path=$(readlink -f "$MODEL" 2>/dev/null || echo "$MODEL")

  echo "starting llama.cpp [$PROFILE] on ${HOST}:${PORT} …"
  echo "  model: $model_path"
  echo "  ctx=$CTX threads=$THREADS alias=$ALIAS"
  nohup "$srv" \
    -m "$MODEL" \
    --host "$HOST" \
    --port "$PORT" \
    -c "$CTX" \
    -t "$THREADS" \
    -ngl "$NGL" \
    --alias "$ALIAS" \
    --sleep-idle-seconds "$SLEEP_IDLE" \
    --jinja \
    --chat-template gemma2 \
    >"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"

  local i
  for i in $(seq 1 90); do
    if health; then
      echo "ready: $URL  (pid $(cat "$PID_FILE"))  [$PROFILE]"
      echo "logs:  $LOG_FILE"
      return 0
    fi
    if [[ -f "$PID_FILE" ]] && ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "error: llama-server exited while loading. Last log lines:" >&2
      tail -30 "$LOG_FILE" >&2 || true
      rm -f "$PID_FILE"
      return 1
    fi
    sleep 1
  done
  echo "error: timeout waiting for API. See $LOG_FILE" >&2
  return 1
}

cmd_stop() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid=$(cat "$PID_FILE")
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      sleep 0.4
      kill -9 "$pid" 2>/dev/null || true
      echo "stopped [$PROFILE] pid $pid"
    fi
    rm -f "$PID_FILE"
  fi
  if command -v fuser >/dev/null 2>&1; then
    fuser -k "${PORT}/tcp" 2>/dev/null || true
  fi
  echo "menagerie [$PROFILE] stopped"
}

cmd_stop_all() {
  local p
  for p in qwen kur imp; do
    resolve_profile "$p"
    cmd_stop 2>/dev/null || true
  done
  # legacy single pid file
  if [[ -f "$CACHE_DIR/llama-server.pid" ]]; then
    local pid
    pid=$(cat "$CACHE_DIR/llama-server.pid" 2>/dev/null || true)
    [[ -n "${pid:-}" ]] && kill "$pid" 2>/dev/null || true
    rm -f "$CACHE_DIR/llama-server.pid"
  fi
}

cmd_chat() {
  local prompt="${*:-hello}"
  if ! health; then
    echo "server not up — try: menagerie start $PROFILE" >&2
    return 1
  fi
  curl -fsS --max-time 300 "${URL}/v1/chat/completions" \
    -H 'Content-Type: application/json' \
    -d "$(python3 -c "
import json,sys
print(json.dumps({
  'model': sys.argv[2],
  'messages': [{'role':'user','content': sys.argv[1]}],
  'temperature': 0.2,
  'max_tokens': 256,
  'stream': False,
}))
" "$prompt" "$ALIAS")" \
  | python3 -c "
import json,sys
d=json.load(sys.stdin)
print((d.get('choices') or [{}])[0].get('message',{}).get('content','') or d)
"
}

cmd_path() {
  echo "PROFILE=$PROFILE"
  echo "MODEL=$MODEL"
  echo "URL=$URL"
  echo "LOG=$LOG_FILE"
  echo "PID=$PID_FILE"
  find_server || true
}

cmd_models() {
  echo "models in $MODEL_DIR:"
  ls -lh "$MODEL_DIR"/*.gguf 2>/dev/null || echo "  (none)"
}

# ── argv ──────────────────────────────────────────────────────────────
cmd="${1:-status}"
shift || true

# commands that take optional profile as first remaining arg
case "$cmd" in
  start|stop|restart|status|logs|chat|path)
    prof=default
    if [[ "${1:-}" =~ ^(qwen|kur|imp|default|pixie|all)$ ]]; then
      prof="$1"
      shift || true
    fi
    if [[ "$cmd" == "status" && "$prof" == "all" ]]; then
      cmd_status_all
      exit 0
    fi
    if [[ "$cmd" == "stop" && "$prof" == "all" ]]; then
      cmd_stop_all
      exit 0
    fi
    resolve_profile "$prof"
    case "$cmd" in
      start)   cmd_start ;;
      stop)    cmd_stop ;;
      restart) cmd_stop; cmd_start ;;
      status)  cmd_status ;;
      logs)    tail -n "${1:-80}" "$LOG_FILE" 2>/dev/null || echo "(no log yet)" ;;
      chat)    cmd_chat "$@" ;;
      path)    cmd_path ;;
    esac
    ;;
  models|ls)
    cmd_models
    ;;
  -h|--help|help)
    cat <<'H'
menagerie — offline llama.cpp profiles

  menagerie start [qwen|kur|imp]         start a profile (default: qwen if present)
  menagerie stop  [qwen|kur|imp|all]
  menagerie status [profile|all]
  menagerie restart [profile]
  menagerie chat [profile] "hello"
  menagerie models

Ports:  qwen → 8080    kur → 8081    imp → 8082
Idle RAM: models unload after PIXIE_LLM_SLEEP_IDLE seconds of inactivity
          (default 300; set 0 to keep the model loaded, like before)
H
    ;;
  *)
    echo "Usage: menagerie {start|stop|restart|status|logs|chat|path|models}" >&2
    exit 1
    ;;
esac
