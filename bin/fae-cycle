#!/usr/bin/env bash
# fae-cycle — window cycling for the house, with visible proof.
# Usage: fae-cycle [next|prev]   (alias: fae-tab; FAE_CYCLE_QUIET=1 = quiet)
# Cycling is xprop + i3-msg. The cue is a themed toast typed into the kitty
# window you arrived in (kitty remote control is per-socket, so only sockets
# that exist can carry it), plus a pink confirmation on stderr.
# No resident process, no bar, no overlay window: nothing to keep alive.
set -euo pipefail
dir="${1:-next}"
D="${DISPLAY:-:0}"

# ── audit log ─────────────────────────────────────────────────────────────
# i3 runs `exec` with stderr inherited from i3 itself, and i3's stderr is
# /dev/tty1 (measured: /proc/<i3-pid>/fd/2 -> /dev/tty1). So the stderr cue
# at the bottom of this file prints to a virtual console nobody is looking
# at — it has been invisible since the day it was written. This log is how we
# tell "the binding never fired" apart from "it fired and you could not see
# it", which are otherwise indistinguishable from the outside.
LOG="${FAE_CYCLE_LOG:-${XDG_RUNTIME_DIR:-/tmp}/fae-cycle.log}"
faelog() { printf '%s pid=%s %s\n' "$(date +%T)" "$$" "$*" >>"$LOG" 2>/dev/null || true; }
faelog "start dir=$dir DISPLAY=$D"

# ── find focused + collect windows ─────────────────────────────────────────
ids=$(DISPLAY="$D" xprop -root _NET_CLIENT_LIST 2>/dev/null | sed 's/.*# //' | tr ', ' '\n\n' | grep -E '^0x[0-9a-fA-F]+$') \
  || { faelog "giveup: no _NET_CLIENT_LIST"; exit 0; }
[ -n "$ids" ] || { faelog "giveup: client list empty"; exit 0; }
faelog "windows=$(echo "$ids" | wc -w)"
focused=""
for w in $ids; do
  if DISPLAY="$D" xprop -id "$w" _NET_WM_STATE 2>/dev/null | grep -q "_NET_WM_STATE_FOCUSED"; then
    focused="$w"; break
  fi
done
if [ -z "$focused" ]; then
  focused=$(DISPLAY="$D" i3-msg -t get_tree 2>/dev/null | python3 -c "
import json,sys
try: t=json.load(sys.stdin)
except Exception: raise SystemExit
best=None
def walk(n):
    global best
    if n.get('focused') and n.get('window'): best=n['window']; return True
    for c in n.get('nodes',[])+n.get('floating_nodes',[]):
        if walk(c): return True
walk(t); print(best or '')" 2>/dev/null || true)
fi
[ -n "$focused" ] || { echo "fae-cycle: no focused window" >&2; exit 1; }

list=($ids)
n=${#list[@]}
i=0
for ((k=0;k<n;k++)); do [ "${list[$k]}" = "$focused" ] && { i=$k; break; }; done
step=1; [ "$dir" = "prev" ] && step=-1
j=$(( (i + step + n) % n ))
target=${list[$j]}

# ── window → i3 con id (and reveal scratchpad) ───────────────────────────
tree() { DISPLAY="$D" i3-msg -t get_tree 2>/dev/null; }
con=$(tree | python3 -c "
import json,sys
try: t=json.load(sys.stdin)
except Exception: raise SystemExit
want=int('$target',16); found=None
def walk(n):
    global found
    if n.get('window')==want: found=n['id']; return True
    for c in n.get('nodes',[])+n.get('floating_nodes',[]):
        if walk(c): return True
walk(t); print(found or '')" 2>/dev/null) || con=""
if [ -z "$con" ]; then
  state=$(tree | python3 -c "
import json,sys
try: t=json.load(sys.stdin)
except Exception: raise SystemExit
want=int('$target',16); out='none'
def walk(n):
    global out
    if n.get('window')==want: out=n.get('scratchpad_state','none'); return True
    for c in n.get('nodes',[])+n.get('floating_nodes',[]):
        if walk(c): return True
walk(t); print(out)" 2>/dev/null) || state=""
  case "$state" in
    fresh|hidden) DISPLAY="$D" i3-msg "[window=$((target))] scratchpad show" >/dev/null 2>&1
      con=$(tree | python3 -c "
import json,sys
try: t=json.load(sys.stdin)
except Exception: raise SystemExit
want=int('$target',16); found=None
def walk(n):
    global found
    if n.get('window')==want: found=n['id']; return True
    for c in n.get('nodes',[])+n.get('floating_nodes',[]):
        if walk(c): return True
walk(t); print(found or '')" 2>/dev/null) || con="" ;;
  esac
fi
[ -n "$con" ] || { faelog "FAIL: cannot focus target=$target"; echo "fae-cycle: cannot focus $target" >&2; exit 1; }
CON="$con"
DISPLAY="$D" i3-msg "[con_id=$con] focus" >/dev/null
faelog "focused con=$con target=$target"

# ── cue 1: name the window for the toast ────────────────────────────────
# Guarded: with `set -euo pipefail`, a pipeline where ANY stage fails aborts
# the whole script with no message. xprop exits non-zero on a window that has
# been destroyed since we listed it, which is exactly what happens when you
# cycle quickly and a client exits. The symptom was Alt+Tab doing nothing at
# all, silently, rc=1, with no output anywhere a human could see.
name=$(DISPLAY="$D" xprop -id "$target" WM_NAME 2>/dev/null | sed 's/.*= //; s/^"//; s/"$//' | cut -c1-28) || name=""
[ -n "$name" ] || name="window"
# The toast is PLAIN ASCII on purpose. `send-key` types real key events into
# the window, and the shell would then try to *run* them; colour escapes arrive
# as literal junk (it once complained about `8`, `5`, `175m|m`). So no colour
# here: the house prompt frame is already on screen, and the text only says
# where the cycle landed.

# ── cue: the toast, in the window you arrived in. Kitty remote control is
# per-socket, so only sockets that exist can carry it.
# Cue. What was measured, and what it killed:
#   1) a 1px i3 border is invisible under most client chrome — killed: border.
#   2) i3 will not repaint a runtime client.focused colour change — killed:
#      runtime i3-msg colour flip.
#   3) i3 owns the root window, so xsetroot/feh repaints never reach the
#      screen — killed: root repaint.
#   4) a throwaway fullscreen kitty paints over everything, but it takes focus
#      and leaks windows if it dies early — killed: overlay window.
# The only remaining painting surface that covers every client without a window
# is the X root as the compositor sees it, which we do not own. So the cue is
# honest and cheap: the terminal toast (kitty sockets that exist) plus a pink
# confirmation on stderr. No flash, no lie. If you want a screen-wide flash, the
# right place to build it is our own compositor (picom fork) — not this script.
PULSE_LILAC="#d4b4e8"
TOAST_LEN=46

if [ "${FAE_CYCLE_QUIET:-0}" != "1" ]; then
  # ── the cue: fae-hud, a themed panel listing every window ────────────────
  # This is the part you can actually see. i3 gives us stderr on /dev/tty1, so
  # anything printed there is invisible, and a kitty toast is easy to miss if
  # you are looking at the window you just left. The panel is a short-lived
  # process (paint, hold, fade, exit) — no resident daemon, per the house rule
  # that came out of the i3bar incident.
  #
  # It is told which window to highlight rather than being asked to work it
  # out, and it reads the rest of the list itself over EWMH. It is strictly a
  # viewer: it never focuses, kills, moves or resizes anything.
  FAE_HUD="${FAE_HUD:-$HOME/bin/fae-hud}"
  if [ -x "$FAE_HUD" ]; then
    ( "$FAE_HUD" --focus="$target" >/dev/null 2>&1 & ) || true
  fi

  # Kitty appends its pid to a listen_on name — abstract sockets become
  # @faeos-kitty-2172 (measured in /proc/net/unix). Three ids have to agree
  # before a keystroke can be targeted, and they are NOT the same number:
  #   socket  @faeos-kitty-<X11 pid>
  #   X11     $target (_NET_WM_PID)
  #   kitty   its own window id from `kitty @ ls` (1, 2, 3 …)
  # `send-key --match id:` wants the third one. So: pid -> socket -> kitty id.
  # No trailing newline, so the text lands on the prompt line, unexecuted.
  toasted=0
  flashed=0
  tpid=$(DISPLAY="$D" xprop -id "$target" _NET_WM_PID 2>/dev/null | grep -oE '[0-9]+$') || tpid=""
  if [ -n "$tpid" ]; then
    kid=$(kitty @ --to "unix:@faeos-kitty-$tpid" ls 2>/dev/null | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: raise SystemExit
best=None
for w in d:
    for t in w.get('tabs',[]):
        for win in t.get('windows',[]):
            if win.get('is_focused'): best=win['id']
if best is None:
    for w in d:
        for t in w.get('tabs',[]):
            if t.get('is_active'):
                for win in t.get('windows',[]): best=win['id']
print(best or '')" 2>/dev/null) || kid=""
    if [ -n "$kid" ]; then
      # `if` rather than `&&`: with `set -e`, a `cmd && var=1` list that FAILS
      # aborts the whole script. Cycling to any non-kitty window (the red-view
      # console, say) means there is no @faeos-kitty-<pid> socket at all, so
      # `kitty @` exits non-zero — and the script died right there, silently,
      # rc=1, after focus had already moved. That is precisely the "Alt+Tab
      # works but nothing tells me anything" behaviour. The HUD above has
      # already painted by this point, which is why it is spawned first.
      if kitty @ --to "unix:@faeos-kitty-$tpid" send-key --match "id:$kid" \
           lbracket space f a e c y c l e colon space ${dir} space minus greater space \
           "${name// /space}" space rbracket >/dev/null 2>&1; then
        toasted=1
      fi
      # ── the visible cue ──────────────────────────────────────────────────
      # The stderr line below is USELESS on this machine: i3 runs `exec` with
      # stderr inherited from i3, and i3's fd 2 is /dev/tty1 (measured). So the
      # pink confirmation has been printing to a virtual console nobody is
      # watching, and the toast alone is easy to miss. `set-tab-color` is the
      # one painting surface kitty actually owns: it tints the tab bar of the
      # window you land in. Verified working on kitty 0.48.2 (there is no
      # `set-tint` in this build). Reverted by a short-lived background sleep,
      # not a resident daemon — nothing to keep alive, nothing to leak errors.
      if [ "${FAE_CYCLE_FLASH:-1}" = "1" ]; then
        PINK_BG="#ff2d55"; PINK_FG="#ffe3ee"
        if kitty @ --to "unix:@faeos-kitty-$tpid" set-tab-color \
             --match "window_id:$kid" "active_bg=$PINK_BG" "active_fg=$PINK_FG" \
             >/dev/null 2>&1; then
          flashed=1
          ( sleep 0.9
            kitty @ --to "unix:@faeos-kitty-$tpid" set-tab-color \
              --match "window_id:$kid" active_bg=NONE active_fg=NONE \
              >/dev/null 2>&1 || true ) &
        fi
      fi
    fi
  fi
  faelog "ok dir=$dir target=$target con=$con name='$name' toasted=$toasted flashed=${flashed:-0}"
  cat >&2 <<MSG
fae-cycle: ${dir} → '${name}'
fae-cycle:   hint: Alt+Tab again, Alt+Shift+Tab to go back${toasted:+ · toasted}${flashed:+ · tab flashed}
MSG
fi
exit 0
