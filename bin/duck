#!/usr/bin/env python3
"""duck — privacy-first terminal search via DuckDuckGo (ddgr).

  duck arch linux              # fast: titles + snippets (no URLs)
  duck -a ufw tutorial         # fetch top pages, then ONE AI summary
  duck --tor query             # DDG via Tor
  duck --any query             # opt-in non-DDG fallbacks if DDG fails

Design:
  - Default is fast (ddgr only).
  - -a deepens top results (page text) once, then one local AI pass at the end.
  - Never print URLs in normal output (privacy/UX).
"""
from __future__ import annotations

import argparse
from pathlib import Path
import html as html_lib
import json
import os
import random
import re
import shutil
import subprocess
import sys
import urllib.parse
import urllib.request
from html.parser import HTMLParser
from xml.etree import ElementTree as ET

LLAMA = os.environ.get("PIXIE_LLM_URL", "http://127.0.0.1:8080").rstrip("/")
MODEL = os.environ.get("ASK_MODEL", os.environ.get("ASK_WEB_MODEL", "mistral"))
UA = "duck/3.0 (terminal search; +https://github.com/jarun/ddgr)"

# Rotated while Mistral runs (same spirit as pixie/ask)
