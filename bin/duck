    "Pixie is listening to the machine spirits…",
    "Pixie is braiding a reply out of moonlight…",
    "Hold still — Pixie is concentrating…",
    "Pixie wandered into /tmp and got distracted…",
    "Pixie is counting sparkles in the cache…",
    "Pixie is negotiating with the kernel gnomes…",
    "Pixie is untangling a knot of pointers…",
    "Pixie is whispering to the inode fairies…",
    "Pixie is polishing her answer with starlight…",
    "Pixie is peeking under the root of the problem…",
    "Pixie is sipping tea from a thimble of RAM…",
    "Pixie is mapping the lay of the home directory…",
    "Pixie is asking the pipes which way is north…",
    "Pixie is humming a little compile song…",
    "Pixie is sorting wishes by priority…",
    "Pixie is chasing a runaway null…",
    "Pixie is rolling up her sleeves (figuratively)…",
    "Pixie is consulting the ancient man pages…",
    "Pixie is balancing on a stack frame…",
    "Pixie is bribing the scheduler with cookies…",
    "Pixie is drawing a tiny map of your request…",
    "Pixie is waiting for the moon to align with /dev…",
    "Pixie is shaking the magic 8-bit ball…",
    "Pixie is retying her boots for another try…",
    "Pixie is listening for the click of a good idea…",
    "Pixie is sweeping cobwebs out of the heap…",
)
# How many top hits to open when -a / --deep
DEEP_DEFAULT = 3
DEEP_MAX = 5
PAGE_CHARS = 2500
FETCH_TIMEOUT = 8

def _detect_color() -> bool:
    """Enable color on real terminals; 256-color codes (widely supported)."""
    # explicit on wins (our zshrc sets FORCE_COLOR)
    if os.environ.get("FORCE_COLOR") or os.environ.get("CLICOLOR_FORCE"):
        return True
    if os.environ.get("DUCK_COLOR", "").lower() in ("1", "always", "yes", "on"):
        return True
    # explicit off
    if os.environ.get("NO_COLOR", "").strip() != "":
        return False
    if os.environ.get("DUCK_COLOR", "").lower() in ("0", "never", "no", "off"):
        return False
    # default: color on any interactive tty
    if sys.stdout.isatty() or sys.stderr.isatty():
        return True
    return False


_USE_COLOR = _detect_color()


class C:
    """ANSI helpers — 256-color pink palette (works without truecolor)."""

    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    # 256-color (reliable on xterm, linux console, most emulators)
    PINK = "\033[38;5;175m"        # soft pink
    DARK_PINK = "\033[38;5;168m"
    PINK_DIM = "\033[38;5;132m"
    BLUSH = "\033[38;5;218m"
    SILVER = "\033[38;5;252m"
    SILVER_DIM = "\033[38;5;245m"
    DANGER = "\033[38;5;197m"      # bright red-pink
    WARN = "\033[38;5;214m"        # amber
    OK = "\033[38;5;78m"           # green
    INV_BG = "\033[48;5;52m"       # dark red bg
    INV_FG = "\033[38;5;224m"
    ROSE = DANGER
    GREEN = OK

    @staticmethod
    def paint(text: str, *codes: str) -> str:
        if not _USE_COLOR or not codes:
            return text
        return "".join(codes) + text + C.RESET

    @staticmethod
    def danger_banner(msg: str) -> str:
        if not _USE_COLOR:
            return f"!! {msg}"
        return C.INV_BG + C.BOLD + C.DANGER + " ⚠ " + msg + " " + C.RESET


def eprint(*a, **k):
    print(*a, file=sys.stderr, **k)


def term_width(default: int = 72) -> int:
    try:
        return max(40, min(shutil.get_terminal_size((default, 24)).columns, 100))
    except Exception:
        return default


def box(title: str, body: str, *, accent: str = C.PINK, width: int | None = None) -> str:
    """Unicode box around multiline body."""
    w = width or term_width()
    inner = max(20, w - 4)
    # title may be colored; measure plain length for padding
    plain_title = re.sub(r"\033\[[0-9;]*m", "", title)
    title_disp = plain_title[: inner - 2]
    # top: ┌─ title ────┐
    pad = inner - len(title_disp) - 2
    if pad < 0:
        pad = 0
    top = (
        C.paint("┌─", accent)
        + C.paint(f" {title_disp} ", C.BOLD, accent)
        + C.paint("─" * pad + "┐", accent)
    )
    mid_lines = []
    for raw in body.splitlines() or [""]:
        plain = re.sub(r"\033\[[0-9;]*m", "", raw)
        # preserve left indent on wrap
        indent_m = re.match(r"^(\s*)", plain)
        indent = indent_m.group(1) if indent_m else ""
        content = plain[len(indent) :]
        if len(plain) <= inner:
            chunks_plain = [plain]
        else:
            chunks_plain = []
            words = content.split(" ")
            cur = ""
            max_c = inner - len(indent)
            for word in words:
                trial = (cur + " " + word).strip() if cur else word
                if len(trial) <= max_c:
                    cur = trial
                else:
                    if cur:
                        chunks_plain.append(indent + cur)
                    cur = word
            if cur:
                chunks_plain.append(indent + cur)
        for ch_plain in chunks_plain:
            # re-color: if original had ANSI and single chunk, keep raw
            if len(chunks_plain) == 1 and "\033" in raw:
                ch = raw
                p = plain
            else:
                ch = ch_plain
                p = ch_plain
            space = max(0, inner - len(p))
            mid_lines.append(
                C.paint("│", accent)
                + " "
                + ch
                + (" " * space)
                + " "
                + C.paint("│", accent)
            )
    bot = C.paint("└" + "─" * (inner + 2) + "┘", accent)
    return "\n".join([top, *mid_lines, bot])


def require_ddgr() -> str:
    path = shutil.which("ddgr")
    if not path:
        eprint("error: ddgr not installed. Run: sudo pacman -S ddgr")
        sys.exit(1)
    return path


def strip_urls(text: str) -> str:
    text = re.sub(r"https?://\S+", "", text)
    text = re.sub(r"www\.\S+", "", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def run_ddgr(query: str, n: int = 8, tor: bool = False) -> tuple[list[dict], str]:
    ddgr = require_ddgr()
    cmd = [ddgr, "-n", str(n), "--np", "--json", "-C", "--expand", query]
    env = os.environ.copy()
    env["DDGR_COLORS"] = ""
    if tor:
        if not shutil.which("torsocks"):
            return [], "torsocks not installed (sudo pacman -S torsocks)"
        cmd = ["torsocks", "--isolate"] + cmd
    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=45 if not tor else 90,
            env=env,
        )
    except subprocess.TimeoutExpired:
        return [], "DuckDuckGo timed out" + (" (via Tor)" if tor else "")
    except FileNotFoundError as e:
        return [], str(e)

    out = (proc.stdout or "").strip()
    err = (proc.stderr or "").strip()
    if not out:
        hint = (
            " Is tor running? systemctl status tor"
            if tor
            else " Try: duck --tor <query>"
        )
        msg = "No DuckDuckGo results."
        if proc.returncode:
            msg += f" ddgr exit={proc.returncode}."
        if err:
            msg += f" {err[:200]}"
        return [], msg + hint

    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        return [
            {"title": line, "url": "", "abstract": "", "body": ""}
            for line in out.splitlines()
            if line.strip()
        ], ""

    if isinstance(data, dict):
        data = data.get("results") or data.get("items") or []
    if not isinstance(data, list):
        return [], "Unexpected ddgr JSON shape"

    results = []
    for item in data:
        if not isinstance(item, dict):
            continue
        results.append(
            {
                "title": item.get("title") or item.get("t") or "",
                "url": item.get("url") or item.get("u") or "",
                "abstract": item.get("abstract")
                or item.get("a")
                or item.get("snippet")
                or "",
                "body": "",
            }
        )
    if not results:
        return [], "DuckDuckGo returned empty result list."
    return results, ""


def format_results(results: list[dict], source: str, show_body: bool = False) -> str:
    """Titles + snippets (no URLs), colored + boxed."""
    lines: list[str] = []
    for i, r in enumerate(results, 1):
        title = strip_urls((r.get("title") or "(no title)").strip())
        ab = strip_urls((r.get("abstract") or "").strip())
        body = strip_urls((r.get("body") or "").strip())
        num = C.paint(f"{i}.", C.BOLD, C.PINK)
        ttl = C.paint(title, C.BOLD, C.SILVER)
        lines.append(f"{num} {ttl}")
        if ab and ab.lower() != title.lower():
            snip = ab[:350] + ("…" if len(ab) > 350 else "")
            lines.append(C.paint(f"   {snip}", C.SILVER_DIM))
        elif not ab:
            lines.append(C.paint("   (no snippet)", C.DIM))
        if show_body and body:
            excerpt = body[:420]
            if len(body) > 420:
                excerpt = excerpt.rsplit(" ", 1)[0] + "…"
            lines.append(C.paint("   · ", C.PINK_DIM) + C.paint(excerpt, C.SILVER_DIM))
        lines.append("")  # gap between hits
    body = "\n".join(lines).rstrip()
    title = f"duck · {source}"
    return box(title, body, accent=C.PINK_DIM)


# ── page fetch / text extract ────────────────────────────────────────────────

class _TextExtractor(HTMLParser):
    SKIP = {"script", "style", "noscript", "svg", "nav", "footer", "header"}

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self._skip = 0
        self.parts: list[str] = []

    def handle_starttag(self, tag, attrs):
        if tag.lower() in self.SKIP:
            self._skip += 1

    def handle_endtag(self, tag):
        if tag.lower() in self.SKIP and self._skip:
            self._skip -= 1

    def handle_data(self, data):
        if self._skip:
            return
        t = data.strip()
        if t:
            self.parts.append(t)


def html_to_text(raw: bytes) -> str:
    try:
        s = raw.decode("utf-8")
    except UnicodeDecodeError:
        s = raw.decode("latin-1", "replace")
    # drop obvious junk
    s = re.sub(r"(?is)<(script|style|noscript).*?>.*?</\1>", " ", s)
    p = _TextExtractor()
    try:
        p.feed(s)
        p.close()
    except Exception:
        return strip_urls(re.sub(r"<[^>]+>", " ", s))
    text = " ".join(p.parts)
    text = html_lib.unescape(text)
    text = re.sub(r"\s+", " ", text).strip()
    return strip_urls(text)


def fetch_url(url: str, timeout: float = FETCH_TIMEOUT, tor: bool = False) -> bytes | None:
    if not url or not url.startswith("http"):
        return None
    try:
        if tor and shutil.which("torsocks"):
            proc = subprocess.run(
                [
                    "torsocks",
                    "--isolate",
                    "curl",
                    "-fsSL",
                    "-A",
                    UA,
                    "--max-time",
                    str(int(timeout)),
                    url,
                ],
                capture_output=True,
                timeout=timeout + 5,
            )
            if proc.returncode == 0 and proc.stdout:
                return proc.stdout
            return None
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            # cap download size
            return r.read(800_000)
    except Exception as e:
        eprint(f"[deep skip] {urllib.parse.urlparse(url).netloc}: {e}")
        return None


def deepen_results(
    results: list[dict], k: int = DEEP_DEFAULT, tor: bool = False
) -> list[dict]:
    """Fetch top-k pages and attach body text for better AI context."""
    k = max(1, min(k, DEEP_MAX, len(results)))
    eprint(f"Deepening top {k} result(s) (page text for AI + you)…")
    for i in range(k):
        url = (results[i].get("url") or "").strip()
        if not url:
            continue
        eprint(f"  [{i+1}/{k}] fetching…")
        raw = fetch_url(url, tor=tor)
        if not raw:
            continue
        text = html_to_text(raw)
        if len(text) < 80:
            continue
        results[i]["body"] = text[:PAGE_CHARS]
    return results


def context_for_ai(results: list[dict], query: str) -> str:
    """Build one rich block for a single AI call (no URLs)."""
    chunks = [f"User query: {query}", ""]
    for i, r in enumerate(results, 1):
        title = strip_urls(r.get("title") or "")
        ab = strip_urls(r.get("abstract") or "")
        body = strip_urls(r.get("body") or "")
        chunks.append(f"### Result {i}: {title}")
        if ab:
            chunks.append(f"Snippet: {ab}")
        if body:
            chunks.append(f"Page extract: {body[:PAGE_CHARS]}")
        chunks.append("")
    return "\n".join(chunks)[:14000]


def fetch(url: str, timeout: float = 8) -> bytes | None:
    return fetch_url(url, timeout=timeout, tor=False)


def fallback_any(query: str) -> str:
    blocks: list[str] = []
    oq = urllib.parse.quote(query)
    raw = fetch(
        f"https://en.wikipedia.org/w/api.php?action=opensearch&search={oq}&limit=2&format=json"
    )
    if raw:
        try:
            data = json.loads(raw.decode())
            titles = data[1] if len(data) > 1 else []
            for title in titles[:2]:
                tq = urllib.parse.quote(title.replace(" ", "_"))
                sraw = fetch(f"https://en.wikipedia.org/api/rest_v1/page/summary/{tq}")
                if not sraw:
                    continue
                s = json.loads(sraw.decode())
                extract = (s.get("extract") or "")[:350]
                if extract:
                    blocks.append(f"• [Wikipedia] {title}: {extract}")
        except Exception as e:
            eprint(f"[fallback skip] wikipedia: {e}")

    raw = fetch(
        "https://news.google.com/rss/search?"
        + urllib.parse.urlencode(
            {"q": query, "hl": "en-US", "gl": "US", "ceid": "US:en"}
        )
    )
    if raw:
        try:
            root = ET.fromstring(raw)
            news = []
            for it in root.findall(".//item")[:5]:
                t = (it.findtext("title") or "").strip()
                if t:
                    news.append(f"• {t}")
            if news:
                blocks.append(
                    "[News — Google News RSS, less private than DDG]\n" + "\n".join(news)
                )
        except Exception as e:
            eprint(f"[fallback skip] news: {e}")

    if not blocks:
        return "(No fallback results either.)"
    return "FALLBACKS (not DuckDuckGo — only because you passed --any)\n\n" + "\n\n".join(
        blocks
    )


def llm_up() -> bool:
    for path in ("/health", "/v1/models"):
        try:
            with urllib.request.urlopen(f"{LLAMA}{path}", timeout=1.5) as r:
                if r.status == 200:
                    return True
        except Exception:
            continue
    return False


def llm_generate(prompt: str) -> str:
    """One-shot generation via offline llama.cpp (localhost only)."""
    if not llm_up():
        raise RuntimeError("pixie-llm not running")
    body = {
        "model": MODEL,
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.25,
        "max_tokens": 350,
        "stream": False,
    }
    req = urllib.request.Request(
        f"{LLAMA}/v1/chat/completions",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=300) as r:
        data = json.loads(r.read().decode())
    choices = data.get("choices") or []
    if choices:
        return str((choices[0].get("message") or {}).get("content") or "")
    return ""


def ai_summary(query: str, context: str) -> str:
    """ONE model call: overall answer from deepened results — as Pixie."""
    prompt = (
        "You are Pixie: a cute, witty, helpful terminal companion (she/her).\n"
        "Using ONLY the search material below, answer the user.\n"
        "Voice rules:\n"
        "- ALWAYS open with a short Pixie line, e.g. "
        "\"Pixie thinks that…\", \"Pixie reckons…\", \"Hmm, Pixie would say…\", "
        "or \"Pixie peeked at the web and…\" (vary it; don't always use the same one).\n"
        "- Then give a clear, useful summary (short paragraphs or bullets).\n"
        "- Friendly and a little playful, never mean or overly long.\n"
        "- Prefer facts from page extracts over thin snippets.\n"
        "- No URLs, no domain names, no 'according to result 3'.\n"
        "- If material is thin or conflicting, say so in character "
        "(\"Pixie isn't sure, but…\").\n"
        "- Keep total under ~200 words.\n"
        "- Do NOT invent facts not in the material.\n\n"
        f"{context}\n"
    )
    import threading
    import time as _t

    stop = threading.Event()
    frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    state = {
        "i": 0,
        "label": random.choice(PIXIE_WAIT),
        "t0": _t.time(),
        "drawn": False,
    }
    lock = threading.Lock()
    BOX_H = 3

    def _box_lines():
        f = frames[state["i"] % len(frames)]
        plain = f"{f}  {state['label']}"
        inner = max(28, min(56, len(plain) + 2))
        title = "Pixie"
        pad = max(0, inner - len(title) - 2)
        top = (
            C.paint("┌─", C.PINK_DIM)
            + C.paint(f" {title} ", C.BOLD, C.PINK)
            + C.paint("─" * pad + "┐", C.PINK_DIM)
        )
        space = max(0, inner - len(plain))
        mid = (
            C.paint("│", C.PINK_DIM)
            + " "
            + C.paint(f, C.PINK)
            + "  "
            + C.paint(state["label"], C.BOLD, C.PINK)
            + (" " * space)
            + " "
            + C.paint("│", C.PINK_DIM)
        )
        bot = C.paint("└" + "─" * (inner + 2) + "┘", C.PINK_DIM)
        return [top, mid, bot]

    def _draw():
        with lock:
            lines = _box_lines()
            if state["drawn"]:
                eprint(f"\033[{BOX_H}A", end="")
            for line in lines:
                eprint(f"\r\033[K{line}")
            state["drawn"] = True

    def _erase():
        with lock:
            if not state["drawn"]:
                return
            eprint(f"\033[{BOX_H}A", end="")
            for _ in range(BOX_H):
                eprint("\r\033[K")
            eprint(f"\033[{BOX_H}A", end="")
            state["drawn"] = False

    def _anim():
        while not stop.wait(0.12):
            state["i"] += 1
            if _t.time() - state["t0"] >= 10:
                choices = [m for m in PIXIE_WAIT if m != state["label"]] or list(
                    PIXIE_WAIT
                )
                state["label"] = random.choice(choices)
                state["t0"] = _t.time()
            _draw()

    busy = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / f"pixie-busy.{os.getpid()}"
    try:
        busy.write_text(str(os.getpid()), encoding="utf-8")
    except OSError:
        busy = None
    thr = threading.Thread(target=_anim, daemon=True)
    thr.start()
    _draw()
    text = ""
    try:
        text = llm_generate(prompt)
    finally:
        stop.set()
        thr.join(timeout=0.5)
        _erase()
        if busy is not None:
            try:
                busy.unlink()
            except OSError:
                pass
    return (text or "").strip()


def main() -> int:
    ap = argparse.ArgumentParser(description="Privacy-first DuckDuckGo search")
    ap.add_argument("query", nargs="+", help="search terms")
    ap.add_argument(
        "-a",
        "--ai",
        action="store_true",
        help=f"deepen top pages + ONE local AI summary ({MODEL})",
    )
    ap.add_argument(
        "--deep",
        type=int,
        default=0,
        metavar="N",
        help=f"fetch top N pages for richer text (default with -a: {DEEP_DEFAULT})",
    )
    ap.add_argument("--tor", action="store_true", help="DDG + fetches via Tor")
    ap.add_argument(
        "--any",
        action="store_true",
        help="if DDG fails, opt-in wiki/news (labeled less private)",
    )
    ap.add_argument("-n", type=int, default=8, help="number of DDG results (default 8)")
    args = ap.parse_args()
    q = " ".join(args.query).strip()
    if not q:
        ap.error("empty query")

    mode = "tor" if args.tor else "clearnet"
    eprint(C.paint(f"◆ duck", C.BOLD, C.PINK) + C.paint(f"  {q}", C.SILVER) + C.paint(f"  ({mode})", C.SILVER_DIM))

    results, err = run_ddgr(q, n=max(1, min(args.n, 25)), tor=args.tor)
    text_parts: list[str] = []

    deep_n = args.deep
    if args.ai and deep_n <= 0:
        deep_n = DEEP_DEFAULT

    if results:
        if deep_n > 0:
            results = deepen_results(results, k=deep_n, tor=args.tor)
        human = format_results(results, mode, show_body=bool(deep_n))
        # plain context for AI (strip ANSI)
        text_parts.append(re.sub(r"\033\[[0-9;]*m", "", human))
        print(human)
    else:
        eprint(C.danger_banner("SEARCH FAILED"))
        eprint(C.paint("error: ", C.BOLD, C.DANGER) + (err or "unknown"))
        print(box("duck · offline", err or "DuckDuckGo unavailable", accent=C.DANGER))
        if not args.tor:
            eprint(C.paint("hint: ", C.WARN) + "duck --tor " + q)
        if args.any:
            eprint(C.paint("trying labeled non-DDG fallbacks…", C.WARN))
            fb = fallback_any(q)
            text_parts.append(fb)
            print("\n" + box("fallback · less private", fb, accent=C.WARN))
        else:
            eprint(C.paint("hint: ", C.WARN) + "duck --any … for opt-in non-DDG fallbacks")

    if args.ai:
        if not llm_up():
            eprint(
                C.paint(
                    "⚠ AI skip: no local LLM (try: pixie-llm start)",
                    C.BOLD,
                    C.WARN,
                )
            )
            return 0 if results else 1
        if results:
            ctx = context_for_ai(results, q)
        else:
            ctx = "\n\n".join(text_parts) or err or "(no material)"
        try:
            summary = ai_summary(q, ctx)
        except Exception as e:
            eprint(C.danger_banner("AI FAILED"))
            eprint(C.paint(str(e), C.DANGER))
            return 1
        print()
        print(box("Pixie · search notes", summary, accent=C.PINK))

    return 0 if results else 1


if __name__ == "__main__":
    raise SystemExit(main())
