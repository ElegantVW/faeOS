#!/usr/bin/env python3
"""ether — network paths & weaves for faeOS.

A single weave that answers to several names (multi-call):

  whisper ether   tune the ether to the ANC headphone (the quiet voice)
  listen  ether   tune the ether to the JBL Go 3 (the loud voice)
  ether           live TUI: bluetooth · wifi · lan (navigate · q to close)
  status ether    one-shot report: bt · wifi · lan at a glance

  ether net                    connectivity (IPv4/IPv6, archive.org probe)
  ether veil [on|off|status]   raise/lower the VPN veil  (alias: ether vpn)
  ether bridge                 phone-hotspot fallback (runs at boot via systemd)
  ether about                  help

Install as symlinks so each name reads as English:
  ln -s ether ~/bin/whisper  &&  ln -s ether ~/bin/listen  &&  ln -s ether ~/bin/status

Free media lives under Siren now:
  siren trove list 10 music lofi
"""
from __future__ import annotations

import argparse
import os
import pty
import re
import select
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path.home() / "bin"))
import pixie_termart as art  # noqa: E402

os.environ.setdefault("PIXIE_UNICODE", "1")
P = art.P

UA = "ether/1.2 (faeOS network tool; +https://archive.org)"

# The voices of the ether: verb -> (MAC, pipewire sink name)
WEAVES = {
    "whisper": ("8F:E4:19:50:23:F9", "ANC headphone"),
    "listen": ("70:99:1C:D0:40:E4", "JBL Go 3"),
}


def _bootstrap() -> None:
    """Make sure session bus + pipewire are reachable (tty sessions)."""
    uid = os.getuid()
    os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{uid}/bus")


# Phone hotspot weave (auto on boot via ether-bridge.service).
# NEVER hardcode Wi‑Fi secrets in the repo. Load from env or local config:
#   ~/.config/ether/netherweave.env   (chmod 600)
#   ETHER_NETHER_SSID=…  ETHER_NETHER_PSK=…  ETHER_NETHER_CON=…
def _load_nether_env() -> None:
    candidates = (
        Path.home() / ".config" / "ether" / "netherweave.env",
        Path.home() / ".config" / "pixie" / "netherweave.env",
    )
    for cfg in candidates:
        if not cfg.is_file():
            continue
        try:
            for line in cfg.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                k, v = k.strip(), v.strip().strip("'").strip('"')
                if k and k not in os.environ:
                    os.environ[k] = v
        except OSError:
            pass


_load_nether_env()
NETHER_SSID = os.environ.get("ETHER_NETHER_SSID", "").strip()
NETHER_PSK = os.environ.get("ETHER_NETHER_PSK", "").strip()
NETHER_CON = os.environ.get("ETHER_NETHER_CON", "").strip() or NETHER_SSID


def eprint(*a, **k) -> None:
    print(*a, file=sys.stderr, **k)


def _nmcli(args: list[str], *, timeout: float = 60) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["nmcli", *args],
        text=True,
        capture_output=True,
        timeout=timeout,
        check=False,
    )


def banner(title: str, label: str) -> None:
    print()
    print(art.box([], title="Ether ✦", subtitle=label + "  ·  " + title, width=art.term_width()))
    print()


def net_diag() -> int:
    """Quick IPv4/IPv6 + archive.org reachability report."""
    banner("Ether ✦", "net — connectivity across the aether")
    lines: list[str] = []

    def try_tcp(host: str, port: int, family: int, label: str) -> bool:
        try:
            infos = socket.getaddrinfo(host, port, family, socket.SOCK_STREAM)
        except socket.gaierror as e:
            lines.append(art.paint(f"  ✗ DNS    {label} aether: {e}", art.P.WARN))
            return False
        for fam, _, _, _, addr in infos:
            tag = "v6" if fam == socket.AF_INET6 else "v4"
            try:
                s = socket.socket(fam, socket.SOCK_STREAM)
                s.settimeout(3)
                s.connect(addr[:2])
                s.close()
                lines.append(art.paint(f"  ✓ TCP    {tag} {host}:{port}  ({label})", art.P.OK))
                return True
            except OSError:
                continue
        lines.append(art.paint(f"  ✗ TCP    {host}:{port}  ({label})", art.P.WARN))
        return False

    def try_https(url: str) -> bool:
        import urllib.request as u

        try:
            req = u.Request(url, headers={"User-Agent": UA})
            with u.urlopen(req, timeout=6) as r:
                code = getattr(r, "status", 200)
            lines.append(art.paint(f"  ✓ HTTPS  {url} → {code}", art.P.OK))
            return True
        except Exception as e:
            lines.append(art.paint(f"  ✗ HTTPS  {url}: {e}", art.P.WARN))
            return False

    lines.append(art.paint("  LAN / sockets", "1;" + art.P.PINK))
    try_tcp("1.1.1.1", 80, socket.AF_INET, "IPv4 :80")
    try_tcp("1.1.1.1", 443, socket.AF_INET, "IPv4 :443")
    try_tcp("2606:4700:4700::1111", 443, socket.AF_INET6, "IPv6 :443")
    lines.append("")
    lines.append(art.paint("  Dual-stack web", "1;" + art.P.PINK))
    try_https("https://example.com/")
    lines.append("")
    lines.append(art.paint("  archive.org (ether backend — IPv4-only A record today)", "1;" + art.P.PINK))
    try_tcp("archive.org", 80, socket.AF_INET, "IA :80")
    try_tcp("archive.org", 443, socket.AF_INET, "IA :443")
    ok = try_https("https://archive.org/advancedsearch.php?q=test&rows=1&output=json")
    print("\n".join(lines))
    print()
    if not ok:
        print(art.box(
            [
                "ether needs HTTPS to archive.org (IPv4 A only, no AAAA).",
                "If IPv4 :443 fails but IPv6 works, WAN IPv4/HTTPS is broken",
                "(router firewall, ISP, or Vodafone filter). Dual-stack sites",
                "still work over IPv6; archive.org will not until IPv4:443 works.",
                "",
                "Try:",
                "  1) reboot the Vodafone router",
                "  2) router admin → disable parental/HTTPS filter if any",
                "  3) phone hotspot to confirm it's the LAN/ISP path",
            ],
            title="runes",
            body_style=(art.P.MUTED,),
            width=art.term_width(),
        ))
        return 1
    print(art.box(
        ["archive.org looks reachable — siren trove should work."],
        title="runes",
        body_style=(art.P.OK,),
        width=art.term_width(),
    ))
    return 0


def vpn_connections() -> list[tuple[str, str]]:
    """(name, type) of NetworkManager VPN profiles."""
    show = _nmcli(["-t", "-f", "NAME,TYPE", "con", "show"])
    out = []
    for ln in (show.stdout or "").splitlines():
        parts = ln.rsplit(":", 1)
        if len(parts) == 2 and "vpn" in parts[1].lower():
            out.append((parts[0], parts[1]))
    return out


def cmd_veil(args: argparse.Namespace) -> int:
    """Raise / lower the aetheric veil (VPN)."""
    conns = vpn_connections()
    if not conns:
        banner("Ether ✦", "veil — no VPN woven yet")
        print(art.box(
            [
                "No VPN connection is woven into NetworkManager yet.",
                "",
                "  nmcli connection add type wireguard con-name veil ...",
                "  nmcli connection import type openvpn file fleet.ovpn",
                "  nmcli connection import type vpn file vpn.conf",
                "",
                "then: ether veil on / off / status.",
            ],
            title="the veil",
            body_style=(art.P.MUTED,),
            width=art.term_width(),
        ))
        return 0

    active = set()
    for ln in (_nmcli(["-t", "-f", "NAME", "con", "show", "--active"]).stdout or "").splitlines():
        if ln.strip():
            active.add(ln.strip())

    wanted = args.name or conns[0][0]
    if args.name and not any(n == wanted for n, _ in conns):
        banner("Ether ✦", f"veil — no such weave {wanted}")
        return 1

    action = _ACTION_ALIASES.get((args.action or "toggle").lower(), (args.action or "toggle").lower())
    if action == "status":
        banner("Ether ✦", "veil — status")
        for name, typ in conns:
            woven = name in active
            line = art.paint(
                f"  {'✓' if woven else '·'}  {name}  ({typ})  {'woven' if woven else 'drawn'}",
                art.P.OK if woven else art.P.MUTED,
            )
            print(line)
        print()
        return 0

    if action in ("on", "raise", "up"):
        if wanted in active:
            print(art.box([f"the veil already rises — {wanted}"], title="Ether ✦", body_style=(art.P.MUTED,), width=art.term_width()))
            return 0
        r = _nmcli(["con", "up", wanted], timeout=90)
        if r.returncode != 0:
            print(art.box([f"could not raise {wanted}: {(r.stderr or r.stdout or '').strip()}"], title="Ether ✦", body_style=(art.P.WARN,), width=art.term_width()))
            return 1
        print(art.box([f"the veil rises — {wanted}"], title="Ether ✦", body_style=(art.P.OK,), width=art.term_width()))
        return 0

    if action in ("off", "lower", "down"):
        if wanted not in active:
            print(art.box([f"the veil already falls — {wanted} is down"], title="Ether ✦", body_style=(art.P.MUTED,), width=art.term_width()))
            return 0
        r = _nmcli(["con", "down", wanted], timeout=90)
        if r.returncode != 0:
            print(art.box([f"could not lower {wanted}: {(r.stderr or r.stdout or '').strip()}"], title="Ether ✦", body_style=(art.P.WARN,), width=art.term_width()))
            return 1
        print(art.box([f"the veil falls — {wanted}"], title="Ether ✦", body_style=(art.P.OK,), width=art.term_width()))
        return 0

    # toggle
    if wanted in active:
        return cmd_veil(argparse.Namespace(action="off", name=args.name))
    return cmd_veil(argparse.Namespace(action="on", name=args.name))


def cmd_bridge(args: argparse.Namespace) -> int:
    """Boot fallback used by ether-bridge.service: bridge to the phone hotspot
    when no other real link is up."""
    if not shutil.which("nmcli"):
        return 1
    if not NETHER_CON:
        if not args.quiet:
            eprint("no hotspot configured — nothing to weave")
        return 1
    active = _nmcli(["-t", "-f", "NAME,TYPE", "con", "show", "--active"])
    has_real = False
    for ln in (active.stdout or "").splitlines():
        if ":loopback" in ln or ln.endswith(":lo"):
            continue
        has_real = True
        break
    if has_real:
        return 0
    if not args.quiet:
        eprint(f"no real link up — bridging to phone hotspot ({NETHER_CON})…")
    r = _nmcli(["con", "up", NETHER_CON], timeout=90)
    if r.returncode != 0:
        if not args.quiet:
            eprint(f"bridge failed: {(r.stderr or r.stdout or '').strip()}")
        return 1
    if not args.quiet:
        eprint("tether bound.")
    return 0


# ---------------------------------------------------------------------------
# Bluetooth weave helpers
# ---------------------------------------------------------------------------

def _bt(mac: str, *verb: str, timeout: float = 30) -> str:
    try:
        r = subprocess.run(
            ["bluetoothctl", *verb, mac],
            text=True, capture_output=True, timeout=timeout, check=False,
        )
        return (r.stdout or "") + (r.stderr or "")
    except (subprocess.TimeoutExpired, OSError):
        return ""


def _bt_connected(mac: str) -> bool:
    out = _bt(mac, "info", timeout=5)
    return "Connected: yes" in out


def _bt_devices() -> list[tuple[str, str]]:
    """(mac, name) of every device bluetoothd has seen."""
    out = []
    try:
        r = subprocess.run(
            ["bluetoothctl", "devices"],
            text=True, capture_output=True, timeout=8, check=False,
        )
    except (subprocess.TimeoutExpired, OSError):
        return out
    for ln in (r.stdout or "").splitlines():
        parts = ln.split()
        if len(parts) >= 2 and parts[0] == "Device":
            mac = parts[1]
            name = " ".join(parts[2:]) or mac
            out.append((mac, name))
    return out


def _bt_state(mac: str) -> dict:
    """connected / paired / trusted / battery for one device."""
    state = {"connected": False, "paired": False, "trusted": False, "battery": None}
    out = _bt(mac, "info", timeout=5)
    for ln in out.splitlines():
        ln = ln.strip()
        if ln.startswith("Connected:"):
            state["connected"] = ln.endswith("yes")
        elif ln.startswith("Paired:"):
            state["paired"] = ln.endswith("yes")
        elif ln.startswith("Trusted:"):
            state["trusted"] = ln.endswith("yes")
        elif "Battery Percentage:" in ln:
            raw = ln.rsplit(":", 1)[-1].strip().split()[0]
            try:
                state["battery"] = int(raw, 16) if raw.lower().startswith("0x") else int(raw)
            except ValueError:
                pass
    return state


def _wpctl_sinks() -> list[tuple[int, str, bool]]:
    """(id, name, is_default) for every pipewire sink."""
    out = []
    try:
        r = subprocess.run(
            ["wpctl", "status"],
            text=True, capture_output=True, timeout=8, check=False,
        )
    except (subprocess.TimeoutExpired, OSError):
        return out
    for ln in (r.stdout or "").splitlines():
        if "[vol:" not in ln:
            continue
        head = ln.split("[vol:")[0]
        is_default = "*" in head
        m = re.search(r"(\d+)\.\s+(.*?)\s*$", head)
        if m:
            out.append((int(m.group(1)), m.group(2).strip(), is_default))
    return out


def _find_sink_id(name: str, retries: int = 6) -> int | None:
    for _ in range(retries):
        for sid, sname, _d in _wpctl_sinks():
            if sname == name or sname in name or name in sname:
                return sid
        time.sleep(1)
    return None


def _weave(verb: str) -> tuple[bool, str]:
    """whisper / listen core — returns (ok, message); never prints."""
    target_mac, target_name = WEAVES[verb]
    others = [mac for v, (mac, _n) in WEAVES.items() if v != verb]

    if not _bt_connected(target_mac):
        out = _bt(target_mac, "connect", timeout=30)
        if "Failed to connect" in out:
            return False, f"could not reach the {verb}ing one — is it powered on?\n  ({target_name}  {target_mac})"

    for mac in others:
        if _bt_connected(mac):
            _bt(mac, "disconnect", timeout=10)

    sink_id = _find_sink_id(target_name)
    if sink_id is None:
        return False, f"sink '{target_name}' not found in pipewire — is the weave alive?"

    try:
        subprocess.run(["wpctl", "set-default", str(sink_id)], text=True, capture_output=True, timeout=10, check=False)
    except OSError:
        pass

    if verb == "whisper":
        msg = f"A quiet whisper threads through the ether — {target_name} (sink {sink_id})"
    else:
        msg = f"The ether bends to listen — {target_name} (sink {sink_id})"
    return True, msg


def cmd_weave(verb: str, token: str | None) -> int:
    """whisper ether / listen ether — point the aether at one voice."""
    if token not in (None, "", "ether"):
        print(art.box(
            [f"no such weave — {token}", "the ether only answers to: whisper / listen / status"],
            title="Ether ✦", body_style=(art.P.WARN,), width=art.term_width(),
        ))
        print()
        return 1

    ok, msg = _weave(verb)
    print(art.box([msg], title="Ether ✦",
                  body_style=(art.P.OK,) if ok else (art.P.WARN,),
                  width=art.term_width()))
    print()
    return 0 if ok else 1


# ---------------------------------------------------------------------------
# status TUI
# ---------------------------------------------------------------------------

def _collect_status() -> dict:
    data: dict = {"bt": [], "wifi": [], "lan": [], "sinks": [], "conns": []}

    for mac, name in _bt_devices():
        state = _bt_state(mac)
        state.update({"mac": mac, "name": name})
        data["bt"].append(state)

    try:
        r = subprocess.run(
            ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL", "device", "wifi", "list"],
            text=True, capture_output=True, timeout=8, check=False,
        )
        for ln in (r.stdout or "").splitlines():
            parts = ln.split(":")
            if len(parts) >= 3:
                data["wifi"].append({"in_use": parts[0] == "*", "ssid": parts[1], "signal": parts[2]})
    except (subprocess.TimeoutExpired, OSError):
        pass

    try:
        r = _nmcli(["-t", "-f", "NAME,TYPE,DEVICE", "con", "show", "--active"], timeout=8)
        for ln in (r.stdout or "").splitlines():
            if not ln:
                continue
            parts = ln.split(":")
            if len(parts) >= 3:
                data["conns"].append({"name": parts[0], "type": parts[1], "dev": parts[2]})
    except (subprocess.TimeoutExpired, OSError):
        pass

    def tcp_probe(host: str, port: int, family: int, label: str) -> bool:
        try:
            infos = socket.getaddrinfo(host, port, family, socket.SOCK_STREAM)
        except socket.gaierror:
            data["lan"].append((label, False))
            return False
        for fam, _, _, _, addr in infos:
            try:
                s = socket.socket(fam, socket.SOCK_STREAM)
                s.settimeout(3)
                s.connect(addr[:2])
                s.close()
                data["lan"].append((label, True))
                return True
            except OSError:
                continue
        data["lan"].append((label, False))
        return False

    tcp_probe("1.1.1.1", 443, socket.AF_INET, "IPv4 :443")
    tcp_probe("2606:4700:4700::1111", 443, socket.AF_INET6, "IPv6 :443")
    tcp_probe("archive.org", 443, socket.AF_INET, "IA :443")

    data["sinks"] = _wpctl_sinks()
    return data


def _bt_panel(data: dict, width: int) -> str:
    known = [d for d in data["bt"]
             if d["paired"] or d["connected"] or d["mac"] in [m for m, _n in WEAVES.values()]]
    lines = []
    if not known:
        lines.append(art.paint("  no devices woven yet — pair one with bluetoothctl", P.MUTED))
    for d in known:
        status = "on" if d["connected"] else "off"
        color = P.OK if d["connected"] else P.MUTED
        bat = f"  {d['battery']}%" if d["battery"] is not None else ""
        lines.append(f"  {'▶' if d['connected'] else '·'}  {art.paint(d['name'], color)}  {d['mac']}  {art.paint(status, color)}{bat}")
    if not known:
        for mac, name in WEAVES.values():
            lines.append(art.paint(f"  ·  {name}  {mac}  (unseen)", P.MUTED))
    return art.box(lines, title="bluetooth", width=width, body_style=(P.SILVER,))


def _wifi_panel(data: dict, width: int) -> str:
    lines = []
    if not data["wifi"]:
        lines.append(art.paint("  no networks in sight", P.MUTED))
    nets = sorted(data["wifi"], key=lambda x: -int(x["signal"] or 0))
    in_use = next((w for w in nets if w["in_use"]), None)
    shown = [w for w in nets[:8] if w is not in_use]
    if in_use:
        shown.insert(0, in_use)
    shown = shown[:8]
    for w in shown:
        mark = art.paint("▰", P.OK) if w["in_use"] else "·"
        sig = int(w["signal"] or 0)
        bar = "█" * max(0, sig // 20) + "░" * (5 - max(0, sig // 20))
        tag = art.paint("  ◀ woven", P.OK) if w["in_use"] else ""
        lines.append(f"  {mark}  {w['ssid'] or '(hidden)'}  {sig}%  {bar}{tag}")
    if len(nets) > len(shown):
        lines.append(art.paint(f"  … {len(nets) - len(shown)} more", P.MUTED))
    for c in data["conns"]:
        if c["type"] not in ("ethernet", "wifi"):
            continue
        dev = f" ({c['dev']})" if c["dev"] else ""
        lines.append(art.paint(f"  link: {c['name']}  ·  {c['type']}{dev}", P.PINK_DIM))
    return art.box(lines, title="wifi", width=width, body_style=(P.SILVER,))


def _lan_panel(data: dict, width: int) -> str:
    lines = []
    if not data["lan"]:
        lines.append(art.paint("  probing…", P.MUTED))
    for label, ok in data["lan"]:
        mark = art.paint("✓", P.OK) if ok else art.paint("✗", P.WARN)
        lines.append(f"  {mark}  {label}")
    default = next((s for s in data["sinks"] if s[2]), None)
    if default:
        lines.append("")
        lines.append(art.paint(f"  default sink: {default[1]}  (sink {default[0]})", P.MUTED))
    return art.box(lines, title="lan · weave", width=width, body_style=(P.SILVER,))


def build_frame(data: dict, width: int, height: int) -> str:
    panel_w = max(44, min(width - 2, 88))
    bt = _bt_panel(data, panel_w)
    wifi = _wifi_panel(data, panel_w)
    lan = _lan_panel(data, panel_w)
    footer = art.box(
        ["w whisper · l listen · s scan · n new · d remove · R restart · r refresh · q quit"],
        title="runes", width=width, body_style=(P.MUTED,),
    )
    return "\n".join([bt, "", wifi, "", lan, "", footer])


# ---------------------------------------------------------------------------
# interactive TUI modes
# ---------------------------------------------------------------------------

def _menu_frame(title: str, items: list, sel: int, width: int) -> str:
    lines = []
    for i, (label, _cb) in enumerate(items):
        mark = "❯" if i == sel else " "
        style = P.SILVER if i == sel else P.MUTED
        lines.append(art.paint(f" {mark} {label}", style))
    return art.box(lines, title=title, width=width, body_style=(P.SILVER,))


def _input_frame(prompt: str, value: str, secret: bool, width: int) -> str:
    shown = "•" * len(value) if secret else value
    return art.box([art.paint(f"  {prompt}", P.SILVER), "", f"  {shown}█"],
                   title="weave · input", width=width, body_style=(P.SILVER,))


def _confirm_frame(msg: str, width: int) -> str:
    return art.box([f"  {msg}", "", "  y  yes        n / esc  no"],
                   title="are you sure?", width=width, body_style=(P.WARN,))


def _work_frame(msg: str, width: int) -> str:
    return art.box([f"  {msg} …"], title="weaving", width=width, body_style=(P.MUTED,))


def _result_frame(ok: bool, msg: str, width: int) -> str:
    style = (P.OK,) if ok else (P.WARN,)
    return art.box([f"  {msg}"], title="runes", width=width, body_style=style)


def _footer_frame(width: int, hint: str) -> str:
    return art.box([hint], title="runes", width=width, body_style=(P.MUTED,))


def _start_work(ui: dict, msg: str, fn) -> None:
    ui["mode"] = "work"
    ui["work_msg"] = msg
    ui["work_fn"] = fn


def _btctl_raw(*args: str, timeout: float = 15) -> str:
    try:
        r = subprocess.run(["bluetoothctl", *args], text=True, capture_output=True,
                           timeout=timeout, check=False)
        return (r.stdout or "") + (r.stderr or "")
    except (subprocess.TimeoutExpired, OSError):
        return ""


def _bt_pair_pty(mac: str, pin: str | None = None, timeout: float = 30) -> tuple[bool, str]:
    """Pair via bluetoothctl on a pty so legacy-PIN prompts can be answered."""
    master, slave = pty.openpty()
    proc = subprocess.Popen(["bluetoothctl"], stdin=slave, stdout=slave, stderr=slave, close_fds=True)
    os.close(slave)

    def send(cmd: str) -> None:
        os.write(master, (cmd + "\n").encode())

    send("agent NoInputNoOutput")
    send("default-agent")
    send(f"pair {mac}")
    buf = b""
    pin_sent = False
    deadline = time.monotonic() + timeout
    try:
        while time.monotonic() < deadline:
            r, _, _ = select.select([master], [], [], 0.3)
            if not r:
                continue
            data = os.read(master, 4096)
            if not data:
                break
            buf += data
            if b"Enter PIN code" in buf and pin and not pin_sent:
                send(pin)
                pin_sent = True
                buf = buf[-200:]
            elif b"Confirm passkey" in buf and not pin_sent:
                send("yes")
                pin_sent = True
                buf = buf[-200:]
            if b"Pairing successful" in buf:
                return True, "pairing successful"
            if b"Failed" in buf or b"not available" in buf:
                return False, buf.decode(errors="replace").strip().splitlines()[-1]
    finally:
        try:
            send("quit")
        except OSError:
            pass
        try:
            proc.wait(timeout=2)
        except Exception:
            proc.kill()
        try:
            os.close(master)
        except OSError:
            pass
    return False, "pairing timed out"


def _scan_bt_top5() -> list[tuple[str, str]]:
    """Fresh bluetooth scan — up to 5 NEW devices as (mac, name)."""
    devs: list[tuple[str, str]] = []
    try:
        r = subprocess.run(["bluetoothctl", "--timeout", "12", "scan", "on"],
                           text=True, capture_output=True, timeout=20, check=False)
    except (subprocess.TimeoutExpired, OSError):
        return devs
    for ln in (r.stdout or "").splitlines():
        if "[NEW]" not in ln:
            continue
        m = re.search(r"Device ([0-9A-F:]+) ?(.*)", ln)
        if not m:
            continue
        mac, name = m.group(1), m.group(2).strip() or m.group(1)
        if not any(x == mac for x, _ in devs):
            devs.append((mac, name))
        if len(devs) >= 5:
            break
    return devs


def _scan_wifi_top5() -> list[dict]:
    """Rescan + list wifi, top 5 by signal."""
    try:
        subprocess.run(["nmcli", "device", "wifi", "rescan"], text=True, capture_output=True,
                       timeout=10, check=False)
    except (subprocess.TimeoutExpired, OSError):
        pass
    nets: list[dict] = []
    try:
        r = subprocess.run(["nmcli", "-t", "-f", "IN-USE,SSID,SECURITY,SIGNAL", "device", "wifi", "list"],
                           text=True, capture_output=True, timeout=10, check=False)
        for ln in (r.stdout or "").splitlines():
            p = ln.split(":")
            if len(p) >= 4:
                nets.append({"in_use": p[0] == "*", "ssid": p[1], "security": p[2], "signal": int(p[3] or 0)})
    except (subprocess.TimeoutExpired, OSError):
        pass
    nets.sort(key=lambda n: -n["signal"])
    return nets[:5]


def _saved_wifi_connections() -> list[str]:
    out: list[str] = []
    show = _nmcli(["-t", "-f", "NAME,TYPE", "con", "show"])
    for ln in (show.stdout or "").splitlines():
        parts = ln.rsplit(":", 1)
        if len(parts) == 2 and "wireless" in parts[1]:
            out.append(parts[0])
    return out


def _scan_menu(ui: dict) -> None:
    ui["mode"] = "menu"
    ui["title"] = "scan the aether"
    ui["sel"] = 0
    ui["items"] = [
        ("bluetooth voices", lambda u: _scan_bt_flow(u)),
        ("wifi airwaves", lambda u: _scan_wifi_flow(u)),
    ]


def _scan_bt_flow(ui: dict) -> None:
    def run() -> tuple[bool, str] | None:
        devs = _scan_bt_top5()
        if not devs:
            return False, "no bluetooth voices heard"
        ui["mode"] = "menu"
        ui["title"] = "bluetooth · top 5"
        ui["sel"] = 0
        ui["items"] = [(f"{n}  {m}", lambda u, mac=m, name=n: _pair_flow(u, mac, name)) for m, n in devs]
        return None
    _start_work(ui, "listening to the aether", run)


def _scan_wifi_flow(ui: dict) -> None:
    def run() -> tuple[bool, str] | None:
        nets = _scan_wifi_top5()
        if not nets:
            return False, "no wifi airwaves heard"
        ui["mode"] = "menu"
        ui["title"] = "wifi · top 5"
        ui["sel"] = 0
        ui["items"] = []
        for n in nets:
            label = f"{n['ssid'] or '(hidden)'}  {n['signal']}%  {n['security'] or 'open'}"
            if n["in_use"]:
                label += "  ◀ woven"
            ui["items"].append((label, lambda u, net=n: _wifi_connect_flow(u, net)))
        return None
    _start_work(ui, "reading the airwaves", run)


def _pair_flow(ui: dict, mac: str, name: str) -> None:
    def run() -> tuple[bool, str]:
        ok, msg = _bt_pair_pty(mac)
        if ok:
            _btctl_raw("trust", mac)
            return True, f"paired with {name}"
        return False, msg
    _start_work(ui, f"pairing with {name}", run)


def _wifi_connect_flow(ui: dict, net: dict) -> None:
    if net["security"]:
        ui["mode"] = "input"
        ui["prompt"] = f"password for {net['ssid']}:"
        ui["value"] = ""
        ui["secret"] = True
        ui["input_cb"] = lambda u, psk: _wifi_connect_do(u, net, psk)
        return

    def run() -> tuple[bool, str]:
        r = _nmcli(["device", "wifi", "connect", net["ssid"]], timeout=40)
        if r.returncode != 0:
            r = _nmcli(["device", "wifi", "connect", net["ssid"]], timeout=40)
            if r.returncode != 0:
                return False, "open-network connect failed"
        return True, f"woven into {net['ssid']}"
    _start_work(ui, f"weaving into {net['ssid']}", run)


def _wifi_connect_do(ui: dict, net: dict, psk: str) -> None:
    def run() -> tuple[bool, str]:
        cmd = ["device", "wifi", "connect", net["ssid"], "password", psk]
        r = _nmcli(cmd, timeout=40)
        if r.returncode != 0:
            r = _nmcli(cmd, timeout=40)
            if r.returncode != 0:
                return False, "connect failed — wrong password?"
        return True, f"woven into {net['ssid']}"
    _start_work(ui, f"weaving into {net['ssid']}", run)


def _new_menu(ui: dict) -> None:
    ui["mode"] = "menu"
    ui["title"] = "weave a new thread"
    ui["sel"] = 0
    ui["items"] = [
        ("wifi network", lambda u: _scan_wifi_flow(u)),
        ("bluetooth device", lambda u: _scan_bt_flow(u)),
    ]


def _remove_menu(ui: dict) -> None:
    ui["mode"] = "menu"
    ui["title"] = "unravel a thread"
    ui["sel"] = 0
    ui["items"] = [
        ("bluetooth device", lambda u: _remove_bt_menu(u)),
        ("wifi connection", lambda u: _remove_wifi_menu(u)),
    ]


def _remove_bt_menu(ui: dict) -> None:
    devs = [(m, n) for m, n in _bt_devices() if _bt_state(m)["paired"]]
    if not devs:
        ui["mode"] = "result"
        ui["result"] = (False, "nothing paired yet")
        return
    ui["mode"] = "menu"
    ui["title"] = "paired bluetooth"
    ui["sel"] = 0
    ui["items"] = [(f"{n}  {m}", lambda u, mac=m, name=n: _confirm_remove_bt(u, mac, name)) for m, n in devs]


def _confirm_remove_bt(ui: dict, mac: str, name: str) -> None:
    def run() -> tuple[bool, str]:
        out = _bt(mac, "remove", timeout=10)
        if "not available" in out:
            return False, "device already gone"
        return True, f"unravelled {name}"
    ui["mode"] = "confirm"
    ui["confirm_msg"] = f"unravel {name}? (unpair + forget)"
    ui["confirm_cb"] = lambda: _start_work(ui, f"unravelling {name}", run)


def _remove_wifi_menu(ui: dict) -> None:
    conns = _saved_wifi_connections()
    if not conns:
        ui["mode"] = "result"
        ui["result"] = (False, "no saved wifi connections")
        return
    ui["mode"] = "menu"
    ui["title"] = "saved wifi connections"
    ui["sel"] = 0
    ui["items"] = [(c, lambda u, name=c: _confirm_remove_wifi(u, name)) for c in conns]


def _confirm_remove_wifi(ui: dict, name: str) -> None:
    def run() -> tuple[bool, str]:
        r = _nmcli(["con", "delete", name], timeout=20)
        if r.returncode != 0:
            return False, "could not delete connection"
        return True, f"forgot {name}"
    ui["mode"] = "confirm"
    ui["confirm_msg"] = f"forget {name}? (deletes saved connection)"
    ui["confirm_cb"] = lambda: _start_work(ui, f"forgetting {name}", run)


def _restart_menu(ui: dict) -> None:
    ui["mode"] = "menu"
    ui["title"] = "stir the sleeping powers"
    ui["sel"] = 0
    ui["items"] = [
        ("bluetooth · soft", lambda u: _restart_soft(u, "bluetooth")),
        ("bluetooth · full (sudo)", lambda u: _restart_sudo(u, "bluetooth")),
        ("wifi · soft", lambda u: _restart_soft(u, "wifi")),
        ("wifi · full (sudo)", lambda u: _restart_sudo(u, "NetworkManager")),
    ]


def _restart_soft(ui: dict, target: str) -> None:
    def run() -> tuple[bool, str]:
        if target == "bluetooth":
            _btctl_raw("power", "off")
            time.sleep(1)
            out = _btctl_raw("power", "on")
            ok = "Powered: yes" in _btctl_raw("show") or "Changing power on succeeded" in out
            return (True, "bluetooth folded and refolded") if ok else (False, "soft restart failed — try full (sudo)")
        r = _nmcli(["networking", "off"], timeout=20)
        time.sleep(2)
        r = _nmcli(["networking", "on"], timeout=30)
        return (True, "wifi folded and refolded") if r.returncode == 0 else (False, "soft restart failed — try full (sudo)")
    _start_work(ui, f"folding {target} over", run)


def _restart_sudo(ui: dict, target: str) -> None:
    ui["mode"] = "input"
    ui["prompt"] = "sudo password:"
    ui["value"] = ""
    ui["secret"] = True
    ui["input_cb"] = lambda u, pw: _restart_sudo_do(u, target, pw)


def _restart_sudo_do(ui: dict, target: str, pw: str) -> None:
    def run() -> tuple[bool, str]:
        try:
            r = subprocess.run(["sudo", "-S", "-p", "", "systemctl", "restart", target],
                               input=pw + "\n", text=True, capture_output=True, timeout=60, check=False)
        except (subprocess.TimeoutExpired, OSError) as e:
            return False, f"restart failed: {e}"
        if r.returncode != 0:
            return False, (r.stderr or "restart failed").strip()
        return True, f"{target} stirred back to life"
    _start_work(ui, f"restarting {target}", run)


def cmd_status(_: argparse.Namespace | None = None) -> int:
    fd = art.tui_open_tty()
    if fd is None:
        print(art.paint("status needs a real TTY (not a pipe).", P.ERR), file=sys.stderr)
        return 2

    art.tui_begin(fd, "ether")
    last_refresh = 0.0
    data: dict = {}
    ui: dict = {
        "mode": "home", "sel": 0, "items": [], "title": "",
        "prompt": "", "value": "", "secret": True, "input_cb": None,
        "confirm_msg": "", "confirm_cb": None,
        "work_msg": "", "work_fn": None,
        "result": (True, ""),
    }
    try:
        while True:
            if ui["mode"] == "home" and time.monotonic() - last_refresh > 3.0:
                data = _collect_status()
                last_refresh = time.monotonic()
            width = art.term_width()
            height = art.term_height()

            if ui["mode"] == "home":
                frame = build_frame(data, width, height)
            elif ui["mode"] == "menu":
                frame = _menu_frame(ui["title"], ui["items"], ui["sel"], width)
                hint = "↑/↓ or j/k move · enter pick · esc back"
            elif ui["mode"] == "input":
                frame = _input_frame(ui["prompt"], ui["value"], ui["secret"], width)
                hint = "enter confirm · esc cancel"
            elif ui["mode"] == "confirm":
                frame = _confirm_frame(ui["confirm_msg"], width)
                hint = "y yes · n/esc no"
            elif ui["mode"] == "work":
                frame = _work_frame(ui["work_msg"], width)
                hint = ""
            else:
                ok, msg = ui["result"]
                frame = _result_frame(ok, msg, width)
                hint = "enter / esc continue"
            if ui["mode"] != "home":
                frame += "\n\n" + _footer_frame(width, hint)

            try:
                art.paint_frame(fd, frame)
            except OSError:
                art.tty_write(fd, art.clear_screen() + frame + "\n")

            if ui["mode"] == "work" and ui["work_fn"] is not None:
                fn, ui["work_fn"] = ui["work_fn"], None
                res = fn()
                if res is not None:
                    ui["result"] = res
                    ui["mode"] = "result"
                last_refresh = 0.0
                continue

            key = art.tui_read_key(fd, timeout=0.2)
            if key in ("q", "esc", "ctrl-c", "Q") and ui["mode"] == "home":
                return 0

            if ui["mode"] == "home":
                if key in ("w", "W"):
                    _start_work(ui, "whispering to the ether", lambda: _weave("whisper"))
                elif key in ("l", "L"):
                    _start_work(ui, "bending the ether to listen", lambda: _weave("listen"))
                elif key in ("s", "S"):
                    _scan_menu(ui)
                elif key in ("n", "N"):
                    _new_menu(ui)
                elif key in ("d", "D"):
                    _remove_menu(ui)
                elif key in ("R",):
                    _restart_menu(ui)
                elif key in ("r",):
                    last_refresh = 0.0
            elif ui["mode"] == "menu":
                if key in ("esc", "q"):
                    ui["mode"] = "home"
                elif key in ("up", "k"):
                    ui["sel"] = (ui["sel"] - 1) % len(ui["items"])
                elif key in ("down", "j"):
                    ui["sel"] = (ui["sel"] + 1) % len(ui["items"])
                elif key in ("enter", "space"):
                    _, cb = ui["items"][ui["sel"]]
                    cb(ui)
            elif ui["mode"] == "input":
                if key in ("esc", "q"):
                    ui["mode"] = "home"
                elif key in ("enter",):
                    cb = ui["input_cb"]
                    val = ui["value"]
                    ui["value"] = ""
                    if cb:
                        cb(ui, val)
                elif key in ("backspace",):
                    ui["value"] = ui["value"][:-1]
                elif len(key) == 1 and key.isprintable():
                    ui["value"] += key
                elif key == "space":
                    ui["value"] += " "
            elif ui["mode"] == "confirm":
                if key in ("y", "Y", "enter"):
                    cb = ui["confirm_cb"]
                    if cb:
                        cb()
                elif key in ("n", "N", "esc", "q"):
                    ui["mode"] = "home"
            elif ui["mode"] == "result":
                if key in ("enter", "esc", "space"):
                    ui["mode"] = "home"
                    last_refresh = 0.0
    finally:
        art.tui_cleanup()


def cmd_info(_: argparse.Namespace | None = None) -> int:
    """ether status / status ether — one-shot report (no TUI)."""
    data = _collect_status()
    width = art.term_width()
    panel_w = max(44, min(width - 2, 88))
    print()
    print(art.box([], title="Ether ✦", subtitle="status — the aether at a glance", width=width))
    print(_bt_panel(data, panel_w))
    print()
    print(_wifi_panel(data, panel_w))
    print()
    print(_lan_panel(data, panel_w))
    print()
    return 0


def cmd_about(_: argparse.Namespace) -> int:
    print()
    print(art.box(
        [
            "ether — network paths & weaves for faeOS",
            "",
            "the ether answers to several names (multi-call):",
            "  whisper ether               tune the ANC headphone in",
            "  listen  ether               tune the JBL Go 3 in",
            "  ether                      live TUI: bt · wifi · lan (q to close)",
            "  status ether               one-shot report: bt · wifi · lan",
            "",
            "  ether net                  connectivity across the weave",
            "  ether veil [on|off|status] raise/lower the VPN (alias: vpn)",
            "  ether bridge               phone hotspot on boot (systemd)",
            "  ether about",
            "",
            "Free media lives under Siren now:",
            "  siren trove list 10 music lofi",
            "  siren trove get <identifier>",
            "",
            "Phone hotspot (local only — never commit):",
            "  ~/.config/ether/netherweave.env",
            "    ETHER_NETHER_SSID=…  ETHER_NETHER_PSK=…",
        ],
        title="Ether ✦",
        subtitle="network paths & weaves",
        body_style=(art.P.MUTED,),
        width=art.term_width(),
    ))
    print()
    return 0


_ACTION_ALIASES = {
    "raise": "on", "up": "on",
    "lower": "off", "down": "off",
    "check": "status",
}


def main() -> int:
    _bootstrap()

    prog = os.path.basename(sys.argv[0])
    rest = sys.argv[1:]

    if prog == "whisper":
        return cmd_weave("whisper", rest[0] if rest else None)
    if prog == "listen":
        return cmd_weave("listen", rest[0] if rest else None)
    if prog == "status":
        return cmd_info()

    ap = argparse.ArgumentParser(prog="ether", description="network paths & weaves for faeOS")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("net", help="IPv4/IPv6 + archive.org reachability")
    p.set_defaults(func=lambda _a: net_diag())

    p = sub.add_parser("veil", help="raise/lower the VPN", aliases=["vpn"])
    p.add_argument("action", nargs="?", default="toggle", help="on|off|status  (aliases raise/lower/up/down/check)")
    p.add_argument("--name", default=None, help="specific VPN connection name")
    p.set_defaults(func=cmd_veil)

    p = sub.add_parser("bridge", help="boot fallback: tether to phone hotspot (systemd)")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_bridge)

    p = sub.add_parser("about")
    p.set_defaults(func=cmd_about)

    p = sub.add_parser("status", help="one-shot report: bt · wifi · lan")
    p.set_defaults(func=cmd_info)

    args = ap.parse_args()
    if not getattr(args, "cmd", None):
        return cmd_status()
    return args.func(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print()
        raise SystemExit(130)

