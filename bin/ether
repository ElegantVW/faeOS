#!/usr/bin/env python3
"""ether — network paths & weaves for faeOS.

A single weave that answers to several names (multi-call):

  whisper ether   tune the ether to the ANC headphone (the quiet voice)
  listen  ether   tune the ether to the JBL Go 3 (the loud voice)
  ether           live TUI: bluetooth · wifi · lan (navigate · q to close)
  status ether    one-shot report: bt · wifi · lan at a glance

  ether net                    connectivity (IPv4/IPv6, archive.org probe)
  ether link [target]          show / select the internet path (lan · usb tether)
  ether veil [on|off|status]   raise/lower the VPN veil  (alias: ether vpn)
  ether bridge                 phone-hotspot fallback (runs at boot via systemd)
  ether ap [on|off|status]     house Wi-Fi AP (iw + hostapd; NetworkManager-free)
  ether about                  help

Install as symlinks so each name reads as English:
  ln -s ether ~/bin/whisper  &&  ln -s ether ~/bin/listen  &&  ln -s ether ~/bin/status

Free media lives under Siren now:
  siren trove list 10 music lofi
"""
from __future__ import annotations

import argparse
import ipaddress
import json
import os
import pty
import re
import select
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.parse
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

sys.path.insert(0, str(Path.home() / "bin"))
import fae_termart as art  # noqa: E402

os.environ.setdefault("PIXIE_UNICODE", "1")
P = art.P

UA = "ether/1.2 (faeOS network tool; +https://archive.org)"

# The voices of the ether: verb -> (MAC, pipewire sink name)
WEAVES = {
    "whisper": ("8F:E4:19:50:23:F9", "ANC headphone"),
    "listen": ("70:99:1C:D0:40:E4", "JBL Go 3"),
}


def _bootstrap() -> None:
    """Make sure session bus + pipewire are reachable (tty sessions)."""
    uid = os.getuid()
    os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{uid}")
    os.environ.setdefault("DBUS_SESSION_BUS_ADDRESS", f"unix:path=/run/user/{uid}/bus")


# Phone hotspot weave (auto on boot via ether-bridge.service).
# NEVER hardcode Wi‑Fi secrets in the repo. Load from env or local config:
#   ~/.config/ether/netherweave.env   (chmod 600)
#   ETHER_NETHER_SSID=…  ETHER_NETHER_PSK=…  ETHER_NETHER_CON=…
def _load_nether_env() -> None:
    candidates = (
        Path.home() / ".config" / "ether" / "netherweave.env",
        Path.home() / ".config" / "pixie" / "netherweave.env",
    )
    for cfg in candidates:
        if not cfg.is_file():
            continue
        try:
            for line in cfg.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                k, v = k.strip(), v.strip().strip("'").strip('"')
                if k and k not in os.environ:
                    os.environ[k] = v
        except OSError:
            pass


_load_nether_env()
NETHER_SSID = os.environ.get("ETHER_NETHER_SSID", "").strip()
NETHER_PSK = os.environ.get("ETHER_NETHER_PSK", "").strip()
NETHER_CON = os.environ.get("ETHER_NETHER_CON", "").strip() or NETHER_SSID


# House AP weave — the NetworkManager-free path. Credentials live in
#   ~/.config/ether/ap.env   (chmod 600; ETHER_AP_IFACE / ETHER_AP_SSID / ETHER_AP_PSK)
# falling back to ~/.config/wisp/ap.env (WISP_AP_*) so the existing wisp
# file keeps working. The PSK is NEVER printed — status may only say
# "psk set". `ether ap` drives iw + hostapd directly; nmcli stays out of it.
def _load_ap_env() -> dict:
    """iface/ssid/psk for the house AP. ether's own file wins per key."""
    cfg = {"iface": "", "ssid": "", "psk": ""}
    field = {"IFACE": "iface", "SSID": "ssid", "PSK": "psk"}
    for path, prefix in (
        (Path.home() / ".config" / "ether" / "ap.env", "ETHER_AP_"),
        (Path.home() / ".config" / "wisp" / "ap.env", "WISP_AP_"),
    ):
        if not path.is_file():
            continue
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        for line in lines:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            k = k.strip()
            if not k.startswith(prefix):
                continue
            f = field.get(k[len(prefix):])
            if f and not cfg[f]:
                cfg[f] = v.strip().strip("'").strip('"')
    return cfg


def eprint(*a, **k) -> None:
    print(*a, file=sys.stderr, **k)


def _nmcli(args: list[str], *, timeout: float = 60) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["nmcli", *args],
        text=True,
        capture_output=True,
        timeout=timeout,
        check=False,
    )


def banner(title: str, label: str) -> None:
    print()
    print(art.box([], title="Ether", subtitle=label + "  ·  " + title, width=art.term_width()))
    print()


def net_diag() -> int:
    """Quick IPv4/IPv6 + archive.org reachability report."""
    banner("Ether ✦", "net — connectivity across the aether")
    lines: list[str] = []

    def try_tcp(host: str, port: int, family: int, label: str) -> bool:
        try:
            infos = socket.getaddrinfo(host, port, family, socket.SOCK_STREAM)
        except socket.gaierror as e:
            lines.append(art.paint(f"  ✗ DNS    {label} aether: {e}", art.P.WARN))
            return False
        for fam, _, _, _, addr in infos:
            tag = "v6" if fam == socket.AF_INET6 else "v4"
            try:
                s = socket.socket(fam, socket.SOCK_STREAM)
                s.settimeout(3)
                s.connect(addr[:2])
                s.close()
                lines.append(art.paint(f"  ✓ TCP    {tag} {host}:{port}  ({label})", art.P.OK))
                return True
            except OSError:
                continue
        lines.append(art.paint(f"  ✗ TCP    {host}:{port}  ({label})", art.P.WARN))
        return False

    def try_https(url: str) -> bool:
        import urllib.request as u

        try:
            req = u.Request(url, headers={"User-Agent": UA})
            with u.urlopen(req, timeout=6) as r:
                code = getattr(r, "status", 200)
            lines.append(art.paint(f"  ✓ HTTPS  {url} → {code}", art.P.OK))
            return True
        except Exception as e:
            lines.append(art.paint(f"  ✗ HTTPS  {url}: {e}", art.P.WARN))
            return False

    lines.append(art.paint("  LAN / sockets", "1;" + art.P.PINK))
    try_tcp("1.1.1.1", 80, socket.AF_INET, "IPv4 :80")
    try_tcp("1.1.1.1", 443, socket.AF_INET, "IPv4 :443")
    try_tcp("2606:4700:4700::1111", 443, socket.AF_INET6, "IPv6 :443")
    lines.append("")
    lines.append(art.paint("  Dual-stack web", "1;" + art.P.PINK))
    try_https("https://example.com/")
    lines.append("")
    lines.append(art.paint("  archive.org (ether backend — IPv4-only A record today)", "1;" + art.P.PINK))
    try_tcp("archive.org", 80, socket.AF_INET, "IA :80")
    try_tcp("archive.org", 443, socket.AF_INET, "IA :443")
    ok = try_https("https://archive.org/advancedsearch.php?q=test&rows=1&output=json")
    print("\n".join(lines))
    print()
    if not ok:
        print(art.box(
            [
                "ether needs HTTPS to archive.org (IPv4 A only, no AAAA).",
                "If IPv4 :443 fails but IPv6 works, WAN IPv4/HTTPS is broken",
                "(router firewall, ISP, or Vodafone filter). Dual-stack sites",
                "still work over IPv6; archive.org will not until IPv4:443 works.",
                "",
                "Try:",
                "  1) reboot the Vodafone router",
                "  2) router admin → disable parental/HTTPS filter if any",
                "  3) phone hotspot to confirm it's the LAN/ISP path",
            ],
            title="runes",
            body_style=(art.P.MUTED,),
            width=art.term_width(),
        ))
        return 1
    print(art.box(
        ["archive.org looks reachable — siren trove should work."],
        title="runes",
        body_style=(art.P.OK,),
        width=art.term_width(),
    ))
    return 0


def vpn_connections() -> list[tuple[str, str]]:
    """(name, type) of NetworkManager VPN profiles."""
    show = _nmcli(["-t", "-f", "NAME,TYPE", "con", "show"])
    out = []
    for ln in (show.stdout or "").splitlines():
        parts = ln.rsplit(":", 1)
        if len(parts) == 2 and "vpn" in parts[1].lower():
            out.append((parts[0], parts[1]))
    return out


def cmd_veil(args: argparse.Namespace) -> int:
    """Raise / lower the aetheric veil (VPN)."""
    conns = vpn_connections()
    if not conns:
        banner("Ether ✦", "veil — no VPN woven yet")
        print(art.box(
            [
                "No VPN connection is woven into NetworkManager yet.",
                "",
                "  nmcli connection add type wireguard con-name veil ...",
                "  nmcli connection import type openvpn file fleet.ovpn",
                "  nmcli connection import type vpn file vpn.conf",
                "",
                "then: ether veil on / off / status.",
            ],
            title="the veil",
            body_style=(art.P.MUTED,),
            width=art.term_width(),
        ))
        return 0

    active = set()
    for ln in (_nmcli(["-t", "-f", "NAME", "con", "show", "--active"]).stdout or "").splitlines():
        if ln.strip():
            active.add(ln.strip())

    wanted = args.name or conns[0][0]
    if args.name and not any(n == wanted for n, _ in conns):
        banner("Ether ✦", f"veil — no such weave {wanted}")
        return 1

    action = _ACTION_ALIASES.get((args.action or "toggle").lower(), (args.action or "toggle").lower())
    if action == "status":
        banner("Ether ✦", "veil — status")
        for name, typ in conns:
            woven = name in active
            line = art.paint(
                f"  {'✓' if woven else '·'}  {name}  ({typ})  {'woven' if woven else 'drawn'}",
                art.P.OK if woven else art.P.MUTED,
            )
            print(line)
        print()
        return 0

    if action in ("on", "raise", "up"):
        if wanted in active:
            print(art.box([f"the veil already rises — {wanted}"], title="Ether", body_style=(art.P.MUTED,), width=art.term_width()))
            return 0
        r = _nmcli(["con", "up", wanted], timeout=90)
        if r.returncode != 0:
            print(art.box([f"could not raise {wanted}: {(r.stderr or r.stdout or '').strip()}"], title="Ether", body_style=(art.P.WARN,), width=art.term_width()))
            return 1
        print(art.box([f"the veil rises — {wanted}"], title="Ether", body_style=(art.P.OK,), width=art.term_width()))
        return 0

    if action in ("off", "lower", "down"):
        if wanted not in active:
            print(art.box([f"the veil already falls — {wanted} is down"], title="Ether", body_style=(art.P.MUTED,), width=art.term_width()))
            return 0
        r = _nmcli(["con", "down", wanted], timeout=90)
        if r.returncode != 0:
            print(art.box([f"could not lower {wanted}: {(r.stderr or r.stdout or '').strip()}"], title="Ether", body_style=(art.P.WARN,), width=art.term_width()))
            return 1
        print(art.box([f"the veil falls — {wanted}"], title="Ether", body_style=(art.P.OK,), width=art.term_width()))
        return 0

    # toggle
    if wanted in active:
        return cmd_veil(argparse.Namespace(action="off", name=args.name))
    return cmd_veil(argparse.Namespace(action="on", name=args.name))


def cmd_bridge(args: argparse.Namespace) -> int:
    """Boot fallback used by ether-bridge.service: bridge to the phone hotspot
    when no other real link is up."""
    if not shutil.which("nmcli"):
        return 1
    if not NETHER_CON:
        if not args.quiet:
            eprint("no hotspot configured — nothing to weave")
        return 1
    active = _nmcli(["-t", "-f", "NAME,TYPE", "con", "show", "--active"])
    has_real = False
    for ln in (active.stdout or "").splitlines():
        if ":loopback" in ln or ln.endswith(":lo"):
            continue
        has_real = True
        break
    if has_real:
        return 0
    if not args.quiet:
        eprint(f"no real link up — bridging to phone hotspot ({NETHER_CON})…")
    r = _nmcli(["con", "up", NETHER_CON], timeout=90)
    if r.returncode != 0:
        if not args.quiet:
            eprint(f"bridge failed: {(r.stderr or r.stdout or '').strip()}")
        return 1
    if not args.quiet:
        eprint("tether bound.")
    return 0


# ---------------------------------------------------------------------------
# ether ap — the house Wi-Fi access point (NetworkManager-free)
# ---------------------------------------------------------------------------
# NM-free on purpose: bridge/veil keep their nmcli phone-client path, but the
# AP is driven straight on the radio with iw + hostapd (+ dnsmasq for DHCP
# when present). No NetworkManager state is read or written here.

_AP_NET = "192.168.42.1/24"


def _ap_runtime() -> Path:
    """Private runtime dir for hostapd/dnsmasq conf + pids (0700)."""
    p = Path(f"/run/user/{os.getuid()}/ether")
    p.mkdir(parents=True, exist_ok=True)
    os.chmod(p, 0o700)
    return p


def _ap_conf(iface: str, daemon: str) -> Path:
    return _ap_runtime() / f"{daemon}.{iface}.conf"


def _ap_pidfile(iface: str, daemon: str) -> Path:
    return _ap_runtime() / f"{daemon}.{iface}.pid"


def _iw_dev_type(dev: str) -> str:
    """managed | monitor | ap | … — from `iw dev <dev> info`."""
    iw = shutil.which("iw")
    if not iw:
        return "?"
    try:
        r = subprocess.run([iw, "dev", dev, "info"], text=True,
                           capture_output=True, timeout=10, check=False)
    except (subprocess.TimeoutExpired, OSError):
        return "?"
    m = re.search(r"^\s*type\s+(\S+)", r.stdout or "", re.M)
    return m.group(1) if m else "?"


def _iw_channel(dev: str) -> tuple[str, int]:
    """(hw_mode, channel) from `iw dev <dev> info` — ('g', 10)."""
    iw = shutil.which("iw")
    if not iw:
        return ("g", 6)
    try:
        r = subprocess.run([iw, "dev", dev, "info"], text=True,
                           capture_output=True, timeout=10, check=False)
    except (subprocess.TimeoutExpired, OSError):
        return ("g", 6)
    m = re.search(r"channel\s+(\d+)\s+\((\d+)\s+MHz\)", r.stdout or "")
    if not m:
        return ("g", 6)
    chan, mhz = int(m.group(1)), int(m.group(2))
    return ("a" if mhz >= 3000 else "g", chan)


def _proc_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _daemon_alive(iface: str, daemon: str) -> bool:
    """True when our pidfile names a live `daemon` process on this iface."""
    try:
        pid = int(_ap_pidfile(iface, daemon).read_text(
            encoding="utf-8").strip())
    except (OSError, ValueError):
        return False
    if not _proc_alive(pid):
        return False
    try:
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes().replace(
            b"\0", b" ").decode(errors="replace")
    except OSError:
        return False
    return daemon in cmd and iface in cmd


def _stop_daemon(iface: str, daemon: str) -> None:
    """Terminate one daemon we started (pidfile, never a blind pkill)."""
    try:
        pid = int(_ap_pidfile(iface, daemon).read_text(
            encoding="utf-8").strip())
    except (OSError, ValueError):
        return
    if _proc_alive(pid):
        try:
            os.kill(pid, 15)
            for _ in range(20):
                if not _proc_alive(pid):
                    break
                time.sleep(0.1)
            if _proc_alive(pid):
                os.kill(pid, 9)
        except OSError:
            pass
    try:
        _ap_pidfile(iface, daemon).unlink()
    except OSError:
        pass


def cmd_ap(args: argparse.Namespace) -> int:
    """Raise / lower / report the house AP — iw + hostapd, no nmcli."""
    cfg = _load_ap_env()
    iface = cfg["iface"] or "wlp41s0"
    action = (args.action or "status").lower()

    if action == "status":
        ssid = cfg["ssid"] or "—"
        psk = "psk set" if len(cfg["psk"]) >= 8 else "psk missing"
        print(f"iface {iface}  type {_iw_dev_type(iface)}  ssid {ssid}"
              f"  {psk}  hostapd {'up' if _daemon_alive(iface, 'hostapd') else 'down'}")
        if not cfg["ssid"]:
            eprint("no AP credentials — write ~/.config/ether/ap.env (0600):")
            eprint("  ETHER_AP_IFACE=wlp41s0  ETHER_AP_SSID=…  ETHER_AP_PSK=… (8+ chars)")
            return 1
        return 0

    if action == "off":
        _stop_daemon(iface, "dnsmasq")
        _stop_daemon(iface, "hostapd")
        for f in (_ap_conf(iface, "hostapd"), _ap_conf(iface, "dnsmasq")):
            try:
                f.unlink()
            except OSError:
                pass
        # Restore a sane state: leave __ap, come back managed (never monitor).
        subprocess.run(["ip", "link", "set", iface, "down"],
                       capture_output=True, timeout=15, check=False)
        subprocess.run(["iw", "dev", iface, "set", "type", "managed"],
                       capture_output=True, timeout=15, check=False)
        subprocess.run(["ip", "link", "set", iface, "up"],
                       capture_output=True, timeout=15, check=False)
        print(f"ap down — {iface} managed")
        return 0

    # action == "on"
    hostapd = shutil.which("hostapd")
    if not hostapd:
        eprint("hostapd is not installed — the house AP cannot rise.")
        eprint("  install:  pacman -S hostapd")
        return 1
    if not shutil.which("iw") or not shutil.which("ip"):
        eprint("the house AP path needs iw and ip (iproute2).")
        return 1
    if not cfg["ssid"] or len(cfg["psk"]) < 8:
        eprint("no AP credentials — write ~/.config/ether/ap.env (0600):")
        eprint("  ETHER_AP_IFACE=wlp41s0  ETHER_AP_SSID=…  ETHER_AP_PSK=… (8+ chars)")
        return 1
    if _daemon_alive(iface, "hostapd"):
        print(f"ap already up — ssid {cfg['ssid']} on {iface}")
        return 0

    # Leave monitor if the radio sits there (aircrack leftover), then __ap.
    cur = _iw_dev_type(iface)
    if cur == "monitor":
        subprocess.run(["ip", "link", "set", iface, "down"],
                       capture_output=True, timeout=15, check=False)
        subprocess.run(["iw", "dev", iface, "set", "type", "__ap"],
                       capture_output=True, timeout=15, check=False)
    if _iw_dev_type(iface) not in ("ap", "__ap"):
        r = subprocess.run(["iw", "dev", iface, "set", "type", "__ap"],
                           capture_output=True, timeout=15, check=False)
        if r.returncode != 0:
            eprint(f"cannot set {iface} to AP mode: {(r.stderr or '').strip()}")
            return 1

    hw_mode, chan = _iw_channel(iface)
    conf = _ap_conf(iface, "hostapd")
    conf.write_text(
        f"interface={iface}\n"
        f"driver=nl80211\n"
        f"ssid={cfg['ssid']}\n"
        f"hw_mode={hw_mode}\n"
        f"channel={chan}\n"
        f"wpa=2\n"
        f"wpa_passphrase={cfg['psk']}\n"
        f"wpa_key_mgmt=WPA-PSK\n"
        f"rsn_pairwise=CCMP\n",
        encoding="utf-8",
    )
    os.chmod(conf, 0o600)

    subprocess.run(["ip", "addr", "flush", "dev", iface],
                   capture_output=True, timeout=15, check=False)
    subprocess.run(["ip", "addr", "add", _AP_NET, "dev", iface],
                   capture_output=True, timeout=15, check=False)
    subprocess.run(["ip", "link", "set", iface, "up"],
                   capture_output=True, timeout=15, check=False)

    proc = subprocess.Popen(
        [hostapd, "-P", str(_ap_pidfile(iface, "hostapd")), str(conf)],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
        start_new_session=True,
    )
    _ap_pidfile(iface, "hostapd").write_text(str(proc.pid), encoding="utf-8")

    up = False
    err = ""
    for _ in range(30):  # ~3s for hostapd to come up or fail
        time.sleep(0.1)
        if proc.poll() is not None:
            err = (proc.stderr.read() or b"").decode(errors="replace").strip()
            break
        if _daemon_alive(iface, "hostapd") and _iw_dev_type(iface) == "ap":
            up = True
            break
    if not up:
        _stop_daemon(iface, "hostapd")
        try:
            conf.unlink()
        except OSError:
            pass
        eprint(f"hostapd failed on {iface}: {err or 'no AP mode after 3s'}")
        return 1

    # Tiny DHCP for clients on the AP (speakers need addresses). Optional.
    dnsmasq = shutil.which("dnsmasq")
    if dnsmasq:
        dconf = _ap_conf(iface, "dnsmasq")
        dconf.write_text(
            f"interface={iface}\n"
            f"dhcp-range={_AP_NET.rsplit('.', 1)[0]}.50,{_AP_NET.rsplit('.', 1)[0]}.150,12h\n"
            f"dhcp-option=3,{_AP_NET.split('/')[0]}\n",
            encoding="utf-8",
        )
        os.chmod(dconf, 0o600)
        dproc = subprocess.Popen(
            [dnsmasq, "--no-daemon", "--pid-file"
             f"={_ap_pidfile(iface, 'dnsmasq')}", "-C", str(dconf)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        _ap_pidfile(iface, "dnsmasq").write_text(str(dproc.pid), encoding="utf-8")
        dhcp = " + dhcp"
    else:
        eprint("no dnsmasq — clients need static addresses on "
               f"{_AP_NET.rsplit('.', 1)[0]}.0/24 (optional: pacman -S dnsmasq)")
        dhcp = ""

    print(f"ap up — ssid {cfg['ssid']} on {iface} ({_AP_NET}){dhcp}")
    return 0


# ---------------------------------------------------------------------------
# ether link — network path discovery & selection
# ---------------------------------------------------------------------------
# Distinguishes wired LAN (PCI/onboard ethernet) from USB tether / USB
# network adapters, wifi and vpn/other paths. Signals used: sysfs uevent
# (DEVTYPE), sysfs device symlink (a USB bus in the path = USB NIC),
# sysfs speed/carrier/operstate, `ip` routing state and — when present —
# systemd-networkd per-interface state (networkctl status). No root needed
# to discover; selection steers routes/metrics via `ip route` and triggers
# DHCP via `networkctl reconfigure` — never touches tailscale.

_LINK_CFG = os.path.expanduser("~/.config/ether/link.json")
_LINK_METRIC_PREF = 50   # preferred path
_LINK_METRIC_BACK = 100  # demoted path


def _ip(*args: str, timeout: float = 8) -> str:
    """Run ip(8) and return stdout; "" when unavailable."""
    ip = shutil.which("ip")
    if not ip:
        return ""
    try:
        r = subprocess.run([ip, *args], text=True, capture_output=True,
                           timeout=timeout, check=False)
        return r.stdout or ""
    except (subprocess.TimeoutExpired, OSError):
        return ""


def _networkctl_status(dev: str, timeout: float = 8) -> dict:
    """Parse `networkctl status <dev>` — networkd's view of one interface.

    Returns {state, addresses, gateway, dns, network_file}; {} when
    networkctl is unavailable or the query fails. Never needs root.
    """
    nc = shutil.which("networkctl")
    if not nc:
        return {}
    try:
        r = subprocess.run([nc, "status", dev], text=True,
                           capture_output=True, timeout=timeout,
                           check=False)
    except (subprocess.TimeoutExpired, OSError):
        return {}
    if r.returncode != 0 and not (r.stdout or "").strip():
        return {}
    info: dict = {"state": "", "addresses": [], "gateway": "",
                  "dns": [], "network_file": ""}
    for ln in (r.stdout or "").splitlines():
        key, _, val = ln.strip().partition(":")
        key = key.strip().lower()
        val = val.strip()
        if key == "state":
            info["state"] = val
        elif key == "address" and val:
            info["addresses"].append(val.split()[0])
        elif key == "gateway" and val:
            info["gateway"] = val.split()[0]
        elif key == "dns" and val:
            info["dns"].append(val.split()[0])
        elif key == "network file" and val:
            info["network_file"] = val
    return info


def _sysfs(dev: str, name: str) -> str:
    try:
        return (Path("/sys/class/net") / dev / name).read_text(
            encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def _default_routes() -> list[dict]:
    """Every default route, lowest metric first."""
    routes: list[dict] = []
    for ln in _ip("route", "show", "default").splitlines():
        rt: dict = {"via": "", "dev": "", "metric": 0, "raw": ln.strip()}
        parts = ln.split()
        for i, p in enumerate(parts):
            nxt = parts[i + 1] if i + 1 < len(parts) else ""
            if p == "via":
                rt["via"] = nxt
            elif p == "dev":
                rt["dev"] = nxt
            elif p == "metric":
                try:
                    rt["metric"] = int(nxt)
                except ValueError:
                    pass
        if rt["dev"]:
            routes.append(rt)
    routes.sort(key=lambda r: r["metric"])
    return routes


def _iface_ips() -> dict[str, list[str]]:
    """dev → [ipv4…] parsed from `ip -4 addr show` (works on any iproute2)."""
    out: dict[str, list[str]] = {}
    dev = ""
    for ln in _ip("-4", "addr", "show").splitlines():
        if ln and not ln[0].isspace():
            m = re.match(r"\d+:\s+([^:\s]+):", ln)
            dev = m.group(1) if m else ""
        elif "inet " in ln and dev:
            m = re.search(r"inet\s+(\S+)", ln)
            if m:
                out.setdefault(dev, []).append(m.group(1))
    return out


def _iface_kind(dev: str, devlink: str, uevent: str, wireless: bool) -> str:
    """lan | usb | wifi | vpn | other | loopback."""
    if dev == "lo":
        return "loopback"
    if "/usb" in devlink:
        return "usb"           # USB tether or USB NIC (device hangs off a usb bus)
    if wireless or "DEVTYPE=wlan" in uevent:
        return "wifi"
    if devlink.startswith("/sys/devices/virtual"):
        return "vpn" if "vpn" in dev.lower() else "other"
    return "lan"             # plain PCI / onboard ethernet


def _path_label(kind: str, dev: str) -> str:
    if kind == "lan":
        return "wired LAN"
    if kind == "usb":
        return "USB tether"
    if kind == "wifi":
        return "wifi"
    if kind == "vpn":
        return "VPN"
    if "tailscale" in dev.lower():
        return "tailscale"
    return "other path"


def _load_selection() -> dict:
    try:
        with open(_LINK_CFG) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def _save_selection(sel: dict) -> None:
    try:
        os.makedirs(os.path.dirname(_LINK_CFG), exist_ok=True)
        with open(_LINK_CFG, "w") as f:
            json.dump(sel, f)
    except OSError:
        pass


def discover_paths() -> dict:
    """Every network path + the effective default route.

    Works with systemd-networkd (networkctl) or plain iproute2;
    no root required.
    """
    out: dict = {
        "default": None,
        "paths": [],
        "networkmanager": bool(shutil.which("nmcli")),
        "networkd": bool(shutil.which("networkctl")),
        "selection": _load_selection(),
    }
    routes = _default_routes()
    if routes:
        out["default"] = routes[0]

    dev_route: dict[str, dict] = {}
    for rt in routes:
        dev_route.setdefault(rt["dev"], rt)

    ipmap = _iface_ips()

    try:
        devs = sorted(os.listdir("/sys/class/net"))
    except OSError:
        devs = []

    for dev in devs:
        base = Path("/sys/class/net") / dev
        uevent = ""
        devlink = ""
        wireless = False
        try:
            uevent = (base / "uevent").read_text(encoding="utf-8",
                                                 errors="replace")
            devlink = os.path.realpath(base / "device")
            wireless = (base / "wireless").is_dir()
        except OSError:
            continue
        kind = _iface_kind(dev, devlink, uevent, wireless)
        if kind == "loopback":
            continue
        try:
            driver = os.path.basename(os.readlink(base / "device" / "driver"))
        except OSError:
            driver = ""
        try:
            spd = int(_sysfs(dev, "speed"))
            speed = spd if spd > 0 else None
        except ValueError:
            speed = None
        carrier = _sysfs(dev, "carrier") == "1"
        operup = _sysfs(dev, "operstate") == "up"
        nc = _networkctl_status(dev) if out["networkd"] else {}
        out["paths"].append({
            "dev": dev,
            "kind": kind,
            "label": _path_label(kind, dev),
            "driver": driver,
            "speed": speed,
            "operstate": _sysfs(dev, "operstate"),
            "carrier": carrier,
            "ips": ipmap.get(dev, []),
            "gateway": (dev_route.get(dev, {}).get("via", "")
                        or nc.get("gateway", "")),
            "metric": dev_route.get(dev, {}).get("metric"),
            "connection": (os.path.basename(nc["network_file"])
                           if nc.get("network_file") else nc.get("state", "")),
            "nm_type": "networkd" if nc else "",
            "nm_state": nc.get("state", ""),
            "networkd": nc,
            "current": bool(routes and routes[0]["dev"] == dev),
            "usable": (carrier or operup) and bool(ipmap.get(dev)),
        })
    return out


def _run_cmd(cmd: list[str], *, timeout: float = 90) -> tuple[bool, str]:
    """Run cmd; escalate to `sudo -n` only when the plain run is denied."""
    def once(argv: list[str]) -> tuple[bool, str]:
        try:
            r = subprocess.run(argv, text=True, capture_output=True,
                               timeout=timeout, check=False)
            tail = (r.stderr or r.stdout or "").strip().splitlines()
            return r.returncode == 0, (tail[-1] if tail else "")
        except subprocess.TimeoutExpired:
            return False, "timed out"
        except OSError as e:
            return False, str(e)

    ok, out = once(cmd)
    if ok:
        return True, out
    if not any(k in out.lower() for k in
               ("permission", "permitted", "denied", "authorized",
                "allowed", "commit")):
        return False, out
    sok, sout = once(["sudo", "-n", *cmd])
    if sok:
        return True, "(via sudo) " + sout
    return False, "needs sudo — run as root: sudo " + " ".join(cmd)


def _select_path(cand: dict, disc: dict) -> tuple[bool, str, list[list[str]]]:
    """Plan how to make `cand` the preferred internet path
    (systemd-networkd / iproute2 — never NetworkManager).

    Returns (ok, error, commands). Metric steering only: the current
    managed path is demoted, the target promoted — tailscale / vpn /
    other paths are never touched.
    """
    cmds: list[list[str]] = []
    cur = disc.get("default") or {}
    cur_cand = next((p for p in disc.get("paths", [])
                     if p.get("dev") == cur.get("dev")), None)

    def managed(p: dict) -> bool:
        """Paths we may steer — never tailscale / vpn."""
        return (p.get("kind") in ("lan", "usb", "wifi")
                and "tailscale" not in p.get("dev", "").lower())

    # demote the current path (only paths we manage — never tailscale)
    if (cur_cand and cur_cand["dev"] != cand["dev"]
            and managed(cur_cand)
            and cur_cand.get("gateway")
            and cur_cand["gateway"] != cand.get("gateway")):
        cmds.append(["ip", "route", "replace", "default",
                     "via", cur_cand["gateway"],
                     "dev", cur_cand["dev"],
                     "metric", str(_LINK_METRIC_BACK)])

    # promote the target
    if cand.get("gateway"):
        cmds.append(["ip", "route", "replace", "default",
                     "via", cand["gateway"], "dev", cand["dev"],
                     "metric", str(_LINK_METRIC_PREF)])
    elif cand.get("kind") == "lan":
        # No gateway yet — trigger DHCP so a lease (and its default
        # route) appears. The interface's .network file carries a
        # [DHCPv4] RouteMetric, so networkd installs the route at
        # the preferred metric automatically.
        cmds.append(["networkctl", "reconfigure", cand["dev"]])
    else:
        return False, (f"no gateway on {cand['label']} ({cand['dev']}) "
                       "— is it connected?"), cmds
    return True, "", cmds


def cmd_link(args: argparse.Namespace) -> int:
    """ether link — show / select the preferred network path."""
    quiet = bool(getattr(args, "quiet", False))
    disc = discover_paths()
    paths = disc.get("paths", [])
    cur = disc.get("default") or {}
    cur_cand = next((p for p in paths if p.get("dev") == cur.get("dev")), None)

    if getattr(args, "json", False):
        print(json.dumps(disc, indent=2))
        return 0

    target = (getattr(args, "target", None) or "").strip().lower()
    if not target:
        if quiet:
            return 0
        banner("Ether ✦", "link — network paths")
        lines: list[str] = []
        if cur_cand:
            first_ip = cur_cand["ips"][0] if cur_cand["ips"] else "—"
            via = f"  via {cur['via']}" if cur.get("via") else ""
            lines.append(art.paint(
                f"  ▶ current: {cur_cand['label']}  ·  {cur['dev']}  ·  "
                f"{first_ip}{via}  ·  metric {cur.get('metric', 0)}", P.OK))
        elif cur.get("dev"):
            lines.append(art.paint(f"  ▶ current: {cur['dev']} (unmanaged path)",
                                   P.WARN))
        else:
            lines.append(art.paint("  ▶ current: no default route — offline?",
                                   P.WARN))
        sel = disc.get("selection") or {}
        if sel.get("preferred"):
            lines.append(art.paint(f"  · selected: {sel['preferred']}", P.MUTED))
        lines.append("")
        lines.append(art.paint("  candidates:", "1;" + P.PINK))
        if not paths:
            lines.append(art.paint("    no network paths found", P.MUTED))
        order = {"lan": 0, "usb": 1, "wifi": 2, "vpn": 3}
        for p in sorted(paths, key=lambda p: (order.get(p["kind"], 4), p["dev"])):
            mark = "▶" if p.get("current") else "·"
            state = "usable" if p.get("usable") else "down"
            speed = f"  {p['speed']}M" if p.get("speed") else ""
            ips = p["ips"][0] if p["ips"] else "—"
            con = f"  ({p['connection']})" if p.get("connection") else ""
            tag = "  ◀ current" if p.get("current") else ""
            lines.append(f"    {mark}  {p['label']:<12}  {p['dev']:<16}  "
                         f"{ips:<18}{speed}  {state}{con}{tag}")
        lines.append("")
        lines.append(art.paint(
            "  select: ether link lan | usb | tether | wifi | <connection>",
            P.MUTED))
        print(art.box(lines, title="link", width=art.term_width(),
                      body_style=(P.SILVER,)))
        print()
        return 0

    # ── selection ──────────────────────────────────────────────
    aliases = {"lan": "lan", "wired": "lan", "ethernet": "lan",
               "usb": "usb", "tether": "usb", "tethering": "usb",
               "wifi": "wifi", "wireless": "wifi"}
    want = aliases.get(target, target)
    if want in ("lan", "usb", "wifi", "vpn"):
        cand = next((p for p in paths if p.get("kind") == want and p.get("usable")), None)
        if cand is None:
            cand = next((p for p in paths if p.get("kind") == want), None)
    else:
        cand = next((p for p in paths
                     if want in (p.get("connection") or "").lower()
                     or want == p.get("dev").lower()), None)

    kinds = ", ".join(sorted({p["kind"] for p in paths})) or "none"
    if cand is None:
        if not quiet:
            print(art.box([f"no such path — {target}",
                           f"candidates: {kinds}"],
                          title="Ether", body_style=(P.WARN),
                          width=art.term_width()))
        return 1

    sel = {"preferred": cand.get("connection") or cand["kind"],
           "dev": cand["dev"], "ts": int(time.time())}
    if cand.get("current") and not getattr(args, "dry_run", False):
        _save_selection(sel)
        if not quiet:
            print(art.box([f"{cand['label']} ({cand['dev']}) already carries "
                           "the default route"],
                          title="Ether", body_style=(P.OK,), width=art.term_width()))
        return 0

    ok, err, cmds = _select_path(cand, disc)
    if not ok:
        if not quiet:
            print(art.box([err], title="Ether", body_style=(P.WARN),
                          width=art.term_width()))
        return 1

    if getattr(args, "dry_run", False):
        lines = [f"dry run — would steer the ether to {cand['label']} ({cand['dev']})"]
        lines += [f"  $ {' '.join(c)}" for c in cmds]
        if any(c[0] == "networkctl" for c in cmds):
            lines.append(f"  # DHCP on {cand['dev']} will then install its "
                         f"default route at metric {_LINK_METRIC_PREF}")
        if not quiet:
            print(art.box(lines, title="Ether", body_style=(P.MUTED,),
                          width=art.term_width()))
        return 0

    for c in cmds:
        cok, cout = _run_cmd(c)
        if not cok:
            if not quiet:
                print(art.box([f"could not steer the ether to {cand['label']}: "
                               f"{cout}"],
                              title="Ether", body_style=(P.WARN),
                              width=art.term_width()))
            return 1
    _save_selection(sel)
    if not quiet:
        print(art.box([f"the ether bends to {cand['label']} ({cand['dev']})"],
                      title="Ether", body_style=(P.OK,), width=art.term_width()))
    return 0


# ---------------------------------------------------------------------------
# Bluetooth weave helpers
# ---------------------------------------------------------------------------

def _bt(mac: str, *verb: str, timeout: float = 30) -> str:
    try:
        r = subprocess.run(
            ["bluetoothctl", *verb, mac],
            text=True, capture_output=True, timeout=timeout, check=False,
        )
        return (r.stdout or "") + (r.stderr or "")
    except (subprocess.TimeoutExpired, OSError):
        return ""


def _bt_connected(mac: str) -> bool:
    out = _bt(mac, "info", timeout=5)
    return "Connected: yes" in out


def _bt_devices() -> list[tuple[str, str]]:
    """(mac, name) of every device bluetoothd has seen."""
    out = []
    try:
        r = subprocess.run(
            ["bluetoothctl", "devices"],
            text=True, capture_output=True, timeout=8, check=False,
        )
    except (subprocess.TimeoutExpired, OSError):
        return out
    for ln in (r.stdout or "").splitlines():
        parts = ln.split()
        if len(parts) >= 2 and parts[0] == "Device":
            mac = parts[1]
            name = " ".join(parts[2:]) or mac
            out.append((mac, name))
    return out


def _bt_state(mac: str) -> dict:
    """connected / paired / trusted / battery for one device."""
    state = {"connected": False, "paired": False, "trusted": False, "battery": None}
    out = _bt(mac, "info", timeout=5)
    for ln in out.splitlines():
        ln = ln.strip()
        if ln.startswith("Connected:"):
            state["connected"] = ln.endswith("yes")
        elif ln.startswith("Paired:"):
            state["paired"] = ln.endswith("yes")
        elif ln.startswith("Trusted:"):
            state["trusted"] = ln.endswith("yes")
        elif "Battery Percentage:" in ln:
            raw = ln.rsplit(":", 1)[-1].strip().split()[0]
            try:
                state["battery"] = int(raw, 16) if raw.lower().startswith("0x") else int(raw)
            except ValueError:
                pass
    return state


def _wpctl_sinks() -> list[tuple[int, str, bool]]:
    """(id, name, is_default) for every pipewire sink."""
    out = []
    try:
        r = subprocess.run(
            ["wpctl", "status"],
            text=True, capture_output=True, timeout=8, check=False,
        )
    except (subprocess.TimeoutExpired, OSError):
        return out
    for ln in (r.stdout or "").splitlines():
        if "[vol:" not in ln:
            continue
        head = ln.split("[vol:")[0]
        is_default = "*" in head
        m = re.search(r"(\d+)\.\s+(.*?)\s*$", head)
        if m:
            out.append((int(m.group(1)), m.group(2).strip(), is_default))
    return out


def _find_sink_id(name: str, retries: int = 6) -> int | None:
    for _ in range(retries):
        for sid, sname, _d in _wpctl_sinks():
            if sname == name or sname in name or name in sname:
                return sid
        time.sleep(1)
    return None


def _weave(verb: str) -> tuple[bool, str]:
    """whisper / listen core — returns (ok, message); never prints."""
    target_mac, target_name = WEAVES[verb]
    others = [mac for v, (mac, _n) in WEAVES.items() if v != verb]

    if not _bt_connected(target_mac):
        out = _bt(target_mac, "connect", timeout=30)
        if "Failed to connect" in out:
            return False, f"could not reach the {verb}ing one — is it powered on?\n  ({target_name}  {target_mac})"

    for mac in others:
        if _bt_connected(mac):
            _bt(mac, "disconnect", timeout=10)

    sink_id = _find_sink_id(target_name)
    if sink_id is None:
        return False, f"sink '{target_name}' not found in pipewire — is the weave alive?"

    try:
        subprocess.run(["wpctl", "set-default", str(sink_id)], text=True, capture_output=True, timeout=10, check=False)
    except OSError:
        pass

    if verb == "whisper":
        msg = f"A quiet whisper threads through the ether — {target_name} (sink {sink_id})"
    else:
        msg = f"The ether bends to listen — {target_name} (sink {sink_id})"
    return True, msg


def cmd_weave(verb: str, token: str | None) -> int:
    """whisper ether / listen ether — point the aether at one voice."""
    if token not in (None, "", "ether"):
        print(art.box(
            [f"no such weave — {token}", "the ether only answers to: whisper / listen / status"],
            title="Ether", body_style=(art.P.WARN,), width=art.term_width(),
        ))
        print()
        return 1

    ok, msg = _weave(verb)
    print(art.box([msg], title="Ether",
                  body_style=(art.P.OK,) if ok else (art.P.WARN,),
                  width=art.term_width()))
    print()
    return 0 if ok else 1


# ---------------------------------------------------------------------------
# status TUI
# ---------------------------------------------------------------------------

# ── HEOS speakers (Denon / D&M) on the LAN ────────────────────────────
# Discovery is deliberately UNICAST first: SSDP multicast
# (239.255.255.250:1900) often gets zero replies here — ufw/conntrack
# drops the unicast replies to our M-SEARCH — while a fast parallel TCP
# sweep of port 1255 (the HEOS control API) always works. Any HEOS box
# answers get_players with the WHOLE fleet roster, one connection is
# enough. Protocol: newline-terminated `heos://…` URIs, JSON replies.
_HEOS_PORT = 1255
_HEOS_CACHE = os.path.expanduser("~/.config/ether/heos.json")


def _heos_rpc(ip: str, uris: list[str], timeout: float = 3.0) -> list[dict]:
    """Send newline-terminated heos:// commands; parse every JSON reply."""
    try:
        s = socket.create_connection((ip, _HEOS_PORT), timeout=timeout)
        s.settimeout(timeout)
        for u in uris:
            s.sendall((u + "\n").encode())
        data = b""
        while len(data) < 65536:
            try:
                chunk = s.recv(8192)
            except socket.timeout:
                break
            if not chunk:
                break
            data += chunk
            s.settimeout(0.5)  # idle gap → end of a batched reply
        s.close()
    except OSError:
        return []
    objs: list[dict] = []
    dec = json.JSONDecoder()
    txt = data.decode("utf-8", "replace")
    idx = 0
    while idx < len(txt):
        while idx < len(txt) and txt[idx] in " \r\n\t":
            idx += 1
        if idx >= len(txt):
            break
        try:
            obj, idx = dec.raw_decode(txt, idx)
        except ValueError:
            break
        if isinstance(obj, dict):
            objs.append(obj)
    return objs


def _heos_ssdp(timeout: float = 1.0) -> list[str]:
    """Secondary path: SSDP M-SEARCH for HEOS devices (needs multicast)."""
    ips: list[str] = []
    msg = ("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\n"
           'MAN: "ssdp:discover"\r\nMX: 1\r\n'
           "ST: urn:schemas-upnp-org:device:HEOSDevice:1\r\n\r\n")
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
        s.bind(("", 0))
        s.settimeout(timeout)
        s.sendto(msg.encode(), ("239.255.255.250", 1900))
        t_end = time.time() + timeout
        while time.time() < t_end:
            try:
                data, addr = s.recvfrom(2048)
            except socket.timeout:
                break
            if b"HEOS" in data.upper() and addr[0] not in ips:
                ips.append(addr[0])
        s.close()
    except OSError:
        pass
    return ips


def _heos_local_ip() -> str:
    """Best-effort local IPv4 (UDP route lookup — no packets flow)."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(0.3)
        s.connect(("1.1.1.1", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip if not ip.startswith("127.") else ""
    except OSError:
        return ""


def _heos_sweep(timeout: float = 0.6) -> list[str]:
    """Primary path: parallel TCP/1255 sweep of the local /24."""
    local = _heos_local_ip()
    if not local:
        return []
    base = local.rsplit(".", 1)[0]

    def probe(n: int) -> str | None:
        cand = f"{base}.{n}"
        if cand == local:
            return None
        try:
            s = socket.create_connection((cand, _HEOS_PORT), timeout=timeout)
            s.close()
            return cand
        except OSError:
            return None

    hits: list[str] = []
    with ThreadPoolExecutor(max_workers=128) as pool:
        for hit in pool.map(probe, range(1, 255)):
            if hit:
                hits.append(hit)
    return hits


def _heos_fleet_from(ip: str) -> list[dict]:
    """get_players on one device — every HEOS box lists the whole fleet."""
    for obj in _heos_rpc(ip, ["heos://player/get_players"]):
        pl = obj.get("payload")
        if obj.get("heos", {}).get("result") == "success" and isinstance(pl, list):
            return [p for p in pl if isinstance(p, dict)]
    return []


def _heos_cache_write(players: list[dict]) -> None:
    try:
        os.makedirs(os.path.dirname(_HEOS_CACHE), exist_ok=True)
        with open(_HEOS_CACHE, "w") as f:
            json.dump({"ts": int(time.time()), "players": players}, f)
    except OSError:
        pass


def _heos_cached() -> list[dict]:
    try:
        with open(_HEOS_CACHE) as f:
            d = json.load(f)
        ps = d.get("players")
        return ps if isinstance(ps, list) else []
    except (OSError, ValueError):
        return []


def heos_roster(refresh: bool = True) -> list[dict]:
    """Every HEOS speaker on the LAN: name, model, ip, pid, network…"""
    if not refresh:
        return _heos_cached()
    try:
        for ip in _heos_ssdp() + _heos_sweep():
            players = _heos_fleet_from(ip)
            if players:
                _heos_cache_write(players)
                return players
    except OSError:
        pass
    return _heos_cached()  # nothing found — last known roster


def _heos_enrich(players: list[dict]) -> list[dict]:
    """Best effort: play state, volume, now-playing (one device answers all)."""
    ip = players[0].get("ip") if players else ""
    if not ip:
        return players
    for p in players:
        pid = p.get("pid")
        if not isinstance(pid, int):
            continue
        objs = _heos_rpc(ip, [
            f"heos://player/get_play_state?pid={pid}",
            f"heos://player/get_volume?pid={pid}",
        ])
        for o in objs:
            pl = o.get("payload")
            if isinstance(pl, dict):
                if "state" in pl:
                    p["state"] = pl.get("state")
                if "level" in pl:
                    p["volume"] = pl.get("level")
            he = o.get("heos", {})
            # some firmwares put state/volume in message querystring
            msg = he.get("message", "")
            if isinstance(msg, str) and "state=" in msg:
                for kv in msg.split("&"):
                    if "=" in kv:
                        k, v = kv.split("=", 1)
                        if k == "state":
                            p["state"] = v
                        elif k == "level":
                            try: p["volume"] = int(v)
                            except: pass
        if p.get("state") == "play":
            for o in _heos_rpc(ip, [f"heos://player/get_now_playing_info?pid={pid}"]):
                pl = o.get("payload")
                if isinstance(pl, dict):
                    bits = [x for x in (pl.get("artist"), pl.get("song") or pl.get("station")) if x]
                    if bits:
                        p["now"] = " — ".join(bits)
    return players


# ── HEOS controls (transport + cast) ──────────────────────────────
_HEOS_DEFAULT = "Vanguarda Office"
_HEOS_HTTP_PORT = 8099
_HEOS_HTTP_INFO = os.path.expanduser("~/.config/ether/heos-http.json")


def _heos_resolve(name: str | None) -> tuple[str, int, dict] | None:
    roster = heos_roster(refresh=False)
    if not roster:
        roster = heos_roster(refresh=True)
    if not roster:
        return None
    if not name:
        for p in roster:
            if "vanguarda" in str(p.get("name","")).lower():
                return (str(p["ip"]), int(p["pid"]), p)
        p = roster[0]
        return (str(p["ip"]), int(p["pid"]), p)
    lo = name.lower()
    for p in roster:
        if lo in str(p.get("name","")).lower():
            return (str(p["ip"]), int(p["pid"]), p)
        if lo == str(p.get("pid")):
            return (str(p["ip"]), int(p["pid"]), p)
    # refresh once more with that hint
    roster = heos_roster(refresh=True)
    for p in roster:
        if lo in str(p.get("name","")).lower():
            return (str(p["ip"]), int(p["pid"]), p)
    return None


def _heos_ok(objs: list[dict]) -> bool:
    return any(o.get("heos",{}).get("result") == "success" for o in objs)

def _heos_set_state(pid: int, ip: str, state: str) -> bool:
    return _heos_ok(_heos_rpc(ip, [f"heos://player/set_play_state?pid={pid}&state={state}"]))

def _heos_set_volume(pid: int, ip: str, level: int) -> bool:
    level = max(0, min(100, int(level)))
    return _heos_ok(_heos_rpc(ip, [f"heos://player/set_volume?pid={pid}&level={level}"]))

def _heos_set_mute(pid: int, ip: str, on: bool) -> bool:
    return _heos_ok(_heos_rpc(ip, [f"heos://player/set_mute?pid={pid}&state={'on' if on else 'off'}"]))

def _heos_next(pid: int, ip: str) -> bool:
    return _heos_ok(_heos_rpc(ip, [f"heos://player/play_next?pid={pid}"]))

def _heos_prev(pid: int, ip: str) -> bool:
    return _heos_ok(_heos_rpc(ip, [f"heos://player/play_previous?pid={pid}"]))

def _heos_play_url(pid: int, ip: str, url: str) -> bool:
    q = urllib.parse.quote(url, safe="")
    return _heos_ok(_heos_rpc(ip, [f"heos://browse/play_stream?pid={pid}&url={q}"]))

def _heos_find_dlna_sid(ip: str) -> int | None:
    """Find VANGUARDA-DLNA sid via get_music_sources -> browse 1024."""
    for obj in _heos_rpc(ip, ["heos://browse/get_music_sources"]):
        for src in obj.get("payload",[]):
            if isinstance(src, dict) and src.get("type")=="heos_server" and "VANGUARDA" in str(src.get("name","")).upper():
                try: return int(src["sid"])
                except: pass
    # fallback: browse Local Music
    for obj in _heos_rpc(ip, ["heos://browse/browse?sid=1024"]):
        for src in obj.get("payload",[]):
            if isinstance(src, dict) and "VANGUARDA" in str(src.get("name","")).upper():
                try: return int(src["sid"])
                except: pass
    return None

def _heos_dlna_find(ip: str, sid: int, query: str) -> tuple[str,str] | None:
    """Search DLNA for query via browsing known containers. Returns (cid,mid)."""
    # known DLNA browse roots that contain music
    cands = ["1$4","1$14","64","1","64$0"]
    ql = query.lower()
    for cid in cands:
        for obj in _heos_rpc(ip, [f"heos://browse/browse?sid={sid}&cid={cid}"]):
            for item in obj.get("payload",[]):
                if not isinstance(item, dict): continue
                name = str(item.get("name","")).lower()
                if ql in name or ql.replace(" ","") in name.replace(" ",""):
                    if "mid" in item and "cid" in item:
                        return (str(item["cid"]), str(item["mid"]))
                    # also try via payload's container
                    if item.get("playable")=="yes" and "mid" in item:
                        return (cid, str(item["mid"]))
    return None

def _heos_dlna_cast(ip: str, pid: int, path: Path) -> bool:
    """Cast local file via DLNA (minidlna on 192.168.8.186:8200)."""
    # ensure file is in a DLNA media_dir
    dlna_dirs = [Path("/tmp/dlna"), Path.home()/"Music"]
    in_dlna = any(str(path.resolve()).startswith(str(d.resolve())) for d in dlna_dirs if d.exists())
    target = path
    if not in_dlna:
        dl = Path("/tmp/dlna"); dl.mkdir(parents=True, exist_ok=True)
        target = dl / path.name
        try:
            if not target.exists() or target.stat().st_size != path.stat().st_size:
                import shutil as _sh
                _sh.copy2(str(path), str(target))
        except Exception as e:
            raise RuntimeError(f"copy to DLNA failed: {e}")
        # trigger rescan: minidlnad inotify should pick it up, wait a bit
        time.sleep(1.2)
        # also force rescan if needed
        try:
            import subprocess as _sp
            _sp.run(["pkill","-USR1","minidlnad"], timeout=2)
        except: pass
        time.sleep(0.8)
    # find DLNA sid
    sid = _heos_find_dlna_sid(ip)
    if sid is None:
        # retry after short wait (minidlna notify interval 30s, but we poked)
        time.sleep(2)
        sid = _heos_find_dlna_sid(ip)
    if sid is None:
        raise RuntimeError("DLNA server VANGUARDA-DLNA not found — is minidlna running on 192.168.8.186:8200?")
    # find track
    query = target.stem if len(target.stem) >= 4 else target.name
    # try stem, then basename without ext, then full
    for q in [target.stem, target.name, query[:12]]:
        found = _heos_dlna_find(ip, sid, q)
        if found:
            cid, mid = found
            # add_to_queue with aid=1 = play now
            ok = _heos_ok(_heos_rpc(ip, [f"heos://browse/add_to_queue?pid={pid}&sid={sid}&cid={cid}&mid={mid}&aid=1"]))
            if ok:
                return True
    raise RuntimeError(f"track not found in DLNA for query '{query}' (sid {sid})")

def _heos_serve_file(path: Path) -> tuple[str, int]:
    """Serve file's directory on LAN, return (url, port). Keeps daemon alive."""
    abspath = path.resolve()
    d = str(abspath.parent)
    fname = abspath.name
    lan = _heos_local_ip()
    if not lan:
        raise RuntimeError("no LAN IP — not on 192.168.8.x?")
    # find free port near _HEOS_HTTP_PORT
    port = _HEOS_HTTP_PORT
    for cand in range(port, port+20):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.5)
        try:
            s.bind(("0.0.0.0", cand)); s.close(); port = cand; break
        except OSError:
            s.close(); continue
    # launch daemon if not already serving same dir/port
    info = {}
    try:
        with open(_HEOS_HTTP_INFO) as f: info = json.load(f)
    except: pass
    # kill stale if port changed or dir changed
    if info.get("port") != port or info.get("dir") != d:
        try:
            old_pid = int(info.get("pid",0))
            os.kill(old_pid, 15)
        except: pass
    # start new http.server
    log = os.path.expanduser("~/.cache/ether-heos-http.log")
    os.makedirs(os.path.dirname(log), exist_ok=True)
    # detach
    proc = subprocess.Popen(
        ["python3","-m","http.server",str(port),"--bind","0.0.0.0","--directory",d],
        stdout=open(log,"a"), stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    info = {"port": port, "dir": d, "pid": proc.pid, "lan": lan}
    os.makedirs(os.path.dirname(_HEOS_HTTP_INFO), exist_ok=True)
    with open(_HEOS_HTTP_INFO,"w") as f: json.dump(info,f)
    time.sleep(0.6)  # let it bind
    url = f"http://{lan}:{port}/{urllib.parse.quote(fname)}"
    return url, port


def _collect_status() -> dict:
    data: dict = {"bt": [], "wifi": [], "lan": [], "sinks": [], "conns": [], "dls": [],
                  "heos": []}

    for mac, name in _bt_devices():
        state = _bt_state(mac)
        state.update({"mac": mac, "name": name})
        data["bt"].append(state)

    try:
        r = subprocess.run(
            ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL", "device", "wifi", "list"],
            text=True, capture_output=True, timeout=8, check=False,
        )
        for ln in (r.stdout or "").splitlines():
            parts = ln.split(":")
            if len(parts) >= 3:
                data["wifi"].append({"in_use": parts[0] == "*", "ssid": parts[1], "signal": parts[2]})
    except (subprocess.TimeoutExpired, OSError):
        pass

    try:
        r = _nmcli(["-t", "-f", "NAME,TYPE,DEVICE", "con", "show", "--active"], timeout=8)
        for ln in (r.stdout or "").splitlines():
            if not ln:
                continue
            parts = ln.split(":")
            if len(parts) >= 3:
                data["conns"].append({"name": parts[0], "type": parts[1], "dev": parts[2]})
    except (subprocess.TimeoutExpired, OSError):
        pass

    def tcp_probe(host: str, port: int, family: int, label: str) -> bool:
        try:
            infos = socket.getaddrinfo(host, port, family, socket.SOCK_STREAM)
        except socket.gaierror:
            data["lan"].append((label, False))
            return False
        for fam, _, _, _, addr in infos:
            try:
                s = socket.socket(fam, socket.SOCK_STREAM)
                s.settimeout(3)
                s.connect(addr[:2])
                s.close()
                data["lan"].append((label, True))
                return True
            except OSError:
                continue
        data["lan"].append((label, False))
        return False

    tcp_probe("1.1.1.1", 443, socket.AF_INET, "IPv4 :443")
    tcp_probe("2606:4700:4700::1111", 443, socket.AF_INET6, "IPv6 :443")
    tcp_probe("archive.org", 443, socket.AF_INET, "IA :443")

    data["sinks"] = _wpctl_sinks()
    data["dls"] = _collect_downloads()
    data["heos"] = _heos_cached()  # cache only — live sweep is `ether speakers`
    data["path"] = discover_paths()  # current + selected network path
    return data


def _bt_panel(data: dict, width: int) -> str:
    known = [d for d in data["bt"]
             if d["paired"] or d["connected"] or d["mac"] in [m for m, _n in WEAVES.values()]]
    lines = []
    if not known:
        lines.append(art.paint("  no devices woven yet — pair one with bluetoothctl", P.MUTED))
    for d in known:
        status = "on" if d["connected"] else "off"
        color = P.OK if d["connected"] else P.MUTED
        bat = f"  {d['battery']}%" if d["battery"] is not None else ""
        lines.append(f"  {'▶' if d['connected'] else '·'}  {art.paint(d['name'], color)}  {d['mac']}  {art.paint(status, color)}{bat}")
    if not known:
        for mac, name in WEAVES.values():
            lines.append(art.paint(f"  ·  {name}  {mac}  (unseen)", P.MUTED))
    return art.box(lines, title="bluetooth", width=width, body_style=(P.SILVER,))


def _wifi_panel(data: dict, width: int) -> str:
    lines = []
    if not data["wifi"]:
        lines.append(art.paint("  no networks in sight", P.MUTED))
    nets = sorted(data["wifi"], key=lambda x: -int(x["signal"] or 0))
    in_use = next((w for w in nets if w["in_use"]), None)
    shown = [w for w in nets[:8] if w is not in_use]
    if in_use:
        shown.insert(0, in_use)
    shown = shown[:8]
    for w in shown:
        mark = art.paint("▰", P.OK) if w["in_use"] else "·"
        sig = int(w["signal"] or 0)
        bar = "█" * max(0, sig // 20) + "░" * (5 - max(0, sig // 20))
        tag = art.paint("  ◀ woven", P.OK) if w["in_use"] else ""
        lines.append(f"  {mark}  {w['ssid'] or '(hidden)'}  {sig}%  {bar}{tag}")
    if len(nets) > len(shown):
        lines.append(art.paint(f"  … {len(nets) - len(shown)} more", P.MUTED))
    for c in data["conns"]:
        if c["type"] not in ("ethernet", "wifi"):
            continue
        dev = f" ({c['dev']})" if c["dev"] else ""
        lines.append(art.paint(f"  link: {c['name']}  ·  {c['type']}{dev}", P.PINK_DIM))
    return art.box(lines, title="wifi", width=width, body_style=(P.SILVER,))


def _lan_panel(data: dict, width: int) -> str:
    lines = []
    # current / selected network path (wired LAN vs USB tether vs …)
    path = data.get("path") or {}
    cur = path.get("default") or {}
    paths = path.get("paths") or []
    cur_cand = next((p for p in paths if p.get("dev") == cur.get("dev")), None)
    if cur_cand or paths:
        if cur_cand:
            first_ip = cur_cand["ips"][0] if cur_cand["ips"] else "—"
            lines.append(art.paint(
                f"  ▶ path: {cur_cand['label']}  ·  {cur['dev']}  ·  {first_ip}",
                P.OK))
        else:
            lines.append(art.paint(
                f"  ▶ path: {cur.get('dev', '—')}  ·  unmanaged", P.WARN))
        sel = path.get("selection") or {}
        if sel.get("preferred"):
            lines.append(art.paint(f"  · selected: {sel['preferred']}", P.MUTED))
        for p in paths:
            if p.get("dev") == cur.get("dev"):
                continue
            state = "usable" if p.get("usable") else "down"
            lines.append(art.paint(f"  · {p['label']}  {p['dev']}  {state}",
                                   P.MUTED))
        lines.append("")
    if not data["lan"]:
        lines.append(art.paint("  probing…", P.MUTED))
    for label, ok in data["lan"]:
        mark = art.paint("✓", P.OK) if ok else art.paint("✗", P.WARN)
        lines.append(f"  {mark}  {label}")
    default = next((s for s in data["sinks"] if s[2]), None)
    if default:
        lines.append("")
        lines.append(art.paint(f"  default sink: {default[1]}  (sink {default[0]})", P.MUTED))
    heos = data.get("heos") or []
    if heos:
        lines.append("")
        for p in heos:
            mark = "▶" if p.get("state") == "play" else "·"
            vol = f"  {p['volume']}%" if p.get("volume") is not None else ""
            lines.append(f"  {mark}  {art.paint(str(p.get('name', '?')), P.PINK_DIM)}"
                         f"  {p.get('model', '')}  {p.get('ip', '')}{vol}")
    return art.box(lines, title="lan · weave", width=width, body_style=(P.SILVER,))


_DL_DIRS = (
    os.path.expanduser("~/.local/share/pixie/models"),
    os.path.expanduser("~/Downloads"),
    "/var/cache/pacman/pkg",
    "/tmp",
)
_DL_HIST: dict[str, tuple[float, int]] = {}
_TMP1_RE = re.compile(r"\.(part|tmp)(\d*)$")
_TMP2_RE = re.compile(r"\.(incomplete|crdownload|download|part|tmp)$")


def _human_bytes(n: int) -> str:
    v = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if v < 1024 or unit == "GB":
            return f"{v:.0f}{unit}" if unit == "B" else f"{v:.1f}{unit}"
        v /= 1024
    return f"{n}B"


def _dl_group_base(name: str) -> str:
    """Strip temp suffixes (.part, .part3, .tmp, .tmp3, .incomplete, …)."""
    base = name
    while True:
        nb = _TMP1_RE.sub("", base)
        nb = _TMP2_RE.sub("", nb)
        if nb == base:
            return nb
        base = nb


def _is_committed_chunk(name: str) -> bool:
    """True for committed chunk suffixes (.part, .partN) — excludes merging .tmp/.tmpN."""
    m = _TMP1_RE.search(name)
    return m is not None and m.group(1) == "part"


def _collect_downloads() -> list[dict]:
    """What the loom is weaving: temp-suffixed files growing in known dirs.

    A `<name>.size` sidecar next to a partial group provides its total size
    so the panel can show a true progress bar (menagerie writes these).
    """
    groups: dict[str, int] = {}
    for d in _DL_DIRS:
        if not os.path.isdir(d):
            continue
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for n in names:
            if n.endswith((".size", ".aria2", ".lock")):
                continue
            path = os.path.join(d, n)
            if not os.path.isfile(path):
                continue
            base = _dl_group_base(n)
            if base == n and not os.path.exists(path + ".aria2"):
                continue
            # Only count committed chunks (.part*) for progress; skip merging .tmp*
            if not _is_committed_chunk(n):
                continue
            try:
                groups[base] = groups.get(base, 0) + os.path.getsize(path)
            except OSError:
                continue
    now = time.monotonic()

    # Remove completed downloads: final file exists with expected size
    complete = set()
    for base in groups:
        total = None
        for d in _DL_DIRS:
            t = os.path.join(d, base + ".size")
            if os.path.isfile(t):
                try:
                    with open(t) as fh:
                        total = int(fh.read().strip())
                except (OSError, ValueError):
                    total = None
                break
        if total and total > 0:
            for d in _DL_DIRS:
                try:
                    for fn in os.listdir(d):
                        if fn.endswith((".size", ".aria2", ".lock", ".part", ".tmp", ".incomplete", ".crdownload", ".download")):
                            continue
                        fp = os.path.join(d, fn)
                        if os.path.isfile(fp):
                            try:
                                sz = os.path.getsize(fp)
                                if abs(sz - total) <= 1024:
                                    complete.add(base)
                                    break
                            except OSError:
                                pass
                    if base in complete:
                        break
                except OSError:
                    pass
    for base in complete:
        groups.pop(base, None)

    dls: list[dict] = []
    for base, cur in groups.items():
        total = None
        for d in _DL_DIRS:
            t = os.path.join(d, base + ".size")
            if os.path.isfile(t):
                try:
                    with open(t) as fh:
                        total = int(fh.read().strip())
                except (OSError, ValueError):
                    total = None
                break
        speed = 0.0
        prev = _DL_HIST.get(base)
        if prev:
            dt = now - prev[0]
            if 0 < dt < 30:
                speed = max(0.0, (cur - prev[1]) / dt)
        _DL_HIST[base] = (now, cur)
        dls.append({"name": base, "cur": cur, "total": total, "speed": speed})
    for base in list(_DL_HIST):
        if base not in groups:
            del _DL_HIST[base]
    dls.sort(key=lambda x: -x["cur"])
    return dls


def _downloads_panel(data: list, width: int) -> str:
    lines = []
    if not data:
        lines.append(art.paint("  nothing being conjured", P.MUTED))
    for d in data:
        speed = d["speed"]
        speed_s = f"{speed/1e6:.1f} MB/s" if speed >= 1e6 else f"{speed/1e3:.0f} KB/s"
        if d["total"] and d["total"] > 0:
            pct = min(1.0, d["cur"] / d["total"])
            bar_w = max(8, min(24, width - 2 - len(d["name"]) - 32))
            filled = int(bar_w * pct)
            bar = "█" * filled + "░" * (bar_w - filled)
            tail = f" {bar} {pct*100:3.0f}% {speed_s}"
        else:
            tail = f" {_human_bytes(d['cur'])} · {speed_s}"
        room = max(8, width - 2 - len(tail) - 4)
        nm = d["name"] if len(d["name"]) <= room else d["name"][: room - 1] + "…"
        lines.append(f"  ✦  {art.paint(nm, P.PINK_DIM)}{' ' * max(1, room - len(nm))}{tail}")
    return art.box(lines, title="Conjuring", width=width, body_style=(P.SILVER,))


def build_frame(data: dict, width: int, height: int) -> str:
    panel_w = max(44, min(width - 2, 88))
    bt = _bt_panel(data, panel_w)
    wifi = _wifi_panel(data, panel_w)
    lan = _lan_panel(data, panel_w)
    dls = _downloads_panel(data.get("dls", []), panel_w)
    footer = art.box(
        ["w whisper · l listen · s scan · n new (wifi · bt · wired lan) · d remove · R restart · r refresh · q quit"],
        title="runes", width=width, body_style=(P.MUTED,),
    )
    return "\n".join([bt, "", wifi, "", lan, "", dls, "", footer])


# ---------------------------------------------------------------------------
# interactive TUI modes
# ---------------------------------------------------------------------------

def _menu_frame(title: str, items: list, sel: int, width: int) -> str:
    lines = []
    for i, (label, _cb) in enumerate(items):
        mark = "❯" if i == sel else " "
        style = P.SILVER if i == sel else P.MUTED
        lines.append(art.paint(f" {mark} {label}", style))
    return art.box(lines, title=title, width=width, body_style=(P.SILVER,))


def _input_frame(prompt: str, value: str, secret: bool,
                 width: int, err: str = "") -> str:
    shown = "•" * len(value) if secret else value
    lines = [art.paint(f"  {prompt}", P.SILVER), "", f"  {shown}█"]
    if err:
        lines += ["", art.paint(f"  ⚠ {err}", P.ERR)]
    return art.box(lines, title="weave · input", width=width,
                   body_style=(P.SILVER,))


def _confirm_frame(msg: str | list[str], width: int) -> str:
    lines = list(msg) if isinstance(msg, list) else [f"  {msg}"]
    return art.box([*lines, "", "  y  yes        n / esc  no"],
                   title="are you sure?", width=width, body_style=(P.WARN,))


def _work_frame(msg: str, width: int) -> str:
    return art.box([f"  {msg} …"], title="Conjuring", width=width, body_style=(P.MUTED,))


def _result_frame(ok: bool, msg: str, width: int) -> str:
    style = (P.OK,) if ok else (P.WARN,)
    return art.box([f"  {msg}"], title="runes", width=width, body_style=style)


def _footer_frame(width: int, hint: str) -> str:
    return art.box([hint], title="runes", width=width, body_style=(P.MUTED,))


def _start_work(ui: dict, msg: str, fn) -> None:
    ui["mode"] = "work"
    ui["work_msg"] = msg
    ui["work_fn"] = fn


def _btctl_raw(*args: str, timeout: float = 15) -> str:
    try:
        r = subprocess.run(["bluetoothctl", *args], text=True, capture_output=True,
                           timeout=timeout, check=False)
        return (r.stdout or "") + (r.stderr or "")
    except (subprocess.TimeoutExpired, OSError):
        return ""


def _bt_pair_pty(mac: str, pin: str | None = None, timeout: float = 30) -> tuple[bool, str]:
    """Pair via bluetoothctl on a pty so legacy-PIN prompts can be answered."""
    master, slave = pty.openpty()
    proc = subprocess.Popen(["bluetoothctl"], stdin=slave, stdout=slave, stderr=slave, close_fds=True)
    os.close(slave)

    def send(cmd: str) -> None:
        os.write(master, (cmd + "\n").encode())

    send("agent NoInputNoOutput")
    send("default-agent")
    send(f"pair {mac}")
    buf = b""
    pin_sent = False
    deadline = time.monotonic() + timeout
    try:
        while time.monotonic() < deadline:
            r, _, _ = select.select([master], [], [], 0.3)
            if not r:
                continue
            data = os.read(master, 4096)
            if not data:
                break
            buf += data
            if b"Enter PIN code" in buf and pin and not pin_sent:
                send(pin)
                pin_sent = True
                buf = buf[-200:]
            elif b"Confirm passkey" in buf and not pin_sent:
                send("yes")
                pin_sent = True
                buf = buf[-200:]
            if b"Pairing successful" in buf:
                return True, "pairing successful"
            if b"Failed" in buf or b"not available" in buf:
                return False, buf.decode(errors="replace").strip().splitlines()[-1]
    finally:
        try:
            send("quit")
        except OSError:
            pass
        try:
            proc.wait(timeout=2)
        except Exception:
            proc.kill()
        try:
            os.close(master)
        except OSError:
            pass
    return False, "pairing timed out"


def _scan_bt_top5() -> list[tuple[str, str]]:
    """Fresh bluetooth scan — up to 5 NEW devices as (mac, name)."""
    devs: list[tuple[str, str]] = []
    try:
        r = subprocess.run(["bluetoothctl", "--timeout", "12", "scan", "on"],
                           text=True, capture_output=True, timeout=20, check=False)
    except (subprocess.TimeoutExpired, OSError):
        return devs
    for ln in (r.stdout or "").splitlines():
        if "[NEW]" not in ln:
            continue
        m = re.search(r"Device ([0-9A-F:]+) ?(.*)", ln)
        if not m:
            continue
        mac, name = m.group(1), m.group(2).strip() or m.group(1)
        if not any(x == mac for x, _ in devs):
            devs.append((mac, name))
        if len(devs) >= 5:
            break
    return devs


def _scan_wifi_top5() -> list[dict]:
    """Rescan + list wifi, top 5 by signal."""
    try:
        subprocess.run(["nmcli", "device", "wifi", "rescan"], text=True, capture_output=True,
                       timeout=10, check=False)
    except (subprocess.TimeoutExpired, OSError):
        pass
    nets: list[dict] = []
    try:
        r = subprocess.run(["nmcli", "-t", "-f", "IN-USE,SSID,SECURITY,SIGNAL", "device", "wifi", "list"],
                           text=True, capture_output=True, timeout=10, check=False)
        for ln in (r.stdout or "").splitlines():
            p = ln.split(":")
            if len(p) >= 4:
                nets.append({"in_use": p[0] == "*", "ssid": p[1], "security": p[2], "signal": int(p[3] or 0)})
    except (subprocess.TimeoutExpired, OSError):
        pass
    nets.sort(key=lambda n: -n["signal"])
    return nets[:5]


def _saved_wifi_connections() -> list[str]:
    out: list[str] = []
    show = _nmcli(["-t", "-f", "NAME,TYPE", "con", "show"])
    for ln in (show.stdout or "").splitlines():
        parts = ln.rsplit(":", 1)
        if len(parts) == 2 and "wireless" in parts[1]:
            out.append(parts[0])
    return out


def _scan_menu(ui: dict) -> None:
    ui["mode"] = "menu"
    ui["title"] = "scan the aether"
    ui["sel"] = 0
    ui["items"] = [
        ("bluetooth voices", lambda u: _scan_bt_flow(u)),
        ("wifi airwaves", lambda u: _scan_wifi_flow(u)),
    ]


def _scan_bt_flow(ui: dict) -> None:
    def run() -> tuple[bool, str] | None:
        devs = _scan_bt_top5()
        if not devs:
            return False, "no bluetooth voices heard"
        ui["mode"] = "menu"
        ui["title"] = "bluetooth · top 5"
        ui["sel"] = 0
        ui["items"] = [(f"{n}  {m}", lambda u, mac=m, name=n: _pair_flow(u, mac, name)) for m, n in devs]
        return None
    _start_work(ui, "listening to the aether", run)


def _scan_wifi_flow(ui: dict) -> None:
    def run() -> tuple[bool, str] | None:
        nets = _scan_wifi_top5()
        if not nets:
            return False, "no wifi airwaves heard"
        ui["mode"] = "menu"
        ui["title"] = "wifi · top 5"
        ui["sel"] = 0
        ui["items"] = []
        for n in nets:
            label = f"{n['ssid'] or '(hidden)'}  {n['signal']}%  {n['security'] or 'open'}"
            if n["in_use"]:
                label += "  ◀ woven"
            ui["items"].append((label, lambda u, net=n: _wifi_connect_flow(u, net)))
        return None
    _start_work(ui, "reading the airwaves", run)


def _pair_flow(ui: dict, mac: str, name: str) -> None:
    def run() -> tuple[bool, str]:
        ok, msg = _bt_pair_pty(mac)
        if ok:
            _btctl_raw("trust", mac)
            return True, f"paired with {name}"
        return False, msg
    _start_work(ui, f"pairing with {name}", run)


def _wifi_connect_flow(ui: dict, net: dict) -> None:
    if net["security"]:
        ui["mode"] = "input"
        ui["prompt"] = f"password for {net['ssid']}:"
        ui["value"] = ""
        ui["secret"] = True
        ui["input_cb"] = lambda u, psk: _wifi_connect_do(u, net, psk)
        return

    def run() -> tuple[bool, str]:
        r = _nmcli(["device", "wifi", "connect", net["ssid"]], timeout=40)
        if r.returncode != 0:
            r = _nmcli(["device", "wifi", "connect", net["ssid"]], timeout=40)
            if r.returncode != 0:
                return False, "open-network connect failed"
        return True, f"woven into {net['ssid']}"
    _start_work(ui, f"weaving into {net['ssid']}", run)


def _wifi_connect_do(ui: dict, net: dict, psk: str) -> None:
    def run() -> tuple[bool, str]:
        cmd = ["device", "wifi", "connect", net["ssid"], "password", psk]
        r = _nmcli(cmd, timeout=40)
        if r.returncode != 0:
            r = _nmcli(cmd, timeout=40)
            if r.returncode != 0:
                return False, "connect failed — wrong password?"
        return True, f"woven into {net['ssid']}"
    _start_work(ui, f"weaving into {net['ssid']}", run)


# ---------------------------------------------------------------------------
# wired LAN / static IPv4 — systemd-networkd profiles woven by ether
# ---------------------------------------------------------------------------

# .network files ether creates sort before 20-ethernet.network so the
# static profile wins for the matched interface.
_LAN_PROFILE_PREFIX = "10-ether-"
LAN_PROFILE_MARKER = "# managed-by: ether link"


def _lan_profile_filename(dev: str) -> str:
    """/etc/systemd/network filename for an ether-woven LAN profile."""
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", (dev or "").strip()) or "lan"
    return f"{_LAN_PROFILE_PREFIX}{safe}.network"


def _parse_lan_cidr(text: str) -> tuple[str, str]:
    """Validate a static IPv4 address in CIDR form → (addr, error)."""
    raw = (text or "").strip()
    if not raw:
        return "", "address required — e.g. 192.168.11.1/24"
    if "/" not in raw:
        return "", "CIDR form required — e.g. 192.168.11.1/24"
    try:
        iface = ipaddress.ip_interface(raw)
    except ValueError as e:
        return "", f"not an address/prefix: {e}"
    if iface.version != 4:
        return "", "IPv4 only — IPv6 is not woven yet"
    return str(iface), ""


def _parse_lan_gateway(text: str) -> tuple[str, str]:
    """Optional gateway → (gateway, error); blank is allowed."""
    raw = (text or "").strip()
    if not raw:
        return "", ""
    try:
        net = ipaddress.ip_network(raw, strict=False)
    except ValueError as e:
        return "", f"not a gateway: {e}"
    if net.version != 4:
        return "", "gateway must be IPv4"
    return str(net.network_address), ""


def _parse_lan_dns(text: str) -> tuple[list[str], str]:
    """Optional DNS servers (comma or space separated) → ([addrs], error)."""
    raw = (text or "").strip()
    if not raw:
        return [], ""
    out: list[str] = []
    for part in re.split(r"[,\s]+", raw):
        if not part:
            continue
        try:
            addr = ipaddress.ip_address(part)
        except ValueError:
            return [], f"not a DNS address: {part}"
        if addr.version != 4:
            return [], f"DNS must be IPv4: {part}"
        out.append(str(addr))
    return out, ""


def _lan_network_content(dev: str, addr: str, gateway: str = "",
                       dns: list[str] | None = None) -> str:
    """Render the .network profile for a static IPv4 LAN."""
    lines = [
        LAN_PROFILE_MARKER,
        "[Match]",
        f"Name={dev}",
        "",
        "[Network]",
        f"Address={addr}",
    ]
    if gateway:
        lines.append(f"Gateway={gateway}")
    for server in dns or []:
        lines.append(f"DNS={server}")
    return "\n".join(lines) + "\n"


def _lan_managed_profiles() -> list[Path]:
    """.network profiles under /etc/systemd/network woven by ether."""
    out: list[Path] = []
    try:
        entries = sorted((Path("/etc/systemd/network")).glob("*.network"))
    except OSError:
        return out
    for path in entries:
        if path.name.startswith(_LAN_PROFILE_PREFIX):
            out.append(path)
            continue
        try:
            if LAN_PROFILE_MARKER in path.read_text(encoding="utf-8",
                                                  errors="replace"):
                out.append(path)
        except OSError:
            continue
    return out


def _sudo_run(argv: list[str], pw: str, timeout: float = 90) -> tuple[bool, str]:
    """Run a privileged command, password on stdin (`sudo -S`)."""
    try:
        r = subprocess.run(["sudo", "-S", "-p", "", *argv],
                           input=pw + "\n", text=True, capture_output=True,
                           timeout=timeout, check=False)
    except (subprocess.TimeoutExpired, OSError) as e:
        return False, f"sudo failed: {e}"
    if r.returncode != 0:
        tail = (r.stderr or r.stdout or "").strip().splitlines()
        return False, (tail[-1] if tail else "sudo failed")
    return True, ""


def _lan_apply_profile(dev: str, addr: str, gateway: str = "",
                     dns: list[str] | None = None,
                     pw: str = "") -> tuple[bool, str]:
    """Write the profile with `sudo install`, then reload networkd."""
    name = _lan_profile_filename(dev)
    dest = f"/etc/systemd/network/{name}"
    content = _lan_network_content(dev, addr, gateway, dns)
    try:
        fd, tmpname = tempfile.mkstemp(prefix="ether-", suffix=".network")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
    except OSError as e:
        return False, f"could not stage the profile: {e}"
    try:
        for argv in (["install", "-m", "644", tmpname, dest],
                     ["networkctl", "reload"],
                     ["networkctl", "reconfigure", dev]):
            ok, err = _sudo_run(argv, pw)
            if not ok:
                return False, err
    finally:
        try:
            os.unlink(tmpname)
        except OSError:
            pass
    return True, f"wired profile woven into {dev}"


def _lan_remove_profile(path: Path, pw: str) -> tuple[bool, str]:
    """Remove an ether-woven profile with sudo, then reload networkd."""
    ok, err = _sudo_run(["rm", "-f", str(path)], pw)
    if not ok:
        return False, err
    ok, err = _sudo_run(["networkctl", "reload"], pw)
    if not ok:
        return False, err
    return True, f"unravelled {path.name}"


def _new_lan_flow(ui: dict) -> None:
    def run() -> tuple[bool, str] | None:
        disc = discover_paths()
        wired = [p for p in disc.get("paths", [])
                 if p.get("kind") in ("lan", "usb")
                 and "tailscale" not in p.get("dev", "").lower()]
        if not wired:
            return False, "no wired paths found — is the cable in?"
        ui["mode"] = "menu"
        ui["title"] = "wired paths"
        ui["sel"] = 0
        ui["items"] = []
        for p in wired:
            ips = p["ips"][0] if p["ips"] else "—"
            gw = f"  via {p['gateway']}" if p.get("gateway") else ""
            ui["items"].append(
                (f"{p['label']}  {p['dev']}  {ips}{gw}",
                 lambda u, dev=p["dev"], path=p: _lan_input_addr(u, dev, path)))
        return None
    _start_work(ui, "reading the wired paths", run)


def _lan_input_addr(ui: dict, dev: str, path: dict) -> None:
    ui["mode"] = "input"
    ui["prompt"] = f"static IPv4 for {dev} (CIDR, e.g. 192.168.11.1/24):"
    ui["value"] = ""
    ui["secret"] = False
    ui["input_err"] = ""
    ui["input_cb"] = lambda u, addr: _lan_input_gw(u, dev, path, addr)


def _lan_input_gw(ui: dict, dev: str, path: dict, addr: str) -> None:
    parsed, err = _parse_lan_cidr(addr)
    if err:
        ui["mode"] = "input"
        ui["input_err"] = err
        ui["value"] = addr
        return
    lan = {"dev": dev, "path": path, "addr": parsed}
    ui["mode"] = "input"
    ui["prompt"] = f"gateway for {dev} (blank to skip):"
    ui["value"] = ""
    ui["secret"] = False
    ui["input_err"] = ""
    ui["input_cb"] = lambda u, gw: _lan_input_dns(u, lan, gw)


def _lan_input_dns(ui: dict, lan: dict, gw: str) -> None:
    parsed, err = _parse_lan_gateway(gw)
    if err:
        ui["mode"] = "input"
        ui["input_err"] = err
        ui["value"] = gw
        return
    lan["gateway"] = parsed
    ui["mode"] = "input"
    ui["prompt"] = (f"DNS servers for {lan['dev']} "
                    "(comma or space separated, blank to skip):")
    ui["value"] = ""
    ui["secret"] = False
    ui["input_err"] = ""
    ui["input_cb"] = lambda u, dns: _lan_confirm(u, lan, dns)


def _lan_confirm(ui: dict, lan: dict, dns_text: str) -> None:
    servers, err = _parse_lan_dns(dns_text)
    if err:
        ui["mode"] = "input"
        ui["input_err"] = err
        ui["value"] = dns_text
        return
    lan["dns"] = servers
    dev = lan["dev"]
    name = _lan_profile_filename(dev)
    lines = [
        f"  interface:  {dev}",
        f"  address:    {lan['addr']}",
        f"  profile:    {name}",
    ]
    if lan["gateway"]:
        lines.append(f"  gateway:    {lan['gateway']}")
    if lan["dns"]:
        lines.append(f"  dns:        {', '.join(lan['dns'])}")
    lines += ["", "  applied with sudo — the interface may briefly bounce"]
    ui["mode"] = "confirm"
    ui["confirm_msg"] = lines
    ui["confirm_cb"] = lambda: _lan_sudo(ui, lan)


def _lan_sudo(ui: dict, lan: dict) -> None:
    ui["mode"] = "input"
    ui["prompt"] = "sudo password (to write the network profile):"
    ui["value"] = ""
    ui["secret"] = True
    ui["input_err"] = ""
    ui["input_cb"] = lambda u, pw: _lan_apply_do(u, lan, pw)


def _lan_apply_do(ui: dict, lan: dict, pw: str) -> None:
    def run() -> tuple[bool, str]:
        return _lan_apply_profile(lan["dev"], lan["addr"],
                                  lan["gateway"], lan["dns"], pw)
    _start_work(ui, f"weaving {_lan_profile_filename(lan['dev'])}", run)


def _remove_lan_menu(ui: dict) -> None:
    profiles = _lan_managed_profiles()
    if not profiles:
        ui["mode"] = "result"
        ui["result"] = (False, "no ether-woven LAN profiles")
        return
    ui["mode"] = "menu"
    ui["title"] = "ether-woven LAN profiles"
    ui["sel"] = 0
    ui["items"] = [(p.name, lambda u, path=p: _confirm_remove_lan(u, path))
                   for p in profiles]


def _confirm_remove_lan(ui: dict, path: Path) -> None:
    ui["mode"] = "confirm"
    ui["confirm_msg"] = (f"unravel {path.name}? (removes the static "
                         "profile — the interface may fall back to DHCP)")
    ui["confirm_cb"] = lambda: _lan_remove_sudo(ui, path)


def _lan_remove_sudo(ui: dict, path: Path) -> None:
    ui["mode"] = "input"
    ui["prompt"] = "sudo password (to remove the profile):"
    ui["value"] = ""
    ui["secret"] = True
    ui["input_err"] = ""
    ui["input_cb"] = lambda u, pw: _lan_remove_do(u, path, pw)


def _lan_remove_do(ui: dict, path: Path, pw: str) -> None:
    def run() -> tuple[bool, str]:
        return _lan_remove_profile(path, pw)
    _start_work(ui, f"unravelling {path.name}", run)


def _new_menu(ui: dict) -> None:
    ui["mode"] = "menu"
    ui["title"] = "weave a new thread"
    ui["sel"] = 0
    ui["items"] = [
        ("wifi network", lambda u: _scan_wifi_flow(u)),
        ("bluetooth device", lambda u: _scan_bt_flow(u)),
        ("wired LAN / static IPv4", lambda u: _new_lan_flow(u)),
    ]


def _remove_menu(ui: dict) -> None:
    ui["mode"] = "menu"
    ui["title"] = "unravel a thread"
    ui["sel"] = 0
    ui["items"] = [
        ("bluetooth device", lambda u: _remove_bt_menu(u)),
        ("wifi connection", lambda u: _remove_wifi_menu(u)),
        ("wired LAN profile", lambda u: _remove_lan_menu(u)),
    ]


def _remove_bt_menu(ui: dict) -> None:
    devs = [(m, n) for m, n in _bt_devices() if _bt_state(m)["paired"]]
    if not devs:
        ui["mode"] = "result"
        ui["result"] = (False, "nothing paired yet")
        return
    ui["mode"] = "menu"
    ui["title"] = "paired bluetooth"
    ui["sel"] = 0
    ui["items"] = [(f"{n}  {m}", lambda u, mac=m, name=n: _confirm_remove_bt(u, mac, name)) for m, n in devs]


def _confirm_remove_bt(ui: dict, mac: str, name: str) -> None:
    def run() -> tuple[bool, str]:
        out = _bt(mac, "remove", timeout=10)
        if "not available" in out:
            return False, "device already gone"
        return True, f"unravelled {name}"
    ui["mode"] = "confirm"
    ui["confirm_msg"] = f"unravel {name}? (unpair + forget)"
    ui["confirm_cb"] = lambda: _start_work(ui, f"unravelling {name}", run)


def _remove_wifi_menu(ui: dict) -> None:
    conns = _saved_wifi_connections()
    if not conns:
        ui["mode"] = "result"
        ui["result"] = (False, "no saved wifi connections")
        return
    ui["mode"] = "menu"
    ui["title"] = "saved wifi connections"
    ui["sel"] = 0
    ui["items"] = [(c, lambda u, name=c: _confirm_remove_wifi(u, name)) for c in conns]


def _confirm_remove_wifi(ui: dict, name: str) -> None:
    def run() -> tuple[bool, str]:
        r = _nmcli(["con", "delete", name], timeout=20)
        if r.returncode != 0:
            return False, "could not delete connection"
        return True, f"forgot {name}"
    ui["mode"] = "confirm"
    ui["confirm_msg"] = f"forget {name}? (deletes saved connection)"
    ui["confirm_cb"] = lambda: _start_work(ui, f"forgetting {name}", run)


def _restart_menu(ui: dict) -> None:
    ui["mode"] = "menu"
    ui["title"] = "stir the sleeping powers"
    ui["sel"] = 0
    ui["items"] = [
        ("bluetooth · soft", lambda u: _restart_soft(u, "bluetooth")),
        ("bluetooth · full (sudo)", lambda u: _restart_sudo(u, "bluetooth")),
        ("wifi · soft", lambda u: _restart_soft(u, "wifi")),
        ("wifi · full (sudo)", lambda u: _restart_sudo(u, "NetworkManager")),
    ]


def _restart_soft(ui: dict, target: str) -> None:
    def run() -> tuple[bool, str]:
        if target == "bluetooth":
            _btctl_raw("power", "off")
            time.sleep(1)
            out = _btctl_raw("power", "on")
            ok = "Powered: yes" in _btctl_raw("show") or "Changing power on succeeded" in out
            return (True, "bluetooth folded and refolded") if ok else (False, "soft restart failed — try full (sudo)")
        r = _nmcli(["networking", "off"], timeout=20)
        time.sleep(2)
        r = _nmcli(["networking", "on"], timeout=30)
        return (True, "wifi folded and refolded") if r.returncode == 0 else (False, "soft restart failed — try full (sudo)")
    _start_work(ui, f"folding {target} over", run)


def _restart_sudo(ui: dict, target: str) -> None:
    ui["mode"] = "input"
    ui["prompt"] = "sudo password:"
    ui["value"] = ""
    ui["secret"] = True
    ui["input_cb"] = lambda u, pw: _restart_sudo_do(u, target, pw)


def _restart_sudo_do(ui: dict, target: str, pw: str) -> None:
    def run() -> tuple[bool, str]:
        try:
            r = subprocess.run(["sudo", "-S", "-p", "", "systemctl", "restart", target],
                               input=pw + "\n", text=True, capture_output=True, timeout=60, check=False)
        except (subprocess.TimeoutExpired, OSError) as e:
            return False, f"restart failed: {e}"
        if r.returncode != 0:
            return False, (r.stderr or "restart failed").strip()
        return True, f"{target} stirred back to life"
    _start_work(ui, f"restarting {target}", run)


def cmd_status(_: argparse.Namespace | None = None) -> int:
    fd = art.tui_open_tty()
    if fd is None:
        print(art.paint("status needs a real TTY (not a pipe).", P.ERR), file=sys.stderr)
        return 2

    art.tui_begin(fd, "ether")
    last_refresh = 0.0
    data: dict = {}
    ui: dict = {
        "mode": "home", "sel": 0, "items": [], "title": "",
        "prompt": "", "value": "", "secret": True, "input_cb": None,
        "input_err": "",
        "confirm_msg": "", "confirm_cb": None,
        "work_msg": "", "work_fn": None,
        "result": (True, ""),
    }
    try:
        while True:
            if ui["mode"] == "home" and time.monotonic() - last_refresh > 3.0:
                data = _collect_status()
                last_refresh = time.monotonic()
            width = art.term_width()
            height = art.term_height()

            if ui["mode"] == "home":
                frame = build_frame(data, width, height)
            elif ui["mode"] == "menu":
                frame = _menu_frame(ui["title"], ui["items"], ui["sel"], width)
                hint = "↑/↓ or j/k move · enter pick · esc back"
            elif ui["mode"] == "input":
                frame = _input_frame(ui["prompt"], ui["value"],
                                     ui["secret"], width,
                                     ui.get("input_err", ""))
                hint = "enter confirm · esc cancel"
            elif ui["mode"] == "confirm":
                frame = _confirm_frame(ui["confirm_msg"], width)
                hint = "y yes · n/esc no"
            elif ui["mode"] == "work":
                frame = _work_frame(ui["work_msg"], width)
                hint = ""
            else:
                ok, msg = ui["result"]
                frame = _result_frame(ok, msg, width)
                hint = "enter / esc continue"
            if ui["mode"] != "home":
                frame += "\n\n" + _footer_frame(width, hint)

            try:
                art.paint_frame(fd, frame)
            except OSError:
                art.tty_write(fd, art.clear_screen() + frame + "\n")

            if ui["mode"] == "work" and ui["work_fn"] is not None:
                fn, ui["work_fn"] = ui["work_fn"], None
                res = fn()
                if res is not None:
                    ui["result"] = res
                    ui["mode"] = "result"
                last_refresh = 0.0
                continue

            key = art.tui_read_key(fd, timeout=0.2)
            if key in ("q", "esc", "ctrl-c", "Q") and ui["mode"] == "home":
                return 0

            if ui["mode"] == "home":
                if key in ("w", "W"):
                    _start_work(ui, "whispering to the ether", lambda: _weave("whisper"))
                elif key in ("l", "L"):
                    _start_work(ui, "bending the ether to listen", lambda: _weave("listen"))
                elif key in ("s", "S"):
                    _scan_menu(ui)
                elif key in ("n", "N"):
                    _new_menu(ui)
                elif key in ("d", "D"):
                    _remove_menu(ui)
                elif key in ("R",):
                    _restart_menu(ui)
                elif key in ("r",):
                    last_refresh = 0.0
            elif ui["mode"] == "menu":
                if key in ("esc", "q"):
                    ui["mode"] = "home"
                elif key in ("up", "k"):
                    ui["sel"] = (ui["sel"] - 1) % len(ui["items"])
                elif key in ("down", "j"):
                    ui["sel"] = (ui["sel"] + 1) % len(ui["items"])
                elif key in ("enter", "space"):
                    _, cb = ui["items"][ui["sel"]]
                    cb(ui)
            elif ui["mode"] == "input":
                if key in ("esc", "q"):
                    ui["mode"] = "home"
                elif key in ("enter",):
                    cb = ui["input_cb"]
                    val = ui["value"]
                    ui["value"] = ""
                    if cb:
                        cb(ui, val)
                elif key in ("backspace",):
                    ui["value"] = ui["value"][:-1]
                elif len(key) == 1 and key.isprintable():
                    ui["value"] += key
                elif key == "space":
                    ui["value"] += " "
            elif ui["mode"] == "confirm":
                if key in ("y", "Y", "enter"):
                    cb = ui["confirm_cb"]
                    if cb:
                        cb()
                elif key in ("n", "N", "esc", "q"):
                    ui["mode"] = "home"
            elif ui["mode"] == "result":
                if key in ("enter", "esc", "space"):
                    ui["mode"] = "home"
                    last_refresh = 0.0
    finally:
        art.tui_cleanup()


def cmd_info(_: argparse.Namespace | None = None) -> int:
    """ether status / status ether — one-shot report (no TUI)."""
    try:
        heos_roster(refresh=True)  # warm the cache with a live sweep
    except Exception:
        pass
    data = _collect_status()
    width = art.term_width()
    panel_w = max(44, min(width - 2, 88))
    print()
    print(art.box([], title="Ether", subtitle="status — the aether at a glance", width=width))
    print(_bt_panel(data, panel_w))
    print()
    print(_wifi_panel(data, panel_w))
    print()
    print(_lan_panel(data, panel_w))
    print()
    print(_downloads_panel(data.get("dls", []), panel_w))
    print()
    return 0


def cmd_speakers(args: argparse.Namespace) -> int:
    """ether speakers — HEOS discovery + transport + cast to Vanguarda Office."""
    # action routing: ether speakers [action] [value] [--speaker NAME] [--cached]
    act = (getattr(args, "action", None) or "list").lower()
    val = getattr(args, "value", None)
    speaker_hint = getattr(args, "speaker", None)
    cached = bool(getattr(args, "cached", False))

    # ── list / status ──────────────────────────────────────────────
    if act in ("list","ls","status","show"):
        players = heos_roster(refresh=not cached)
        players = _heos_enrich(players) if players else []
        lines = []
        if not players:
            lines.append(art.paint("  no HEOS speakers found — SSDP + tcp/1255 sweep came up empty", P.MUTED))
        for p in players:
            playing = p.get("state") == "play"
            name = art.paint(str(p.get("name", "?")), P.OK if playing else P.SILVER)
            state = str(p.get("state", "?")).upper()
            vol = f" {p['volume']}%" if p.get("volume") is not None else ""
            line = (f"  {'▶' if playing else '·'}  {name}  {p.get('model', '?')}"
                    f"  {p.get('ip', '?')}  {p.get('network', '')}  ·  {state}{vol}")
            if p.get("now"):
                line += f"  —  {p['now']}"
            lines.append(line)
        print(); print(art.box(lines, title="heos speakers", subtitle="the voices in the walls", width=art.term_width(), body_style=(P.SILVER,))); print()
        return 0

    # resolve target for all control actions
    tgt = _heos_resolve(speaker_hint)
    if not tgt:
        eprint("no HEOS speaker found — try: ether speakers"); return 1
    ip, pid, info = tgt
    sp_name = info.get("name","?")

    # ── pause / resume / stop / next / prev ───────────────────────
    if act in ("pause",):
        ok = _heos_set_state(pid, ip, "pause"); print(art.paint(f"  {'✓' if ok else '✗'} pause {sp_name}", P.OK if ok else P.WARN)); return 0 if ok else 1
    if act in ("resume","play") and not val:
        ok = _heos_set_state(pid, ip, "play"); print(art.paint(f"  {'✓' if ok else '✗'} resume {sp_name}", P.OK if ok else P.WARN)); return 0 if ok else 1
    if act in ("stop",):
        ok = _heos_set_state(pid, ip, "stop"); print(art.paint(f"  {'✓' if ok else '✗'} stop {sp_name}", P.OK if ok else P.WARN)); return 0 if ok else 1
    if act in ("next","skip"):
        ok = _heos_next(pid, ip); print(art.paint(f"  {'✓' if ok else '✗'} next {sp_name}", P.OK if ok else P.WARN)); return 0 if ok else 1
    if act in ("prev","previous"):
        ok = _heos_prev(pid, ip); print(art.paint(f"  {'✓' if ok else '✗'} prev {sp_name}", P.OK if ok else P.WARN)); return 0 if ok else 1
    if act in ("vol","volume"):
        if val is None:
            # show current
            cur = _heos_rpc(ip, [f"heos://player/get_volume?pid={pid}"])
            lvl = None
            for o in cur:
                if isinstance(o.get("payload"), dict) and "level" in o["payload"]: lvl = o["payload"]["level"]
                msg = o.get("heos",{}).get("message","")
                if "level=" in msg: lvl = int(msg.split("level=")[-1].split("&")[0])
            print(f"  {sp_name} volume: {lvl if lvl is not None else '?'}"); return 0
        try: lvl = int(str(val).strip().rstrip("%"))
        except: eprint("volume must be 0-100"); return 1
        ok = _heos_set_volume(pid, ip, lvl); print(art.paint(f"  {'✓' if ok else '✗'} {sp_name} volume → {lvl}%", P.OK if ok else P.WARN)); return 0 if ok else 1
    if act in ("mute",):
        # mute [on|off|toggle]
        mode = str(val or "toggle").lower() if val else "toggle"
        if mode == "toggle":
            # read current mute if possible, else just toggle off->on
            cur = _heos_rpc(ip, [f"heos://player/get_mute?pid={pid}"])
            is_muted = False
            for o in cur:
                msg = o.get("heos",{}).get("message","")
                if "state=on" in msg: is_muted = True
                if isinstance(o.get("payload"), dict) and o["payload"].get("state")=="on": is_muted = True
            mode = "off" if is_muted else "on"
        on = mode in ("on","1","true","mute")
        ok = _heos_set_mute(pid, ip, on); print(art.paint(f"  {'✓' if ok else '✗'} {sp_name} mute → {mode}", P.OK if ok else P.WARN)); return 0 if ok else 1
    if act == "cast":
        if not val:
            eprint("usage: ether speakers cast <file> [--speaker NAME]"); return 1
        p = Path(val).expanduser()
        if not p.exists():
            import glob as _glob
            cands = _glob.glob(str(Path.home()/f"Music/**/{val}*"), recursive=True)
            cands = [c for c in cands if os.path.isfile(c)]
            if cands:
                p = Path(cands[0])
            else:
                eprint(f"file not found: {val}"); return 1
        # primary: DLNA via minidlna (works for both HEOS 1+5)
        try:
            ok = _heos_dlna_cast(ip, pid, p)
            tag = art.paint("✓", P.OK) if ok else art.paint("✗", P.WARN)
            print(f"  {tag} cast {p.name} → {sp_name} (DLNA)")
            if not ok:
                raise RuntimeError("DLNA queue failed")
            return 0
        except Exception as e:
            # fallback: direct HTTP via UPnP (HEOS 5) / play_stream
            try:
                url, port = _heos_serve_file(p)
                # try UPnP first (more reliable for local http than HEOS CLI)
                # HEOS CLI play_stream as last resort
                ok2 = _heos_play_url(pid, ip, url)
                # also try UPnP if HEOS side failed and it's a HEOS 5 (Cave) — via AVTransport
                if not ok2 and "Cave" in sp_name:
                    # try UPnP AVTransport directly
                    try:
                        import socket as _s
                        body = f'<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body><u:SetAVTransportURI xmlns:u="urn:schemas-upnp-org:service:AVTransport:1"><InstanceID>0</InstanceID><CurrentURI>{url}</CurrentURI><CurrentURIMetaData></CurrentURIMetaData></u:SetAVTransportURI></s:Body></s:Envelope>'
                        hdr = f'POST /upnp/control/renderer_dvc/AVTransport HTTP/1.0\r\nHost: {ip}:60006\r\nContent-Type: text/xml; charset="utf-8"\r\nSOAPAction: "urn:schemas-upnp-org:service:AVTransport:1#SetAVTransportURI"\r\nContent-Length: {len(body.encode())}\r\n\r\n{body}'
                        s=_s.create_connection((ip,60006),timeout=4); s.sendall(hdr.encode()); s.settimeout(4); d=b""
                        try:
                            while len(d)<4096:
                                ch=s.recv(4096)
                                if not ch: break
                                d+=ch
                        except: pass
                        s.close()
                        if b"200 OK" in d:
                            body2='<?xml version="1.0"?><s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"><s:Body><u:Play xmlns:u="urn:schemas-upnp-org:service:AVTransport:1"><InstanceID>0</InstanceID><Speed>1</Speed></u:Play></s:Body></s:Envelope>'
                            hdr2=f'POST /upnp/control/renderer_dvc/AVTransport HTTP/1.0\r\nHost: {ip}:60006\r\nContent-Type: text/xml; charset="utf-8"\r\nSOAPAction: "urn:schemas-upnp-org:service:AVTransport:1#Play"\r\nContent-Length: {len(body2.encode())}\r\n\r\n{body2}'
                            s=_s.create_connection((ip,60006),timeout=4); s.sendall(hdr2.encode()); s.settimeout(4); d=b""
                            try:
                                while len(d)<4096:
                                    ch=s.recv(4096)
                                    if not ch: break
                                    d+=ch
                            except: pass
                            s.close()
                            ok2 = b"200 OK" in d
                    except: pass
                tag = art.paint("✓", P.OK) if ok2 else art.paint("✗", P.WARN)
                print(f"  {tag} cast {p.name} → {sp_name} (HTTP fallback)")
                print(f"    url: {url}  (port {port}, pid {pid})")
                if not ok2:
                    eprint(f"  DLNA failed: {e}")
                    print(art.paint("  cast failed — is minidlna on 192.168.8.186:8200 running? check: curl http://192.168.8.186:8200/", P.WARN))
                    return 1
                return 0
            except Exception as e2:
                eprint(f"cast failed: {e} / fallback: {e2}"); return 1
    if act == "play" and val and str(val).startswith("http"):
        ok = _heos_play_url(pid, ip, str(val))
        print(art.paint(f"  {'✓' if ok else '✗'} play url → {sp_name}", P.OK if ok else P.WARN)); return 0 if ok else 1

    eprint(f"unknown speakers action: {act} — try: list, pause, resume, stop, next, prev, vol <n>, mute [on|off], cast <file>, play <url>"); return 1


def cmd_about(_: argparse.Namespace) -> int:
    print()
    print(art.box(
        [
            "ether — network paths & weaves for faeOS",
            "",
            "the ether answers to several names (multi-call):",
            "  whisper ether               tune the ANC headphone in",
            "  listen  ether               tune the JBL Go 3 in",
            "  ether                      live TUI: bt · wifi · lan (q to close)",
            "  ether TUI · n new → wired LAN / static IPv4 profile (systemd-networkd)",
            "  status ether               one-shot report: bt · wifi · lan",
            "",
            "  ether net                  connectivity across the weave",
            "  ether link [lan|usb|…]     show / select the internet path",
            "  ether veil [on|off|status] raise/lower the VPN (alias: vpn)",
            "  ether bridge               phone hotspot on boot (systemd)",
            "  ether ap [on|off|status]   house Wi-Fi AP (iw + hostapd; NetworkManager-free)",
            "  ether about",
            "",
            "Free media lives under Siren now:",
            "  siren trove list 10 music lofi",
            "  siren trove get <identifier>",
            "",
            "Phone hotspot (local only — never commit):",
            "  ~/.config/ether/netherweave.env",
            "    ETHER_NETHER_SSID=…  ETHER_NETHER_PSK=…",
        ],
        title="Ether",
        subtitle="network paths & weaves",
        body_style=(art.P.MUTED,),
        width=art.term_width(),
    ))
    print()
    return 0


_ACTION_ALIASES = {
    "raise": "on", "up": "on",
    "lower": "off", "down": "off",
    "check": "status",
}


def main() -> int:
    _bootstrap()

    prog = os.path.basename(sys.argv[0])
    rest = sys.argv[1:]

    if prog == "whisper":
        return cmd_weave("whisper", rest[0] if rest else None)
    if prog == "listen":
        return cmd_weave("listen", rest[0] if rest else None)
    if prog == "status":
        return cmd_info()

    ap = argparse.ArgumentParser(prog="ether", description="network paths & weaves for faeOS")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("net", help="IPv4/IPv6 + archive.org reachability")
    p.set_defaults(func=lambda _a: net_diag())

    p = sub.add_parser("veil", help="raise/lower the VPN", aliases=["vpn"])
    p.add_argument("action", nargs="?", default="toggle", help="on|off|status  (aliases raise/lower/up/down/check)")
    p.add_argument("--name", default=None, help="specific VPN connection name")
    p.set_defaults(func=cmd_veil)

    p = sub.add_parser("bridge", help="boot fallback: tether to phone hotspot (systemd)")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_bridge)

    p = sub.add_parser("ap", help="house Wi-Fi AP (iw + hostapd; NetworkManager-free)")
    p.add_argument("action", nargs="?", default="status", help="on|off|status")
    p.set_defaults(func=cmd_ap)

    p = sub.add_parser("speakers", help="HEOS speakers on the LAN (Denon HEOS API)")
    p.add_argument("action", nargs="?", default="list", help="list|status|pause|resume|stop|next|prev|vol|mute|cast|play")
    p.add_argument("value", nargs="?", default=None, help="volume level, url, or file for cast/play")
    p.add_argument("--speaker","-s", default=None, help="speaker name (default Vanguarda Office)")
    p.add_argument("--cached", action="store_true", help="last known roster only (no sweep)")
    p.set_defaults(func=cmd_speakers)

    p = sub.add_parser("link", help="show / select the network path (lan · usb tether)")
    p.add_argument("target", nargs="?", default=None,
                   help="lan | usb | tether | wifi | connection name")
    p.add_argument("--json", action="store_true",
                   help="machine-readable discovery data")
    p.add_argument("--dry-run", action="store_true",
                   help="print the commands without changing anything")
    p.add_argument("--quiet", "-q", action="store_true",
                   help="suppress human output (exit code only)")
    p.set_defaults(func=cmd_link)

    p = sub.add_parser("about")
    p.set_defaults(func=cmd_about)

    p = sub.add_parser("status", help="one-shot report: bt · wifi · lan")
    p.set_defaults(func=cmd_info)

    args = ap.parse_args()
    if not getattr(args, "cmd", None):
        return cmd_status()
    return args.func(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print()
        raise SystemExit(130)

