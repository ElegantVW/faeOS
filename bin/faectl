#!/usr/bin/env python3
"""faectl — FaeOS Control Panel & Service Supervisor.

Usage:
  faectl status           # Show dashboard of all services (LLM, Kur, Siren, Audio)
  faectl restart-llm      # Restart local LLM / menagerie
"""
from __future__ import annotations

import argparse
import json
import os
import socket
import subprocess
import sys
import urllib.request
from pathlib import Path

# Force Unicode box drawing for smooth round corners
os.environ["PIXIE_UNICODE"] = "1"

import sys as _sys
_sys.path.insert(0, str(Path.home() / "bin"))
import fae_termart as art
from fae_termart import Palette as P

def menagerie_status(profile: str) -> tuple[bool, str]:
    """Ask the AI control center (menagerie) for a profile's status."""
    try:
        out = subprocess.run(
            [str(Path.home() / "bin" / "menagerie"), "status", profile],
            capture_output=True, text=True, timeout=20,
        )
        for line in (out.stdout or "").splitlines():
            line = line.strip()
            if line.startswith("status:"):
                return out.returncode == 0, line.split(":", 1)[1].strip()
        return False, "unknown"
    except Exception:
        return False, "unknown"

def check_llm() -> tuple[bool, str]:
    ok, status = menagerie_status("qwen")
    return ok, f"{status} (menagerie qwen · 8080)"

def check_kur() -> tuple[bool, str]:
    ok, status = menagerie_status("kur")
    return ok, f"{status} (menagerie kur · 8081)"

def check_siren() -> tuple[bool, str]:
    sock = "/tmp/siren-mpv.sock"
    if os.path.exists(sock):
        try:
            client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            client.settimeout(0.5)
            client.connect(sock)
            client.sendall((json.dumps({"command": ["get_property", "pause"]}) + "\n").encode())
            raw = client.recv(1024).decode()
            client.close()
            paused = "true" in raw.lower()
            return True, ("Paused" if paused else "Playing")
        except Exception:
            return True, "Socket active (Idle)"
    return False, "Offline"

def check_volume() -> str:
    try:
        out = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], text=True, timeout=0.5)
        return out.strip()
    except Exception:
        return "Unknown"

def main() -> int:
    ap = argparse.ArgumentParser(description="FaeOS Control Panel & Service Supervisor")
    ap.add_argument("action", nargs="?", default="status", choices=("status", "restart-llm"))
    args = ap.parse_args()

    if args.action == "status":
        llm_ok, llm_status = check_llm()
        kur_ok, kur_status = check_kur()
        siren_ok, siren_status = check_siren()
        vol = check_volume()

        lines = [
            f"Pixie LLM (8080):  {llm_status}",
            f"Kur Server (8081):  {kur_status}",
            f"Siren Music Player: {siren_status}",
            f"Audio Sink Vol:     {vol}",
        ]
        w = max(45, min(65, art.term_width()))
        print()
        print(art.box(lines, title="Fae OS Control Panel", accent=P.PINK, width=w))
        print()
        return 0

    elif args.action == "restart-llm":
        print("Restarting local LLM (menagerie.service)…")
        subprocess.run(
            ["systemctl", "--user", "restart", "menagerie.service"],
            capture_output=True, timeout=30,
        )
        print("Done.")
        return 0

    return 0

if __name__ == "__main__":
    sys.exit(main())
