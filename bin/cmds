#!/usr/bin/env bash
# cmds — list custom / QOL commands (pink palette)
source "${HOME}/.config/palette.env" 2>/dev/null || true

# 256-color (works on more terminals than truecolor)
if [[ -z "${NO_COLOR:-}" ]]; then
  P=$'\033[38;5;175m'   # pink
  DP=$'\033[38;5;168m'  # dark pink
  PD=$'\033[38;5;132m'  # pink dim
  S=$'\033[38;5;252m'   # silver
  SD=$'\033[38;5;245m'  # silver dim
  W=$'\033[38;5;214m'   # warn
  D=$'\033[38;5;197m'   # danger
  O=$'\033[38;5;78m'    # ok
  B=$'\033[1m'
  R=$'\033[0m'
else
  P= DP= PD= S= SD= W= D= O= B= R=
fi

cat <<EOF
${PD}┌─────────────────────────────────────────┐${R}
${PD}│${R} ${B}${DP}YOUR COMMANDS${R}  ${SD}(type: cmds)${R}              ${PD}│${R}
${PD}└─────────────────────────────────────────┘${R}

${P}${B}MUSIC / AUDIO${R}
  ${S}play${R}              Shuffle ~/Music/*.wav (quiet; see prompt)
  ${S}next / play-next${R}  Next track
  ${S}prev / play-prev${R}  Previous track
  ${S}now  / play-now${R}   Print current track (optional)
  ${S}stop${R}              Stop mpv
  ${S}volume${R}            Show volume
  ${S}volume 30${R}         Set volume to 30% (0–150)
  ${S}yt <words>${R}        YouTube search → pick → play (needs fzf)
  ${S}ether list 10 music lofi${R}  Legal free media (Internet Archive)
  ${S}ether list 5 movie silent${R}   PD/CC films on archive.org
  ${S}ether about${R}       Legal sources & help

${P}${B}MAIL / CHAT${R}
  ${S}mail${R}              aerc email client
  ${S}pixie-mail sync${R}   Download unread (IMAP → ~/.cache/pixie/mail/unread/)
  ${S}pixie-mail list${R}   List local unread/read/trash .txt files
  ${S}pixie-mail bundle${R} All unread text (for summaries)
  ${S}pixie-mail move read|trash …${R}  Archive or trash (+ IMAP)
  ${S}pixie "check my emails"${R}  Sync + summarize + ask trash/read
  ${S}wolf${R}              Aardwolf MUD (tt++)

${P}${B}SEARCH${R} ${SD}(DuckDuckGo via ddgr)${R}
  ${S}duck <words>${R}         Fast: titles + snippets (no URLs)
  ${S}duck --deep 3 …${R}      Fetch top N pages (richer text)
  ${S}duck -a <words>${R}      Deepen top 3 + ONE AI summary
  ${S}duck --tor <words>${R}   DDG via Tor
  ${S}duck --any <words>${R}   ${W}If DDG fails: wiki/news (less private)${R}

${P}${B}AI${R} ${SD}(local offline — llama.cpp)${R}
  ${S}pixie-llm start${R}    Start offline llama.cpp (localhost only)
  ${S}pixie-llm stop${R}     Stop local server
  ${S}pixie-llm status${R}   URL / model / running?
  ${S}pixie "…"${R}         Your agent ${P}★${R} (wait + final only)
  ${S}pixie verbose on|off${R}  Show/hide tools + rounds
  ${S}pixie tools on|off${R}    Same as verbose
  ${S}pixie -v "…"${R}       Tools visible for one run
  ${S}ask "…"${R}           Same engine as pixie
  ${S}ask-web "…"${R}       Agent biased to web search
  ${S}pixie-llm chat "…"${R} Quick raw offline chat
  ${S}grok${R}              Grok CLI (cloud — optional, not offline)

${P}${B}ROUTER${R} ${SD}(Huawei / VDF terminal admin)${R}
  ${S}router probe${R}         Detect gateway + vendor
  ${S}router status${R}        Probe + PC IPv4/IPv6 check
  ${S}router wan${R}           WAN IP (asks/saves creds)
  ${S}router login${R}         Login + page probe
  ${S}router forget${R}        Delete saved creds

${P}${B}HELP / SYSTEM${R}
  ${S}cmds${R} / ${S}myhelp${R}     This list
  ${S}tick on [N]${R}       Clear every N sec + song change (idle)
  ${S}tick off${R}          Disable screen tick
  ${S}tick status${R}       Show tick + read-grace
  ${S}up${R} / ${S}up message${R}  Re-show last Pixie reply
  ${S}up 3${R}              Last 3 logged events

${SD}Idle tick: Pixie "waiting for you" box + prompt (not during pixie / read-grace).${R}
${SD}While thinking: wait box + clear on each new message (~10s). Reply kept ~45s.${R}

${W}${B}NOTES${R}
  ${W}•${R} ${SD}Pink/silver = normal UI${R}
  ${W}•${R} ${D}Red/danger${R}${SD} = errors / emergencies${R}
  ${W}•${R} ${W}Amber/warn${R}${SD} = important but not fatal${R}
  ${O}•${R} ${SD}Green/ok = success states${R}

${SD}source ~/.zshrc   ·   Shift+PgUp/PgDn to scroll${R}
EOF
