#!/usr/bin/env python3
"""summon — PATH tab of the unified scroll launcher.

Bare `summon` opens scroll on the PATH category (system launcher).
Fae spells live in other scroll tabs — run `scroll` for those.

    summon              PATH picker · Enter runs the command
    summon nano         PATH picker pre-filtered
    summon -x nano      exec first match (no TUI)
    summon --list       dump PATH names
    summon --refresh    rescan PATH cache

See `scroll --help` for the full command scroll (fae + PATH).
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

SCROLL = Path.home() / "bin" / "scroll"
if not SCROLL.is_file():
    SCROLL = Path(__file__).resolve().parent / "scroll"

if not SCROLL.is_file():
    print("summon: scroll not found (unified launcher)", file=sys.stderr)
    raise SystemExit(127)

# Shebang scripts rewrite argv0 to the script path — use env instead.
os.environ["FAE_SCROLL_TAB"] = "path"
os.execv(str(SCROLL), [str(SCROLL), *sys.argv[1:]])
