#!/usr/bin/env bash
# spellbook — thin launcher (never a prebuilt ELF in git)
# Discovery: SPELLBOOK_BIN → ~/.local/lib/faeos/spellbook → sibling tree
set -euo pipefail

USER_HOME="${HOME}"
if [[ -n "${SUDO_USER:-}" ]]; then
  USER_HOME="$(getent passwd "$SUDO_USER" 2>/dev/null | cut -d: -f6 || true)"
  USER_HOME="${USER_HOME:-$HOME}"
fi

CANDIDATES=(
  "${SPELLBOOK_BIN:-}"
  "$USER_HOME/.local/lib/faeos/spellbook"
  /usr/local/lib/faeos/spellbook
  "$USER_HOME/spellbook/target/release/spellbook"
  "${SPELLBOOK_ROOT:-}/target/release/spellbook"
)
here="$(cd "$(dirname "$0")" && pwd)"
if [[ -x "$here/../target/release/spellbook" ]]; then
  CANDIDATES+=("$here/../target/release/spellbook")
fi

for c in "${CANDIDATES[@]}"; do
  [[ -n "$c" && -x "$c" ]] || continue
  exec "$c" "$@"
done

echo "spellbook: engine not built yet." >&2
echo "  next:  cd ~/spellbook && ./build.sh install --house" >&2
exit 127
