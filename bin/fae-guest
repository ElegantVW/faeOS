#!/usr/bin/env bash
# fae-guest — temporary guest user for the faeOS lock screen
#    fae-guest start    creates guest, switches to VT
#    fae-guest stop     kills session, wipes, deletes user
#    fae-guest status   check if guest is active
set -euo pipefail

GUEST_USER="fae-guest"
GUEST_HOME="/tmp/fae-guest"

cmd_start() {
  if id "$GUEST_USER" &>/dev/null; then
    echo "guest already exists"
    return 0
  fi

  sudo useradd -M -s /usr/bin/zsh -d "$GUEST_HOME" -g users "$GUEST_USER"
  sudo mkdir -p "$GUEST_HOME"
  sudo chown "$GUEST_USER:users" "$GUEST_HOME"
  sudo chmod 700 "$GUEST_HOME"

  sudo tee "$GUEST_HOME/.zshrc" >/dev/null <<'EOF'
export PATH=/usr/local/bin:/usr/bin:/bin
export HOME=/tmp/fae-guest
PS1='guest > '
alias ls='ls --color=auto'
echo "✦ welcome, guest ✦"
echo "type 'exit' or Ctrl-D to leave"
EOF
  sudo chown "$GUEST_USER:users" "$GUEST_HOME/.zshrc"

  # lock down home dirs
  for d in /home/*; do
    if [[ -d "$d" && "$d" != "/home/$GUEST_USER" ]]; then
      sudo chmod o-rwx "$d" 2>/dev/null || true
    fi
  done

  echo "guest user created. switch to a new terminal (Ctrl+Alt+F3) and log in as '$GUEST_USER'"
}

cmd_stop() {
  if ! id "$GUEST_USER" &>/dev/null; then
    echo "no guest user"
    return 0
  fi

  # kill all guest processes
  sudo pkill -u "$GUEST_USER" 2>/dev/null || true
  sleep 0.5

  sudo userdel -r "$GUEST_USER" 2>/dev/null || true
  sudo rm -rf "$GUEST_HOME"

  # restore home permissions
  for d in /home/*; do
    if [[ -d "$d" ]]; then
      sudo chmod 755 "$d" 2>/dev/null || true
    fi
  done

  echo "guest removed"
}

cmd_status() {
  if id "$GUEST_USER" &>/dev/null; then
    echo "guest active ($GUEST_USER)"
    return 0
  else
    echo "no guest"
    return 1
  fi
}

case "${1:-}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  status)  cmd_status ;;
  *)       echo "usage: fae-guest {start|stop|status}" >&2; exit 1 ;;
esac
