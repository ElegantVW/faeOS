#!/usr/bin/env python3
"""reflection — screenshots & gallery for faeOS.

Capture the glass (full · window · region), then wander the gallery.
Backends: ImageMagick import, scrot/maim/grim, or pure X11 grab.

Storage:  $XDG_DATA_HOME/faeos/reflection/shots/
Override: REFLECTION_DIR=/path
View:     REFLECTION_VIEW=chafa|normal  (or: reflection view …)

    reflection                  TUI gallery
    reflection full [--open]    capture whole desktop
    reflection window [--open]  focused window
    reflection region [--open]  drag a rectangle
    reflection list [N]         recent shots
    reflection last             path of newest
    reflection open [path]      open by current view mode
    reflection open --chafa     force terminal art (chafa symbols)
    reflection open --normal    force real image scaled to the terminal
    reflection view [chafa|normal]  show or set default view mode
    reflection backend          which tools are live
    reflection -h

TUI: ↑↓ move · enter open (by view mode) · v toggle chafa/normal
     f full · w window · r region · d delete · o always normal
     y path · q leave
"""

from __future__ import annotations

import json
import os
import re
import shutil
import struct
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path.home() / "bin"))
os.environ["PIXIE_UNICODE"] = "1"

import fae_termart as art
from fae_termart import Palette as P

NAME = "Reflection"
MAX_INDEX = 500
VIEW_CHAFA = "chafa"
VIEW_NORMAL = "normal"
VIEW_MODES = (VIEW_CHAFA, VIEW_NORMAL)


# ── paths ──────────────────────────────────────────────────────────────


def data_dir() -> Path:
    env = (
        os.environ.get("REFLECTION_DIR", "").strip()
        or os.environ.get("REFLECTIONDIR", "").strip()
    )
    if env:
        p = Path(env).expanduser()
    else:
        base = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share"))
        p = base / "faeos" / "reflection"
    p.mkdir(parents=True, exist_ok=True)
    return p


def shots_dir() -> Path:
    p = data_dir() / "shots"
    p.mkdir(parents=True, exist_ok=True)
    return p


def index_path() -> Path:
    return data_dir() / "index.jsonl"


def config_path() -> Path:
    return data_dir() / "config.json"


def load_config() -> dict:
    path = config_path()
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_config(cfg: dict) -> None:
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def get_view_mode() -> str:
    """chafa = terminal art · normal = real image viewer / text glass."""
    env = os.environ.get("REFLECTION_VIEW", "").strip().lower()
    if env in VIEW_MODES:
        return env
    if env in ("term", "terminal", "symbols"):
        return VIEW_CHAFA
    if env in ("real", "image", "external", "native", "viewer"):
        return VIEW_NORMAL
    cfg = load_config()
    mode = str(cfg.get("view", VIEW_CHAFA)).strip().lower()
    if mode in VIEW_MODES:
        return mode
    if mode in ("term", "terminal", "symbols"):
        return VIEW_CHAFA
    if mode in ("real", "image", "external", "native", "viewer"):
        return VIEW_NORMAL
    # default: chafa when available, else normal
    return VIEW_CHAFA if _have("chafa") else VIEW_NORMAL


def set_view_mode(mode: str) -> str:
    mode = mode.strip().lower()
    aliases = {
        "term": VIEW_CHAFA,
        "terminal": VIEW_CHAFA,
        "symbols": VIEW_CHAFA,
        "c": VIEW_CHAFA,
        "real": VIEW_NORMAL,
        "image": VIEW_NORMAL,
        "external": VIEW_NORMAL,
        "native": VIEW_NORMAL,
        "viewer": VIEW_NORMAL,
        "n": VIEW_NORMAL,
    }
    mode = aliases.get(mode, mode)
    if mode not in VIEW_MODES:
        raise ValueError(f"view must be chafa or normal, not {mode!r}")
    cfg = load_config()
    cfg["view"] = mode
    save_config(cfg)
    return mode


# ── index ──────────────────────────────────────────────────────────────


@dataclass
class Shot:
    path: Path
    mode: str
    ts: str
    bytes: int
    width: int
    height: int
    n: int = 0  # 1-based newest-first


def _now_iso() -> str:
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def _stamp() -> str:
    return datetime.now().strftime("%Y%m%d-%H%M%S")


def _image_size(path: Path) -> tuple[int, int]:
    """PNG IHDR or identify(1); returns (w,h) or (0,0)."""
    try:
        raw = path.read_bytes()[:32]
        if raw[:8] == b"\x89PNG\r\n\x1a\n" and len(raw) >= 24:
            w, h = struct.unpack(">II", raw[16:24])
            return int(w), int(h)
    except OSError:
        pass
    # JPEG SOF — skip for simplicity; try identify
    if shutil.which("identify"):
        try:
            r = subprocess.run(
                ["identify", "-format", "%w %h", str(path)],
                capture_output=True,
                text=True,
                timeout=3,
            )
            if r.returncode == 0:
                parts = r.stdout.strip().split()
                if len(parts) >= 2:
                    return int(parts[0]), int(parts[1])
        except (OSError, subprocess.TimeoutExpired, ValueError):
            pass
    try:
        from PIL import Image

        with Image.open(path) as im:
            return im.size
    except Exception:
        return 0, 0


def load_index(limit: int = MAX_INDEX) -> list[dict]:
    path = index_path()
    if not path.exists():
        return []
    rows: list[dict] = []
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    except OSError:
        return []
    return rows[-limit:]


def append_index(rec: dict) -> None:
    path = index_path()
    with path.open("a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    rows = load_index(MAX_INDEX + 50)
    if len(rows) > MAX_INDEX:
        path.write_text(
            "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows[-MAX_INDEX:]),
            encoding="utf-8",
        )


def register_shot(path: Path, mode: str) -> Shot:
    path = path.resolve()
    w, h = _image_size(path)
    try:
        nbytes = path.stat().st_size
    except OSError:
        nbytes = 0
    rec = {
        "ts": _now_iso(),
        "mode": mode,
        "path": str(path),
        "bytes": nbytes,
        "width": w,
        "height": h,
    }
    append_index(rec)
    return Shot(path=path, mode=mode, ts=rec["ts"], bytes=nbytes, width=w, height=h)


def delete_shot_record(path: Path) -> bool:
    rows = load_index()
    sp = str(path.resolve())
    new = [r for r in rows if r.get("path") != sp and Path(r.get("path", "")).name != path.name]
    if len(new) == len(rows):
        # still try unlink
        try:
            path.unlink(missing_ok=True)
        except OSError:
            pass
        return False
    index_path().write_text(
        "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in new),
        encoding="utf-8",
    )
    try:
        path.unlink(missing_ok=True)
    except OSError:
        pass
    return True


def list_shots(limit: int = MAX_INDEX) -> list[Shot]:
    """Newest first. Prefer index; also pick up loose files in shots/."""
    seen: set[str] = set()
    out: list[Shot] = []
    for r in reversed(load_index(limit * 2)):
        p = Path(r.get("path", ""))
        if not p.is_file():
            continue
        key = str(p.resolve())
        if key in seen:
            continue
        seen.add(key)
        out.append(
            Shot(
                path=p,
                mode=r.get("mode", "?"),
                ts=r.get("ts", ""),
                bytes=int(r.get("bytes") or 0),
                width=int(r.get("width") or 0),
                height=int(r.get("height") or 0),
            )
        )
        if len(out) >= limit:
            break
    # orphan files
    if len(out) < limit:
        try:
            files = sorted(shots_dir().glob("*.png"), key=lambda p: p.stat().st_mtime, reverse=True)
        except OSError:
            files = []
        for p in files:
            key = str(p.resolve())
            if key in seen:
                continue
            w, h = _image_size(p)
            try:
                nbytes = p.stat().st_size
                mtime = datetime.fromtimestamp(p.stat().st_mtime).astimezone().isoformat(timespec="seconds")
            except OSError:
                nbytes, mtime = 0, ""
            out.append(Shot(path=p, mode="?", ts=mtime, bytes=nbytes, width=w, height=h))
            if len(out) >= limit:
                break
    for i, s in enumerate(out):
        s.n = i + 1
    return out


# ── helpers ────────────────────────────────────────────────────────────


def _have(name: str) -> bool:
    return shutil.which(name) is not None


def _run(cmd: list[str], *, timeout: float = 120.0) -> tuple[int, str, str]:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except FileNotFoundError:
        return 127, "", "not found"
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"


def _dest(mode: str, ext: str = "png") -> Path:
    return shots_dir() / f"{_stamp()}-{mode}.{ext}"


def _age(ts: str) -> str:
    try:
        t = datetime.fromisoformat(ts)
        if t.tzinfo is None:
            t = t.replace(tzinfo=timezone.utc)
        now = datetime.now(timezone.utc).astimezone()
        sec = max(0, int((now - t).total_seconds()))
    except Exception:
        return "?"
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m"
    if sec < 86400:
        return f"{sec // 3600}h"
    return f"{sec // 86400}d"


def _fmt_bytes(n: int) -> str:
    if n < 1024:
        return f"{n}B"
    if n < 1024 * 1024:
        return f"{n / 1024:.0f}K"
    return f"{n / (1024 * 1024):.1f}M"


def _fit(s: str, width: int) -> str:
    if art.vis_len(s) <= width:
        return s
    out: list[str] = []
    w = 0
    for ch in s:
        cw = art.vis_len(ch)
        if w + cw >= width - 1:
            break
        out.append(ch)
        w += cw
    return "".join(out) + "…"


def _line_count(s: str) -> int:
    return s.count("\n") + 1 if s else 0


# ── capture backends ───────────────────────────────────────────────────


def _import_bin() -> list[str] | None:
    if _have("import"):
        return ["import"]
    if _have("magick"):
        return ["magick", "import"]
    return None


def _active_window_id() -> str | None:
    """Hex window id from EWMH, e.g. 0x120000e."""
    if not _have("xprop"):
        return None
    rc, out, _ = _run(["xprop", "-root", "_NET_ACTIVE_WINDOW"], timeout=2)
    if rc != 0:
        return None
    # _NET_ACTIVE_WINDOW(WINDOW): window id # 0x120000e
    for tok in out.replace(",", " ").split():
        if tok.startswith("0x") or tok.startswith("0X"):
            if tok.lower() in ("0x0", "0x00"):
                return None
            return tok
    return None


def capture_full() -> tuple[Path | None, str]:
    dest = _dest("full")
    # grim (wayland)
    if os.environ.get("WAYLAND_DISPLAY") and _have("grim"):
        rc, _, err = _run(["grim", str(dest)])
        if rc == 0 and dest.is_file():
            return dest, "grim"
    # scrot
    if _have("scrot"):
        rc, _, err = _run(["scrot", str(dest)])
        if rc == 0 and dest.is_file():
            return dest, "scrot"
    # maim
    if _have("maim"):
        rc, _, err = _run(["maim", str(dest)])
        if rc == 0 and dest.is_file():
            return dest, "maim"
    # ImageMagick
    imp = _import_bin()
    if imp:
        rc, _, err = _run(imp + ["-window", "root", str(dest)])
        if rc == 0 and dest.is_file():
            return dest, "import"
    # pure X11
    if os.environ.get("DISPLAY"):
        if _x11_grab_root(dest):
            return dest, "x11"
    return None, err if "err" in dir() else "no capture backend"


def capture_window(win_id: str | None = None) -> tuple[Path | None, str]:
    dest = _dest("window")
    wid = win_id or _active_window_id()
    # maim -i
    if _have("maim") and wid:
        # maim wants decimal id sometimes
        try:
            dec = str(int(wid, 16)) if wid.startswith("0x") else wid
        except ValueError:
            dec = wid
        rc, _, err = _run(["maim", "-i", dec, str(dest)])
        if rc == 0 and dest.is_file():
            return dest, "maim"
    # import -window
    imp = _import_bin()
    if imp and wid:
        rc, _, err = _run(imp + ["-window", wid, str(dest)])
        if rc == 0 and dest.is_file():
            return dest, "import"
    # scrot -u focused
    if _have("scrot"):
        rc, _, err = _run(["scrot", "-u", str(dest)])
        if rc == 0 and dest.is_file():
            return dest, "scrot"
    # interactive click-window with import
    if imp:
        print("reflection: click a window…", file=sys.stderr)
        rc, _, err = _run(imp + [str(dest)], timeout=300)
        if rc == 0 and dest.is_file():
            return dest, "import-click"
    return None, "no window capture (need import/scrot/maim + DISPLAY)"


def capture_region() -> tuple[Path | None, str]:
    dest = _dest("region")
    # grim + slurp
    if os.environ.get("WAYLAND_DISPLAY") and _have("grim") and _have("slurp"):
        rc, geo, err = _run(["slurp"], timeout=300)
        if rc == 0 and geo.strip():
            rc2, _, err2 = _run(["grim", "-g", geo.strip(), str(dest)])
            if rc2 == 0 and dest.is_file():
                return dest, "grim+slurp"
    # maim -s
    if _have("maim"):
        print("reflection: drag a region…", file=sys.stderr)
        rc, _, err = _run(["maim", "-s", str(dest)], timeout=300)
        if rc == 0 and dest.is_file():
            return dest, "maim"
    # scrot -s
    if _have("scrot"):
        print("reflection: select a region…", file=sys.stderr)
        rc, _, err = _run(["scrot", "-s", str(dest)], timeout=300)
        if rc == 0 and dest.is_file():
            return dest, "scrot"
    # ImageMagick interactive
    imp = _import_bin()
    if imp:
        print("reflection: drag a rectangle, release to capture…", file=sys.stderr)
        rc, _, err = _run(imp + [str(dest)], timeout=300)
        if rc == 0 and dest.is_file():
            return dest, "import"
    return None, "no region capture (need import/maim/scrot/grim+slurp)"


def _x11_grab_root(dest: Path) -> bool:
    """Full-screen grab via libX11 + Pillow (or raw PPM)."""
    try:
        import ctypes
        from ctypes import POINTER, byref, c_char_p, c_int, c_uint, c_ulong, c_void_p
    except ImportError:
        return False
    try:
        lib = ctypes.CDLL("libX11.so.6")
    except OSError:
        return False

    lib.XOpenDisplay.argtypes = [c_char_p]
    lib.XOpenDisplay.restype = c_void_p
    lib.XCloseDisplay.argtypes = [c_void_p]
    lib.XDefaultScreen.argtypes = [c_void_p]
    lib.XDefaultScreen.restype = c_int
    lib.XRootWindow.argtypes = [c_void_p, c_int]
    lib.XRootWindow.restype = c_ulong
    lib.XDisplayWidth.argtypes = [c_void_p, c_int]
    lib.XDisplayWidth.restype = c_int
    lib.XDisplayHeight.argtypes = [c_void_p, c_int]
    lib.XDisplayHeight.restype = c_int
    lib.XGetImage.argtypes = [c_void_p, c_ulong, c_int, c_int, c_uint, c_uint, c_ulong, c_int]
    lib.XGetImage.restype = c_void_p
    lib.XDestroyImage.argtypes = [c_void_p]

    # XImage layout (partial)
    class XImage(ctypes.Structure):
        _fields_ = [
            ("width", c_int),
            ("height", c_int),
            ("xoffset", c_int),
            ("format", c_int),
            ("data", ctypes.c_char_p),
            ("byte_order", c_int),
            ("bitmap_unit", c_int),
            ("bitmap_bit_order", c_int),
            ("bitmap_pad", c_int),
            ("depth", c_int),
            ("bytes_per_line", c_int),
            ("bits_per_pixel", c_int),
            ("red_mask", c_ulong),
            ("green_mask", c_ulong),
            ("blue_mask", c_ulong),
        ]

    dpy = lib.XOpenDisplay(None)
    if not dpy:
        return False
    try:
        screen = lib.XDefaultScreen(dpy)
        root = lib.XRootWindow(dpy, screen)
        w = lib.XDisplayWidth(dpy, screen)
        h = lib.XDisplayHeight(dpy, screen)
        AllPlanes = c_ulong(~0)
        ZPixmap = 2
        img_p = lib.XGetImage(dpy, root, 0, 0, w, h, AllPlanes, ZPixmap)
        if not img_p:
            return False
        img = ctypes.cast(img_p, POINTER(XImage)).contents
        bpl = img.bytes_per_line
        bpp = img.bits_per_pixel
        depth = img.depth
        # copy pixel data
        nbytes = bpl * h
        buf = ctypes.string_at(img.data, nbytes)
        lib.XDestroyImage(img_p)

        # convert BGRA/RGB to PNG via Pillow, else PPM
        try:
            from PIL import Image

            if bpp == 32:
                # typically BGRA on little-endian X
                im = Image.frombuffer("RGB", (w, h), buf, "raw", "BGRX", bpl, 1)
            elif bpp == 24:
                im = Image.frombuffer("RGB", (w, h), buf, "raw", "BGR", bpl, 1)
            else:
                raise ValueError(f"unsupported bpp {bpp}")
            im.save(dest, "PNG")
            return dest.is_file()
        except Exception:
            # PPM fallback
            ppm = dest.with_suffix(".ppm")
            # only 32bpp BGRA → RGB
            if bpp != 32:
                return False
            rows = []
            for y in range(h):
                row = buf[y * bpl : y * bpl + w * 4]
                rgb = bytearray()
                for i in range(0, len(row), 4):
                    b, g, r = row[i], row[i + 1], row[i + 2]
                    rgb.extend((r, g, b))
                rows.append(bytes(rgb))
            with ppm.open("wb") as f:
                f.write(f"P6\n{w} {h}\n255\n".encode())
                f.write(b"".join(rows))
            # try convert to png
            if _have("convert") or _have("magick"):
                conv = ["magick", str(ppm), str(dest)] if _have("magick") else ["convert", str(ppm), str(dest)]
                rc, _, _ = _run(conv, timeout=30)
                try:
                    ppm.unlink(missing_ok=True)
                except OSError:
                    pass
                return rc == 0 and dest.is_file()
            # keep ppm as dest rename
            dest.unlink(missing_ok=True)
            ppm.rename(dest.with_suffix(".ppm"))
            return True
    except Exception:
        return False
    finally:
        try:
            lib.XCloseDisplay(dpy)
        except Exception:
            pass


def do_capture(mode: str) -> tuple[Shot | None, str]:
    mode = mode.lower()
    if mode in ("full", "screen", "desktop"):
        path, be = capture_full()
        label = "full"
    elif mode in ("window", "win", "w"):
        path, be = capture_window()
        label = "window"
    elif mode in ("region", "area", "sel", "r"):
        path, be = capture_region()
        label = "region"
    else:
        return None, f"unknown mode {mode!r}"
    if path is None:
        return None, be
    shot = register_shot(path, label)
    return shot, be


def backend_report() -> str:
    lines = [
        f"DISPLAY={os.environ.get('DISPLAY') or '(unset)'}",
        f"WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY') or '(unset)'}",
    ]
    for t in ("import", "magick", "scrot", "maim", "grim", "slurp", "chafa", "kitty", "xprop", "convert", "feh", "imv"):
        lines.append(f"  {t}: {'yes' if _have(t) else 'no'}")
    lines.append(f"  graphics backend: {graphics_backend()}")
    try:
        import ctypes

        ctypes.CDLL("libX11.so.6")
        lines.append("  libX11: yes")
    except Exception as e:
        lines.append(f"  libX11: no ({e})")
    try:
        from PIL import Image  # noqa: F401

        lines.append("  Pillow: yes")
    except Exception:
        lines.append("  Pillow: no")
    lines.append(f"  shots dir: {shots_dir()}")
    return "\n".join(lines)


# ── preview / open ─────────────────────────────────────────────────────


@dataclass
class ImagePlace:
    """Where to paint a real (pixel) image inside the TUI after the text frame."""

    path: Path
    col: int  # 0-based cell
    row: int  # 0-based cell
    cols: int
    rows: int


def _term_is_kitty() -> bool:
    if os.environ.get("KITTY_WINDOW_ID"):
        return True
    term = (os.environ.get("TERM") or "").lower()
    if "kitty" in term:
        return True
    # nested under ssh to kitty
    if "kitty" in (os.environ.get("TERM_PROGRAM") or "").lower():
        return True
    return False


def graphics_backend() -> str:
    """Best real-image terminal backend for embedding.

    Prefer chafa protocol streams (reliable on raw fds). kitty icat is used
    only as a fullscreen option when a controlling TTY is available.
    """
    if _have("chafa"):
        if _term_is_kitty():
            return "chafa-kitty"
        term = (os.environ.get("TERM") or "").lower()
        if "iterm" in term or os.environ.get("ITERM_SESSION_ID"):
            return "chafa-iterm"
        return "chafa-sixels"
    if _have("kitty") and _term_is_kitty():
        return "kitty-icat"
    return "none"


def clear_inline_images(fd: int) -> None:
    """Remove previously placed kitty/sixel images so redraws don't stack."""
    try:
        # Kitty: delete all visible images
        os.write(fd, b"\x1b_Ga=d,d=A\x1b\\")
    except OSError:
        pass


def paint_scaled_image(
    fd: int,
    path: Path,
    *,
    cols: int,
    rows: int,
    col: int = 0,
    row: int = 0,
) -> str:
    """Paint the real image scaled into a cell rectangle. Returns backend or ''."""
    if not path.is_file() or cols < 2 or rows < 1:
        return ""
    try:
        # 1) chafa pixel formats — work when writing to any tty fd
        if _have("chafa"):
            if _term_is_kitty():
                fmt, be = "kitty", "chafa-kitty"
            elif os.environ.get("ITERM_SESSION_ID") or "iterm" in (
                os.environ.get("TERM") or ""
            ).lower():
                fmt, be = "iterm", "chafa-iterm"
            else:
                fmt, be = "sixels", "chafa-sixels"
            home = f"\x1b[{row + 1};{col + 1}H".encode()
            r = subprocess.run(
                [
                    "chafa",
                    "-f",
                    fmt,
                    f"--size={cols}x{rows}",
                    "--animate=off",
                    str(path),
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=8,
            )
            if r.returncode == 0 and r.stdout:
                data = r.stdout
                # strip cursor hide/show chafa may prefix
                if data.startswith(b"\x1b[?25l"):
                    data = data[6:]
                if data.endswith(b"\x1b[?25h"):
                    data = data[:-6]
                os.write(fd, home + data)
                return be

        # 2) kitty icat with place (needs a real terminal environment)
        if _have("kitty") and _term_is_kitty():
            place = f"{cols}x{rows}@{col}x{row}"
            r = subprocess.run(
                [
                    "kitty",
                    "+kitten",
                    "icat",
                    f"--place={place}",
                    "--scale-up",
                    "--align=center",
                    "--transfer-mode=stream",
                    str(path),
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=8,
            )
            if r.returncode == 0 and r.stdout:
                os.write(fd, r.stdout)
                return "kitty-icat"
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return ""


def _wait_one_key_early() -> None:
    """Key wait usable before the TUI helper section is defined."""
    try:
        with open("/dev/tty", "r") as tin:
            term_fd = tin.fileno()
            import termios
            import tty

            old = termios.tcgetattr(term_fd)
            try:
                tty.setcbreak(term_fd)
                os.read(term_fd, 1)
            finally:
                termios.tcsetattr(term_fd, termios.TCSADRAIN, old)
    except (OSError, EOFError):
        pass


def show_image_fullscreen(path: Path, fd: int | None = None) -> str:
    """Show real image scaled to the whole terminal; wait for a key. Returns backend."""
    if not path.is_file():
        return "missing"
    close_fd = False
    if fd is None:
        try:
            fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
            close_fd = True
        except OSError:
            return "no-tty"
    try:
        try:
            cols, rows = shutil.get_terminal_size((80, 24))
        except OSError:
            cols, rows = 80, 24
        img_rows = max(4, rows - 2)
        clear_inline_images(fd)
        os.write(fd, b"\x1b[H\x1b[2J\x1b[?25l")
        be = paint_scaled_image(fd, path, cols=cols, rows=img_rows, col=0, row=0)
        if not be and _have("chafa"):
            lines = preview_chafa(path, cols, img_rows)
            if lines:
                os.write(fd, ("\n".join(lines) + "\n").encode("utf-8", "replace"))
                be = "chafa-symbols"
        if not be:
            return open_external_gui(path)
        hint = f"\x1b[{rows};1H\x1b[0m  {path.name}  ·  scaled image  ·  any key\x1b[K"
        os.write(fd, hint.encode("utf-8", "replace"))
        _wait_one_key_early()
        clear_inline_images(fd)
        return be or "image"
    except OSError:
        return "failed"
    finally:
        if close_fd and fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def preview_chafa(path: Path, cols: int, rows: int) -> list[str]:
    """Render image to exactly ≤rows terminal lines, each ≤cols visible cells.

    Always forces ``-f symbols``: piped chafa otherwise emits Kitty/sixel
    (one opaque line) so the looking glass looks empty and height math dies.
    Clamped so art.box() never re-wraps (which shreds ANSI and inflates height).
    """
    if not _have("chafa") or not path.is_file() or rows < 1 or cols < 4:
        return []
    cols = max(8, cols)
    rows = max(1, rows)
    size = f"{cols}x{rows}"
    # Strip cursor / kitty noise chafa sometimes prefixes
    junk_re = re.compile(
        r"\x1b\[\?25[lh]"  # cursor hide/show
        r"|\x1b_G[^\x1b]*\x1b\\"  # kitty graphics
        r"|\x1bP[^\x1b]*\x1b\\"  # sixel DCS (coarse)
    )
    try:
        r = subprocess.run(
            [
                "chafa",
                f"--size={size}",
                "--animate=off",
                "-f",
                "symbols",  # never sixel/kitty into a box
                str(path),
            ],
            capture_output=True,
            text=True,
            timeout=8,
            env={**os.environ, "TERM": os.environ.get("TERM", "xterm-256color")},
        )
        if r.returncode != 0 or not r.stdout.strip():
            return []
        text = junk_re.sub("", r.stdout)
        out: list[str] = []
        for raw in text.splitlines():
            if not raw and out:
                continue
            # Keep ANSI if it fits; otherwise hard-cut plain (box would re-wrap).
            plain = art.strip_ansi(raw)
            if not plain.strip() and not out:
                continue
            if art.vis_len(plain) > cols:
                cut: list[str] = []
                w = 0
                for ch in plain:
                    cw = art.vis_len(ch)
                    if w + cw > cols:
                        break
                    cut.append(ch)
                    w += cw
                raw = "".join(cut)
            out.append(raw)
            if len(out) >= rows:
                break
        return out[:rows]
    except (OSError, subprocess.TimeoutExpired):
        return []


def open_external_gui(path: Path) -> str:
    """Open in a GUI image viewer (separate window). Returns status."""
    if not path.is_file():
        return "missing"
    for cmd in (
        ["xdg-open", str(path)],
        ["feh", "--scale-down", "--auto-zoom", str(path)],
        ["imv", str(path)],
        ["mpv", "--loop-file=no", str(path)],
    ):
        if not _have(cmd[0]):
            continue
        try:
            subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            return cmd[0]
        except OSError:
            continue
    return "no viewer"


def open_external(path: Path) -> str:
    """Prefer in-terminal scaled image; fall back to GUI viewer."""
    # When we have a real TTY + graphics, scale into the terminal.
    if graphics_backend() != "none":
        try:
            be = show_image_fullscreen(path)
            if be not in ("missing", "no-tty", "failed", "no viewer"):
                return be
        except Exception:
            pass
    return open_external_gui(path)


# ── CLI ────────────────────────────────────────────────────────────────


def cmd_list(n: int = 20) -> int:
    shots = list_shots(n)
    print(f"# {NAME}  {shots_dir()}  ({len(shots)})")
    for s in shots:
        dim = f"{s.width}×{s.height}" if s.width else "?"
        print(
            f"{s.n:3}  {_age(s.ts):>4}  {s.mode:<7}  {_fmt_bytes(s.bytes):>6}  {dim:<11}  {s.path.name}"
        )
    return 0


def cmd_last() -> int:
    shots = list_shots(1)
    if not shots:
        print("reflection: no shots yet", file=sys.stderr)
        return 1
    print(shots[0].path)
    return 0


def cmd_capture(mode: str, *, open_after: bool = False, open_mode: str | None = None) -> int:
    shot, be = do_capture(mode)
    if shot is None:
        print(f"reflection: capture failed — {be}", file=sys.stderr)
        return 1
    print(shot.path)
    print(
        f"reflection: {shot.mode} via {be} · {shot.width}×{shot.height} · {_fmt_bytes(shot.bytes)}",
        file=sys.stderr,
    )
    if open_after:
        return cmd_open(shot.path, view=open_mode or get_view_mode())
    return 0


def cmd_open(path: Path | None = None, *, view: str | None = None) -> int:
    if path is None:
        shots = list_shots(1)
        if not shots:
            print("reflection: no shots", file=sys.stderr)
            return 1
        path = shots[0].path
    path = Path(path).expanduser()
    if not path.is_file():
        print(f"reflection: not found: {path}", file=sys.stderr)
        return 1
    mode = (view or get_view_mode()).lower()
    if mode == VIEW_CHAFA:
        if not _have("chafa"):
            print("reflection: chafa not installed — opening scaled image", file=sys.stderr)
            mode = VIEW_NORMAL
        else:
            cols = shutil.get_terminal_size((80, 24)).columns
            rows = max(8, shutil.get_terminal_size((80, 24)).lines - 4)
            lines = preview_chafa(path, cols, rows)
            if lines:
                dest = sys.stdout
                try:
                    if not sys.stdout.isatty():
                        dest = open("/dev/tty", "w")
                except OSError:
                    dest = sys.stdout
                print("\n".join(lines), file=dest)
                print(f"\n{path}", file=dest)
                if dest is not sys.stdout:
                    dest.close()
                return 0
            print("reflection: chafa preview empty — falling back to image", file=sys.stderr)
            mode = VIEW_NORMAL
    # normal: real image scaled to the terminal (or GUI fallback)
    be = open_external(path)
    print(f"reflection: scaled image via {be}: {path}", file=sys.stderr)
    return 0 if be not in ("no viewer", "missing", "failed", "no-tty") else 1


def cmd_view(argv: list[str]) -> int:
    if not argv:
        mode = get_view_mode()
        print(f"view: {mode}")
        print(f"  chafa  — terminal art (chafa symbols)")
        print(f"  normal — real image scaled to the terminal (kitty/sixel)")
        print(f"graphics: {graphics_backend()}")
        print(f"config: {config_path()}")
        return 0
    try:
        mode = set_view_mode(argv[0])
    except ValueError as e:
        print(f"reflection: {e}", file=sys.stderr)
        return 2
    print(f"reflection: view mode → {mode}", file=sys.stderr)
    return 0


# ── TUI ────────────────────────────────────────────────────────────────


def _mirror_rows(
    shots: list[Shot],
    sel: int,
    n_rows: int,
    body_w: int,
) -> list[str]:
    """Exactly n_rows list lines (padded), newest-first shots."""
    n_rows = max(1, n_rows)
    if not shots:
        rows = [art.pad_vis(_fit("(empty gallery — f full · w window · r region)", body_w), body_w)]
        while len(rows) < n_rows:
            rows.append(" " * body_w)
        return rows[:n_rows]

    start = max(0, min(sel - n_rows // 2, max(0, len(shots) - n_rows)))
    end = min(len(shots), start + n_rows)
    rows: list[str] = []
    for i in range(start, end):
        s = shots[i]
        mark = "✦" if i == sel else " "
        dim = f"{s.width}×{s.height}" if s.width else "?"
        left = f" {mark} {_age(s.ts):>4}  {s.mode:<6}  "
        rest = f"{dim}  {s.path.name}"
        line = left + _fit(rest, max(4, body_w - art.vis_len(left)))
        line = art.pad_vis(_fit(line, body_w), body_w)
        if i == sel:
            rows.append(art.paint(line, P.PINK))
        else:
            rows.append(line)
    while len(rows) < n_rows:
        rows.append(" " * body_w)
    return rows[:n_rows]


def _glass_rows(
    shot: Shot | None,
    body_w: int,
    n_rows: int,
    *,
    view: str,
) -> list[str]:
    """Looking-glass body: chafa art, or blank canvas for real-image overlay."""
    n_rows = max(1, n_rows)
    if shot is None:
        rows = [
            art.pad_vis(
                _fit("(no mirrors yet — f full · w window · r region)", body_w),
                body_w,
            )
        ]
    elif view == VIEW_CHAFA:
        chafa_lines = preview_chafa(shot.path, body_w, n_rows) if _have("chafa") else []
        if chafa_lines:
            rows = list(chafa_lines)
        else:
            dim = f"{shot.width}×{shot.height}" if shot.width else "?"
            rows = [
                art.pad_vis(_fit("(chafa unavailable — v for normal)", body_w), body_w),
                art.pad_vis(_fit(shot.path.name, body_w), body_w),
                art.pad_vis(
                    _fit(f"{dim} · {_fmt_bytes(shot.bytes)} · {shot.mode}", body_w),
                    body_w,
                ),
            ]
    else:
        # normal mode — blank cells; real pixels painted after the text frame
        if graphics_backend() == "none":
            dim = f"{shot.width}×{shot.height}" if shot.width else "?"
            rows = [
                art.pad_vis(_fit("normal image (no terminal graphics)", body_w), body_w),
                art.pad_vis(_fit("enter / o → open viewer · install kitty/chafa", body_w), body_w),
                art.pad_vis(_fit(shot.path.name, body_w), body_w),
                art.pad_vis(
                    _fit(f"{dim} · {_fmt_bytes(shot.bytes)}", body_w),
                    body_w,
                ),
            ]
        else:
            rows = [" " * body_w]
    while len(rows) < n_rows:
        rows.append(" " * body_w)
    return rows[:n_rows]


def build_frame(
    shots: list[Shot],
    sel: int,
    *,
    flash: str,
    mode: str,
    pending: Shot | None,
    view: str,
) -> tuple[str, int, ImagePlace | None]:
    """Height-safe layout: head + mirrors + looking glass + Runes always fit.

    Returns (frame, list_rows_used, image_place for normal-mode overlay).
    """
    tw = art.term_width()
    th = art.term_height()
    # art.box caps outer at 96 and uses body_w = outer - 4
    outer = max(36, min(tw, 96))
    body_w = outer - 4

    view_label = "chafa" if view == VIEW_CHAFA else "normal"
    gfx = graphics_backend() if view == VIEW_NORMAL else ""
    st = flash or (
        f"{len(shots)} mirrors · view {view_label}"
        + (f"/{gfx}" if gfx else "")
        + f" · {shots_dir().name}/"
    )
    head_lines = [_fit(st, body_w)]
    if mode == "confirm_del" and pending:
        head_lines.append(
            art.paint(
                _fit(f"shatter this mirror?  y / n  ·  {pending.path.name}", body_w),
                P.WARN,
            )
        )
    head = art.box(
        head_lines,
        title=f"{NAME} ✦ gallery",
        width=outer,
        body_style=(P.MUTED,),
    )
    runes = art.box(
        [
            _fit("↑↓ move · enter open · v chafa|normal · f/w/r capture", body_w),
            _fit("o fullscreen image · d delete · y path · q leave", body_w),
        ],
        title="Runes",
        width=outer,
        body_style=(P.MUTED,),
    )
    head_h = _line_count(head)
    runes_h = _line_count(runes)
    # 3 blank separators between 4 panels
    gaps = 3
    fixed = head_h + runes_h + gaps
    remain = th - fixed
    if remain < 6:
        list_content = max(1, remain - 2)
        glass_content = 0
    else:
        # normal mode wants a large glass for the real image
        if view == VIEW_NORMAL:
            glass_total_budget = max(8, min(18, remain * 3 // 5))
        else:
            glass_total_budget = max(5, min(14, remain * 2 // 5))
        glass_content = max(3, glass_total_budget - 2)
        list_total = remain - (glass_content + 2)
        list_content = max(1, list_total - 2)

    shot = shots[sel] if shots else None

    def assemble(lc: int, gc: int) -> str:
        body = art.box(
            _mirror_rows(shots, sel, max(1, lc), body_w),
            title="mirrors",
            width=outer,
            body_style=(P.SILVER,),
        )
        parts = [head, "", body]
        if gc > 0:
            glass_title = (
                "looking glass · chafa"
                if view == VIEW_CHAFA
                else "looking glass · image"
            )
            glass = art.box(
                _glass_rows(shot, body_w, gc, view=view),
                title=glass_title,
                width=outer,
                body_style=(P.SILVER,),
            )
            parts += ["", glass]
        parts += ["", runes]
        return "\n".join(parts)

    frame = assemble(list_content, glass_content)
    guard = 0
    while _line_count(frame) > th and guard < 40:
        guard += 1
        if list_content > 1:
            list_content -= 1
        elif glass_content > 3:
            glass_content -= 1
        elif glass_content > 0:
            glass_content = 0
        elif list_content > 0:
            break
        else:
            break
        frame = assemble(list_content, glass_content)

    if _line_count(frame) > th:
        frame = assemble(max(1, list_content), 0)
        glass_content = 0
    if _line_count(frame) > th:
        frame = assemble(1, 0)
        list_content = 1
        glass_content = 0
    if _line_count(frame) > th:
        lines = frame.splitlines()
        runes_lines = runes.splitlines()
        head_lines_f = head.splitlines()
        keep_tail = len(runes_lines) + 1
        keep_head = len(head_lines_f) + 1
        mid_budget = max(0, th - keep_head - keep_tail)
        mid = lines[keep_head : len(lines) - keep_tail]
        frame = "\n".join(
            head_lines_f + [""] + mid[:mid_budget] + ([""] if mid_budget else []) + runes_lines
        )
        glass_content = 0
        if _line_count(frame) > th:
            frame = "\n".join(frame.splitlines()[:th])

    # Geometry for real-image overlay inside looking glass (0-based cells)
    place: ImagePlace | None = None
    if (
        view == VIEW_NORMAL
        and shot is not None
        and glass_content > 0
        and graphics_backend() != "none"
    ):
        # frame layout: head, blank, body, blank, glass, blank, runes
        body_h = _line_count(
            art.box(
                _mirror_rows(shots, sel, max(1, list_content), body_w),
                title="mirrors",
                width=outer,
                body_style=(P.SILVER,),
            )
        )
        # 0-based row of glass title line
        glass_title_row = head_h + 1 + body_h + 1
        content_row = glass_title_row + 1  # first content line inside box
        # box: "│ " + body + " │" → content starts at col 2
        content_col = 2
        place = ImagePlace(
            path=shot.path,
            col=content_col,
            row=content_row,
            cols=body_w,
            rows=glass_content,
        )

    return frame, list_content, place


def _wait_one_key() -> None:
    _wait_one_key_early()


def open_shot_in_tui(path: Path, view: str, fd: int | None = None) -> str:
    """Open selected shot according to view mode. Returns status flash."""
    if view == VIEW_CHAFA and _have("chafa"):
        try:
            with open("/dev/tty", "w") as tout:
                tout.write("\033[2J\033[H")
                cols = shutil.get_terminal_size((80, 24)).columns
                rows_n = max(10, shutil.get_terminal_size((80, 24)).lines - 3)
                lines = preview_chafa(path, cols, rows_n)
                if lines:
                    tout.write("\n".join(lines) + "\n")
                else:
                    tout.write(art.paint("  (chafa empty)\n", P.WARN))
                tout.write(
                    art.paint(
                        f"\n  {path}  ·  chafa  ·  any key to return\n",
                        P.MUTED,
                    )
                )
                tout.flush()
            _wait_one_key()
            return "chafa preview"
        except (OSError, EOFError):
            return "chafa failed"
    # normal: real image scaled to the terminal window
    be = show_image_fullscreen(path, fd=fd)
    return f"image · {be}"


def run_tui() -> int:
    fd = art.tui_open_tty()
    if fd is None:
        return cmd_list()

    art.tui_begin(fd, "reflection")
    sel = 0
    flash = ""
    mode = "nav"  # nav | confirm_del
    pending: Shot | None = None
    list_rows = 3
    view = get_view_mode()
    try:
        while True:
            shots = list_shots()
            if sel >= len(shots):
                sel = max(0, len(shots) - 1)

            frame, list_rows, img_place = build_frame(
                shots, sel, flash=flash, mode=mode, pending=pending, view=view
            )
            try:
                clear_inline_images(fd)
                art.paint_frame(fd, frame)
                # normal mode: paint real image scaled into the looking glass
                if img_place is not None:
                    paint_scaled_image(
                        fd,
                        img_place.path,
                        cols=img_place.cols,
                        rows=img_place.rows,
                        col=img_place.col,
                        row=img_place.row,
                    )
            except OSError:
                pass
            flash = ""

            key = art.tui_read_key(fd)

            if mode == "confirm_del":
                if key in ("y", "Y") and pending:
                    delete_shot_record(pending.path)
                    mode = "nav"
                    pending = None
                    flash = "mirror shattered"
                elif key in ("n", "N", "esc", "q"):
                    mode = "nav"
                    pending = None
                    flash = "kept"
                continue

            if key in ("q", "Q", "esc", "ctrl-c"):
                art.tui_cleanup()
                return 0
            if key == "up":
                sel = max(0, sel - 1)
            elif key == "down":
                sel = min(max(0, len(shots) - 1), sel + 1)
            elif key == "home":
                sel = 0
            elif key == "end":
                sel = max(0, len(shots) - 1)
            elif key == "pgup":
                sel = max(0, sel - list_rows)
            elif key == "pgdn":
                sel = min(max(0, len(shots) - 1), sel + list_rows)
            elif key in ("enter", "right", " "):
                if shots:
                    art.tui_suspend()
                    try:
                        clear_inline_images(fd)
                        flash = open_shot_in_tui(shots[sel].path, view, fd=fd)
                    finally:
                        art.tui_resume()
            elif key in ("v", "V", "t", "T"):
                # toggle view mode and remember it
                view = VIEW_NORMAL if view == VIEW_CHAFA else VIEW_CHAFA
                try:
                    set_view_mode(view)
                except ValueError:
                    pass
                flash = f"view → {view}" + (
                    " (terminal art)" if view == VIEW_CHAFA else " (real image)"
                )
            elif key == "c":
                view = VIEW_CHAFA
                try:
                    set_view_mode(view)
                except ValueError:
                    pass
                flash = "view → chafa (terminal art)"
            elif key == "n":
                view = VIEW_NORMAL
                try:
                    set_view_mode(view)
                except ValueError:
                    pass
                flash = "view → normal (real image)"
            elif key in ("f", "F"):
                art.tui_suspend()
                try:
                    shot, be = do_capture("full")
                finally:
                    art.tui_resume()
                if shot:
                    flash = f"full via {be} · {shot.path.name}"
                    sel = 0
                    if view == VIEW_NORMAL:
                        art.tui_suspend()
                        try:
                            clear_inline_images(fd)
                            show_image_fullscreen(shot.path, fd=fd)
                        finally:
                            art.tui_resume()
                        flash = f"full via {be} · scaled image"
                else:
                    flash = f"full failed — {be}"
            elif key in ("w", "W"):
                art.tui_suspend()
                try:
                    with open("/dev/tty", "w") as tout:
                        tout.write(art.paint("\n  capturing window…\n", P.PINK))
                        tout.flush()
                    shot, be = do_capture("window")
                finally:
                    art.tui_resume()
                if shot:
                    flash = f"window via {be} · {shot.path.name}"
                    sel = 0
                    if view == VIEW_NORMAL:
                        art.tui_suspend()
                        try:
                            clear_inline_images(fd)
                            show_image_fullscreen(shot.path, fd=fd)
                        finally:
                            art.tui_resume()
                        flash = f"window via {be} · scaled image"
                else:
                    flash = f"window failed — {be}"
            elif key in ("r", "R"):
                art.tui_suspend()
                try:
                    with open("/dev/tty", "w") as tout:
                        tout.write(
                            art.paint(
                                "\n  drag a rectangle on the screen…\n",
                                P.PINK,
                            )
                        )
                        tout.flush()
                    shot, be = do_capture("region")
                finally:
                    art.tui_resume()
                if shot:
                    flash = f"region via {be} · {shot.path.name}"
                    sel = 0
                    if view == VIEW_NORMAL:
                        art.tui_suspend()
                        try:
                            clear_inline_images(fd)
                            show_image_fullscreen(shot.path, fd=fd)
                        finally:
                            art.tui_resume()
                        flash = f"region via {be} · scaled image"
                else:
                    flash = f"region failed — {be}"
            elif key in ("d", "D", "delete"):
                if shots:
                    pending = shots[sel]
                    mode = "confirm_del"
            elif key in ("o", "O"):
                # always real image scaled to the window
                if shots:
                    art.tui_suspend()
                    try:
                        clear_inline_images(fd)
                        be = show_image_fullscreen(shots[sel].path, fd=fd)
                    finally:
                        art.tui_resume()
                    flash = f"image · {be}"
            elif key in ("y", "Y"):
                if shots:
                    art.tui_cleanup()
                    print(shots[sel].path)
                    return 0
            elif key == "g":
                # refresh / re-read
                flash = "gallery refreshed"
    finally:
        try:
            art.tui_cleanup()
        except Exception:
            pass


# ── main ───────────────────────────────────────────────────────────────


def _parse_open_flags(args: list[str]) -> tuple[Path | None, str | None]:
    """Return (path, view_override) from open argv."""
    view: str | None = None
    path: Path | None = None
    for a in args:
        if a in ("--chafa", "-c", "--term"):
            view = VIEW_CHAFA
        elif a in ("--normal", "--real", "--image", "-n", "--native"):
            view = VIEW_NORMAL
        elif a in ("--open",):
            continue
        elif a.startswith("-"):
            continue
        else:
            path = Path(a).expanduser()
    return path, view


def _parse_capture_flags(args: list[str]) -> tuple[bool, str | None]:
    open_after = False
    view: str | None = None
    for a in args:
        if a in ("--open", "-o"):
            open_after = True
        elif a in ("--chafa", "-c", "--term"):
            open_after = True
            view = VIEW_CHAFA
        elif a in ("--normal", "--real", "--image", "-n", "--native"):
            open_after = True
            view = VIEW_NORMAL
    return open_after, view


def main(argv: list[str]) -> int:
    if not argv:
        return run_tui()

    cmd = argv[0]
    rest = argv[1:]

    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if cmd in ("tui", "ui", "gallery"):
        return run_tui()
    if cmd == "list":
        n = 20
        if rest:
            try:
                n = int(rest[0])
            except ValueError:
                pass
        return cmd_list(n)
    if cmd == "last":
        return cmd_last()
    if cmd in ("full", "screen", "desktop"):
        open_after, view = _parse_capture_flags(rest)
        return cmd_capture("full", open_after=open_after, open_mode=view)
    if cmd in ("window", "win"):
        open_after, view = _parse_capture_flags(rest)
        return cmd_capture("window", open_after=open_after, open_mode=view)
    if cmd in ("region", "area", "sel"):
        open_after, view = _parse_capture_flags(rest)
        return cmd_capture("region", open_after=open_after, open_mode=view)
    if cmd == "open":
        p, view = _parse_open_flags(rest)
        return cmd_open(p, view=view)
    if cmd in ("view", "mode"):
        return cmd_view(rest)
    if cmd == "backend":
        print(backend_report())
        print(f"view mode: {get_view_mode()}")
        return 0
    if cmd == "capture" and rest:
        open_after, view = _parse_capture_flags(rest[1:])
        return cmd_capture(rest[0], open_after=open_after, open_mode=view)
    print(f"reflection: unknown command {cmd!r} (try reflection -h)", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
