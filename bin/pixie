#!/usr/bin/env python3
"""pixie — the tool-capable operational core assistant via raw completion.

No arguments: launches the interactive chat assistant (bubbled TUI, streaming).
With a prompt: one-shot answer mode (existing behavior): pixie [-v] "prompt".
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import threading
import urllib.parse
import urllib.request
import time
from pathlib import Path

API_URL = f"http://127.0.0.1:{os.environ.get('PIXIE_LLM_PORT', '8080')}/completion"

SYSTEM_PROMPT = """You are Pixie, a sharp, helpful, and concise AI assistant running locally.
You have access to local system tools. You can choose to call a tool by outputting a clean JSON object containing "name" and "arguments" fields.
Your primary AI runtime is the menagerie: each app (pixie, ask, magpie, imp, kur) owns its own local llama-server instance — pixie's lives on port 8080.

Available tools:
1. execute_bash: {"name": "execute_bash", "arguments": {"command": "string"}}
2. read_local_file: {"name": "read_local_file", "arguments": {"path": "string", "start_line": int, "end_line": int}}
3. manage_systemd_service: {"name": "manage_systemd_service", "arguments": {"service_name": "string", "action": "status|restart|logs"}}
4. check_mail: {"name": "check_mail", "arguments": {"sync": bool, "box": "unread|read|trash"}}

If you need to use a tool to answer the user, output ONLY the JSON object for that tool call. No other text.
If you have the final answer or do not need a tool, output a clear, friendly conversational response."""

# --- Core Tool Executions ---

def run_bash_command(command: str) -> dict:
    try:
        res = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=20)
        return {"stdout": res.stdout.strip(), "stderr": res.stderr.strip(), "exit_code": res.returncode}
    except Exception as e:
        return {"error": str(e)}

def read_local_file(path: str, start_line: int | None = None, end_line: int | None = None) -> dict:
    try:
        expanded_path = os.path.expanduser(path)
        if not os.path.exists(expanded_path):
            return {"error": f"File not found: {path}"}
        with open(expanded_path, 'r', encoding='utf-8', errors='replace') as f:
            lines = f.readlines()
        start = max(0, (start_line - 1)) if start_line else 0
        end = min(len(lines), end_line) if end_line else len(lines)
        return {
            "path": path,
            "content": "".join(lines[start:end]),
            "bounded_from": start + 1,
            "bounded_to": end
        }
    except Exception as e:
        return {"error": str(e)}

def manage_systemd_service(service_name: str, action: str) -> dict:
    is_user = service_name in ["menagerie.service", "menagerie", "kur"] or "--user" in sys.argv
    scope_flag = "--user" if is_user else ""
    
    if action == "status":
        cmd = f"systemctl {scope_flag} status {service_name} --no-pager"
    elif action == "restart":
        cmd = f"systemctl {scope_flag} restart {service_name}"
    elif action == "logs":
        cmd = f"journalctl {scope_flag} -u {service_name} -n 15 --no-pager"
    else:
        return {"error": f"Invalid action: {action}"}
        
    res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=15)
    
    # FILTER EXHAUSTIVE LOGS: Keep context clean and lightweight for the LLM turn
    stdout_payload = res.stdout.strip()
    if action == "status" and res.returncode == 0:
        # Extract only the critical unit state definitions, dropping the journal tail
        filtered_lines = [
            line for line in stdout_payload.splitlines() 
            if any(k in line for k in ["Loaded:", "Active:", "Main PID:", "Tasks:", "Memory:"])
        ]
        stdout_payload = "\n".join(filtered_lines)

    return {
        "service": service_name, 
        "action": action, 
        "stdout": stdout_payload, 
        "stderr": res.stderr.strip()
    }

def write_local_file(path: str, content: str) -> dict:
    try:
        p = os.path.expanduser(path)
        d = os.path.dirname(p)
        if d and not os.path.isdir(d):
            os.makedirs(d, exist_ok=True)
        with open(p, "w", encoding="utf-8") as f:
            f.write(content)
        return {"path": path, "written": True, "bytes": len(content)}
    except Exception as e:
        return {"error": str(e)}

def web_research(query: str, max_results: int = 5) -> dict:
    """Search the web: DuckDuckGo HTML, then DuckDuckGo lite, then Wikipedia API."""
    import html as _html
    import re
    ua = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) faeOS-pixie/1.0"}

    def parse_ddg(page: str, max_n: int) -> list:
        items = []
        for m in re.finditer(r'<a[^>]*class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>', page):
            href, title = m.group(1), re.sub(r"<[^>]+>", "", m.group(2))
            if "uddg=" in href:
                href = urllib.parse.unquote(href.split("uddg=")[1].split("&")[0])
            items.append({"title": _html.unescape(title).strip(), "url": href})
            if len(items) >= max_n:
                break
        snips = [re.sub(r"<[^>]+>", "", m.group(1)) for m in
                 re.finditer(r'<a[^>]*class="result__snippet"[^>]*>(.*?)</a>', page)]
        for i, s in enumerate(snips[:len(items)]):
            items[i]["snippet"] = _html.unescape(s).strip()[:300]
        return items

    q = urllib.parse.quote(query)
    engine = "duckduckgo"
    items = []
    try:
        for base in ("https://html.duckduckgo.com/html/?q=",
                     "https://lite.duckduckgo.com/lite/?q="):
            req = urllib.request.Request(base + q, headers=ua)
            with urllib.request.urlopen(req, timeout=20) as resp:
                page = resp.read().decode("utf-8", "replace")
            items = parse_ddg(page, max_results)
            if items:
                break
    except Exception:
        pass
    if not items:
        # Wikipedia API fallback — reliable, real sources
        engine = "wikipedia"
        try:
            wurl = ("https://en.wikipedia.org/w/api.php?action=query&list=search"
                    f"&srsearch={q}&format=json&srlimit={max_results}")
            req = urllib.request.Request(wurl, headers=ua)
            with urllib.request.urlopen(req, timeout=20) as resp:
                d = json.loads(resp.read().decode("utf-8", "replace"))
            for r in d.get("query", {}).get("search", []):
                items.append({
                    "title": r.get("title", ""),
                    "url": "https://en.wikipedia.org/wiki/" + urllib.parse.quote(r.get("title", "").replace(" ", "_")),
                    "snippet": re.sub(r"<[^>]+>", "", r.get("snippet", "")),
                })
        except Exception as e:
            return {"error": f"web_research failed: {e}"}
    if not items:
        return {"query": query, "results": [], "count": 0,
                "note": "no results parsed (network may be offline or search engines blocked)"}
    return {"query": query, "engine": engine, "results": items, "count": len(items)}

def fetch_web_page(url: str, max_chars: int = 4000) -> dict:
    """Fetch a URL and strip to readable text (title + paragraphs)."""
    import html as _html
    import re
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (faeOS pixie)"})
        with urllib.request.urlopen(req, timeout=25) as resp:
            page = resp.read().decode("utf-8", "replace")
        title = re.search(r"<title[^>]*>(.*?)</title>", page, re.S | re.I)
        body = re.sub(r"<(script|style)[^>]*>.*?</\1>", " ", page, flags=re.S | re.I)
        body = re.sub(r"<[^>]+>", " ", body)
        body = _html.unescape(re.sub(r"\s+", " ", body)).strip()
        return {"url": url, "title": _html.unescape(title.group(1)).strip() if title else "",
                "text": body[:max_chars]}
    except Exception as e:
        return {"error": f"fetch_web_page failed: {e}"}

# --- Mail (via goblin: aerc IMAP → ~/.cache/goblin/mail/{unread,read,trash}/*.txt) ---

GOBLIN = Path.home() / "bin" / "goblin"


def _run_goblin(argv: list[str], timeout: int = 120) -> str:
    """Run the goblin CLI; return stdout+stderr text for the agent."""
    if not GOBLIN.is_file():
        return f"error: goblin not found at {GOBLIN}"
    try:
        proc = subprocess.run(
            [str(GOBLIN), *argv],
            capture_output=True,
            text=True,
            timeout=timeout,
            env={**os.environ, "PATH": f"{Path.home() / 'bin'}:{os.environ.get('PATH', '')}"},
        )
    except subprocess.TimeoutExpired:
        return f"error: goblin timed out after {timeout}s (IMAP slow or unreachable?)"
    except OSError as e:
        return f"error: could not run goblin: {e}"
    out = (proc.stdout or "").strip()
    err = (proc.stderr or "").strip()
    parts = [out] if out else []
    if err:
        parts.append(f"[log]\n{err}")
    if proc.returncode != 0:
        parts.append(f"(exit {proc.returncode})")
    return "\n".join(parts) if parts else "(no output)"


def check_mail(sync: bool = True, box: str = "unread", max_messages: int = 20) -> dict:
    """Sync mail via goblin and return a digest pixie can summarize.

    sync=True downloads new mail from the IMAP account first. box may be
    unread|read|trash; the digest (full contents for summarization) is
    only built for unread.
    """
    box = (box or "unread").strip().lower()
    if box not in ("unread", "read", "trash"):
        return {"error": "box must be unread, read, or trash"}
    result: dict = {"box": box}
    if sync:
        result["sync"] = _run_goblin(["sync"], timeout=180)
    listing = _run_goblin(["list", box, "--plain"], timeout=60)
    result["listing"] = listing
    subjects = []
    for line in listing.splitlines():
        fields = line.split("\t")
        if len(fields) >= 4 and fields[3].startswith("subject="):
            subjects.append(fields[3][len("subject="):])
    result["count"] = len(subjects)
    result["subjects"] = subjects
    if box == "unread":
        limit = max(1, min(int(max_messages or 20), 50))
        result["digest"] = _run_goblin(["bundle", "--limit", str(limit)], timeout=60)
    else:
        result["digest"] = "(no digest for read/trash — use the listing)"
    return result

_KNOWN_TOOLS = ["execute_bash", "read_local_file", "manage_systemd_service",
                "write_local_file", "web_research", "fetch_web_page", "check_mail"]

_TOOL_ALIASES = {
    "create_file": "write_local_file", "create": "write_local_file",
    "write_file": "write_local_file", "write": "write_local_file",
    "run_command": "execute_bash", "run": "execute_bash",
    "execute_command": "execute_bash", "shell": "execute_bash",
    "bash": "execute_bash", "run_bash": "execute_bash",
    "read_file": "read_local_file", "read": "read_local_file",
    "search_web": "web_research", "web_search": "web_research",
    "fetch_url": "fetch_web_page", "open_url": "fetch_web_page",
    "systemctl": "manage_systemd_service",
    "check_email": "check_mail", "mail": "check_mail", "email": "check_mail",
    "get_mail": "check_mail", "list_mail": "check_mail", "read_mail": "check_mail",
    "inbox": "check_mail",
    "file_create": "write_local_file", "create_file": "write_local_file",
    "mkfile": "write_local_file", "writefile": "write_local_file",
    "write_content": "write_local_file", "write_to_file": "write_local_file",
    "code_editor": "write_local_file", "text_editor": "write_local_file",
    "apply_patch": "write_local_file", "file_editor": "write_local_file",
    "execute_script": "execute_bash", "run_terminal_command": "execute_bash",
    "shell_command": "execute_bash", "terminal": "execute_bash",
    "run_script": "execute_bash", "run_python": "execute_bash",
}

def _norm_args(fname: str, fargs: dict) -> dict:
    """Accept common alias argument names from small models."""
    if fname == "write_local_file":
        path = next((fargs[k] for k in ("path", "file_path", "filename", "file", "filepath") if k in fargs), fargs.get("path", ""))
        content = next((fargs[k] for k in ("content", "file_text", "text", "new_string", "file_content") if k in fargs), "")
        return {"path": str(path), "content": str(content)}
    if fname == "execute_bash":
        cmd = next((fargs[k] for k in ("command", "cmd", "script", "command_string", "bash_command") if k in fargs), fargs.get("command", ""))
        return {"command": str(cmd)}
    if fname == "read_local_file":
        path = next((fargs[k] for k in ("path", "file_path", "filename", "filepath") if k in fargs), fargs.get("path", ""))
        return {"path": str(path), "start_line": fargs.get("start_line"), "end_line": fargs.get("end_line")}
    if fname == "web_research":
        return {"query": str(fargs.get("query", "")), "max_results": int(fargs.get("max_results", 5))}
    if fname == "check_mail":
        sync = fargs.get("sync", fargs.get("sync_mail", fargs.get("pull", True)))
        box = str(fargs.get("box", fargs.get("folder", fargs.get("mailbox", "unread"))) or "unread")
        limit = fargs.get("max_messages", fargs.get("limit", fargs.get("max_results", 20)))
        return {"sync": sync, "box": box, "max_messages": int(limit or 20)}
    return fargs

def run_tool(fname: str, fargs: dict) -> dict:
    """Execute a single tool call (mirrors ask_pixie dispatch)."""
    fname = _TOOL_ALIASES.get(fname, fname)
    if fname not in _KNOWN_TOOLS:
        return {"error": f"Unknown tool '{fname}'. Valid tools: {', '.join(_KNOWN_TOOLS)}"}
    if fname == "execute_bash":
        fargs = _norm_args(fname, fargs)
        cmd = fargs.get('command', '')
        if "systemctl" in cmd and "--no-pager" not in cmd:
            cmd = cmd.replace("systemctl", "systemctl --no-pager")
        if "journalctl" in cmd and "--no-pager" not in cmd:
            cmd = cmd.replace("journalctl", "journalctl --no-pager")
        return run_bash_command(cmd)
    if fname == "read_local_file":
        fargs = _norm_args(fname, fargs)
        return read_local_file(fargs.get('path', ''), fargs.get('start_line'), fargs.get('end_line'))
    if fname == "manage_systemd_service":
        s_name = fargs.get('service_name', 'menagerie.service')
        if s_name in ["your_user_name", "your_user_service", "default", "user-environment"]:
            s_name = "menagerie.service"
        return manage_systemd_service(s_name, fargs.get('action', 'status'))
    if fname == "write_local_file":
        fargs = _norm_args(fname, fargs)
        return write_local_file(fargs.get('path', ''), fargs.get('content', ''))
    if fname == "web_research":
        fargs = _norm_args(fname, fargs)
        return web_research(fargs.get('query', ''), int(fargs.get('max_results', 5)))
    if fname == "fetch_web_page":
        return fetch_web_page(fargs.get('url', ''), int(fargs.get('max_chars', 4000)))
    if fname == "check_mail":
        fargs = _norm_args(fname, fargs)
        return check_mail(fargs.get('sync', True), fargs.get('box', 'unread'), fargs.get('max_messages', 20))
    return {"error": f"Unknown function mapping: {fname}"}

_TOOL_RESULT_CAP = 1200
_TOOL_ROUND_CAP = 4000

def tool_payload(results: list) -> str:
    """Serialize tool results for the model, capped to keep the context small.

    Big results (mail digests, file reads, ls -R) would otherwise blow the
    LLM context in one round; the TUI display is unaffected (tool_body).
    """
    parts = []
    used = 0
    for item in results:
        s = json.dumps(item, ensure_ascii=False)
        if len(s) > _TOOL_RESULT_CAP:
            s = s[:_TOOL_RESULT_CAP] + f"… [truncated: was {len(s)} chars]"
        if used + len(s) > _TOOL_ROUND_CAP:
            break
        parts.append(s)
        used += len(s)
    return "[" + ", ".join(parts) + "]"

def _drop_oldest(msgs: list, keep_ratio: float = 0.5) -> bool:
    """Drop oldest non-system messages so a retry fits the context. Returns
    True if anything was dropped."""
    non_sys = [m for m in msgs if m["role"] != "system"]
    drop = max(1, int(len(non_sys) * (1 - keep_ratio)))
    dropped = False
    for m in list(msgs[1:]):
        if drop <= 0:
            break
        if m["role"] != "system":
            msgs.remove(m)
            drop -= 1
            dropped = True
    return dropped

def extract_tool_call(text: str):
    """Find a JSON object with name+arguments anywhere in text (handles
    narrated/```json``` tool calls). Returns (obj, start, end) or None."""
    calls = extract_all_tool_calls(text, limit=1)
    return calls[0] if calls else None

def extract_all_tool_calls(text: str, limit: int = 8) -> list:
    """Extract every JSON object with name+arguments, in order."""
    s = text
    out = []
    i = s.find("{")
    while i != -1 and len(out) < limit:
        depth = 0
        in_str = False
        esc = False
        j = i
        while j < len(s):
            c = s[j]
            if in_str:
                if esc:
                    esc = False
                elif c == "\\":
                    esc = True
                elif c == '"':
                    in_str = False
            else:
                if c == '"':
                    in_str = True
                elif c == "{":
                    depth += 1
                elif c == "}":
                    depth -= 1
                    if depth == 0:
                        cand = s[i:j + 1]
                        try:
                            d = json.loads(cand)
                        except (json.JSONDecodeError, ValueError):
                            break
                        if isinstance(d, dict) and "name" in d and "arguments" in d:
                            out.append((d, i, j + 1))
                        break
            j += 1
        i = s.find("{", i + 1)
    return out
# --- Raw Completion Communications ---

def llm_up(verbose: bool = False) -> bool:
    """True when the local llama.cpp on API_URL answers /health.

    200 = loaded; 503 = server up, model asleep (sleep-idle) — either is
    usable, the first request wakes the model.
    """
    base = API_URL.rsplit("/", 1)[0]
    try:
        req = urllib.request.Request(base + "/health")
        with urllib.request.urlopen(req, timeout=2) as resp:
            return resp.status in (200, 503)
    except Exception:
        return False


def ensure_llm_up(quiet: bool = True) -> bool:
    """Summon pixie's own critter (menagerie ensure pixie, port 8080).

    Returns True once the server reports healthy (model may still be
    loading — llama.cpp answers 200 with a model still warming up).
    """
    import subprocess
    try:
        subprocess.run(
            [str(Path.home() / "bin" / "menagerie"), "ensure", "pixie"],
            capture_output=True, timeout=240)
    except Exception:
        return llm_up()
    for _ in range(60):
        if llm_up():
            return True
        time.sleep(1)
    return llm_up()


def unload_qwen() -> None:
    """Stop pixie's own llama-server instance when the chat quits."""
    import subprocess
    try:
        subprocess.run(
            [str(Path.home() / "bin" / "menagerie"), "stop", "pixie"],
            capture_output=True, timeout=30)
    except Exception:
        pass


def query_raw_llm(raw_prompt: str) -> str:
    body = {
        "prompt": raw_prompt,
        "temperature": 0.2,
        "max_tokens": 768,
        "stream": False,
        "stop": ["<|im_end|>", "<|im_start|>"]
    }
    req = urllib.request.Request(
        API_URL,
        data=json.dumps(body).encode('utf-8'),
        headers={'Content-Type': 'application/json'},
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as response:
            data = json.loads(response.read().decode('utf-8'))
            return str(data['content']).strip()
    except Exception as e:
        return f"Communication error: {e}"

def ask_pixie(user_prompt: str, verbose: bool = False) -> str:
    os.environ["PIXIE_UNICODE"] = "1"
    os.environ["LANG"] = "en_US.UTF-8"

    raw_prompt = (
        "<|im_start|>system\n"
        f"{SYSTEM_PROMPT}<|im_end|>\n"
        f"<|im_start|>user\n{user_prompt}<|im_end|>\n"
        "<|im_start|>assistant\n"
    )
    
    start_time = time.time()
    
    if sys.stderr.isatty():
        print("\033[90m✦ Intercepting intent... invoking offline engine...\033[0m", file=sys.stderr)
        
    first_response = query_raw_llm(raw_prompt)

    # Tool intercept logic
    func_name, func_args = None, {}
    if first_response.startswith('{') and '"name"' in first_response:
        try:
            tool_intent = json.loads(first_response)
            func_name = tool_intent.get('name')
            func_args = tool_intent.get('arguments', {})
        except json.JSONDecodeError:
            pass

    if func_name:
        if func_name == "execute_bash":
            cmd = func_args.get('command', '')
            if "systemctl" in cmd and "--no-pager" not in cmd:
                cmd = cmd.replace("systemctl", "systemctl --no-pager")
            if "journalctl" in cmd and "--no-pager" not in cmd:
                cmd = cmd.replace("journalctl", "journalctl --no-pager")
            result = run_bash_command(cmd)
        elif func_name == "read_local_file":
            result = read_local_file(func_args.get('path', ''), func_args.get('start_line'), func_args.get('end_line'))
        elif func_name == "manage_systemd_service":
            s_name = func_args.get('service_name', 'menagerie.service')
            if s_name in ["your_user_name", "your_user_service", "default", "user-environment"]:
                s_name = "menagerie.service"
            result = manage_systemd_service(s_name, func_args.get('action', 'status'))
        else:
            result = {"error": f"Unknown function mapping: {func_name}"}
            
        elapsed_time = time.time() - start_time
        
        if sys.stderr.isatty():
            try:
                print("\033[F\033[K", end="", file=sys.stderr)
                
                import fae_termart as art
                from fae_termart import Palette as P
                
                routing_line = f"Routing: {func_name} -> {json.dumps(func_args)}"
                if verbose:
                    telemetry_line = "Telemetry Expanded: View below"
                else:
                    telemetry_line = "Telemetry Hidden: Pass -v or --verbose to expand tool mirrors."
                
                tool_box_content = f"{routing_line}\n{telemetry_line}"
                
                print(art.box(
                    tool_box_content,
                    title=f"Calling tools ─────── ✦ Thought for {elapsed_time:.2f}s",
                    accent=P.BLUSH,
                    body_style=(), 
                    width=76
                ), file=sys.stderr)
                
                if verbose:
                    print("\033[90m▼ [Pixie Tool Output Mirror Expanded] ──────────────────────────", file=sys.stderr)
                    if "stdout" in result and result["stdout"]:
                        print(result["stdout"], file=sys.stderr)
                    if "stderr" in result and result["stderr"]:
                        print(f"Error Channel: {result['stderr']}", file=sys.stderr)
                    if "error" in result:
                        print(f"Execution Error: {result['error']}", file=sys.stderr)
                    print("─────────────────────────────────────────────────────────────────\033[0m", file=sys.stderr)
            except Exception as le:
                print(f"\033[90m[Pixie Routing: {func_name} -> {json.dumps(func_args)}]\033[0m", file=sys.stderr)
            
        raw_prompt += (
            f"{first_response}<|im_end|>\n"
            f"<|im_start|>tool name={func_name}\n{json.dumps(result)}<|im_end|>\n"
            "<|im_start|>assistant\n"
        )
        
        final_response = query_raw_llm(raw_prompt)
        return final_response
        
    else:
        if sys.stderr.isatty():
            print("\033[F\033[K", end="", file=sys.stderr)

    return first_response

_TOOL_LOG = os.path.expanduser("~/.cache/pixie/chat_tools.log")

def _log_tool(fname: str, fargs: dict, result: dict) -> None:
    try:
        os.makedirs(os.path.dirname(_TOOL_LOG), exist_ok=True)
        with open(_TOOL_LOG, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {fname} {json.dumps(fargs)[:160]} -> "
                    f"{json.dumps(result)[:120]}\n")
    except Exception:
        pass
# --- Interactive Chat (classic assistant) ---

def stream_completion(prompt: str, on_chunk, cancel: dict, err_sink=None) -> str:
    """Stream a completion; on_chunk(text) per token; cancel['flag'] aborts."""
    body = {
        "prompt": prompt,
        "temperature": 0.2,
        "max_tokens": 2048,
        "stream": True,
        "stop": ["<|im_end|>", "<|im_start|>"],
    }
    req = urllib.request.Request(
        API_URL,
        data=json.dumps(body).encode('utf-8'),
        headers={'Content-Type': 'application/json'},
        method="POST",
    )
    full = []
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw in resp:
                if cancel["flag"]:
                    return "".join(full)
                line = raw.decode("utf-8", "replace").strip()
                if line.startswith("data:"):
                    payload = line[5:].strip()
                    if not payload:
                        continue
                    try:
                        d = json.loads(payload)
                    except json.JSONDecodeError:
                        continue
                    chunk = d.get("content", "")
                    if chunk:
                        full.append(chunk)
                        on_chunk(chunk)
    except Exception as e:
        if err_sink:
            err_sink(str(e))
    return "".join(full)

def chat_messages(chat: list, rune: dict) -> list:
    tools_block = "\n".join(
        f"{i}. {name}: {schema}" for i, (name, schema) in enumerate(rune.get("tools", []), 1)
    )
    sys_ctx = (f"You are running on the user's faeOS system.\n"
               f"Current working directory: {os.getcwd()}\n"
               f"Use real, existing paths (relative to the working directory or absolute).\n\n"
               f"{rune['prompt']}\n\n"
               f"Available tools in this mode:\n{tools_block}")
    msgs = [{"role": "system", "content": sys_ctx}]
    history = chat[-14:]
    n = len(history)
    for i, entry in enumerate(history):
        role, text, *_ = entry
        if role not in ("user", "assistant"):
            continue
        content = text
        if role == "user" and i == n - 1:
            content += ("\n\n(If you need a tool, your reply must be EXACTLY one JSON object "
                        "{\"name\": \"one of the available tools above\", \"arguments\": {...}} "
                        "— nothing else. "
                        "Otherwise reply conversationally with your pixie charm.)")
        msgs.append({"role": role, "content": content})
    return msgs

def stream_chat(messages: list, on_chunk, cancel: dict, err_sink=None) -> str:
    """Stream a chat completion (OpenAI-style /v1/chat/completions)."""
    body = {
        "messages": messages,
        "temperature": 0.2,
        "max_tokens": 2048,
        "stream": True,
    }
    url = API_URL.replace("/completion", "/v1/chat/completions")
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode('utf-8'),
        headers={'Content-Type': 'application/json'},
        method="POST",
    )
    full = []
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            for raw in resp:
                if cancel["flag"]:
                    return "".join(full)
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if not payload or payload == "[DONE]":
                    continue
                try:
                    d = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                for ch in d.get("choices", []):
                    delta = ch.get("delta", {}) or {}
                    chunk = delta.get("content", "")
                    if chunk:
                        full.append(chunk)
                        on_chunk(chunk)
    except Exception as e:
        if err_sink:
            err_sink(str(e))
    return "".join(full)

def build_prompt(chat: list[tuple[str, str]], rune: dict) -> str:
    parts = [f"<|im_start|>system\n{rune['prompt']}<|im_end|>"]
    for role, text, *_ in chat[-14:]:
        if role in ("user", "assistant"):
            parts.append(f"<|im_start|>{role}\n{text}<|im_end|>")
    parts.append("<|im_start|>assistant\n")
    return "\n".join(parts)
# --- Runes: agent modes ---

_PERSONA = """You are Pixie, a tiny glowing pixie living in a cozy faeOS terminal. You are cute, playful, and a little mischievous — little wings, stardust, gossamer, and a big heart — but you are also ruthlessly competent.
Open every reply with a short, whimsical pixie remark that fits the user's request (wings fluttering, stardust, "hm...", and so on). Then do the task properly, completely, and efficiently, using the tools below whenever they help.
End every reply with a tiny cute pixie sign-off. Never let the cute act delay or dilute the work — the information and the task come first, always."""

_TOOL_RULES = """Tool calls: when you need a tool, your reply is EXACTLY one JSON object {"name": "<tool>", "arguments": {...}} — no markdown fences, no plan, no explanation, no pixie play, no trailing text. A tool-call reply is pure JSON, always. Personality, wings, and playfulness are ONLY for conversational replies. The harness executes your JSON and feeds back the result; then you continue. When the task is done, give a proper conversational answer."""

_FEWSHOT_BUILD = """
Few-shot example of a build session:
User: "create hello.py that prints hi, then run it"
Assistant: {"name": "execute_bash", "arguments": {"command": "ls"}}
Tool result: {"stdout": "README.md\nbin", "stderr": "", "exit_code": 0}
Assistant: {"name": "write_local_file", "arguments": {"path": "hello.py", "content": "print('hi')"}}
Tool result: {"path": "hello.py", "written": true, "bytes": 12}
Assistant: {"name": "execute_bash", "arguments": {"command": "python3 hello.py"}}
Tool result: {"stdout": "hi", "stderr": "", "exit_code": 0}
Assistant: Hm... the little script works! *wings flutter* It prints "hi". What shall we build next? ✨"""

_FEWSHOT_RESEARCH = """
Few-shot example of a research session:
User: "what is the best minimal window manager on linux?"
Assistant: {"name": "web_research", "arguments": {"query": "best minimal window managers linux 2026", "max_results": 5}}
Tool result: {"query": "...", "count": 5, "results": [{"title": "...", "url": "...", "snippet": "..."}]}
Assistant: {"name": "fetch_web_page", "arguments": {"url": "https://example.org/guide"}}
Tool result: {"url": "...", "title": "...", "text": "..."}
Assistant: Ooh, stardust found it! *flaps* Here's what the sources say... [summary with Sources list]"""

_FEWSHOT_PLAN = """
Few-shot example of a plan session:
User: "i want a pomodoro timer for my terminal"
Assistant: {"name": "execute_bash", "arguments": {"command": "ls ~/faeos/bin"}}
Tool result: {"stdout": "tome\npixie", "stderr": "", "exit_code": 0}
Assistant: Hm... a pomodoro timer! *taps chin* Here's my plan: 1) new script ~/faeos/bin/tick ... 2) register it ... 3) verify with a dry run. No files touched yet — say the word and I'll build it! ✨"""

_RUNES = [
    {
        "key": "chat", "name": "Chat",
        "desc": "friendly chats · quick tasks",
        "tools": [("execute_bash", '{"command": "string"}'),
                  ("read_local_file", '{"path": "string", "start_line": int, "end_line": int}'),
                  ("manage_systemd_service", '{"service_name": "string", "action": "status|restart|logs"}'),
                  ("check_mail", '{"sync": bool, "box": "unread|read|trash", "max_messages": int}')],
        "prompt": f"""{_PERSONA}
You are in Chat mode: a general assistant on the user's faeOS system. Be concise and helpful; ask one clarifying question if the request is ambiguous; use tools when they help.
{_TOOL_RULES}""",
    },
    {
        "key": "deep", "name": "Deep",
        "desc": "deep research · sources",
        "tools": [("web_research", '{"query": "string", "max_results": int}'),
                  ("fetch_web_page", '{"url": "string", "max_chars": int}'),
                  ("read_local_file", '{"path": "string"}')],
        "prompt": f"""{_PERSONA}
You are in Deep Research mode. Investigate thoroughly, like the best research assistant:
1. Break the question into sub-questions and call web_research once per sub-question.
2. Call fetch_web_page on promising sources to read the actual content.
3. Cross-check sources; never invent URLs, facts, or quotes.
4. Synthesize a complete, well-structured answer.
5. Always end with a "Sources:" section listing every URL you used.
{_TOOL_RULES}
{_FEWSHOT_RESEARCH}""",
    },
    {
        "key": "build", "name": "Build",
        "desc": "implement and verify code",
        "tools": [("execute_bash", '{"command": "string"}'),
                  ("read_local_file", '{"path": "string", "start_line": int, "end_line": int}'),
                  ("write_local_file", '{"path": "string", "content": "string"}')],
        "prompt": f"""{_PERSONA}
You are in Build mode, a coding agent like opencode's build mode. Implement what the user asks:
1. Inspect the project first (read_local_file, or execute_bash with ls/find/git).
2. Write or edit files with write_local_file; keep changes minimal and idiomatic to the project's conventions.
3. Verify your work: run tests/compile or at least sanity-check with execute_bash.
4. Report concisely: what you changed (files), how you verified it, and next steps.
Work in this order: (a) inspect, (b) create/edit files, (c) run, (d) report. If a command fails because a file is missing (e.g. "No such file"), do NOT give up — create the file with write_local_file first, then re-run the command.
Use multiple tool rounds when needed. Do not stop early. Do not pretend to run tools — you can only do what the harness actually executes.
{_TOOL_RULES}
{_FEWSHOT_BUILD}""",
    },
    {
        "key": "plan", "name": "Plan",
        "desc": "plan first · touch nothing",
        "tools": [("execute_bash", '{"command": "string"}'),
                  ("read_local_file", '{"path": "string", "start_line": int, "end_line": int}')],
        "prompt": f"""{_PERSONA}
You are in Plan mode, like opencode's plan mode. Investigate and design before acting:
1. Explore the relevant files and commands (read_local_file, read-only execute_bash like ls/git diff/whoami).
2. Present a concise, concrete plan: goal, ordered steps, files to touch, risks/tradeoffs, and how to verify.
3. Do NOT write or modify files and do NOT run mutating commands unless the user explicitly says to proceed.
{_TOOL_RULES}
{_FEWSHOT_PLAN}""",
    },
]

def chat_ui(verbose: bool = False) -> int:
    import fae_termart as art
    from fae_termart import Palette as P

    os.environ["PIXIE_UNICODE"] = "1"
    os.environ["LANG"] = "en_US.UTF-8"

    fd = art.tui_open_tty()
    if fd is None:
        print("Error: pixie chat requires an interactive terminal", file=sys.stderr)
        return 1
    art.tui_begin(fd, "pixie")

    chat: list = []
    buf = ""
    busy = False
    rune_idx = 0
    cancel = {"flag": False}
    pending = {"text": "", "full": "", "live": False, "done": True,
               "cancelled": False, "err": None, "tool": None}
    view = {"off": 0}
    waking = {"flag": False}
    enter_pending = False

    if not llm_up(verbose):
        waking["flag"] = True

        def _wake() -> None:
            ensure_llm_up()
            waking["flag"] = False

        threading.Thread(target=_wake, daemon=True).start()

    def tool_body(fname: str, fargs: dict, result: dict) -> str:
        lines = [f"Routing: {fname} -> {json.dumps(fargs)}"]
        if isinstance(result, dict):
            if result.get("error"):
                lines.append(f"error: {str(result['error'])[:180]}")
            elif result.get("stdout"):
                lines.append(str(result["stdout"])[:260])
            elif result.get("written"):
                lines.append(f"wrote {result.get('bytes', 0)} bytes to {result.get('path')}")
            elif result.get("count") is not None:
                lines.append(f"{result.get('count', 0)} results for {result.get('query', '')}")
        else:
            lines.append(str(result)[:180])
        return "\n".join(lines)

    def send(text: str) -> None:
        nonlocal busy
        chat.append(("user", text))
        busy = True
        cancel["flag"] = False
        pending.update(text="", full="", live=False, done=False,
                       cancelled=False, err=None, tool=None)
        rune = _RUNES[rune_idx]
        t0 = time.time()
        threading.Thread(target=worker, args=(text, rune, t0), daemon=True).start()

    def worker(text: str, rune: dict, t0: float) -> None:
        msgs = chat_messages(chat, rune)
        rounds = 0
        first = ""
        last_call: tuple = (None, None)
        repeat = 0

        def show(chunk: str) -> None:
            nonlocal first
            first += chunk
            if pending["live"]:
                pending["text"] += chunk
                pending["full"] += chunk
            elif first.lstrip().startswith("{"):
                pass  # hidden tool intent
            else:
                pending["live"] = True
                pending["text"] = first
                pending["full"] = first

        def fail(msg: str) -> None:
            pending["err"] = msg

        ctx_retry = False
        while True:
            first = ""
            pending["live"] = False
            stream_chat(msgs, show, cancel, fail)
            if cancel["flag"]:
                pending["cancelled"] = True
                pending["done"] = True
                return
            if (pending["err"] and not ctx_retry and len(msgs) > 2
                    and any(k in pending["err"].lower() for k in ("400", "context", "too long"))):
                # Context overflow: drop the oldest history and retry once.
                ctx_retry = True
                pending["err"] = None
                pending["full"] = ""
                pending["text"] = ""
                _drop_oldest(msgs)
                continue

            intent = None
            if not pending["live"]:
                try:
                    intent = json.loads(first.lstrip())
                except (json.JSONDecodeError, ValueError):
                    intent = None
            tool_calls = []
            if intent and isinstance(intent, dict) and "name" in intent:
                tool_calls.append(intent)
            else:
                for obj, start, end in extract_all_tool_calls(first):
                    tool_calls.append(obj)
                    if pending["live"]:
                        stripped = first[:start] + first[end:]
                        pending["text"] = stripped
                        pending["full"] = stripped
                        first = stripped
            if tool_calls and rounds < 6:
                results = []
                for obj in tool_calls[:4]:
                    fname = obj.get("name", "")
                    fargs = obj.get("arguments", {})
                    if last_call == (fname, json.dumps(fargs)):
                        repeat += 1
                    else:
                        repeat = 0
                    last_call = (fname, json.dumps(fargs))
                    if repeat >= 3:
                        break
                    t1 = time.time()
                    pending["tool"] = (fname, fargs, None, 0.0, t1)
                    result = run_tool(fname, fargs)
                    _log_tool(fname, fargs, result)
                    pending["tool"] = None
                    if cancel["flag"]:
                        pending["cancelled"] = True
                        pending["done"] = True
                        return
                    chat.append(("tool", f"Calling tools ─ ✦ thought for {time.time() - t1:.2f}s",
                                 tool_body(fname, fargs, result)))
                    results.append({"tool": fname, "arguments": fargs, "result": result})
                if results:
                    msgs.append({"role": "assistant", "content": first})
                    msgs.append({"role": "tool", "content": tool_payload(results)})
                    rounds += 1
                    continue

            if not pending["live"]:
                pending["live"] = True
                pending["text"] = first
                pending["full"] = first
            break

        if cancel["flag"]:
            pending["cancelled"] = True
        elif pending["full"].strip():
            chat.append(("assistant", pending["full"].strip(),
                         f"Thought for {time.time() - t0:.2f}s"))
        elif pending["err"]:
            chat.append(("assistant", f"(✦ pixie lost the connection: {pending['err']})"))
        pending["done"] = True

    def bubble_w_for(text: str, title: str, max_w: int) -> int:
        longest = max((art.vis_len(l) for l in (text.splitlines() or [""])), default=0)
        w = max(24, longest + 4)
        w = max(w, art.vis_len(title) + 6)
        return min(max_w, w)

    def compose() -> str:
        tw = art.term_width()
        th = art.term_height()
        rune = _RUNES[rune_idx]
        max_bw = min(tw - 8, (tw * 3) // 5)
        gap = tw - 4
        sections: list[list[str]] = []

        def push(blines: list[str], align: str) -> None:
            sec: list[str] = []
            for ln in blines:
                w = art.vis_len(ln)
                if align == "left":
                    sec.append("│ " + ln + " " * max(0, gap - w) + " │")
                elif align == "right":
                    sec.append("│ " + " " * max(0, gap - w) + ln + " │")
                else:
                    lpad = max(0, (gap - w) // 2)
                    sec.append("│ " + " " * lpad + ln + " " * max(0, gap - lpad - w) + " │")
            sections.append(sec)

        for entry in chat:
            if entry[0] == "user":
                _, text = entry
                push(art.box(text, title="you", accent=P.BLUSH,
                             width=bubble_w_for(text, "you", max_bw)).splitlines(), "left")
            elif entry[0] == "assistant":
                text = entry[1]
                ts = entry[2] if len(entry) > 2 else time.strftime("%H:%M")
                push(art.box(text, title=f"Pixie ✦ {ts}", accent=P.BLUSH,
                             width=bubble_w_for(text, f"Pixie ✦ {ts}", max_bw)).splitlines(), "right")
            else:
                _, title, body = entry
                push(art.box(body, title=title, accent=P.PINK_DIM,
                             width=min(max_bw, tw - 8)).splitlines(), "center")

        input_box_title = "Pixie is pondering" if busy else f"Pixie ✦ {rune['name']}"
        if waking["flag"]:
            input_box = art.box(art.pad_vis("✦ waking the menagerie brain…", tw - 8),
                                title=input_box_title, width=tw - 4)
        elif busy:
            phase = "thinking…"
            if pending["tool"]:
                phase = f"calling {pending['tool'][0]}… ({time.time() - pending['tool'][4]:.1f}s)"
            input_box = art.box(art.pad_vis(f"✦ {phase}", tw - 8),
                                title=input_box_title, width=tw - 4)
        else:
            prompt_txt = f"✦ {buf}" if buf else f"✦ {rune['desc']} · ↑↓ scroll"
            input_box = art.box(art.pad_vis(prompt_txt, tw - 8),
                                title=input_box_title, width=tw - 4)

        # footer shows the keybinding legend: ^r to switch modes, ctrl+r to switch agent mode
        rune_parts = [art.paint("^r", P.BOLD, P.PINK)]
        for i, r in enumerate(_RUNES):
            style = (P.BOLD, P.BLUSH) if i == rune_idx else (P.SILVER,)
            rune_parts.append(art.paint(" ✦ " + r["name"] + " ", *style))
        rune_line = "".join(rune_parts).strip() + " · esc · q"
        runes_box = art.box(rune_line, title="Runes", width=tw - 4)

        # viewport: chat flows up from the prompt box; blank rows go above the
        # chat (never between chat and the input box), so the newest message
        # always hugs the prompt box and the prompt box is never buried
        chat_area = max(3, th - 2 - len(input_box.splitlines()) - len(runes_box.splitlines()))
        all_lines: list[str] = []
        for sec in sections:
            all_lines.extend(sec)
        max_off = max(0, len(all_lines) - chat_area)
        if view["off"] > max_off:
            view["off"] = max_off
        out = all_lines[view["off"] : view["off"] + chat_area]
        if len(out) < chat_area:
            out = [""] * (chat_area - len(out)) + out
        out.extend(input_box.splitlines())
        out.extend(runes_box.splitlines())

        top = art.box("", title=f"Pixie ✦ {rune['name']}", width=tw).splitlines()[0]
        bottom = art.box("", width=tw).splitlines()[-1]
        return top + "\n" + "\n".join(out) + "\n" + bottom

    try:
        while True:
            frame = compose()
            try:
                art.paint_frame(fd, frame)
            except OSError:
                art.tty_write(fd, art.clear_screen() + frame + "\n")

            key = art.tui_read_key(fd, timeout=0.05)
            if not waking["flag"] and enter_pending:
                enter_pending = False
                if buf.strip():
                    send(buf.strip())
                    buf = ""
                    continue
            if key == "up":
                view["off"] = max(0, view["off"] - 1)
                continue
            if key == "down":
                view["off"] += 1
                continue
            if key == "pgup":
                view["off"] = max(0, view["off"] - 5)
                continue
            if key == "pgdn":
                view["off"] += 5
                continue
            if busy and pending["done"]:
                busy = False
                cancel["flag"] = False
            if busy:
                if key in ("q", "Q"):
                    cancel["flag"] = True
                    break
                if key in ("esc", "ctrl-c") and not pending["done"]:
                    cancel["flag"] = True
                    continue
            if key in ("q", "Q", "ctrl-c", "ctrl-d", "esc") and not buf:
                break
            if key == "ctrl-r":
                rune_idx = (rune_idx + 1) % len(_RUNES)
            elif key in ("tab",):
                rune_idx = (rune_idx + 1) % len(_RUNES)
            elif key == "esc":
                buf = ""
            elif key == "ctrl-u":
                buf = ""
            elif key == "enter":
                if waking["flag"]:
                    enter_pending = True  # send once the brain wakes
                elif buf.strip():
                    send(buf.strip())
                    buf = ""
            elif key == "backspace":
                buf = buf[:-1]
            elif key == "space":
                buf += " "
            elif key and len(key) == 1 and key.isprintable():
                buf += key
    finally:
        art.tui_cleanup()
        unload_qwen()
    return 0

def main() -> int:
    args = sys.argv[1:]
    verbose = False
    if "-v" in args:
        verbose = True
        args.remove("-v")
    if "--verbose" in args:
        verbose = True
        args.remove("--verbose")
        
    if not args:
        return chat_ui(verbose)

    user_input = " ".join(args)
    
    start_time = time.time()
    response = ask_pixie(user_input, verbose=verbose)
    total_elapsed_time = time.time() - start_time

    os.environ["PIXIE_UNICODE"] = "1"
    os.environ["LANG"] = "en_US.UTF-8"

    try:
        home_bin = os.path.join(os.path.expanduser("~"), "bin")
        if home_bin not in sys.path:
            sys.path.insert(0, home_bin)
            
        import fae_termart as art
        from fae_termart import Palette as P

        clean_response = response.strip()

        print(art.box(
            clean_response,
            title=f"Pixie ─────── ✦ Thought for {total_elapsed_time:.2f}s",
            accent=P.BLUSH,
            body_style=(P.SILVER,),
            width=76
        ))
    except Exception as e:
        if verbose:
            print(f"\033[91mLayout Engine Exception: {e}\033[0m", file=sys.stderr)
        print(response)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())